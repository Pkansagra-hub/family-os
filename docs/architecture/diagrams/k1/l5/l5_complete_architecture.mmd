        subgraph Resilience_Backpressure["3️⃣ Resilience & Backpressure (Fault Tolerance + Flow Control)"]
            direction TB
            WatermarkChecker["WatermarkChecker<br/>📊 Tier Thresholds<br/>───────────<br/>• 80/90/95% bands<br/>• 5% hysteresis<br/>• Queue depth, latency<br/>• Prom metrics export<br/>───────────<br/>⏱️ <5ms check"]
            VoicePipelineMonitor["VoicePipelineMonitor<br/>🎙️ Voice Signals<br/>───────────<br/>• ASR frame drops<br/>• TTS degradation<br/>• Barge-in priority<br/>• Buffer saturation<br/>───────────<br/>⏱️ <5ms poll"]
            GlobalLimitsEnforcer["GlobalLimitsEnforcer<br/>� Session Caps<br/>───────────<br/>• Max 3 agents/session<br/>• CPU ≥85% throttle<br/>• Memory ≥480MB shed<br/>• Fairness enforcement<br/>───────────<br/>⏱️ <5ms eval"]
            CascadeManager["CascadeManager<br/>🌊 Tier Aggregator<br/>───────────<br/>• Merge signals<br/>• Tier escalation<br/>• Thermal multipliers<br/>• Audit playback<br/>───────────<br/>⏱️ <5ms aggregate"]
            CascadeDecision["CascadeDecision<br/>⚖️ Action Planner<br/>───────────<br/>• ALLOW/WARN/DEGRADE/REJECT<br/>• Tier order T1→T3<br/>• 10s stability checks<br/>• Rollback safeguards<br/>───────────<br/>⏱️ <10ms decide"]
            CircuitBreaker["CircuitBreaker<br/>🔌 3-State FSM<br/>───────────<br/>• CLOSED / OPEN / HALF_OPEN<br/>• 5 failures → OPEN<br/>• 30s cooldown<br/>• Fallback cascade<br/>───────────<br/>⏱️ <10ms check"]
            RetryPolicy["RetryPolicy<br/>🔄 Exponential Backoff<br/>───────────<br/>• Max 5 retries<br/>• 100ms→1600ms<br/>• Jitter ±20%<br/>• Idempotency keys<br/>───────────<br/>⏱️ <5ms decision"]

            WatermarkChecker --> CascadeManager
            VoicePipelineMonitor --> CascadeManager
            GlobalLimitsEnforcer --> CascadeManager
            CascadeManager --> CascadeDecision
            CascadeDecision --> CircuitBreaker
            CascadeDecision --> RetryPolicy
            CircuitBreaker --> RetryPolicy
        end

        %% ===== 4. THERMAL (Temperature Monitoring + Placement) =====
        subgraph Thermal["4️⃣ Thermal (Adaptive Placement)"]
            direction TB
            ThermalMonitor["ThermalMonitor<br/>🌡️ Temp Polling<br/>───────────<br/>• 1 Hz polling<br/>• 5 thermal zones<br/>• COOL → EMERGENCY<br/>• Alert ≥85°C<br/>───────────<br/>⏱️ <5ms read"]
            PlacementPlanner["PlacementPlanner<br/>🎯 4-Tier Cascade<br/>───────────<br/>• NPU (30ms, 10W)<br/>• GPU (50ms, 12W)<br/>• CPU (120ms, 15W)<br/>• Remote (500ms, 5W)<br/>───────────<br/>⏱️ <10ms placement"]
            HysteresisFSM["HysteresisFSM<br/>🔄 State Machine<br/>───────────<br/>• Asymmetric (7°C)<br/>• Upgrade +5°C<br/>• Downgrade -2°C<br/>• Cooldown 10-60s<br/>───────────<br/>🛑 Prevents oscillation"]

            ThermalMonitor --> PlacementPlanner
            PlacementPlanner --> HysteresisFSM
        end

