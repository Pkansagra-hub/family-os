        subgraph K0_Bridge["1️⃣ K0 Bridge (K1↔K0 Communication)"]
            direction TB
            CommandClient["CommandClient<br/>📤 Write Operations<br/>───────────<br/>• HTTP/2 POST :8080<br/>• P01 MemoryWrite<br/>• P02 PlanCommitted<br/>• FlatBuffers payload<br/>───────────<br/>⏱️ <50ms (GREEN)<br/>⏱️ <200ms (AMBER/RED)"]
            QueryClient["QueryClient<br/>📥 Read Operations<br/>───────────<br/>• HTTP/2 POST :8080<br/>• Multi-store retrieval<br/>• FTS5+FAISS+KG<br/>• MMR fusion<br/>───────────<br/>⏱️ <100ms P95"]
            SSEClient["SSEClient<br/>📡 Event Streaming<br/>───────────<br/>• HTTP GET :8080<br/>• EventSource SSE<br/>• Cursor-based resume<br/>• At-least-once<br/>───────────<br/>⏱️ <5ms delivery"]
            BatchClient["BatchClient<br/>📦 Delta Batching<br/>───────────<br/>• 250ms interval<br/>• SessionState deltas<br/>• 64KB or 100 items<br/>• zstd compression<br/>───────────<br/>⏱️ <10ms batch"]
            HTTP2Manager["HTTP2ConnectionManager<br/>🔌 Connection Pooling<br/>───────────<br/>• 1 conn per port<br/>• 100 streams/conn<br/>• PING every 10s<br/>• TLS 1.3<br/>───────────<br/>⏱️ <10ms round-trip"]

            CommandClient --> HTTP2Manager
            QueryClient --> HTTP2Manager
            SSEClient --> HTTP2Manager
            BatchClient --> HTTP2Manager
        end

        %% ===== 2. EVENT BUS (Layer 1→Layer 2 Communication) =====
        subgraph Event_Bus["2️⃣ Event Bus (Cross-Layer Pub/Sub)"]
            direction TB
            EventBus["EventBus<br/>📬 Pub/Sub Router<br/>───────────<br/>• In-memory queues<br/>• Topic-based routing<br/>• Zero-copy delivery<br/>• 1-to-N fan-out<br/>───────────<br/>⏱️ <5ms delivery"]
            EventSchemas["EventSchemas<br/>📋 Event Types<br/>───────────<br/>• IntentDetected<br/>• UserInput<br/>• VoiceCommand<br/>• BargeIn<br/>───────────<br/>🔗 cognitive_trace_id"]

            EventBus --> EventSchemas
        end

