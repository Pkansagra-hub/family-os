stateDiagram-v2
    [*] --> CLOSED: Initial State
    
    state "CLOSED<br/>(Normal Operation)" as CLOSED {
        [*] --> Processing
        Processing --> CheckFailures: Request Completed
        CheckFailures --> Processing: Success (Reset Count)
        CheckFailures --> FailureCount: Failure
        FailureCount --> Processing: Count < Threshold (3)
        FailureCount --> [*]: Count >= Threshold (3)
    }
    
    state "OPEN<br/>(Reject All Requests)" as OPEN {
        [*] --> Rejecting
        Rejecting --> WaitingTimeout: Start Timeout (30s)
        WaitingTimeout --> [*]: Timeout Elapsed
    }
    
    state "HALF_OPEN<br/>(Trial Period)" as HALF_OPEN {
        [*] --> TestRequest
        TestRequest --> CheckResult: Single Request
        CheckResult --> Success: 200 OK
        CheckResult --> Failure: 5xx Error
        Success --> [*]: Reset Failures
        Failure --> [*]: Increment Failures
    }
    
    CLOSED --> OPEN: Failure Count >= 3
    OPEN --> HALF_OPEN: Timeout Elapsed (30s)
    HALF_OPEN --> CLOSED: Test Request Success
    HALF_OPEN --> OPEN: Test Request Failure
    
    note right of CLOSED
        Failure Threshold: 3 consecutive failures
        Success Action: Reset failure count to 0
        Metrics: k0_circuit_closed_total
        Behavior: Allow all requests through
    end note
    
    note right of OPEN
        Timeout Duration: 30 seconds
        Rejection: Immediate fail-fast (no K0 call)
        Metrics: k0_circuit_open_total
        Error: K0CircuitOpenError
    end note
    
    note right of HALF_OPEN
        Trial Mode: Single test request
        Success → CLOSED: Resume normal operation
        Failure → OPEN: Restart timeout (30s)
        Metrics: k0_circuit_half_open_total
    end note

---

stateDiagram-v2
    [*] --> Attempt1: Initial Request
    
    state "Attempt 1<br/>(Delay: 0ms)" as Attempt1 {
        [*] --> SendRequest1
        SendRequest1 --> Classify1: Response Received
        Classify1 --> Success1: 2xx Success
        Classify1 --> PermanentError1: 4xx Client Error
        Classify1 --> TransientError1: 5xx/Timeout
        Success1 --> [*]: Return Result
        PermanentError1 --> [*]: Fail Immediately
    }
    
    state "Backoff 1<br/>(100ms * 2^0)" as Backoff1 {
        [*] --> Sleep1: await asyncio.sleep(0.1)
        Sleep1 --> [*]: Resume
    }
    
    state "Attempt 2<br/>(Delay: 100ms)" as Attempt2 {
        [*] --> SendRequest2
        SendRequest2 --> Classify2: Response Received
        Classify2 --> Success2: 2xx Success
        Classify2 --> PermanentError2: 4xx Client Error
        Classify2 --> TransientError2: 5xx/Timeout
        Success2 --> [*]: Return Result
        PermanentError2 --> [*]: Fail Immediately
    }
    
    state "Backoff 2<br/>(100ms * 2^1)" as Backoff2 {
        [*] --> Sleep2: await asyncio.sleep(0.4)
        Sleep2 --> [*]: Resume
    }
    
    state "Attempt 3<br/>(Delay: 400ms)" as Attempt3 {
        [*] --> SendRequest3
        SendRequest3 --> Classify3: Response Received
        Classify3 --> Success3: 2xx Success
        Classify3 --> PermanentError3: 4xx Client Error
        Classify3 --> TransientError3: 5xx/Timeout
        Success3 --> [*]: Return Result
        PermanentError3 --> [*]: Fail Immediately
        TransientError3 --> [*]: Exhaust Retries
    }
    
    Attempt1 --> Backoff1: TransientError1 (Retry)
    Backoff1 --> Attempt2: After 100ms
    Attempt2 --> Backoff2: TransientError2 (Retry)
    Backoff2 --> Attempt3: After 400ms
    Attempt3 --> [*]: Max Retries (3) Reached
    
    note right of Attempt1
        Transient Errors (Retry):
        - 500 Internal Server Error
        - 502 Bad Gateway
        - 503 Service Unavailable
        - 504 Gateway Timeout
        - Network timeout
        - Connection refused
    end note
    
    note right of Backoff1
        Exponential Backoff Formula:
        delay = base_delay * (2 ^ attempt)
        base_delay = 100ms
        max_delay = 1600ms
        
        Attempt 1: 100ms * 2^0 = 100ms
        Attempt 2: 100ms * 2^1 = 400ms
        Attempt 3: 100ms * 2^2 = 1600ms
    end note
    
    note right of Attempt2
        Permanent Errors (No Retry):
        - 400 Bad Request (malformed)
        - 403 Forbidden (authz failure)
        - 404 Not Found (invalid endpoint)
        - 409 Conflict (duplicate receipt)
        - 413 Payload Too Large
        - 429 Rate Limited (backpressure)
    end note

---

graph TB
    subgraph "Retry Policy - Error Classification"
        REQ[Incoming Request<br/>POST /k0/command.submit]
        SEND[Send HTTP Request]
        RESP{Response Status}
        
        SUCCESS[2xx Success<br/>Return Result]
        CLIENT_ERR[4xx Client Error<br/>Permanent Failure]
        SERVER_ERR[5xx Server Error<br/>Transient Failure]
        TIMEOUT[Network Timeout<br/>Transient Failure]
        
        CLASSIFY{Error<br/>Classification}
        
        PERM_FAIL[Permanent Error<br/>Do NOT Retry]
        TRANS_FAIL[Transient Error<br/>Apply Backoff]
        
        BACKOFF[Exponential Backoff<br/>Compute Delay]
        SLEEP[await asyncio.sleep<br/>100ms → 400ms → 1600ms]
        
        RETRY[Increment Attempt<br/>Max: 3]
        MAX{Attempts < 3?}
        
        EXHAUST[Retries Exhausted<br/>Raise K0RetryError]
    end
    
    subgraph "Circuit Breaker - Failure Tracking"
        CB_STATE{Circuit<br/>State}
        CB_CLOSED[CLOSED<br/>Allow Request]
        CB_OPEN[OPEN<br/>Reject Immediately]
        CB_HALF[HALF_OPEN<br/>Test Request]
        
        FAIL_COUNT[Failure Counter<br/>Thread-Safe Atomic]
        THRESHOLD{Count >= 3?}
        
        TRIP[Trip Circuit<br/>CLOSED → OPEN]
        TIMER[Start Timeout<br/>30 seconds]
        RESET[Reset Counter<br/>Count = 0]
    end
    
    REQ --> SEND
    SEND --> RESP
    
    RESP -->|2xx| SUCCESS
    RESP -->|4xx| CLIENT_ERR
    RESP -->|5xx| SERVER_ERR
    RESP -->|Timeout| TIMEOUT
    
    CLIENT_ERR --> CLASSIFY
    SERVER_ERR --> CLASSIFY
    TIMEOUT --> CLASSIFY
    
    CLASSIFY -->|400/403/404/409/413| PERM_FAIL
    CLASSIFY -->|500/502/503/504| TRANS_FAIL
    CLASSIFY -->|Connection Error| TRANS_FAIL
    
    PERM_FAIL --> FAIL_COUNT
    TRANS_FAIL --> BACKOFF
    
    BACKOFF --> SLEEP
    SLEEP --> RETRY
    RETRY --> MAX
    
    MAX -->|Yes| SEND
    MAX -->|No| EXHAUST
    
    SUCCESS --> CB_STATE
    PERM_FAIL --> CB_STATE
    TRANS_FAIL --> CB_STATE
    EXHAUST --> CB_STATE
    
    CB_STATE -->|Current: CLOSED| CB_CLOSED
    CB_STATE -->|Current: OPEN| CB_OPEN
    CB_STATE -->|Current: HALF_OPEN| CB_HALF
    
    CB_CLOSED --> FAIL_COUNT
    FAIL_COUNT --> THRESHOLD
    
    THRESHOLD -->|Yes| TRIP
    THRESHOLD -->|No| RESET
    
    TRIP --> TIMER
    TIMER --> CB_OPEN
    
    CB_OPEN -.->|After 30s| CB_HALF
    CB_HALF -.->|Success| RESET
    CB_HALF -.->|Failure| TRIP
    
    RESET --> CB_CLOSED
    
