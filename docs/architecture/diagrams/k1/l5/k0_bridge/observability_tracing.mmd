    classDef note fill:#ecf0f1,stroke:#95a5a6,stroke-width:1px,color:#2c3e50
    
    class AGENT,TRACE_GEN agent
    class SPAN_START,SPAN_ATTRS,INJECT,EXTRACT,K0_SPAN,K0_SPAN_END,TRACE_TREE,TRACE_ATTRS trace
    class CMD_SUCCESS,CMD_ERROR,CMD_LATENCY,CMD_RETRY,CB_STATE,CB_OPEN,CB_TRIP,SSE_EVENTS,SSE_DISCONNECT,SSE_LATENCY,SSE_SESSION,HTTP2_CONN,HTTP2_STREAMS,HTTP2_EVICT,HTTP2_HEALTH metrics
    class PROM_METRICS,OTEL_EXPORT export
    class K0_RECV,K0_PROCESS k0
    class LOG_CTX,LOG_FIELDS,LOG_SAMPLE log
    class Note1,Note2,Note3 note
