  subgraph TRANSITIONS["Transition Table + Guard Matrix"]
    direction TB

    GUARD_ENUM["GuardAction Enum (5)
      TRANSITION  — validate + change state
      PASSTHROUGH — forward without state change
      OBSERVE     — log/history only, no routing
      QUEUE       — queue in FrontLock or pending_results
      DEAD_LETTER — reject as invalid"]:::guard

    TRANS_TABLE["TRANSITION_TABLE
      11 states × ~5-7 triggers each = ~60 legal transitions
      Maps: (from_state, trigger) → to_state | None

      Key transitions:
      LISTENING + user.input              → DISPATCHING
      LISTENING + task.complete           → PROACTIVE_WAKE
      DISPATCHING + task.dispatch         → COMPANIONING
      DISPATCHING + response.final        → LISTENING
      DISPATCHING + task.cancel           → CANCELLING
      DISPATCHING + clarification.detected → CLARIFYING_USER
      COMPANIONING + task.complete        → DELIVERING
      COMPANIONING + user.input           → INTERRUPT_HANDLING
      COMPANIONING + tool.started         → PROGRESSING
      DELIVERING + response.final         → LISTENING
      DELIVERING + pending_results        → WEAVING
      WEAVING + response.final            → LISTENING
      CLARIFYING_WORKER + task.resume     → COMPANIONING
      CANCELLING + task.failed            → DELIVERING"]:::transition

    GUARD_TABLE["FULL_GUARD_TABLE — 11 states × 27 topics = ~297 cells
      Every (state, topic) pair has an explicit guard action.
      Derived from actual controller.py handler code.

      Example rows:
      LISTENING + user.input         → TRANSITION
      LISTENING + final_response     → DEAD_LETTER (spurious)
      DISPATCHING + user.input       → DEAD_LETTER (re-entrant)
      DISPATCHING + task.complete    → QUEUE (pending_results)
      COMPANIONING + task.complete   → TRANSITION
      COMPANIONING + findings.ready  → PASSTHROUGH
      COMPANIONING + artifact.created → OBSERVE
      WEAVING + task.complete        → QUEUE (weave pending)"]:::guard_table

    SYNTHETIC_TRIGGERS["Synthetic Triggers (6 internal)
      clarification.detected     — Phase 1 uncertainty → CLARIFYING_USER
      pending_results.non_empty  — Weave drain trigger
      interrupt.routed           — Arbiter completed → DISPATCHING
      proactive.routed           — ProactiveWakeHandler → DELIVERING
      same_turn.task.complete    — Same-turn completion → LISTENING
      deferred_hitl.surface      — Deferred HITL → CLARIFYING_WORKER"]:::trigger
  end

  %% ================================================================================
  %% 1D. FRONT LOCK — Concurrency Gate (156 lines)
  %% ================================================================================

  subgraph FRONTLOCK["FrontLock — Concurrency Gate"]
    direction TB

    FL_STATE["State
      busy: bool = False
      event_queue: deque[tuple[int, Envelope]]
      max_queue_depth: int (configurable, default 8)"]:::frontlock

    FL_API["Core API
      try_deliver(envelope) → bool
        • If !busy: set busy=True, return True (delivered)
        • If busy: enqueue at priority position, return False (queued)
        • Backpressure: if queue > max_depth, evict lowest-priority

      release() → Envelope | None
        • Pop next queued event at head, or set busy=False
        • Called after Front LLM finishes

      drain_loop(deliver_fn) → async drain entire queue"]:::frontlock

    FL_PRIORITY["Priority Levels (lower = higher)
      P1 URGENT      (1): user.input          — user is ALWAYS first
      P2 INTERACTIVE (2): hil.request          — worker blocked, needs answer
                          task.suspended
      P3 RESULT      (3): task.complete        — result ready
                          weave.batch
      P4 ERROR       (4): task.failed          — error notification
      P5 INFO        (5): findings.ready       — informational
                          proactive.fill"]:::frontlock_priority
  end

  %% ================================================================================
  %% 1E. TURN STATE — Ephemeral Coordination (~200 lines)
  %% ================================================================================

  subgraph TURNSTATE["FSMTurnState — Ephemeral (NOT in SS)"]
    direction TB

    TS_QUEUES["Queues
      pending_results: deque[dict]     — queued task.complete payloads
      deferred_results: list[dict]      — M8 DEFER policy hold
      max_depth: 16
      max_deferred_depth: 16
      ttl_seconds: 300 (5 min)"]:::turnstate

    TS_API["API
      enqueue_result(task_id, result, envelope, urgency)
        → Overflow: evict oldest if at max_depth
        → M9: emit WeaveCandidateArrived to ledger

      drain_results() → (valid[], expired[])
        → Filter by TTL, clear deque
        → M9: emit WeaveEmitted to ledger

      defer_result()           → move to deferred (M8)
      drain_deferred()         → drain deferred queue
      mark_deferred()          → move all pending → deferred
      discard_task(task_id)    → remove from all queues

      Properties: has_pending_results, has_deferred_results, depth"]:::turnstate

    TS_LEDGER["M9 E9.4.4: Ledger Integration
      set_ledger(writer) → write-before-mutate
      Enqueue → WeaveCandidateArrived event
      Drain   → WeaveEmitted event"]:::turnstate_ledger
  end

