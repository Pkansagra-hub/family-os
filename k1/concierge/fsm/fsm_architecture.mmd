  %% ================================================================================
  %% 1B. STATES — 11 FSM states (43 lines)
  %% ================================================================================

  subgraph STATES["ConciergeState Enum — 11 States"]
    direction LR

    subgraph CORE_STATES["Core Loop (5)"]
      S_LISTENING["LISTENING
        Entry: response.final OR session start
        Active: None (idle)
        Exit: user.input → DISPATCHING"]:::state_core
      S_DISPATCHING["DISPATCHING
        Entry: user.input + Phase 1 complete
        Active: Front LLM
        Exit: task.dispatch → COMPANIONING
              response.final → LISTENING
              clarification.detected → CLARIFYING_USER"]:::state_core
      S_COMPANIONING["COMPANIONING
        Entry: ack emitted + task dispatched
        Active: Front (idle), Back working
        Exit: task.complete → DELIVERING
              user.input → INTERRUPT_HANDLING
              tool.started → PROGRESSING"]:::state_core
      S_PROGRESSING["PROGRESSING
        Entry: tool.started received
        Active: Back LLM
        Exit: tool.completed → COMPANIONING
              task.complete → DELIVERING"]:::state_core
      S_DELIVERING["DELIVERING
        Entry: task.complete received
        Active: Front LLM
        Exit: response.final → LISTENING
              pending_results → WEAVING"]:::state_core
    end

    subgraph INTERRUPT_STATES["Interrupt / Special (6)"]
      S_CLARIFY_USER["CLARIFYING_USER
        Entry: uncertainty ≥ threshold
        Active: Front LLM
        Exit: user.input → DISPATCHING"]:::state_interrupt
      S_CLARIFY_WORKER["CLARIFYING_WORKER
        Entry: task.suspended OR hil.request
        Active: Front LLM
        Exit: task.resume → COMPANIONING
              task.failed/complete → DELIVERING"]:::state_interrupt
      S_CANCELLING["CANCELLING
        Entry: task.cancel emitted by Front
        Active: Controller
        Exit: task.failed → DELIVERING"]:::state_interrupt
      S_INTERRUPT["INTERRUPT_HANDLING
        Entry: user.input during COMPANIONING/PROGRESSING
        Active: Front LLM (Arbiter runs first)
        Exit: interrupt.routed → DISPATCHING"]:::state_interrupt
      S_PROACTIVE["PROACTIVE_WAKE
        Entry: task.complete while LISTENING
        Active: Controller
        Exit: proactive.routed → DELIVERING"]:::state_interrupt
      S_WEAVING["WEAVING
        Entry: pending_results non-empty after final
        Active: Front LLM
        Exit: response.final → LISTENING
              pending_results → WEAVING (re-weave)"]:::state_interrupt
    end
  end

