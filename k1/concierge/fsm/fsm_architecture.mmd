%% ======================================================================================
%% SECTION 3: ADAPTIVE WEAVE DELIVERY (M8)
%% ======================================================================================

subgraph WEAVE_ADAPTIVE["M8 Adaptive Weave Delivery"]
  direction TB

  WEAVE_SIGNAL["WeaveSignal
    task_id, safety_band, domain, emotional_urgency,
    user_present, user_typing, active_in_flight,
    pending_depth, deferred_depth, time_since_last_delivery"]:::weave

  WEAVE_POLICY["WeavePolicy Decision
    WeaveDecisionResult { decision, reasoning, flush_window_ms }

    Decisions:
    IMMEDIATE  → deliver now, 0ms delay
    BATCH      → schedule flush, dynamic window
    DEFER      → hold until next user input
    DIGEST     → accumulate + compress, schedule later
    SUPPRESS   → discard, audit only

    Emotional gate: CRISIS/RED → SUPPRESS all non-safety"]:::weave

  WEAVE_FLOW["Flow
    task.complete arrives
      → WeavePolicy.evaluate(signal)
      → IMMEDIATE: _deliver_weave_immediate() → Front now
      → BATCH:     _schedule_weave_flush_adaptive() → dynamic window
      → DEFER:     _mark_results_deferred() → held for next input
      → DIGEST:    _schedule_digest_flush() → accumulate + compress
      → SUPPRESS:  _suppress_result() → audit only"]:::weave

  WEAVE_BATCHER["WeaveBatcher Integration
    schedule_flush(window_ms)
      → asyncio.create_task(flush_after(window_ms))
      → On flush: drain_results() → Front re-invoke
      → Reset on new arrival in window
      → Max batch: 8 results/flush"]:::weave

  WEAVE_FALLBACK["WeaveFallbackHandler
    On flush failure: serialize results → WeaveBatch snapshot
    On Front LLM failure: canned weave response
    Metrics: batch_size, window_actual_ms, overflow_count"]:::weave
end

