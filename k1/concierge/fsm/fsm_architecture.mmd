  subgraph ARBITER["ConversationArbiter — Deterministic Routing"]
    direction TB

    ARB_INPUT["ArbiterInput (minimal signal)
      safety_band: str = 'GREEN'
      intent_classification: str = 'general'
      domain_context: str = 'general'
      primary_emotion: str = 'neutral'
      emotion_confidence: float = 0.5
      entities: list[dict] = []"]:::arbiter

    ARB_INFLIGHT["InflightContext (read-only snapshot)
      tasks: list[InflightTask]      — all inflight
      pending_results: int            — queue depth
      cancelled_task_ids: set[str]    — cancel dedup
      fsm_state: str                  — current state
      current_turn: int
      active_device_id: str | None
      pool_active_workers: int        — M7 capacity
      pool_size: int
      pool_available: int
      lease_deadlines: dict[str, int]"]:::arbiter

    ARB_DECISIONS["ArbiterDecision Enum (4)
      CANCEL           — kill inflight task(s)
      MODIFY_INFLIGHT  — update inflight task params
      PARALLEL_NEW     — run new task alongside
      DEFER            — queue for later"]:::arbiter

    ARB_TABLE["Decision Table (7 priorities, first match wins)
      1. RED safety band                     → CANCEL all
      2. Cancel intent + inflight            → CANCEL (targeted or all)
      3. Cancel intent + no inflight         → PARALLEL_NEW
      4. Domain+entity overlap ≥ threshold   → MODIFY_INFLIGHT
      5. Defer pattern match + inflight      → DEFER
      6. Inflight present                    → PARALLEL_NEW
      7. No inflight                         → PARALLEL_NEW"]:::arbiter_table

    ARB_SCORING["Overlap Scoring (OPP-2 Recency Decay)
      domain_overlap()     → [0.0, 1.0] with recency decay
      entity_overlap()     → Jaccard coefficient with recency decay
      is_short_input()     → <3 words = 50% overlap penalty
      _apply_recency_decay() → raw * (1-decay)^age, decay=0.15"]:::arbiter

    ARB_MULTIDEVICE["Multi-Device Conflict (M5 E5.4.2-3)
      resolve_device_conflict()        → deterministic precedence
      detect_high_impact_conflict()    → contradictory actions?
      build_conflict_clarification()   → system clarification prompt"]:::arbiter
  end

  %% ================================================================================
  %% 1G. RESPONSE FINAL TABLE — Pure Decision Function (~290 lines)
  %% ================================================================================

  subgraph RESPONSE_FINAL["ResponseFinalTable — 13-Branch Pure Function"]
    direction TB

    RF_ACTIONS["ResponseFinalAction Enum (6)
      TRANSITION_LISTENING
      TRANSITION_WEAVING
      TRANSITION_COMPANIONING
      STAY
      IGNORE
      DEAD_LETTER"]:::response_final

    RF_DECISION["ResponseFinalDecision (immutable, frozen, slots)
      action: ResponseFinalAction
      target_state: ConciergeState | None
      emit_turn_completed: bool
      drain_front_lock: bool
      schedule_weave: bool
      release_front_lock: bool
      entry_type: str  — 'final' | 'weave' | 'proactive' | 'proactive_fallback'"]:::response_final

    RF_TABLE["13-Branch Truth Table
      #1  DISPATCHING    + has_pending          → weave flush        → WEAVING
      #2  DISPATCHING    + has_active_tasks      → wait for tasks     → COMPANIONING
      #3  DISPATCHING    + no pending, no active → turn done          → LISTENING
      #4  DELIVERING     + has_pending           → weave transition   → WEAVING
      #5  WEAVING        + has_pending, no flush → re-weave           → WEAVING
      #6  WEAVING        + has_pending, flush    → stay (flush runs)  → WEAVING
      #7  DELIVERING     + no pending            → turn done          → LISTENING
      #8  WEAVING        + no pending            → turn done          → LISTENING
      #9  COMPANIONING   + has_active_tasks      → stay, wait         → COMPANIONING
      #10 COMPANIONING   + no active             → race-safe exit     → LISTENING
      #11 CLARIFY_WORKER + pending_hitl/active   → wait for answer    → CLARIFYING_WORKER
      #12 CLARIFY_WORKER + no active             → turn done          → LISTENING
      #13 LISTENING      + spurious final        → ignore             → LISTENING"]:::response_final_table
  end

