%% ======================================================================================
%% SECTION 7: STRENGTHS & WEAKNESSES (Analysis)
%% ======================================================================================

subgraph ANALYSIS["Strengths & Weaknesses Analysis"]
  direction TB

  subgraph STRENGTHS["STRENGTHS ✅"]
    S1["1. Guard-First Architecture
       Every (state, topic) pair has explicit guard action.
       297 cells in FULL_GUARD_TABLE, derived from actual code.
       No implicit/fallthrough behavior."]:::strength
    S2["2. Pure Decision Tables
       response_final_table: 13 branches, zero side effects.
       decide_response_final() is a pure function.
       Easy to test exhaustively, impossible to have hidden state bugs."]:::strength
    S3["3. Deterministic Arbiter
       7-priority decision table, no LLM dependency.
       Same inputs = same outputs. Fast (<1ms).
       Multi-device conflict resolution built in."]:::strength
    S4["4. Single Writer Invariant
       Clear ownership: FSM owns 4 SS sections.
       Front owns 5 cognitive sections.
       Back NEVER writes SS directly — deltas only."]:::strength
    S5["5. FrontLock Priority Queue
       5 priority levels prevent starvation.
       HIL requests jump ahead of bulk results.
       Backpressure at max depth with eviction."]:::strength
    S6["6. TTL + Overflow on pending_results
       300s TTL prevents stale result delivery.
       Max depth 16 prevents memory bloat.
       Expired/evicted → dead-letter, not silent drop."]:::strength
    S7["7. M8 Adaptive Weave
       5 delivery decisions (IMMEDIATE/BATCH/DEFER/DIGEST/SUPPRESS).
       Emotional gate prevents inappropriate delivery.
       Dynamic batch windows adapt to user activity."]:::strength
    S8["8. Idempotency
       LRU-based dedup (500 entries) prevents double-processing.
       Essential for at-least-once bus delivery."]:::strength
  end

  subgraph WEAKNESSES["WEAKNESSES ⚠️"]
    W1["1. Controller Monolith (~5,800 lines)
       Single file with 19+ handler methods.
       Hard to navigate, harder to test in isolation.
       Risk: change in one handler breaks another."]:::weakness
    W2["2. Handler Extraction Incomplete
       Some handlers externalized (response_final_table, arbiter, interrupt_handler).
       Others still inline in controller.py (_on_task_dispatch, _on_task_complete
       12-step flow, _on_hil_request, etc.).
       Inconsistent extraction pattern."]:::weakness
    W3["3. FULL_GUARD_TABLE Accuracy Risk
       297 cells declared as 'derived from actual handler code'.
       But the derivation is manual — if handler logic changes
       and table isn't updated, guard says one thing, code does another.
       No automated verification that guards match handlers."]:::weakness
    W4["4. Synthetic Triggers Are Invisible on Bus
       Six internal triggers (clarification.detected, interrupt.routed, etc.)
       never appear as bus topics. They're internal state mutations.
       Can't observe them from outside the FSM → hard to debug."]:::weakness
    W5["5. FrontLock release() Race
       release() returns next queued envelope OR sets busy=False.
       But between release() and the next try_deliver(), another event
       could arrive on the bus. The drain_loop handles this but
       the synchronous path has a TOCTOU window."]:::weakness
    W6["6. TaskBridge SS Dependency at Init
       TaskBridge is created before SS is wired (set_session_state).
       rebind() and rebuild_from_projection() handle late binding,
       but any method called before wiring will crash.
       No pre-wiring guard/assertion on public methods."]:::weakness
    W7["7. HistoryWriter Sliding Window is Silent
       Max 20 entries in history_active. No compression before eviction.
       Old entries just disappear. No summary/compaction step.
       OPP-6 EpisodicCompressor exists but isn't called from FSM."]:::weakness
    W8["8. No FSM Transition Timeout
       FSM can get stuck in any state indefinitely.
       No watchdog that forces transition after N seconds.
       E.g., COMPANIONING waiting for Back that crashed."]:::weakness
    W9["9. WeavePolicy Emotional Gate is Binary
       CRISIS/RED → SUPPRESS_ALL_NON_SAFETY.
       But what about AMBER results? They're delivered normally.
       The emotional gating is coarse — only 2 effective bands
       (normal delivery vs. suppress all) despite 5 affect bands."]:::weakness
    W10["10. DeadLetterConsumer is Passive
        Records metrics, never retries, never alerts.
        Dead letters are fire-and-forget. If a critical task
        gets dead-lettered, nobody knows until user complains."]:::weakness
  end

  subgraph GAPS["GAPS 🔴"]
    G1["GAP-1: No Automated Guard/Handler Consistency Check
       FULL_GUARD_TABLE claims to match handler code but
       there's no test that verifies every handler's guard action
       matches the table. A handler returning without state change
       when the table says TRANSITION = silent corruption."]:::gap
    G2["GAP-2: No FSM State History / Audit Trail
       Transitions are logged but not stored in a queryable ledger.
       Can't answer 'what was the state 3 turns ago?'
       The ledger tracks events, not FSM state transitions."]:::gap
    G3["GAP-3: FrontLock Queue Not Observable
       queue_depth is a property but not exposed as a metric.
       Can't monitor if FrontLock is backing up in production.
       Backpressure events are logged but not counted."]:::gap
    G4["GAP-4: Section Update Pipeline Is Loosely Coupled
       Section update (15 files) is wired into the controller via
       overlay/plan_compiler imports but the FSM doesn't have
       explicit states for section update in-progress.
       It runs as a side effect during handlers."]:::gap
    G5["GAP-5: No Crash Recovery Test for FSM Mid-Transition
       Crash recovery exists (ledger/recovery.py) but what if the
       crash happens mid-_transition() — after state change but
       before ControlExtension update? The reconstructed state
       from ledger projection may not match actual SS."]:::gap
  end
end

