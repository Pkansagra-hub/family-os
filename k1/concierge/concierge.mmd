  %% INTERNAL SERVICES -- Codeable Components (Epic 4)
  %% 9 services derived from tracing every subgraph. Each service owns behavioral
  %% flows, enforces invariants, and uses ports from Epic 1.
  %% Dependency: FSMController -> TurnProcessor -> {IntentProcessor -> ComplexityRouter,
  %%   ToolDispatcher, ContextAssembler, OutputManager}.
  %%   DeltaAggregator -> FSMController. ClarificationTracker -> FSMController.
  %% No circular dependencies. Total estimated tests: ~585.
  %% ==================================================================================

  subgraph SERVICES["\ud83c\udfd7\ufe0f Internal Services (9 Codeable Components \u2014 ~585 Tests)"]
    direction TB

    SVC_FSM_CTRL["FSMController<br/>transition(target, ctx) \u2192 TransitionResult<br/>current_state() \u2192 FSMState<br/>on_interrupt(msg) \u2192 InterruptDecision<br/>tick_experience(turn_count) \u2192 ExperienceActions<br/>---<br/>Sub: Persona, Style, Affective, Anticipation, Narrative<br/>~60 tests"]:::service

    SVC_TURN_PROC["TurnProcessor<br/>start_turn(msg) \u2192 TurnContext<br/>execute_phase1(classification) \u2192 Phase1Result<br/>route_dispatch(tier, intent) \u2192 DispatchDecision<br/>execute_phase2(tool_results, llm_resp) \u2192 Phase2Result<br/>end_turn() \u2192 TurnSummary<br/>~90 tests"]:::service

    SVC_INTENT_PROC["IntentProcessor<br/>process(classification, snapshot)<br/>\u2192 ProcessedIntent | CrisisOverride<br/>---<br/>Pipeline: SafetyGate \u2192 Hypothesis<br/>\u2192 TimeResolver \u2192 ContextInference<br/>\u2192 SanityArbiter \u2192 UncertaintyEstimator<br/>~110 tests"]:::service

    SVC_COMPLEXITY["ComplexityRouter<br/>route(processed_intent) \u2192 Tier<br/>---<br/>5 factors: intent_count, domain_count,<br/>safety_band, emotion_intensity, combined<br/>Pure computation \u2014 no ports<br/>~45 tests"]:::service

    SVC_TOOL_DISP["ToolDispatcher<br/>dispatch(tool_call) \u2192 ToolResult<br/>get_buffered_results() \u2192 ToolResult[]<br/>clear_buffer()<br/>active_count() \u2192 int<br/>---<br/>4 categories: Cognitive(6), Read(3),<br/>Action(3), Signal(1)<br/>~80 tests"]:::service

    SVC_OUTPUT_MGR["OutputManager<br/>enqueue(event, priority) \u2192 QueuePosition<br/>deliver_next() \u2192 DeliveryReceipt<br/>flush() \u2192 DeliveryReceipt[]<br/>depth() \u2192 int<br/>---<br/>Sub: ConversationScheduler<br/>9 event types, 3 priority levels<br/>~55 tests"]:::service

    SVC_DELTA_AGG["DeltaAggregator<br/>start_window()<br/>receive(delta)<br/>flush() \u2192 AggregatedBatch<br/>on_error(error)<br/>---<br/>4 delta types, 500ms window, LWW merge<br/>~50 tests"]:::service

    SVC_CLARIFY["ClarificationTracker<br/>track_round(intent_id) \u2192 RoundCount<br/>max_reached(intent_id) \u2192 bool<br/>escalate(intent_id) \u2192 EscalationDecision<br/>add_pending(sub_agent_req)<br/>get_pending() \u2192 PendingClarification[]<br/>~40 tests"]:::service

    SVC_CTX_ASM["ContextAssembler<br/>assemble(tier, intent, tool_results) \u2192 LLMContext<br/>track_usage(tokens_consumed)<br/>remaining_budget() \u2192 int<br/>needs_summarization(ctx) \u2192 bool<br/>summarize(ctx) \u2192 CompressedContext<br/>---<br/>CONTEXT_PROFILES: 6 static profiles by (call_type, tier)<br/>TOKEN_ESTIMATOR: ceil(chars / 3.5), conservative cross-tokenizer<br/>SUMMARIZATION_TRIGGER: &gt;80% of 128K (102,400 tokens)<br/>PER_TURN_TRACKING: input_tokens, output_tokens, llm_calls<br/>OUTPUT_BUDGET: pass-through to provider (not enforced)<br/>~55 tests"]:::service
  end

  %% ==================================================================================
  %% LIFECYCLE -- Session and Turn Lifecycle (Epic 5)
  %% 6 phases owned by FSMController (session-level) or TurnProcessor (turn-level).
  %% Design: version-based lock (D1), checkpoint every turn (D2), never resume
  %% incomplete turns (D3), experience layer deferred (D4), DeltaAggregator timer
  %% session-scoped (D5), interrupted turns use abbreviated turn_end (D6).
  %% ==================================================================================

  subgraph LIFECYCLE["\ud83d\udd04 Lifecycle (6 Phases \u2014 Session + Turn)"]
    direction TB

    LC_INIT["init(session_id)<br/>Owner: FSMController<br/>---<br/>1. Create 9 services (no I/O)<br/>2. Connect 8 ports<br/>3. Restore state (Edge-First: LOCAL COLD first,<br/>\u00a0\u00a0\u00a0K0 only if stale + ONLINE, P95 < 50ms)<br/>4. Load persona \u2192 PersonaEngine + Style<br/>5. Init 7 circuit breakers \u2192 all CLOSED<br/>6. Start subscriptions + DeltaAggregator timer<br/>7. FSM \u2192 LISTENING"]:::lifecycle

    LC_TURN_START["turn_start(message)<br/>Owner: TurnProcessor<br/>---<br/>1. Acquire Single Writer lock (lock_version++)<br/>2. Increment turn_sequence_number<br/>3. Read HOT snapshot (all 8 sections)<br/>4. Reset: ToolDispatcher.clear_buffer(),<br/>\u00a0\u00a0\u00a0ClarificationTracker.reset_turn(),<br/>\u00a0\u00a0\u00a0ContextAssembler.reset_budget()<br/>5. Allocate tier budget envelope"]:::lifecycle

    LC_TURN_END["turn_end()<br/>Owner: TurnProcessor<br/>---<br/>1. Flush OutputManager<br/>2. Append to history_active (MutationGuard)<br/>3. Update telemetry (tokens, cost, latency)<br/>4. Release Single Writer lock<br/>5. Checkpoint LOCAL COLD (SQLite < 1ms)<br/>6. Checkpoint K0 (fire-and-forget via Bridge)<br/>7. Check experience triggers (% 20/25/30)<br/>8. Emit turn.complete.v1 via IDeltaPort<br/>   (triggers: Memory Writer pipeline,<br/>    Learning Loop feedback detectors)<br/>9. FSM \u2192 LISTENING"]:::lifecycle

    LC_TURN_END_ABBREV["turn_end_abbreviated()<br/>Owner: TurnProcessor (Interrupt Path)<br/>---<br/>1. Cancel in-flight dispatches (IDispatchPort)<br/>2. Flush OutputManager (partial progress)<br/>3. Record turn_status: INTERRUPTED<br/>4. Release Single Writer lock<br/>5. Checkpoint LOCAL COLD<br/>---<br/>SKIP: history, telemetry, K0 sync, experience"]:::lifecycle

    LC_SHUTDOWN["shutdown()<br/>Owner: FSMController<br/>---<br/>1. IInputPort.close() (reject new input)<br/>2. Wait active turn (30s) or force-close<br/>3. Flush DeltaAggregator + OutputManager<br/>4. Final checkpoint (LOCAL COLD + K0 5s wait)<br/>5. Stop background (timer, subscriptions, SSE)<br/>6. Disconnect ports (LIFO: Memory \u2192 Input)"]:::lifecycle

    LC_CRASH_RECOVERY["crash_recovery(session_id)<br/>Owner: FSMController<br/>---<br/>1. Bootstrap (9 services + 8 ports)<br/>2. Detect: check turn_lock in SS_CONTROL<br/>3. Rollback: clear lock, lock_version++,<br/>\u00a0\u00a0\u00a0turn_status: ROLLED_BACK<br/>4. Reconcile Local Outbox (Bridge drain)<br/>5. Restore from LOCAL COLD (last checkpoint)<br/>6. Resume: persona, CBs, subscriptions, LISTENING<br/>7. Emit recovery telemetry<br/>---<br/>Max loss: 1 turn (the crashed one)"]:::lifecycle
  end

end

