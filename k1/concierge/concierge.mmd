%% =====================================================================================
%% TOKEN BUDGET MANAGEMENT (Epic 7)
%% ContextAssembler builds budget objects for all ILLMPort.complete() calls.
%% Two paths to summarization: LLM-initiated (tool) and system-initiated (pre-call guard).
%% Budget object shape: {max_tokens, timeout_ms: 30000, context_window: 128000}
%% All PORT_LLM outbound edges carry budget objects (see labels above).
%% =====================================================================================

%% LLM-initiated path: LLM calls summarize_context() as a Read Tool during DELIVERING.
%% Routed by ToolDispatcher to ContextAssembler. Returns compressed context.
TOOL_SUMMARIZE_CONTEXT -->|"LLM-initiated path (Read Tool)"| SVC_CTX_ASM

%% System-initiated path: Before every ILLMPort.complete(), ContextAssembler runs
%% needs_summarization(). If assembled context > 80% of 128K, compresses internally.
%% Invisible to the LLM. Safety net that fires even if LLM forgets the tool.
SVC_CTX_ASM -->|"SUMMARIZATION_TRIGGER<br/>needs_summarization() &gt; 80% of 128K<br/>(system-initiated pre-call guard)"| PORT_LLM

%% Per-turn tracking: ContextAssembler writes token usage to SS_TELEMETRY at turn_end
SVC_CTX_ASM -.->|"turn_end: write token usage"| SS_TELEMETRY

%% =====================================================================================
%% LIFECYCLE STATE FLOW (Epic 5)
%% =====================================================================================

LC_INIT -->|"ready"| LISTENING
LC_TURN_START -->|"lock acquired"| ACKING
LC_TURN_END -->|"turn complete"| LISTENING
LC_TURN_END_ABBREV -->|"interrupt handled"| ACKING
LC_SHUTDOWN -->|"process exit"| PORT_INPUT
LC_CRASH_RECOVERY -->|"recovered"| LISTENING

%% =====================================================================================%% SERVICE → INVARIANT ENFORCEMENT (Epic 4)
%% Every invariant from Epic 2 has exactly one enforcing service. No orphans.
%% =====================================================================================

SVC_FSM_CTRL -.->|"INV-13 (transition <= 1ms)"| INV_TIMING
SVC_FSM_CTRL -.->|"INV-17 (single FSM)"| INV_STRUCTURAL
SVC_TURN_PROC -.->|"INV-01, 03, 04 (Single Writer, Two-Phase, no direct writes)"| INV_OWNERSHIP
SVC_TURN_PROC -.->|"INV-07 (safety_band before routing)"| INV_SAFETY
SVC_TURN_PROC -.->|"INV-12 (1 turn/session)"| INV_RATE
SVC_INTENT_PROC -.->|"INV-05, 06, 07 (safety first, CRISIS override)"| INV_SAFETY
SVC_TOOL_DISP -.->|"INV-02 (MutationGuard preflight)"| INV_OWNERSHIP
SVC_TOOL_DISP -.->|"INV-08 (20 tools/turn), INV-11 (depth 3)"| INV_RATE
SVC_OUTPUT_MGR -.->|"INV-10 (50 queue depth)"| INV_RATE
SVC_OUTPUT_MGR -.->|"INV-15 (OUTPUT_CHANNEL only)"| INV_STRUCTURAL
SVC_DELTA_AGG -.->|"INV-14 (500ms fixed window)"| INV_TIMING
SVC_CLARIFY -.->|"INV-09 (3 rounds max)"| INV_RATE
SVC_CTX_ASM -.->|"INV-18..21 (128K window, 150/200/300 token caps)"| INV_TOKEN

%% =====================================================================================
%% SERVICE → PORT USAGE (Epic 4)
%% Services call ports, never external systems directly (INV-16).
%% ComplexityRouter uses no ports (pure computation).
%% =====================================================================================

SVC_FSM_CTRL -.->|"read guards"| PORT_STATE
SVC_TURN_PROC -.->|"Phase 1+2 writes"| PORT_STATE
SVC_TURN_PROC -.->|"dispatch"| PORT_DISPATCH
SVC_TURN_PROC -.->|"LLM calls"| PORT_LLM
SVC_INTENT_PROC -.->|"context fill + entity resolution"| PORT_STATE
SVC_TOOL_DISP -.->|"cognitive writes (via MutationGuard)"| PORT_STATE
SVC_TOOL_DISP -.->|"recall_memory"| PORT_MEMORY
SVC_TOOL_DISP -.->|"tool execution + discovery"| PORT_DISPATCH
SVC_TOOL_DISP -.->|"signal delivery (ack)"| PORT_OUTPUT
SVC_OUTPUT_MGR -.->|"all delivery"| PORT_OUTPUT
SVC_DELTA_AGG -.->|"subscribe + errors"| PORT_DELTA
SVC_CLARIFY -.->|"write clarifications"| PORT_STATE
SVC_CTX_ASM -.->|"read sections"| PORT_STATE
SVC_CTX_ASM -.->|"System-initiated: pre-call guard<br/>builds budget + summarize if &gt;80% of 128K"| PORT_LLM

