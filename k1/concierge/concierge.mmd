%% =====================================================================================
%% CONCIERGE (K1) — DEEP AI AGENT ARCHITECTURE
%% =====================================================================================
%% STATUS: SKELETON + EPIC 1 (Hexagonal Architecture) + EPIC 2 (Invariants) + EPIC 3 (Performance Baselines) + EPIC 4 (Internal Services) + EPIC 5 (Lifecycle) + EPIC 6 (Concurrency Model) + EPIC 7 (Token Budget Management) + EPIC 8 (Error/Recovery Paths)
%%
%% The Concierge is K1's only user-facing intelligence. It is:
%%   - The ONLY writer to SessionState (Single Writer Pattern, ADR-0017)
%%   - The FSM that governs ALL conversation flow
%%   - The host of the Concierge LLM (which has cognitive tool calls)
%%   - The aggregator of all sub-agent deltas
%%   - The gateway to the user (all output goes through OUTPUT_CHANNEL)
%%
%% TWO-PHASE WRITE PER TURN:
%%   Phase 1: UltraBERT (22ms, deterministic) — writes control, entities, emotion
%%   Phase 2: LLM with Cognitive Tools — writes scoreboard, beliefs, narrative, etc.
%%   Each cognitive tool call → MutationGuard.preflight() → SessionState write
%%
%% TOOL AVAILABILITY (ALL tiers: LOW, MEDIUM, HIGH):
%%   Cognitive: update_scoreboard, update_beliefs, update_clarifications,
%%              update_narrative, refine_affect, promote_belief
%%   Read:      recall_memory, discover_capabilities, summarize_context
%%   Action:    invoke_capability, spawn_via_fabric, execute_workflow
%%
%% EXTERNAL COMPONENT ROLES (per whiteboard 2026-02-05):
%%   Orchestrator: Blind DAG Executor — NO LLM, NO tools.
%%     Supersedes ADR-0006 Contract-Net. Walks DAG topologically.
%%     MED: direct to Fabric (1-2 calls). HIGH: PlanRequest → CommittedPlan → DAG.
%%   Planner: LLM-powered 4-stage pipeline (Sketch→Expand→Validate→Commit).
%%     Has 4 read-only discovery tools served by Fabric retrieval layer.
%%   Fabric: Dual role — (1) Intelligent Retrieval for Planner (semantic Top-K),
%%     (2) Resolution + Execution for Orchestrator/Concierge, (3) Agent Factory.
%% =====================================================================================

subgraph CONCIERGE["🧠 Concierge — Deep AI Agent (Conversation Conductor)"]
  direction TB

  %% ==================================================================================
  %% FSM CORE — State Machine Controller
  %% ==================================================================================

  subgraph FSM["🔄 Concierge FSM (State Machine Controller)"]
    direction TB

    CONCIERGE_FSM["Concierge FSM<br/>Controls ALL state transitions<br/>Single Writer to SessionState<br/>---<br/>ERROR_SEVERITY: RECOVERABLE / DEGRADED / TERMINAL<br/>RECOVERABLE: retry/fallback in same phase<br/>DEGRADED: continue to DELIVERING with partial results<br/>TERMINAL: DELIVERING with error response"]:::brain

    subgraph FSM_CORE_LOOP["Core Loop States (Every Turn)"]
      direction TB

      LISTENING["LISTENING<br/>Waiting for User Input<br/>Entry: session start or DELIVERING complete"]:::state
      ACKING["ACKING (Enhanced)<br/>UltraBERT 22ms + Gap Detection<br/>Complexity Routing (LOW/MED/HIGH)<br/>Signal: acknowledge_request() → user (~50ms)"]:::state
      CLARIFYING["CLARIFYING<br/>Progressive Disclosure<br/>Entropy-Minimizing Questions (1-2 Qs)"]:::state
      DISPATCHING["DISPATCHING<br/>LOW: invoke_capability() direct<br/>MED/HIGH: TaskEnvelope to Orchestrator"]:::state
      COMPANIONING["COMPANIONING<br/>Keep Conversation Moving<br/>Preliminary ack (MED/HIGH)"]:::state
      PROGRESSING["PROGRESSING<br/>Stream Deltas as Updates<br/>Progress narration to user"]:::state
      DELIVERING["DELIVERING<br/>Final Results + Next Steps<br/>LLM call with tool_results[] + cognitive tools<br/>---<br/>META-AGENT (4.5.8):<br/>tool_results[] may contain AgentResponsePayload<br/>from dynamically created agents. Includes:<br/>  agent_name, result, tokens_used, ttl_remaining"]:::state
      INTERRUPT_HANDLING["INTERRUPT_HANDLING<br/>User Changes Topic Mid-Turn<br/>Reset routing, re-ACKING"]:::state
    end

    subgraph FSM_EXPERIENCE_LAYER["Experience Layer (Every 20-30 Turns — Heuristic, NOT LLM)"]
      direction TB

      EMOTIONAL_PROCESSING["EMOTIONAL_PROCESSING<br/>Analyze emotional trajectory from history<br/>Trigger: turn_count % 25 == 0"]:::empathy
      EMOTIONAL_MIRRORING["EMOTIONAL_MIRRORING<br/>Adjust conversational tone<br/>Update persona hints"]:::empathy
      ANTICIPATORY_RESPONSE["ANTICIPATORY_RESPONSE<br/>Predict user needs<br/>Prefetch context via Fabric<br/>Trigger: turn_count % 30 == 0"]:::empathy
      NARRATIVE_WEAVING["NARRATIVE_WEAVING<br/>Cluster conversation threads<br/>Update narrative_active<br/>Trigger: turn_count % 20 == 0"]:::empathy
    end
  end

  %% ==================================================================================
  %% ACKING CORE — UltraBERT + Pre-LLM Processing
  %% ==================================================================================

  subgraph ACKING_CORE["⚡ ACKING Core (Phase 1: UltraBERT — 22ms, Pre-LLM)"]
    direction TB

    subgraph ULTRABERT_ENGINE["UltraBERT v4 (22ms, 12 Heads, Single Forward Pass)"]
      ULTRABERT_CORE["UltraBERT Core<br/>ModernBERT-base 149M params"]:::ultrabert

      subgraph ULTRABERT_HEADS["Classification Heads"]
        ULTRABERT_INTENT["Intent Head V2 (MULTI-LABEL)<br/>8 classes: log_memory, set_reminder...<br/>Returns: primary + all[] + scores{}"]:::ultrabert
        ULTRABERT_INGRESS["Ingress Head V2 (MULTI-LABEL)<br/>12 domains: HEALTH, FINANCE...<br/>Returns: domains[] above threshold"]:::ultrabert
        ULTRABERT_SAFETY["Safety Head<br/>4 bands: GREEN, AMBER, RED, CRISIS"]:::ultrabert
        ULTRABERT_EMOTIONS["Emotions Head<br/>44 classes: joy, sadness, anxiety..."]:::ultrabert
        ULTRABERT_SENTIMENT["Sentiment Head<br/>5 levels: very_negative to very_positive"]:::ultrabert
        ULTRABERT_NER["NER Head (GlobalPointer)<br/>PERSON, ORG, LOC, TIME, DATE, DURATION"]:::ultrabert
        ULTRABERT_RELATIONS["Relations Head<br/>spouse_of, parent_of, works_at..."]:::ultrabert
      end
    end

    subgraph SAFETY_GATE["Safety Gate (Hard Stop — FIRST, Before Any Routing)"]
      CRISIS_DETECTOR["Crisis Detector<br/>CRISIS band = immediate protocol"]:::safety
      SAFETY_OVERRIDE["Safety Override<br/>Bypasses all routing"]:::safety
    end

    subgraph COMPLEXITY_ROUTER["Complexity Router V2 (Multi-Factor)"]
      MULTI_INTENT_SCORER["Multi-Intent Scorer<br/>len(intents) + intent_types → complexity"]:::router
      CROSS_DOMAIN_DETECTOR["Cross-Domain Detector<br/>len(domains) > 1 → complexity bump"]:::router
      COMPLEXITY_CLASSIFIER["Complexity Classifier<br/>primary_intent + multi_factors → Tier"]:::router
      TIER_LOW["LOW Tier<br/>Tool First → LLM Response (~500 tokens)<br/>Latency: <2s"]:::tier_low
      TIER_MEDIUM["MEDIUM Tier<br/>LLM Reasoning + Response (2K tokens)<br/>Latency: 2-10s"]:::tier_med
      TIER_HIGH["HIGH Tier<br/>LLM Planning + Reasoning + Response (8K tokens)<br/>Latency: 10-60s"]:::tier_high
      TIER_CRISIS["CRISIS Tier<br/>Safety Protocol → SAFETY_MAILBOX"]:::tier_crisis
    end

    subgraph HYPOTHESIS_PIPELINE["Hypothesis & Gap Detection Pipeline"]
      HYPOTHESIS_GENERATOR["Hypothesis Generator<br/>Receives explicit multi-intent from heads"]:::engine
      CONTRACT_SIGNAL_GAPS["Contract & Signal Gap Detector<br/>Union of ALL intent requirements"]:::engine
      SIGNAL_LIBRARY["Signal Library<br/>Pronouns/conflicts/multi-entities/time vagueness"]:::engine
    end

    subgraph TIME_RESOLUTION["Temporal Resolution Engine"]
      TIME_PARSER["Time Parser<br/>NER TIME/DATE/DURATION → parsed"]:::engine
      TIME_RESOLVER["Time Resolver<br/>Relative → Absolute<br/>'9' → '09:00' or '21:00'?"]:::engine
      TIMEZONE_CONTEXT["Timezone Context<br/>User TZ from device/profile"]:::engine
      TEMPORAL_ANCHOR["Temporal Anchor<br/>now, today, this_week"]:::engine
    end

    subgraph SPATIAL_RESOLUTION["Spatial Context Engine (ADR-0085/0085a)"]
      LOCATION_INGRESS["Location Ingress<br/>GPS, BLE, Wi-Fi, IP → raw signal"]:::engine
      LOCATION_RESOLVER["Location Resolver<br/>Raw coords → semantic place<br/>lat/lng → 'home', 'gym', 'work'"]:::engine
      PLACE_REGISTRY["Place Registry<br/>Learned places + geofences<br/>User-defined + auto-detected"]:::engine
      MOTION_CLASSIFIER["Motion Classifier<br/>STATIONARY, WALKING, IN_VEHICLE<br/>Device accelerometer + GPS delta"]:::engine
      SPATIAL_ANCHOR["Spatial Anchor<br/>current_place, last_transition, dwell_time"]:::engine
    end

    subgraph CONTEXT_FILLING["Context Inference & Validation"]
      CONTEXT_INFERENCE["Context Inference<br/>SessionState fill + entity resolution"]:::engine
      TINY_SANITY_ARBITER["Tiny Sanity Arbiter (Fast Path)<br/>UltraBERT + cached checks"]:::engine
    end

    subgraph UNCERTAINTY_ROUTING["Uncertainty Estimation & Clarification"]
      UNCERTAINTY_ESTIMATOR["Uncertainty Estimator<br/>UltraBERT confidence scores"]:::engine
      ENTROPY_MIN_QUESTION_PLANNER["Entropy-Minimizing Question Planner<br/>Progressive disclosure (1-2 Qs max)"]:::engine
    end
  end

  %% ==================================================================================
  %% LLM TOOLS — Cognitive / Read / Action (Phase 2)
  %% ==================================================================================

  subgraph CONCIERGE_TOOLS["🔧 Concierge LLM Tools (Available ALL Complexity Tiers)"]
    direction TB

    subgraph COGNITIVE_TOOLS["Cognitive Tools (LLM detects what to update)"]
      TOOL_UPDATE_SCOREBOARD["update_scoreboard()<br/>Referents, QUD, salience, topic shift<br/>LLM detects: pronoun resolution, open Qs"]:::tool_cognitive
      TOOL_UPDATE_BELIEFS["update_beliefs()<br/>New facts, corrections, invalidations<br/>LLM detects: implicit facts, user corrections"]:::tool_cognitive
      TOOL_UPDATE_CLARIFICATIONS["update_clarifications()<br/>Semantic gaps, resolved gaps<br/>LLM detects: cannot proceed without info"]:::tool_cognitive
      TOOL_UPDATE_NARRATIVE["update_narrative()<br/>Thread switch/resume/new/continue<br/>LLM detects: topic shifts, thread resumptions"]:::tool_cognitive
      TOOL_REFINE_AFFECT["refine_affect()<br/>Override emotion when sarcasm/nuance<br/>LLM overrides UltraBERT when confident"]:::tool_cognitive
      TOOL_PROMOTE_BELIEF["promote_belief()<br/>WARM to HOT fact promotion<br/>LLM detects: user referencing old context"]:::tool_cognitive
    end

    subgraph READ_TOOLS["Read Tools (Context Retrieval)"]
      TOOL_RECALL_MEMORY["recall_memory()<br/>K0 Long-Term Memory Query<br/>Via Bridge → K0 Query Port"]:::tool
      TOOL_DISCOVER_CAPABILITIES["discover_capabilities()<br/>Queries Capability Registry<br/>What tools/agents are available?"]:::tool
      TOOL_SUMMARIZE_CONTEXT["summarize_context()<br/>Token Budget Manager<br/>Compress context to fit budget"]:::tool
    end

    subgraph ACTION_TOOLS["Action Tools (Execution & Delegation)"]
      TOOL_INVOKE_CAPABILITY["invoke_capability()<br/>Direct capability execution via Fabric<br/>Used in LOW tier for fast path"]:::tool
      TOOL_SPAWN_VIA_FABRIC["spawn_via_fabric()<br/>Capability-based Agent Creation<br/>Dynamic agent instantiation<br/>---<br/>META-AGENT CREATION (4.5.1-4.5.9):<br/>For HIGH-tier plans, Orchestrator executes build_agent<br/>as a DAG step (not Concierge). spawn_via_fabric remains<br/>for LOW-tier YAML-template agents. Concierge receives<br/>AgentResponsePayload in tool_results[] for both paths."]:::tool
      TOOL_EXECUTE_WORKFLOW["execute_workflow()<br/>Workflow Capability Invocation<br/>Pre-compiled workflow execution<br/>Max depth: 3 (cycle detection)"]:::tool
    end

    subgraph SIGNAL_TOOLS["Signal Tools (Emit-Only, No State Mutation)"]
      TOOL_ACKNOWLEDGE_REQUEST["acknowledge_request()<br/>Immediate intent confirmation to user<br/>~100-150 tokens: restate intent + 1-line plan preview<br/>LLM first tool call — fires BEFORE dispatching<br/>Parallel with cognitive tools (non-blocking)<br/>Skipped on trivial turns (ok cool = no ack)"]:::tool_signal
    end
  end

  %% ==================================================================================
  %% OUTPUT SYSTEM — All outbound messages to user
  %% ==================================================================================

  subgraph OUTPUT_SYSTEM["📤 Output System (System → User)"]
    direction TB

    OUTPUT_CHANNEL["OUTPUT_CHANNEL<br/>Unified Message Delivery<br/>SSE / WebSocket / REST"]:::output
    OUTPUT_QUEUE["Output Queue<br/>Priority: REALTIME > PROGRESS > BACKGROUND"]:::output

    subgraph OUTPUT_EVENTS["Output Event Types"]
      OUT_INTENT_ACK["k1.response.intent_ack.v1<br/>From: ACKING (Signal Tool)<br/>Priority: IMMEDIATE<br/>~50ms after input"]:::output_event
      OUT_FINAL["k1.response.final.v1<br/>From: DELIVERING"]:::output_event
      OUT_ACK["k1.response.ack.v1<br/>From: COMPANIONING"]:::output_event
      OUT_CLARIFICATION["k1.response.clarification.v1<br/>From: CLARIFYING"]:::output_event
      OUT_PROGRESS["k1.response.progress.v1<br/>From: PROGRESSING"]:::output_event
      OUT_PROACTIVE_Q["k1.proactive.question.v1<br/>From: CuriosityAgent"]:::output_event
      OUT_PROACTIVE_M["k1.proactive.message.v1<br/>From: ProactiveDecision"]:::output_event
      OUT_HIL_CLARIFICATION["k1.hil.clarification.v1<br/>From: PlannerHIL"]:::output_event
      OUT_HIL_APPROVAL["k1.hil.approval_request.v1<br/>From: PlannerHIL"]:::output_event
      OUT_HIL_FALLBACK["k1.hil.fallback.v1<br/>From: Orchestrator ConstraintResolver"]:::output_event
      OUT_HIL_PROGRESS["k1.hil.progress.v1<br/>From: Orchestrator ExecutionMonitor"]:::output_event
      OUT_TURN_COMPLETE["turn.complete.v1<br/>From: turn_end() via IDeltaPort<br/>Priority: BACKGROUND<br/>Payload: turn_id, session_id, cognitive_trace_id,<br/>  user_message, assistant_response, timestamp_ms<br/>Consumers: Memory Writer, Learning Loop<br/>See: k1/memory_writer/memory_writer.mmd,<br/>     k1/learning/learning.mmd"]:::output_event
    end

    subgraph HIL_RESPONSE_ROUTING["HIL Response Routing (User -> Originator)"]
      HIL_RESPONSE_DETECTOR["HIL Response Detector<br/>Checks PENDING_CLARIFICATIONS for active HIL request<br/>If active: route as HIL response, NOT new turn<br/>Correlation: request_id from HIL request"]:::brain
      HIL_RESPONSE_CLARIFICATION["k1.hil.clarification_response.v1<br/>To: Planner (via Event Bus)<br/>Payload: {request_id, plan_id, user_response}"]:::output_event
      HIL_RESPONSE_APPROVAL["k1.hil.approval_response.v1<br/>To: Planner (via Event Bus)<br/>Payload: {request_id, plan_id, response_type, modifications}"]:::output_event
      HIL_RESPONSE_FALLBACK["k1.hil.fallback_response.v1<br/>To: Orchestrator (via Event Bus)<br/>Payload: {request_id, trace_id, user_response}"]:::output_event
      HIL_RESPONSE_OVERRIDE["k1.hil.override_response.v1<br/>To: Orchestrator (via Event Bus)<br/>Payload: {trace_id, override_action: cancel|modify|continue}"]:::output_event
    end
  end

  %% ==================================================================================
  %% INTERNAL ENGINES — Persona, Style, Affective, Anticipation, Narrative
  %% ==================================================================================

  subgraph ENGINES["🧩 Internal Engines"]
    direction TB

    CONCIERGE_PERSONA["Persona Engine<br/>Personality configuration<br/>Writes to SessionState.persona"]:::brain
    CONCIERGE_STYLE["Conversational Style<br/>Formality, verbosity, tone<br/>Adapted by Experience Layer"]:::brain
    AFFECTIVE_MIRRORING_ENGINE["Affective Mirroring Engine<br/>Emotion Detection & Resonance<br/>UltraBERT tone + sentiment → style shifts"]:::brain
    CONVERSATIONAL_ANTICIPATION_ENGINE["Anticipation Engine<br/>Predictive Completion<br/>Speculative execution to Orchestrator"]:::brain
    CONVERSATIONAL_NARRATIVE_ENGINE["Narrative Engine<br/>Thread Management<br/>Updates conversation_threads + narrative_arc"]:::brain
  end

  %% ==================================================================================
  %% MAILBOX & AGGREGATION
  %% ==================================================================================

  subgraph MESSAGING["📬 Mailbox & Aggregation"]
    direction TB

    CONCIERGE_MAILBOX["Private Mailbox<br/>Actor: async event loop, 1 task/session<br/>MPSC Queue, WFQ drain order<br/>---<br/>REALTIME(3): UserInput, CapabilityComplete<br/>INTERACTIVE(2): AggregatedBatch, ErrorEvent, Escalation<br/>BACKGROUND(1): ProactiveInterrupt, K0Event"]:::mailbox
    AGGREGATION_WINDOW["Delta Aggregation Window<br/>500ms Batching (async timer callback, not thread)<br/>Merge conflicts (LWW)<br/>Sort by priority"]:::brain
    TOOL_RESULT_BUFFER["Tool Result Buffer<br/>Stages results for LLM context<br/>Cleared after DELIVERING"]:::memory
    CONVERSATION_SCHEDULER["Conversation Scheduler<br/>Deterministic Utterance Gating"]:::brain
  end

  %% ==================================================================================
  %% PENDING CLARIFICATIONS (Sub-agent HIL requests)
  %% ==================================================================================

  PENDING_CLARIFICATIONS["Pending Clarifications (2KB)<br/>Active HIL requests (Planner + Orchestrator + Sub-agents)<br/>Written by Concierge from DeltaBus + HIL events<br/>Keyed by: {request_id, originator, agent_id?}<br/>Cleared on: user response or timeout"]:::memory

  %% ==================================================================================
  %% PORTS — Hexagonal Architecture (Epic 1)
  %% 8 ports defining all boundary contracts. Internal services call ports, never
  %% external systems directly (INV-16).
  %% ==================================================================================

  subgraph PORTS["🔌 Ports (Boundary Contracts)"]
    direction TB

    PORT_INPUT["IInputPort<br/>Direction: Inbound<br/>receive() → UserMessage"]:::port
    PORT_OUTPUT["IOutputPort<br/>Direction: Outbound<br/>send(OutputEvent) → DeliveryReceipt"]:::port
    PORT_CLASSIFICATION["IClassificationPort<br/>Direction: Outbound<br/>classify(text) → ClassificationResult"]:::port
    PORT_LLM["ILLMPort<br/>Direction: Outbound<br/>execute(HubRequest{capability, payload, constraints}) → HubResponse<br/>stream_execute(HubRequest) → AsyncIterator[HubChunk]<br/>Capabilities used: CHAT, TOOL_CALL, STRUCTURED, VISION, REASON<br/>Routes to Model Hub via LLMGatewayAdapter"]:::port
    PORT_STATE["IStatePort<br/>Direction: Both<br/>read(sections[]) → Snapshot<br/>write(section, op, data) → WriteResult"]:::port
    PORT_DISPATCH["IDispatchPort<br/>Direction: Outbound<br/>dispatch_direct(CapReq) → CapResult<br/>dispatch_envelope(TaskEnv) → void"]:::port
    PORT_DELTA["IDeltaPort<br/>Direction: Inbound<br/>subscribe(topics[]) → DeltaStream<br/>errors() → ErrorStream"]:::port
    PORT_MEMORY["IMemoryPort<br/>Direction: Outbound<br/>recall(query, selectors[]) → MemoryResult"]:::port
  end

  %% ==================================================================================
  %% ADAPTERS — Production + Test (Epic 1)
  %% Each port has a production adapter (real infra) and a test adapter (in-memory).
  %% Circuit breakers live inside production adapters (Epic 8).
  %% ==================================================================================

  subgraph ADAPTERS["🔧 Adapters (Infrastructure Bindings)"]
    direction TB

    subgraph ADAPTERS_PROD["Production Adapters"]
      direction TB
      ADAPT_WS_INPUT["WebSocketInputAdapter<br/>RESTInputAdapter"]:::adapter
      ADAPT_SSE_OUTPUT["SSEOutputAdapter<br/>WebSocketOutputAdapter<br/>CB_SSE owner<br/>---<br/>REALTIME: 3 retries, 100ms backoff, dead-letter<br/>PROGRESS: 1 retry, dead-letter<br/>BACKGROUND: 0 retries, no dead-letter<br/>CB OPEN: buffer 5 msgs, flush on reconnect"]:::adapter
      ADAPT_ULTRABERT["UltraBERTv4Adapter<br/>12 heads, 22ms<br/>CB_MODEL owner<br/>---<br/>HEURISTIC_FALLBACK (CB OPEN, &lt;1ms):<br/>1. CRISIS keywords: hardcoded scan (non-negotiable)<br/>2. Question + &lt;20 words: conversational/LOW<br/>3. remind/schedule/set: task/MED<br/>4. plan/help me with: planning/HIGH<br/>5. Default: conversational/LOW"]:::adapter
      ADAPT_MODEL_GW["ModelGatewayAdapter (Capability-Driven)<br/>Routes HubRequest to Model Hub via LLM Request Bus<br/>Tags requests with capability: CHAT|TOOL_CALL|STRUCTURED|VISION|REASON<br/>CB_MODEL owner (inherited from Model Hub CB per provider manifest)<br/>---<br/>LLM_CASCADE:<br/>L1: RETRY (timeout/5xx, retry once) = RECOVERABLE<br/>L2: CB HALF-OPEN probe (30s window) = wait<br/>L3: CANNED_RESPONSE (CB OPEN) = DEGRADED<br/>See: k1/model_hub/model_hub.mmd"]:::adapter
      ADAPT_SESSION["SessionKernelAdapter<br/>MutationGuard inside<br/>CB_SESSIONSTATE owner<br/>---<br/>MutationGuard rejection: RECOVERABLE (skip write)<br/>Read timeout: DEGRADED (stale cached data)<br/>Emergency mode: &gt;=95KB, 50ms GC wait + retry"]:::adapter
      ADAPT_FABRIC_ORCH["FabricOrchestratorAdapter<br/>Routes by tier<br/>CB_ORCHESTRATOR + CB_PLANNER + CB_FABRIC + CB_MCP owner<br/>---<br/>Step failure: 2 retries per Q3, partial results OK<br/>TIER_DEGRADATION: HIGH→MED→LOW→canned<br/>Tool CB_MCP OPEN: mark tool unavailable"]:::adapter
      ADAPT_DELTA_BUS["DeltaBusAdapter<br/>Subscription + error routing<br/>---<br/>IDeltaPort: emit failure = log + skip (RECOVERABLE)<br/>Never TERMINAL (Edge-First: best-effort)"]:::adapter
      ADAPT_BRIDGE_RECALL["BridgeRecallAdapter<br/>QueryPort + offline fallback<br/>---<br/>IMemoryPort: recall timeout = skip memory (RECOVERABLE)<br/>Never TERMINAL (Edge-First: respond without memory)"]:::adapter
    end

    subgraph ADAPTERS_TEST["Test Adapters"]
      direction TB
      ADAPT_TEST_INPUT["TestInputAdapter<br/>Inject messages programmatically"]:::adapter_test
      ADAPT_TEST_OUTPUT["TestOutputAdapter<br/>Capture + assert on messages"]:::adapter_test
      ADAPT_TEST_CLASS["MockClassificationAdapter<br/>Scripted ClassificationResult"]:::adapter_test
      ADAPT_TEST_LLM["MockLLMAdapter<br/>Scripted responses + tool calls"]:::adapter_test
      ADAPT_TEST_STATE["InMemoryStateAdapter<br/>Dict-based, tracks writes"]:::adapter_test
      ADAPT_TEST_DISPATCH["MockDispatchAdapter<br/>Captures envelopes + requests"]:::adapter_test
      ADAPT_TEST_DELTA["TestDeltaAdapter<br/>Emit test deltas on demand"]:::adapter_test
      ADAPT_TEST_MEMORY["MockMemoryAdapter<br/>Canned recall results"]:::adapter_test
    end
  end

  %% ==================================================================================
  %% INVARIANTS -- Non-Negotiable Rules (Epic 2)
  %% 21 invariants across 6 categories. Violation = rejection or override.
  %% Every invariant has a hard number, a violation behavior, and an enforcing service.
  %% ==================================================================================

  subgraph INVARIANTS["\u2696\ufe0f Invariants (21 Non-Negotiable Rules)"]
    direction TB

    INV_OWNERSHIP["OWNERSHIP (INV-01..04)<br/>INV-01: Only Concierge writes SessionState<br/>INV-02: Every cognitive tool write passes MutationGuard.preflight()<br/>INV-03: Phase 1 (UltraBERT) completes before Phase 2 (LLM tools)<br/>INV-04: Orchestrator/Planner/Agents NEVER write SessionState"]:::invariant

    INV_SAFETY["SAFETY (INV-05..07)<br/>INV-05: Safety Gate evaluates FIRST, before any routing<br/>INV-06: CRISIS band = immediate protocol, bypasses all FSM states<br/>INV-07: safety_band written BEFORE any routing decision"]:::invariant

    INV_RATE["RATE LIMITS (INV-08..12)<br/>INV-08: Tool calls per turn: 20 (hard cap)<br/>INV-09: Clarification rounds per intent: 3<br/>INV-10: Output queue depth: 50<br/>INV-11: Workflow execution depth: 3<br/>INV-12: Concurrent active turns per session: 1"]:::invariant

    INV_TIMING["TIMING (INV-13..14)<br/>INV-13: FSM state transition <= 1ms (no I/O in transitions)<br/>INV-14: Delta aggregation window = 500ms fixed"]:::invariant

    INV_STRUCTURAL["STRUCTURAL (INV-15..17)<br/>INV-15: All output through OUTPUT_CHANNEL (no bypass)<br/>INV-16: Internal services call ports, never external systems<br/>INV-17: Single FSM -- no secondary FSMs in engines or tools"]:::invariant

    INV_TOKEN["TOKEN BUDGET (INV-18..21)<br/>INV-18: LLM context window per call: 128K tokens<br/>INV-19: Intent ack (acknowledge_request): 150 tokens<br/>INV-20: Preliminary ack (MED/HIGH): 200 tokens<br/>INV-21: Clarification question: 300 tokens"]:::invariant
  end

  %% ==================================================================================
  %% PERFORMANCE BASELINES (Epic 3)
  %% Split: system-owned P95/P99 (code we write) vs budget envelopes (rails for LLM
  %% providers). BYOLLM = we own the rails, not the train.
  %% Total system overhead per turn (excluding LLM): ~32ms.
  %% ==================================================================================

  subgraph PERF_BASELINES["⏱️ Performance Baselines (System-Owned + Budget Envelopes)"]
    direction TB

    PERF_SYSTEM["SYSTEM-OWNED LATENCIES (P99)<br/>UltraBERT classification: 25ms<br/>Intent ack SSE delivery: 50ms<br/>FSM state transition: 1ms (INV-13)<br/>MutationGuard preflight: 0.2ms<br/>Phase 1 write (deterministic): 0.02ms<br/>Phase 2 write (post-LLM): 0.1ms<br/>Complexity routing decision: 0.2ms<br/>Output queue to SSE delivery: 5ms<br/>Orchestrator envelope dispatch: 2ms<br/>Fabric direct dispatch: 2ms<br/>---<br/>Total system overhead/turn: ~32ms"]:::perf

