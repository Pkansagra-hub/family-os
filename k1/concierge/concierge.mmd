    PERF_TOKENS["TOKEN RAILS (max_tokens per call type)<br/>LOW response: 500 tokens<br/>MED response: 2K tokens<br/>HIGH response: 8K tokens<br/>Intent ack: 150 tokens (INV-19)<br/>Preliminary ack: 200 tokens (INV-20)<br/>Clarification: 300 tokens (INV-21)<br/>Context window: 128K tokens (INV-18)"]:::perf
  end

