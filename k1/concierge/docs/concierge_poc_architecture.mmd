    L2_ENFORCER -->|"validate"| TOOL_INVOKE
    L2_ENFORCER -.->|"check"| FABRIC_CONTRACTS

    %% Internal weave routing
    WEAVE_BATCHER -->|"emit"| T_WEAVE_BATCH
    T_WEAVE_BATCH -->|"FSM routes"| FRONT_HANDLER

    %% SS eviction
    SS_BELIEFS -->|"evict"| SS_BELIEFS_WARM
