    SS_TASK_ARTIFACTS -->|"evict"| SS_ARTIFACTS_WARM
    SS_NARRATIVE -->|"evict"| SS_NARRATIVE_WARM

    %% Mutation guard
    TOOL_BELIEFS -->|"validates"| MG_SECTION
    TOOL_SCOREBOARD -->|"validates"| MG_SECTION
    TOOL_NARRATIVE -->|"validates"| MG_SECTION

    %% ======================================================================================
    %% OPP KERNEL PRIMITIVE DATA FLOWS
    %% ======================================================================================

    %% OPP-1: Paced Delivery
    OPP1_FLUSH -->|"grouped delivery"| FRONT_HANDLER

    %% OPP-2: Recency Bias Decay
    ULTRABERT -->|"classify()"| OPP2_ARBITER
    OPP2_ARBITER -->|"decayed scores"| CONTROLLER

    %% OPP-3: Affect Hard Constraints
    AFFECT_MODULATION -->|"band"| OPP3_ENFORCER
    OPP3_ENFORCER -->|"capped params"| ADAPTER_PORT

    %% OPP-4: Trust Accumulator
    OPP4_ACCUM -.->|"read outcomes"| SS_TASK_STATE
    OPP4_AUTO -->|"auto-approve gate"| L2_ENFORCER
    OPP4_ROUNDS -->|"dynamic max_rounds"| HITL_REQUEST

    %% OPP-5: Proactive Scheduler
    EXP_PROACTIVE -->|"evaluate triggers"| CONTROLLER
    EXP_PROACTIVE -.->|"check affect"| SS_AFFECT

    %% OPP-6: Episodic Compression
    OPP6_COMPRESSOR -->|"compressed context"| DYN_PROMPT_BUILDER
    OPP6_COMPRESSOR -.->|"read history"| SS_HISTORY

    %% OPP-7: Dynamic Identity
    OPP7_CONTEXT -->|"identity snapshot"| PS_IDENTITY
    OPP7_CONTEXT -.->|"read affect"| SS_AFFECT
    OPP7_CONTEXT -.->|"read beliefs"| SS_BELIEFS

    %% OPP-8: Natural Flow Delivery
    OPP8_ENGINE -->|"delivery decision"| CONTROLLER
    OPP8_CLASSIFY -.->|"task result"| CONTROLLER
    OPP8_PAUSE -->|"re-evaluate deferred"| CONTROLLER

    %% OPP Pipeline: Wiring layer
    CONTROLLER -->|"set_opp_pipeline()"| OPP_PIPE
    OPP_PIPE -->|"on_task_complete"| OPP8_ENGINE
    OPP_PIPE -->|"on_weave_flush"| OPP1_PLAN
    OPP_PIPE -->|"on_hitl_outcome"| OPP4_ACCUM
    OPP_PIPE -->|"on_pre_prompt_build"| OPP6_COMPRESSOR
    OPP_PIPE -->|"on_pre_prompt_build"| OPP7_CONTEXT
    OPP_PIPE -->|"on_pre_llm_call"| OPP3_ENFORCER
    OPP_PIPE -->|"on_idle_tick"| EXP_PROACTIVE

    %% ======================================================================================
    %% OUTPUT CHANNEL & STREAMING ARCHITECTURE
    %% ======================================================================================
    subgraph OUTPUT_ARCH["OUTPUT CHANNEL & STREAMING"]
        direction TB

        subgraph STREAM_FLOW["Streaming Architecture"]
            direction LR
            SA_GEN["generate_stream()<br/>LLM yields StreamChunk<br/>(text_delta, tool_call_delta,<br/>thought_delta, done)"]:::output_stream
            SA_EMIT["Front emits<br/>k1.response.stream.v1<br/>per chunk"]:::output_stream
            SA_RENDER["OutputChannel subscribes<br/>+ renders live to user"]:::output_stream
            SA_GEN --> SA_EMIT --> SA_RENDER
        end

        subgraph DELIVERY_MODES["Delivery Modes (OPP-8)"]
            direction LR
            DM_DIRECT["DIRECT_PRESENT<br/>Awaited result,<br/>immediate delivery"]:::delivery_mode
            DM_WEAVE["CONVERSATIONAL_WEAVE<br/>Async result woven<br/>into conversation"]:::delivery_mode
            DM_INJECT["CONTEXTUAL_INJECT<br/>Background result<br/>on topic match"]:::delivery_mode
            DM_NOTIFY["BRIEF_NOTIFY<br/>Time-sensitive,<br/>short notification"]:::delivery_mode
            DM_DEFER["DEFERRED_QUEUE<br/>Low-priority,<br/>hold for pause"]:::delivery_mode
        end

        PROACTIVE_DELIVERY["Proactive Delivery<br/>OPP-5 idle detection triggers<br/>PROACTIVE_WAKE state<br/>--> Front generates fill message"]:::output_stream
    end

    %% Output architecture flows
    OUTPUT_CHANNEL -.->|"renders"| SA_RENDER
    OPP8_ENGINE -->|"selects mode"| DELIVERY_MODES
    EXP_PROACTIVE -->|"idle trigger"| PROACTIVE_DELIVERY

