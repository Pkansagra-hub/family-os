    BACK_HANDLER -->|"emit"| BE_ARTIFACT
    BACK_HANDLER -->|"emit"| BE_TOOL_START
    BACK_HANDLER -->|"emit"| BE_TOOL_DONE
    BE_COMPLETE --> T_COMPLETE
    BE_FAILED --> T_FAILED
    BE_SUSPENDED --> T_SUSPENDED
    BE_ARTIFACT --> T_ARTIFACT
    BE_TOOL_START --> T_TOOL_START
    BE_TOOL_DONE --> T_TOOL_DONE

    %% Bus -> Output
    T_ACK -->|"stream"| OUTPUT_CHANNEL
    T_FINAL -->|"display"| OUTPUT_CHANNEL
    T_CLARIFICATION -->|"display"| OUTPUT_CHANNEL

    %% Front Tools -> SS
    TOOL_BELIEFS -->|"MutationGuard"| SS_BELIEFS
    TOOL_SCOREBOARD -->|"MutationGuard"| SS_SCOREBOARD
    TOOL_CLARIFY -->|"MutationGuard"| SS_CLARIFY
    TOOL_NARRATIVE -->|"MutationGuard"| SS_NARRATIVE
    TOOL_AFFECT -->|"MutationGuard"| SS_AFFECT
    TOOL_PROMOTE -->|"MutationGuard"| SS_BELIEFS

    %% Back Deltas -> DeltaAggregator -> FSM -> SS
    T_ARTIFACT -->|"delta"| DELTA_AGGREGATOR
    T_COMPLETE -->|"delta"| DELTA_AGGREGATOR
    DELTA_AGGREGATOR -->|"FSM.apply_deltas()"| CONTROLLER
    CONTROLLER -->|"write"| SS_TASK_STATE
    CONTROLLER -->|"write"| SS_TASK_ARTIFACTS
    CONTROLLER -->|"append"| SS_HISTORY
    CONTROLLER -->|"update"| SS_META

    %% Both actors read SS
    FRONT_HANDLER -.->|"read (lock-free)"| SESSION_STATE
    BACK_HANDLER -.->|"read (lock-free)"| SESSION_STATE

    %% FSM state transitions
    ST_LISTENING -->|"user.input"| ST_DISPATCHING
    ST_DISPATCHING -->|"response.final (no dispatch)"| ST_LISTENING
    ST_DISPATCHING -->|"task.dispatch"| ST_COMPANIONING
    ST_COMPANIONING -->|"task.complete"| ST_DELIVERING
    ST_DELIVERING -->|"response.final"| ST_LISTENING
    ST_DELIVERING -->|"pending_results?"| ST_WEAVING
    ST_WEAVING -->|"queue drained"| ST_LISTENING
    ST_COMPANIONING -->|"new user.input"| ST_INTERRUPT
    ST_COMPANIONING -->|"cancel intent"| ST_CANCELLING
    ST_LISTENING -->|"task.complete (idle)"| ST_PROACTIVE

    %% Back -> Fabric
    TOOL_INVOKE -->|"execute"| FABRIC_PIPELINE
    TOOL_DISCOVER -->|"search"| FABRIC_REGISTRY
    TOOL_SPAWN -->|"create agent"| FABRIC_PIPELINE
    TOOL_WORKFLOW -->|"run DAG"| FABRIC_PIPELINE

    %% Prompt assembly
    DYN_PROMPT_BUILDER -->|"build context"| FRONT_HANDLER
    BACK_PROMPT_BUILDER -->|"build context"| BACK_HANDLER
