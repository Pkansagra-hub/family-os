%% Created: 2026-02-19
%% Purpose: Ultra-comprehensive architecture diagram for the Concierge POC
%% Document Ref: poc/k1_poc/concierge_poc_design_v2.md (9218 lines)
%% K1 Architecture Ref: architecture_diagrams/k1/k1_cognitive_architecture_skeleton.mmd

%% CORE DESIGN PRINCIPLE:
%%   The Concierge IS Two Minds:
%%     FRONT LLM (Voice): Warm, empathetic, family-aware. TALKS to user.
%%     BACK LLM (Worker): Precise, tool-focused, no personality. EXECUTES tasks.
%%   Neither knows the other exists. Session State is shared memory.
%%   K1 Event Bus is the communication channel. Events are triggers.

%% ACTOR MODEL:
%%   Front LLM: Signal(1) + Cognitive(6) + Read(2) + Control(1) = 10 tools
%%   Back LLM:  Read(2) + Action(3) + Control(1) = 6 tools
%%   Single Writer Invariant (ADR-0017g): Front writes cognitive SS. FSM writes task SS.
%%   Back NEVER writes SS directly -- emits deltas to bus -> FSM applies.

%% REACT LOOP:
%%   Both actors use the SAME shared react_loop() function.
%%   Front terminates: text response with NO tool calls.
%%   Back terminates: submit_result() tool call ONLY.
%%   One tool per iteration. Observation between each.

%% FSM STATES (X-Axis):
%%   LISTENING -> ACKING -> DISPATCHING -> COMPANIONING -> DELIVERING -> LISTENING
%%   + PROGRESSING, CLARIFYING_USER, CLARIFYING_WORKER, CANCELLING,
%%     INTERRUPT_HANDLING, PROACTIVE_WAKE, WEAVING

%% PROMPT MODES (Section 6.1):
%%   STANDARD, CLARIFY_ASK, CLARIFY_RESOLVE, HITL_RELAY, HITL_RESOLVE,
%%   PRESENT, WEAVE, CANCEL, INTERRUPT, ERROR
%%   Each mode selects: tools, SS sections, prompt sections, examples, affect

%% SESSION STATE HOT (52KB = 10 sections):
%%   beliefs_active(8KB), scoreboard(6KB), affective_now(4KB),
%%   clarifications(4KB), narrative_active(4KB), control(8KB),
%%   history_active(8KB), meta(2KB), task_state(4KB), task_artifacts(4KB)

%% COMPLEXITY TIERS:
%%   LOW:    Front -> task.dispatch -> Back -> invoke_capability() directly
%%   MEDIUM: Front -> task.dispatch -> Orchestrator (1-2 Fabric calls)
%%   HIGH:   Front -> TaskEnvelope -> Orchestrator -> Planner 4-stage (future)

%% CAUSAL ORDERING:
%%   TimingChain enforces parent_id chains for STRICT topics.
%%   Replaces ALL anti-spin logic (_force_text_only, _cognitive_only, _ack_next_tool).

%% WEAVE PROTOCOL:
%%   Async task results merge into ongoing conversation via WeaveBatcher.
%%   500ms batch window. FrontLock serializes all Front events.

%% HITL PROTOCOL:
%%   Three variants: Clarification, Approval, Selection.
%%   Back suspends -> Front translates to natural language -> User answers -> Back resumes.
%%   Max 2 suspensions per task. Timeouts: clarification 60s, selection 90s, approval 120s.

%% EXPERIENCE LAYER (6 stubs):
%%   EmotionalProcessor (25th turn), AffectiveMirror (after EP),
%%   NarrativeWeaver (20th turn), AnticipatoryResponder (30th turn),
%%   ProactiveAgent (COMPANIONING + 5s wait), RhythmController (every output)

%% LLM ADAPTER:
%%   IConciergeModelPort protocol. GeminiConciergeAdapter (sole provider).
%%   MODEL_SELECTION_TABLE: (capability, actor) -> model.
%%   Front acks -> flash. Back ReAct -> pro.

%% OPP KERNEL PRIMITIVES (7 Generalized Patterns):
%%   OPP-1 Paced Delivery:     PacingStrategy (STAGGER/GROUP_BY_DOMAIN/PRIORITY_CASCADE)
%%                              WeaveBatcher.flush_paced() delivers in groups with delays
%%   OPP-2 Recency Bias Decay: Arbiter applies exponential decay raw*(1-decay)^age
%%                              Short-input penalty (50% reduction, <3 words)
%%   OPP-3 Affect Hard Caps:   AffectModifiers enforce max_response_tokens, vocabulary_tier,
%%                              tool_budget_override per affect band
%%   OPP-4 Trust Accumulator:  TrustAccumulator tracks approve/reject/cancel/modify/timeout
%%                              Dynamic auto-approve threshold, adaptive HITL rounds
%%   OPP-5 Proactive Scheduler: Idle detection, cooldown, session cap, affect suppression
%%                              Replaces naive 5s-wait stub with kernel-level scheduler
%%   OPP-6 Episodic Compression: Compress old turns into CompressedEpisode summaries
%%                              Preserves HITL/safety turns, recent_window=10, episode_size=5
%%   OPP-7 Dynamic Identity:   Role adaptation (EXPERT/PEER/GUIDE/SUPPORTER/EXECUTOR)
%%                              Domain expertise tracking, formality drift, emotional attunement
%%   OPP-8 Natural Flow Delivery: Result classification + conversation flow + delivery mode
%%                              13-rule decision table, natural pause drain, 5 delivery modes
%%   OPP Pipeline:              OppPipeline wires all 8 primitives into FSM lifecycle hooks
%%                              set_opp_pipeline() DI, 9 hooks, per-primitive enable/disable
