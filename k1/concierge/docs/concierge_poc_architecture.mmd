    FRONT_HANDLER -->|"resume"| T_RESUME
    T_RESUME -->|"Back resumes"| BACK_HANDLER

    %% Tier routing
    CONTROLLER -->|"tier decision"| TIERS
    LOW_PATH -->|"Back direct"| BACK_HANDLER
    MED_PATH -->|"Orchestrator"| ORCH_STUB
