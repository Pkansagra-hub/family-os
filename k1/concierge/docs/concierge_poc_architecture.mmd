    DYN_PROMPT_BUILDER -->|"determine_mode"| PROMPT_MODES
    DYN_PROMPT_BUILDER -->|"assemble"| PROMPT_COMPONENTS
    DYN_PROMPT_BUILDER -->|"compute"| AFFECT_MODULATION
    DYN_PROMPT_BUILDER -->|"inject"| DOMAIN_RULES

    %% LLM calls
    REACT_FRONT -->|"generate()"| ADAPTER_PORT
    REACT_BACK -->|"generate()"| ADAPTER_PORT
    ADAPTER_PORT -->|"validate"| VALIDATOR
    ADAPTER_PORT -->|"route"| GEMINI_ADAPTER

    %% Weave
    T_COMPLETE -->|"if Front busy"| WEAVE_BATCHER

    %% Experience Layer
    CONTROLLER -->|"tick_experience()"| EXPERIENCE
