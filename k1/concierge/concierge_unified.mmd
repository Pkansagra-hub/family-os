  %% 1A. PORTS — 8 Hexagonal Boundary Contracts (kernel.md Section 4.5 / 89)
  %% Internal services call ports, never external systems directly (INV-16).
  %% ==================================================================================

  subgraph PORTS["🔌 Ports (8 Boundary Contracts — kernel.md §4.5)"]
    direction TB

    PORT_INPUT["IInputPort<br/>Direction: Inbound<br/>receive() → UserMessage"]:::port
    PORT_OUTPUT["IOutputPort<br/>Direction: Outbound<br/>send(OutputEvent) → DeliveryReceipt"]:::port
    PORT_CLASSIFICATION["IClassificationPort<br/>Direction: Outbound<br/>classify(text) → ClassificationResult"]:::port
    PORT_LLM["ILLMPort<br/>Direction: Outbound<br/>execute(HubRequest) → HubResponse<br/>stream_execute(HubRequest) → AsyncIterator[HubChunk]<br/>Capabilities: CHAT, TOOL_CALL, STRUCTURED, VISION, REASON"]:::port
    PORT_STATE["IStatePort<br/>Direction: Both<br/>read(sections[]) → Snapshot<br/>write(section, op, data) → WriteResult<br/>ADR-0017: Concierge is ONLY writer"]:::port
    PORT_DISPATCH["IDispatchPort<br/>Direction: Outbound<br/>dispatch_direct(CapReq) → CapResult<br/>dispatch_envelope(TaskEnv) → void"]:::port
    PORT_DELTA["IDeltaPort<br/>Direction: Both<br/>subscribe(topics[]) → DeltaStream<br/>publish(event) → void<br/>errors() → ErrorStream"]:::port
    PORT_MEMORY["IMemoryPort<br/>Direction: Outbound<br/>recall(query, selectors[]) → MemoryResult"]:::port
  end

  %% ==================================================================================
  %% 1B. ADAPTERS — Production + Test (Circuit breakers inside production adapters)
  %% ==================================================================================

  subgraph ADAPTERS["🔧 Adapters (Infrastructure Bindings)"]
    direction TB

    subgraph ADAPTERS_PROD["Production Adapters"]
      ADAPT_WS_INPUT["WebSocketInputAdapter<br/>RESTInputAdapter"]:::adapter
      ADAPT_SSE_OUTPUT["SSEOutputAdapter<br/>WebSocketOutputAdapter<br/>CB_SSE owner<br/>---<br/>REALTIME: 3 retries, 100ms backoff, dead-letter<br/>PROGRESS: 1 retry, dead-letter<br/>BACKGROUND: 0 retries, no dead-letter<br/>CB OPEN: buffer 5 msgs, flush on reconnect"]:::adapter
      ADAPT_ULTRABERT["UltraBERTv4Adapter<br/>12 heads, 22ms<br/>CB_MODEL owner<br/>---<br/>HEURISTIC_FALLBACK (CB OPEN, <1ms):<br/>1. CRISIS keywords: hardcoded scan<br/>2. Question + <20 words: conversational/LOW<br/>3. remind/schedule/set: task/MED<br/>4. plan/help me with: planning/HIGH<br/>5. Default: conversational/LOW"]:::adapter
      ADAPT_MODEL_GW["ModelGatewayAdapter (Capability-Driven)<br/>Routes HubRequest to Model Hub via LLM Request Bus<br/>Tags requests with capability: CHAT|TOOL_CALL|STRUCTURED|VISION|REASON<br/>CB_MODEL owner<br/>---<br/>LLM_CASCADE:<br/>L1: RETRY (timeout/5xx, retry once) = RECOVERABLE<br/>L2: CB HALF-OPEN probe (30s window) = wait<br/>L3: CANNED_RESPONSE (CB OPEN) = DEGRADED"]:::adapter
      ADAPT_SESSION["SessionKernelAdapter<br/>MutationGuard inside<br/>CB_SESSIONSTATE owner<br/>---<br/>MutationGuard rejection: RECOVERABLE (skip write)<br/>Read timeout: DEGRADED (stale cached data)<br/>Emergency mode: ≥95KB, 50ms GC wait + retry"]:::adapter
      ADAPT_FABRIC_ORCH["FabricOrchestratorAdapter<br/>Routes by tier<br/>CB_ORCHESTRATOR + CB_PLANNER + CB_FABRIC + CB_MCP owner<br/>---<br/>Step failure: 2 retries per Q3, partial results OK<br/>TIER_DEGRADATION: HIGH→MED→LOW→canned<br/>Tool CB_MCP OPEN: mark tool unavailable"]:::adapter
      ADAPT_DELTA_BUS["DeltaBusAdapter<br/>Subscription + error routing<br/>---<br/>IDeltaPort: emit failure = log + skip (RECOVERABLE)<br/>Never TERMINAL (Edge-First: best-effort)"]:::adapter
      ADAPT_BRIDGE_RECALL["BridgeRecallAdapter<br/>QueryPort + offline fallback<br/>---<br/>IMemoryPort: recall timeout = skip memory (RECOVERABLE)<br/>Never TERMINAL (Edge-First: respond without memory)"]:::adapter
    end

    subgraph ADAPTERS_TEST["Test Adapters"]
      ADAPT_TEST_INPUT["TestInputAdapter<br/>Inject messages programmatically"]:::adapter_test
      ADAPT_TEST_OUTPUT["TestOutputAdapter<br/>Capture + assert on messages"]:::adapter_test
      ADAPT_TEST_CLASS["MockClassificationAdapter<br/>Scripted ClassificationResult"]:::adapter_test
      ADAPT_TEST_LLM["MockLLMAdapter<br/>Scripted responses + tool calls"]:::adapter_test
      ADAPT_TEST_STATE["InMemoryStateAdapter<br/>Dict-based, tracks writes"]:::adapter_test
      ADAPT_TEST_DISPATCH["MockDispatchAdapter<br/>Captures envelopes + requests"]:::adapter_test
      ADAPT_TEST_DELTA["TestDeltaAdapter<br/>Emit test deltas on demand"]:::adapter_test
      ADAPT_TEST_MEMORY["MockMemoryAdapter<br/>Canned recall results"]:::adapter_test
    end
  end

  %% ==================================================================================
  %% 2. FSM CORE — State Machine Controller (11 states + guard model)
  %% ==================================================================================

  subgraph FSM["🔄 Concierge FSM (State Machine Controller)"]
    direction TB

    CONCIERGE_FSM["ConciergeController<br/>Controls ALL state transitions<br/>Single Writer to SessionState<br/>---<br/>ERROR_SEVERITY: RECOVERABLE / DEGRADED / TERMINAL<br/>RECOVERABLE: retry/fallback in same phase<br/>DEGRADED: continue to DELIVERING with partial results<br/>TERMINAL: DELIVERING with error response"]:::brain

    subgraph FSM_CORE_STATES["Core Loop States (Every Turn)"]
      direction LR
      ST_LISTENING["LISTENING<br/>Idle, awaiting user input<br/>Entry: session start or<br/>DELIVERING complete"]:::fsm_state
      ST_DISPATCHING["DISPATCHING<br/>Phase 1 + Front LLM:<br/>classify, cognitive, dispatch<br/>LOW: LLM tool loop<br/>MED/HIGH: TaskEnvelope"]:::fsm_state
      ST_COMPANIONING["COMPANIONING<br/>Front idle, Back working<br/>Can accept new user input<br/>Preliminary ack (MED/HIGH)"]:::fsm_state
      ST_PROGRESSING["PROGRESSING<br/>Stream Deltas as Updates<br/>Progress narration to user"]:::fsm_state
      ST_DELIVERING["DELIVERING<br/>Final Results + Next Steps<br/>LLM call with tool_results[]<br/>+ cognitive tools"]:::fsm_state
    end

    subgraph FSM_INTERRUPT_STATES["Interrupt / Special States"]
      direction LR
      ST_CLARIFY_USER["CLARIFYING_USER<br/>Front detected ambiguity<br/>Progressive disclosure"]:::fsm_interrupt
      ST_CLARIFY_WORKER["CLARIFYING_WORKER<br/>Back suspended,<br/>needs user input<br/>HITL relay/resolve"]:::fsm_interrupt
      ST_CANCELLING["CANCELLING<br/>Cancel in-flight task<br/>Cooperative tokens"]:::fsm_interrupt
      ST_INTERRUPT["INTERRUPT_HANDLING<br/>New user input during<br/>COMPANIONING<br/>Reset routing, re-ACKING"]:::fsm_interrupt
      ST_PROACTIVE["PROACTIVE_WAKE<br/>task.complete while LISTENING<br/>Idle delivery"]:::fsm_interrupt
      ST_WEAVING["WEAVING<br/>Drain pending_results queue<br/>WeaveBatcher flush"]:::fsm_interrupt
    end

    subgraph GUARD_MODEL["Guard Model (5 Actions)"]
      direction LR
      GA_TRANSITION["TRANSITION<br/>Validate + change state"]:::guard_t
      GA_PASSTHROUGH["PASSTHROUGH<br/>Forward, no state change"]:::guard_p
      GA_OBSERVE["OBSERVE<br/>Log only, no routing"]:::guard_o
      GA_QUEUE["QUEUE<br/>Hold in FrontLock<br/>or pending_results"]:::guard_q
      GA_DEAD_LETTER["DEAD_LETTER<br/>Reject as invalid"]:::guard_d
    end

    subgraph FSM_TURN_STATE["FSMTurnState (Not LLM-visible)"]
      PENDING_RESULTS["pending_results: deque<br/>task.complete payloads<br/>queued for Weave"]:::fsm_internal
      CANCELLED_TASKS["cancelled_tasks: set<br/>For dedup: cancel vs<br/>complete race"]:::fsm_internal
      CANCEL_FLAG["cancellation_requested<br/>Checked by react_loop<br/>between iterations"]:::fsm_internal
    end

    subgraph FRONT_LOCK["FrontLock (Concurrency Gate)"]
      FL_BUSY["busy: bool<br/>True while Front LLM generating"]:::fsm_internal
      FL_QUEUE["event_queue: deque<br/>Queued events when Front busy"]:::fsm_internal
      FL_PRIORITY["Priority Order:<br/>1. user.input (URGENT)<br/>2. task.suspended<br/>3. task.complete<br/>4. task.failed<br/>5. findings.ready"]:::fsm_internal
    end
  end

