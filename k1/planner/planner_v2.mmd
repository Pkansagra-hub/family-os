%% =====================================================================================
%% PORT-TO-SERVICE ASSIGNMENT MATRIX (Principle of Least Privilege)
%% =====================================================================================
%% Direct injection:
%%   PlannerAgent:       IMailboxPort, IEventPort
%%   PipelineController: IDeltaEmitPort, IEventPort
%%   SketchService:      ILLMPort (+ Fabric/State/Bridge via TCR)
%%   ExpandService:      ILLMPort (+ Fabric/Bridge via TCR)
%%   ValidateService:    ILLMPort, IFabricRetrievalPort
%%   CommitService:      IBridgePort, IDeltaEmitPort, IEventPort
%%   ToolCallRouter:     IFabricRetrievalPort, IStateReadPort, IBridgePort
%%   HILCoordinator:     ILLMPort, IEventPort
%%
%% =====================================================================================
%% FAULT TOLERANCE BY PORT
%% =====================================================================================
%% Port              | CB?               | Failure Mode            | Response
%% IMailboxPort      | CB_PLANNER (ext)  | Full (depth>5)          | Reject, PlanAck(REJECTED)
%% ILLMPort          | CB_LLM (ext)      | Timeout, all OPEN       | Stage error recovery (S19)
%% IFabricRetrieval  | None (in-process) | Timeout/exception       | Empty result, degraded
%% IStateReadPort    | None (in-process) | Unavailable             | Empty Dict, degraded
%% IBridgePort       | None              | K0 WAL timeout          | Log, retry, proceed
%% IDeltaEmitPort    | None              | Bus failure             | Log+drop, no propagation
%% IEventPort        | None              | Bus failure             | Retry once, plan valid
%%
%% =====================================================================================
%% CB INTERACTION MATRIX
%% =====================================================================================
%% CB_PLANNER | CB_LLM (all)   | Outcome
%% CLOSED     | CLOSED          | Normal pipeline
%% CLOSED     | Partial OPEN    | Normal (Model Hub handles)
%% CLOSED     | All OPEN        | Pipeline starts, LLM stages fail, likely plan.failed
%% OPEN       | (irrelevant)    | Planner bypassed, MEDIUM-tier
%% HALF_OPEN  | CLOSED          | Probe: if enqueue OK, normal pipeline
%% HALF_OPEN  | All OPEN        | Probe: enqueue OK but LLM fails, plan.failed
%%
%% =====================================================================================
%% TYPE OWNERSHIP REFERENCE
%% =====================================================================================
%% Type               | Owner                    | Used By
%% PlanRequest        | k1/orchestrator/types.py | Orchestrator -> Planner
%% PlanAck            | k1/orchestrator/types.py | Planner -> Orchestrator
%% CommittedPlan      | k1/orchestrator/types.py | Planner -> Orchestrator -> DAGExecutor
%% PlanStep (15 flds) | k1/orchestrator/types.py | CommittedPlan.steps[]
%% MicroReplanRequest | k1/orchestrator/types.py | Orchestrator -> Planner
%% HubRequest         | k1/model_hub/types.py    | Planner -> Model Hub
%% HubResponse        | k1/model_hub/types.py    | Model Hub -> Planner
%%
%% Internal types (k1/planner/types.py, never cross boundary):
%%   RoughStep, SketchResult, ExpandedPlan, ValidationVerdict,
%%   ValidationIssue, StageContext, DeltaPayload
%%
%% =====================================================================================
%% ENVELOPE SCHEMAS
%% =====================================================================================
%% PlanRequest:        intent, trace_id, context, request_id, constraints, timeout_ms
%% MicroReplanRequest: original_plan_id, completed_results, remaining_steps, trace_id,
%%                     request_id, discoveries, failure_context
%% PlanAck:            request_id, status (ACCEPTED|REJECTED), estimated_duration_ms
%% CommittedPlan:      plan_id, request_id, intent, steps[], trace_id, dependencies,
%%                     estimated_duration_ms, created_at
%% PlanStep (15):      id, capability, params, deps, prompt_template, tools_granted,
%%                     output_schema, condition, is_optional, has_side_effects,
%%                     compensation, timeout_ms, required_context, safety_band_min,
%%                     activity_profile
%%
%% =====================================================================================
%% STYLES
