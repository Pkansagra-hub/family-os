subgraph PLANNER_CORE["PLANNER CORE -- L3 LLM-Powered Planning Engine"]
  direction TB

  PLANNER_MAILBOX["PLANNER MAILBOX\nFIFO | Max depth: 5\nAccepts: PlanRequest, MicroReplanRequest\nRejects beyond depth via MailboxFullError"]:::mailbox

  PLANNER_AGENT["PLANNER AGENT\nSingle-threaded async coordinator\nOwns: mailbox loop, plan lock, cancel set\nV1: one plan at a time (asyncio.Lock)"]:::planner

