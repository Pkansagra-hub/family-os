end

%% =====================================================================================
%% 4-STAGE PIPELINE
%% =====================================================================================

subgraph PIPELINE["4-STAGE PLANNING PIPELINE"]
  direction TB

  subgraph STAGE1["STAGE 1: SKETCH -- LLM ~2K tokens, 3-8s"]
    direction TB

    S1_ENTRY["Receive PlanRequest\nExtract intent + constraints"]:::step
    S1_TOOLS["3 Discovery Tool Calls:\n1. discover_capabilities(domain, intent)\n2. query_planning_context(sections)\n3. recall_for_planning(query)"]:::tool_read
    S1_HIL_CHECK{"Intent\nambiguous?"}:::decision
    S1_CLARIFY["HIL Clarification\nLLM ~300 tokens\nMax 2 rounds (PLAN-10)\n60s timeout per round"]:::hil
    S1_LLM["LLM SKETCH Call\nCapability: CHAT\nmax_tokens: 2048 | timeout: 8s | temp: 0.7\nPrompt: ROLE_DEFINITION + OUTPUT_SCHEMA\n+ intent + capabilities + context + memory"]:::llm
    S1_OUTPUT["SketchResult\nrough_steps[] | capability_candidates[]\nrationale | needs_clarification"]:::step
  end

  subgraph STAGE2["STAGE 2: EXPAND -- LLM ~1K tokens, 2-5s"]
    direction TB

    S2_ENTRY["Receive SketchResult\nMap rough steps to concrete tools"]:::step
    S2_TOOLS["2-3 Discovery Tool Calls:\n1. discover_capabilities(specific)\n2. find_relevant_prompts(intent, domain)\n3. (optional) discover_capabilities(refined)"]:::tool_fabric
    S2_LLM["LLM EXPAND Call\nCapability: CHAT\nmax_tokens: 1024 | timeout: 5s | temp: 0.3\nPrompt: sketch + caps + prompts\nOutput: steps with params, deps, schemas"]:::llm
    S2_ENRICH["Contract-Backed Enrichment\nPlanStep fields from LLM plus CapabilityContract metadata\nhas_side_effects, compensation, timeout_ms,\nrequired_context, safety_band_min, activity_profile\nPrompt binding: preserve exact discovered/inventory names or clear"]:::engine
    S2_OUTPUT["ExpandedPlan\nsteps: PlanStep[15 fields]\ndependencies: Dict[str, List[str]]\ntool_mappings | rationale"]:::step
  end

  subgraph STAGE3["STAGE 3: VALIDATE -- LLM ~500 tokens, 1-3s"]
    direction TB

    S3_ENTRY["Receive ExpandedPlan\nValidate coherence + feasibility"]:::step
    S3_DAG["DAG Cycle Detection\nKahn's algorithm (deterministic)\nPLAN-09 enforced"]:::engine
    S3_CAP["Capability Existence Check\nAll steps reference valid Fabric caps\nPLAN-08 enforced"]:::engine
    S3_ARBITER["LLM Arbiter\nCapability: STRUCTURED | strict: true\nmax_tokens: 512 | timeout: 3s | temp: 0.1\nVerdict: approved | revise | reject\nMax 1 revise cycle -> retry EXPAND"]:::llm
    S3_HIL_CHECK{"High-impact\noperations?"}:::decision
    S3_APPROVAL["HIL Approval\nLLM ~400 tokens\nOptions: approve | modify | reject\n120s timeout -> auto-approve if safe"]:::hil
    S3_VERDICT["ValidationVerdict\nstatus | issues[] | confidence | rationale"]:::step
  end

  subgraph STAGE4["STAGE 4: COMMIT -- Deterministic, 0 tokens, <100ms"]
    direction TB

    S4_BUILD["Build CommittedPlan\nAssign plan_id (uuid) + created_at\nAssemble steps + dependencies\nFreeze plan structure\nNO ILLMPort (PLAN-03)"]:::step
    S4_WAL["Persist to K0 WAL\nIBridgePort.persist_plan()\nFire-and-forget | Idempotent via plan_id\nFailure does NOT block delivery"]:::step
    S4_EMIT["Emit plan.ready.v1\nIEventPort.publish()\nPayload: CommittedPlan\nAt-least-once delivery"]:::step
  end
end

%% =====================================================================================
%% MICRO-REPLAN (ORCH-13)
%% =====================================================================================

subgraph MICRO_REPLAN["MICRO-REPLAN -- ORCH-13 Adaptive Blind DAG"]
  direction TB

  MR_ENTRY["Receive MicroReplanRequest\nremaining_steps + failure_context + discoveries\nCompleted steps FROZEN (PLAN-12)\nProtocol: synchronous return, 10s timeout\nNo HIL interaction"]:::step

  MR_SKETCH["Micro-SKETCH\nLLM: re-plan remaining steps\nmax_tokens: 1024 | timeout: 5s"]:::llm

  MR_EXPAND["Micro-EXPAND\nLLM: re-map tools for replacement\nmax_tokens: 512 | timeout: 3s"]:::llm

  MR_VALIDATE["Micro-VALIDATE\nLLM: validate replacement plan\nmax_tokens: 256 | timeout: 2s\n'revise' treated as 'approved'"]:::llm

  MR_OUTPUT["Partial CommittedPlan\nReplacement steps only\nReturned directly (synchronous)\nTelemetry: micro_replan.ready.v1\nOn ANY failure: return None"]:::step
end

