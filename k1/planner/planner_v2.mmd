%% PLANNER_V2.MMD -- K1 Cognitive Kernel Layer 3: Planner (Implementation Truth)
%% =====================================================================================
%% Source of truth: planner.md (Sections 1-32)
%% Type ownership: k1/orchestrator/types.py (PlanRequest, PlanAck, CommittedPlan, PlanStep, MicroReplanRequest)
%% Type imports:    k1/model_hub/types.py (HubRequest, HubResponse, CapabilityType, RequestConstraints)
%% Position:        L0 Rhythm -> L1 Concierge -> L2 Orchestrator -> [L3 PLANNER] -> L2.5 Fabric
%% Activation:      Orchestrator routes HIGH-tier tasks -> Planner Mailbox
%% Delivery:        CommittedPlan via k1.planner.plan.ready.v1 event
%% Contract files:  k1/contracts/modules/planner/wiring.contract.yaml (39 files)
%%                  k1/contracts/modules/planner/module.contract.yaml
%%
%% =====================================================================================
%% LLM CALL MATRIX
%% =====================================================================================
%%  ID   | Stage      | Capability  | Tokens | Timeout | Temp | Purpose
%%  LLM-1| SKETCH     | CHAT        | 2048   | 8000ms  | 0.7  | Rough plan from intent + caps
%%  LLM-2| EXPAND     | CHAT        | 1024   | 5000ms  | 0.3  | Map tools, params, prompts
%%  LLM-3| VALIDATE   | STRUCTURED  | 512    | 3000ms  | 0.1  | Arbiter verdict
%%  LLM-4| (COMMIT)   | (none)      | 0      | -       | -    | Deterministic, no LLM
%%  LLM-5a| HIL Clar. | CHAT        | 300    | 3000ms  | -    | Generate clarification question
%%  LLM-5b| HIL Appr. | CHAT        | 400    | 3000ms  | -    | Format approval summary
%%  LLM-M1| uSKETCH   | CHAT        | 1024   | 5000ms  | 0.7  | Micro-replan sketch
%%  LLM-M2| uEXPAND   | CHAT        | 512    | 3000ms  | 0.3  | Micro-replan expand
%%  LLM-M3| uVALIDATE | STRUCTURED  | 256    | 2000ms  | 0.1  | Micro-replan validate
%%
%% =====================================================================================
%% DISCOVERY TOOL MATRIX (4 tools, ALL read-only, PLAN-02)
%% =====================================================================================
%%  Tool                     | Routes To            | Stages         | Latency
%%  discover_capabilities()  | IFabricRetrievalPort | SKETCH, EXPAND | <50ms
%%  find_relevant_prompts()  | IFabricRetrievalPort | EXPAND         | <50ms
%%  query_planning_context() | IStateReadPort       | SKETCH         | <10ms
%%  recall_for_planning()    | IBridgePort          | SKETCH         | <100ms
%%  Max per plan: 6 (PLAN-05)
%%
%% =====================================================================================
%% PERFORMANCE TARGETS
%% =====================================================================================
%%  Operation        | P50   | P99   | Tokens
%%  Stage 1 SKETCH   | 4s    | 8s    | ~2K
%%  Stage 2 EXPAND   | 3s    | 5s    | ~1K
%%  Stage 3 VALIDATE | 2s    | 3s    | ~500
%%  Stage 4 COMMIT   | 20ms  | 100ms | 0
%%  Total Planning   | 12s   | 30s   | ~3.5K
%%  Micro-Replan     | 8s    | 15s   | ~2K
%%  Plan Delivery    | 2ms   | 10ms  | 0
%%
%% =====================================================================================
%% INVARIANTS (PLAN-01 to PLAN-12)
%% =====================================================================================
%%  PLAN-01: NEVER writes SessionState (IStateReadPort has no write methods)
%%  PLAN-02: ALL 4 discovery tools read-only (zero side effects)
%%  PLAN-03: Stage 4 COMMIT deterministic (zero LLM calls, no ILLMPort dep)
%%  PLAN-04: Max planning time 45s (CB_PLANNER timeout, Orchestrator-owned)
%%  PLAN-05: Max 6 discovery tool calls per plan (ToolCallRouter counter)
%%  PLAN-06: NEVER executes capabilities (discovery only)
%%  PLAN-07: V1 DEFERRED -- token_budget_max removed from types.py
%%  PLAN-08: Each step references valid Fabric capability (ValidateService)
%%  PLAN-09: Plan deps form DAG, no cycles (ValidateService Kahn's algo)
%%  PLAN-10: HIL max 2 rounds per plan (HILCoordinator counter)
%%  PLAN-11: All LLM calls carry budget {max_tokens, timeout_ms} (PipelineController)
%%  PLAN-12: Micro-replan adjusts remaining steps only, completed frozen
%%
%% =====================================================================================
%% PLAN STATE MACHINE (10 states)
%% =====================================================================================
%%  IDLE -> SKETCHING -> EXPANDING -> VALIDATING -> COMMITTING -> COMPLETED
%%  IDLE -> MICRO_SKETCH -> MICRO_EXPAND -> MICRO_VALIDATE -> COMMITTING
%%  Any non-terminal -> FAILED | CANCELLED
%%  Terminal (COMPLETED | FAILED | CANCELLED) -> IDLE (reset)
%%
%% =====================================================================================
%% EVENT CATALOG
%% =====================================================================================
%%  Published (Event Bus, at-least-once):
%%    k1.planner.plan.ready.v1         CommittedPlan        -> Orchestrator
%%    k1.planner.plan.failed.v1        failure payload       -> Orchestrator, Learning Loop
%%    k1.planner.plan.cancelled.v1     cancel payload        -> Orchestrator
%%    k1.planner.micro_replan.ready.v1 partial plan          -> Learning Loop (telemetry only)
%%    k1.hil.clarification.v1          question payload      -> Concierge -> User
%%    k1.hil.approval_request.v1       approval payload      -> Concierge -> User
%%  Subscribed (Event Bus):
%%    k1.hil.clarification_response.v1 user answer           <- Concierge
%%    k1.hil.approval_response.v1      approve/modify/reject <- Concierge
%%    k1.planner.plan.request.v1       async plan request    <- Orchestrator (alt path)
%%    k1.planner.plan.cancel.v1        async cancel          <- Orchestrator (alt path)
%%  Published (K1 Bus delta lane, fire-and-forget):
%%    k1.planner.delta.v1              11 delta_types        -> Learning Loop, SessionState
%%
%% =====================================================================================
%% DELTA TYPE CATALOG (all via IDeltaEmitPort, PipelineController sole emitter)
%% =====================================================================================
%%  delta_type         | section    | When
%%  stage_transition   | pipeline   | Stage start / complete / fail
%%  tool_result        | tools      | Discovery tool returns
%%  hil_event          | pipeline   | HIL round start / end
%%  plan_update        | plan       | Committed / failed / cancelled
%%  plan_end           | pipeline   | Plan lifecycle ends
%%  micro_replan       | pipeline   | Micro-replan completes
%%  crash_recovery     | pipeline   | Crash recovery runs
%%
%% =====================================================================================
%% METRICS (planner.* namespace)
%% =====================================================================================
%%  Counters (9): plan.total, plan.degraded, stage.total, llm.calls, tool.calls,
%%                hil.rounds, micro_replan.total, mailbox.rejected, recovery.activated
%%  Histograms (6): plan.duration_ms, stage.duration_ms, llm.latency_ms,
%%                  llm.tokens, tool.latency_ms, micro_replan.duration_ms
%%  Gauges (4): mailbox.depth, plan.in_flight, tokens.budget_remaining, tool.budget_remaining
%%
%% =====================================================================================
%% RESOURCE BUDGETS
%% =====================================================================================
%%  Total tokens/plan:        ~3.5K    |  Total tokens/micro-replan: ~2K
%%  Discovery tools/plan:     Max 6    |  HIL rounds/plan:           Max 2
%%  Mailbox depth:            Max 5    |  Concurrent plans (V1):     1
%%
