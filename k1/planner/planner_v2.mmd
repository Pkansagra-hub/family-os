%% =====================================================================================
%% LIFECYCLE (6 Phases)
%% =====================================================================================

subgraph LIFECYCLE["LIFECYCLE -- 6 Phases"]
  direction TB

  LC_INIT["INIT (once at startup)\nCreate 7 services | Wire 7 ports\nSubscribe 4 events | FSM -> IDLE\nServices: TCR(Fabric,State,Bridge)\nHIL(LLM,Event) | Sketch(LLM,TCR,HIL)\nExpand(LLM,TCR) | Validate(LLM,Fabric,HIL)\nCommit(Bridge,Delta,Event)\nPipeline(Sketch,Expand,Validate,Commit,Delta,Event)"]:::lifecycle

  LC_START["PLAN_START (per plan)\nDequeue from mailbox\nCancel check (pre-execution)\nAcquire _plan_lock\nReset: PipelineCtrl, TCR, HIL\nFSM: IDLE -> SKETCHING"]:::lifecycle

  LC_TRANS["STAGE_TRANSITION (3x per plan)\nRecord stage tokens + duration\nCheck cancel flag | Advance FSM\nEmit stage delta | Inject next budget\nSKETCHING->EXPANDING->VALIDATING->COMMITTING"]:::lifecycle

  LC_END["PLAN_END (per plan)\nRelease _plan_lock\nClear pipeline state\nEmit plan_end delta\nFSM: terminal -> IDLE\nResume mailbox loop"]:::lifecycle

  LC_SHUT["SHUTDOWN\n1. Stop accepting (ShutdownError)\n2. Drain mailbox (cancel.v1 each)\n3. Cancel in-flight (cooperative)\n4. Flush deltas (best-effort)\n5. Persist partial state (fire-forget)\n6. Release lock | Unsubscribe events\nGrace timeout: 5s"]:::lifecycle

  LC_CRASH["CRASH_RECOVERY (at startup)\nCheck WAL for partial plan\nIf stale (>120s): discard\nElse: resume at last completed stage\nEmit recovery delta\nV1: simplified -- treat as lost"]:::lifecycle
end

%% =====================================================================================
%% CONCURRENCY MODEL
%% =====================================================================================

subgraph CONCURRENCY["CONCURRENCY -- V1 Single Plan"]
  direction TB

  CONC_LOCK["Plan Lock\nasyncio.Lock (FIFO)\nAcquire: PLAN_START\nRelease: PLAN_END\nOne plan at a time"]:::concurrency

  CONC_CANCEL["Cooperative Cancel\n_cancel_set: Set[str]\nCheckpoints: pre-exec, between stages,\nbefore WAL persist\nNot mid-LLM (waits for return)"]:::concurrency

  CONC_MICRO["Micro-Replan Concurrency\nBypasses mailbox queue\nAwaits _plan_lock directly\n10s caller timeout < 12s plan p50\n= almost always times out if plan in-flight\nReturns None on timeout"]:::concurrency

  CONC_QUEUE["Mailbox Queuing\nFIFO within priority band\nDepth > 5: MailboxFullError\n-> PlanAck(REJECTED)\n-> CB_PLANNER counts as failure"]:::concurrency
end

%% =====================================================================================
%% ERROR RECOVERY (6 Named Paths)
%% =====================================================================================

subgraph ERROR_RECOVERY["ERROR RECOVERY -- 6 Named Paths"]
  direction TB

  ERR_SK["ERR_SKETCH_FAIL\nRetry once (simplified prompt)\nIf still fails: PLAN FAILED (terminal)\nImpact rank: 6/8"]:::recovery

  ERR_EX["ERR_EXPAND_FAIL\nRetry once (same prompt)\nIf still fails: FALLBACK to SketchResult\nas degraded PlanSteps (empty params,\ndefault timeout 10s)\nPipeline continues -> VALIDATE\nImpact rank: 3/8"]:::recovery

  ERR_VA["ERR_VALIDATE_FAIL\nIf 'revise': retry EXPAND once\nIf arbiter down + deterministic pass:\nauto-approve (key graceful degradation)\nIf DAG/cap fail 2nd time: PLAN FAILED\nImpact rank: 4/8"]:::recovery

  ERR_CO["ERR_COMMIT_FAIL\nWAL persist: retry once (idempotent)\nWAL fail: proceed anyway (durability loss)\nEvent publish: retry once\nEvent fail: plan valid but undeliverable\nImpact rank: 2/8 (WAL) or 7/8 (event)"]:::recovery

  ERR_HIL["ERR_HIL_TIMEOUT\nClarification: best-effort interpretation\nApproval: auto-approve if all GREEN\nIf any AMBER/RED: PLAN FAILED\nImpact rank: 1/8 (clar) or 5/8 (appr)"]:::recovery

  ERR_CB["ERR_CB_OPEN\nOrchestrator-owned (Planner unaware)\nImmediate AdapterException(DEGRADED)\nFallback: HIGH -> MEDIUM tier\nDirect Fabric exec (no planning)\nImpact rank: 8/8 (highest)"]:::recovery
end

