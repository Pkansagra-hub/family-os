%% =====================================================================================
%% PLANNER.MMD — K1 LLM-Powered Planning Engine
%% =====================================================================================
%%
%% ROLE: 4-Stage LLM-Powered Planning Pipeline
%%   Transforms PlanRequest into CommittedPlan via staged intelligence.
%%   Conditional: Invoked ONLY for HIGH complexity tasks (Orchestrator decides).
%%   NEVER writes SessionState. NEVER executes capabilities. NEVER spawns agents.
%%   ALL tool calls are read-only discovery. Stage 4 COMMIT is deterministic (no LLM).
%%
%% TYPE OWNERSHIP:
%%   CommittedPlan, PlanStep, PlanRequest, PlanAck, MicroReplanRequest
%%   are ALL defined in k1/orchestrator/types.py (source of truth).
%%   Planner re-exports these from k1/planner/__init__.py for convenience.
%%   Planner MUST NOT redefine these types. Field-for-field match enforced.
%%   HubRequest, HubResponse, CapabilityType, RequestConstraints
%%   are defined in k1/model_hub/types.py (source of truth).
%%   Planner imports via ILLMPort adapter layer.
%%
%% GOVERNING DOCS:
%%   - whiteboard_concierge_orchestrator_planner_fabric.md Section 5 (Planner)
%%   - whiteboard_concierge_orchestrator_planner_fabric.md Section 12-16 (Resolved)
%%   - k1_cognitive_architecture_skeleton.mmd L3_PLANNER
%%   - orchestrator.mmd IPlannerPort + TP_PLANNER touchpoint
%%   - fabric.mmd CALLER_PLANNER + Retrieval Flow
%%   - concierge.mmd CB_PLANNER + TP_PLANNER
%%
%% POSITION IN K1 STACK:
%%   L0 Rhythm -> L1 Concierge -> L2 Orchestrator -> L3 PLANNER -> L2.5 Fabric
%%                                                   ^ we are here
%%   Activated: Orchestrator routes HIGH tier tasks -> Planner Mailbox
%%   Returns: CommittedPlan via k1.planner.plan.ready.v1 event
%%
%% =====================================================================================
%% LLM CALL MATRIX (4 stages, 3 use LLM)
%% =====================================================================================
%%
%% | Stage    | LLM? | Budget      | Purpose                                    |
%% |----------|------|-------------|--------------------------------------------|
%% | SKETCH   | YES  | ~2K tokens  | Rough plan from intent + discovered caps    |
%% | EXPAND   | YES  | ~1K tokens  | Map tools, params, prompts to steps         |
%% | VALIDATE | YES  | ~500 tokens | Arbiter: coherence, safety, feasibility     |
%% | COMMIT   | NO   | 0 tokens    | Deterministic: persist to K0 WAL            |
%%
%% HIL LLM calls (interruptive, not counted in stage budgets):
%% | HIL Type                 | Budget      | Stage    |
%% |--------------------------|-------------|----------|
%% | Requirement Clarification| ~300 tokens | Stage 1  |
%% | Plan Approval            | ~400 tokens | Stage 3  |
%%
%% =====================================================================================
%% DISCOVERY TOOL MATRIX (4 tools, ALL read-only)
%% =====================================================================================
%%
%% | Tool                      | Routes To            | Used In Stages     | Latency |
%% |---------------------------|----------------------|--------------------|---------|
%% | discover_capabilities()   | Fabric Retrieval     | 1 SKETCH, 2 EXPAND | <50ms   |
%% | find_relevant_prompts()   | Fabric Retrieval     | 2 EXPAND           | <50ms   |
%% | query_planning_context()  | SessionState (direct) | 1 SKETCH          | <10ms   |
%% | recall_for_planning()     | K0 Bridge            | 1 SKETCH           | <100ms  |
%%
%% Max tool calls per plan: 6 (3 in SKETCH + 3 in EXPAND)
%%
%% =====================================================================================
%% ENVELOPE SCHEMAS
%% =====================================================================================
%%
%% INBOUND:
%%   PlanRequest {                       (SOURCE OF TRUTH: k1/orchestrator/types.py)
%%     intent: string,                     (required, non-empty)
%%     trace_id: string,                   (required, non-empty)
%%     context: SessionSnapshot | null,    (V1: Fabric SessionSnapshot directly, no ContextSnapshot wrapper)
%%     request_id: uuid,                   (auto-generated uuid4 if not set)
%%     constraints: Dict[str, Any],        (V1: opaque dict, not structured -- schema TBD V2)
%%     timeout_ms: int = 45000             (planning timeout, default 45s)
%%   }
%%   NOTE: PlanRequest.constraints is Dict[str, Any] in V1. Structured constraint
%%   fields (token_budget_max, cost_budget_max_usd, safety_band, max_steps, etc.)
%%   are V2-planned. See wiring.contract.yaml committed_plan_spec.v1_removed.
%%
%%   MicroReplanRequest {               (ORCH-13: Adaptive Blind DAG)
%%                                       (SOURCE OF TRUTH: k1/orchestrator/types.py)
%%     original_plan_id: string,          (required, non-empty)
%%     completed_results: Dict[str, StepResult],  (results from completed steps)
%%     remaining_steps: PlanStep[],       (required, non-empty -- only uncompleted steps)
%%     trace_id: string,                  (required)
%%     request_id: uuid = auto,           (auto-generated uuid4)
%%     discoveries: Discovery[],          (runtime discoveries for replan)
%%     failure_context: FailureContext | null  (step_id, error_code, error_message, partial_result)
%%   }
%%
%% OUTBOUND:
%%   PlanAck {                           (SOURCE OF TRUTH: k1/orchestrator/types.py)
%%     request_id: string,                (echoes PlanRequest.request_id)
%%     status: string,                    ("ACCEPTED" | "REJECTED")
%%     estimated_duration_ms: int | null  (optional)
%%   }
%%   NOTE: V1 PlanAck has no 'reason' field. Rejection reason conveyed via
%%   plan.failed.v1 event payload instead.
%%
%%   CommittedPlan {                     (SOURCE OF TRUTH: k1/orchestrator/types.py)
%%     plan_id: string,                   (required, Planner-generated uuid)
%%     request_id: string,                (required, echoes PlanRequest.request_id)
%%     intent: string,                    (required)
%%     steps: PlanStep[],                 (required, non-empty)
%%     trace_id: string,                  (required)
%%     dependencies: Dict[str, List[str]], (step_id -> [predecessor_step_ids])
%%     estimated_duration_ms: int | null, (optional Planner estimate)
%%     created_at: float = 0.0,           (epoch seconds, NOT ISO timestamp)
%%   }
%%   V1 REMOVED: token_budget_max, cost_budget_max_usd (no upstream data -- PLAN-07 DEFERRED)
%%   Validation: plan_id/request_id non-empty, steps non-empty, deps form DAG (Kahn's)
%%
%%   PlanStep (14 fields) {              (SOURCE OF TRUTH: k1/orchestrator/types.py)
%%     -- Fabric-aligned fields (1-6) --
%%     id: string,                        (required, e.g., "s1", "s2")
%%     capability: string,                (required, e.g., "tool.execute.send_message")
%%     params: Dict[str, Any],            (forwarded as CapabilityRequest.parameters)
%%     deps: List[str],                   (step IDs this depends on)
%%     prompt_template: string | null,    (template name reference)
%%     tools_granted: List[str] | null,   (FAB-07: scoped tool list for agent steps)
%%     -- Orchestrator extension fields (7-14) --
%%     output_schema: Dict | null,        (JSON Schema, OutputSchemaGuard validates)
%%     condition: ConditionExpr | null,   (structured expr, NOT raw JSONPath string)
%%     is_optional: bool = false,         (true = failure does NOT fail the plan)
%%     has_side_effects: bool = false,    (from Fabric CapabilityDescriptor, drives rollback)
%%     compensation: string | null,       (capability to call on rollback if has_side_effects)
%%     timeout_ms: int | null,            (per-step timeout, seeded from Fabric estimated_duration_ms)
%%     required_context: List[str] | null,(SessionState sections needed before execution)
%%     safety_band_min: string | null     (minimum safety band for this step)
%%   }
%%   V1 REMOVED: token_budget per step (no upstream data -- PLAN-07 DEFERRED)
%%
%%   META-AGENT DAG PATTERN (4.5.1-4.5.9):
%%   Steps MAY include build_agent capabilities:
%%     { id: "s1", capability: "tool.meta.build_agent",
%%       params: { name: "health_advisor", role: "...",
%%                 tools_granted: [...], prompt_template: "...",
%%                 seed_context: {...}, ttl_turns: 3 },
%%       deps: [], output_schema: { agent_name: "string" } }
%%     { id: "s2", capability: "$s1.result.agent_name",
%%       params: { query: "..." }, deps: ["s1"] }
%%   Planner discovers and composes AgentSpec; Orchestrator executes (PLAN-06)
%%
%% HIL RESPONSE EVENTS (INBOUND via Event Bus -- GAP-1 fix):
%%   HILClarificationResponse {          (k1.hil.clarification_response.v1)
%%     request_id: uuid,                 (correlates to original HIL request)
%%     plan_id: uuid,
%%     user_response: string,            (user's answer to clarification question)
%%     trace_id: string
%%   }
%%
%%   HILApprovalResponse {               (k1.hil.approval_response.v1)
%%     request_id: uuid,
%%     plan_id: uuid,
%%     response_type: "approve" | "modify" | "reject",
%%     modifications: {} | null,         (user modifications if response_type=modify)
%%     trace_id: string
%%   }
%%
%% =====================================================================================
%% INVARIANTS (PLAN-01 through PLAN-12)
%% =====================================================================================
%%
%% PLAN-01: NEVER writes SessionState (all reads are lock-free multi-reader)
%% PLAN-02: ALL 4 discovery tools are read-only (zero side effects)
%% PLAN-03: Stage 4 COMMIT is deterministic (zero LLM calls)
%% PLAN-04: Max planning time 45s (CB_PLANNER timeout, owned by Concierge)
%% PLAN-05: Max 6 discovery tool calls per plan
%% PLAN-06: NEVER executes capabilities (discovery only, no invoke_capability)
%% PLAN-07: CommittedPlan MUST include token_budget_max and per-step token_budget
%%          V1 DEFERRED: No upstream data source. token_budget_max and token_budget
%%          removed from PlanStep and CommittedPlan in types.py.
%%          Planner MAY set max_tokens in HubRequest.constraints for its own LLM calls
%%          but does NOT set per-step token budgets in the CommittedPlan.
%%          See: wiring.contract.yaml committed_plan_spec.v1_removed
%% PLAN-08: Each step MUST reference valid capability from Fabric Registry
%% PLAN-09: Plan dependencies MUST form a DAG (no cycles -- validated in Stage 3)
%% PLAN-10: HIL clarification max 2 rounds per plan (then best-effort)
%% PLAN-11: All LLM calls carry budget{max_tokens, timeout_ms} (no unbounded calls)
%% PLAN-12: Micro-replan adjusts remaining steps only (completed steps frozen)
%%
%% =====================================================================================
%% PERFORMANCE BUDGET
%% =====================================================================================
%%
%% | Phase               | Latency    | Tokens  | System Owned? |
%% |---------------------|------------|---------|---------------|
%% | Stage 1 SKETCH      | 3-8s       | ~2K     | YES           |
%% | Stage 2 EXPAND      | 2-5s       | ~1K     | YES           |
%% | Stage 3 VALIDATE    | 1-3s       | ~500    | YES           |
%% | Stage 4 COMMIT      | <100ms     | 0       | YES           |
%% | Discovery tool call | <50ms      | 0       | NO (Fabric)   |
%% | Plan delivery       | <10ms      | 0       | YES           |
%% | Total planning      | 10-30s     | ~3.5K   | COMPOSITE     |
%% | Micro-replan        | 5-15s      | ~2K     | YES           |
%% | HIL round-trip      | user-bound | ~300-400| NO (user)     |
%%
%% =====================================================================================

flowchart TB

%% =====================================================================================
%% PLANNER CORE
%% =====================================================================================

subgraph PLANNER_CORE["Planner Core (L3 -- LLM-Powered Planning Engine)"]
  direction TB

  PLANNER_MAILBOX["Planner Mailbox<br/>WFQ Priority: INTERACTIVE<br/>Queue: PlanRequest, MicroReplanRequest<br/>Max depth: 5 (reject beyond)"]:::mailbox

  PLANNER_AGENT["PlannerAgent<br/>Single-threaded async coordinator<br/>One plan at a time (V1)<br/>LLM-powered 4-Stage Pipeline<br/>4 read-only discovery tools<br/>NEVER writes SessionState<br/>NEVER executes capabilities"]:::planner

  PIPELINE_CTRL["PipelineController<br/>Orchestrates SKETCH -> EXPAND -> VALIDATE -> COMMIT<br/>Tracks stage transitions, token usage, tool call count<br/>Handles micro-replan re-entry"]:::service

  PLAN_FSM["Plan State Machine<br/>States: IDLE -> SKETCHING -> EXPANDING -><br/>VALIDATING -> COMMITTING -> COMPLETED | FAILED | CANCELLED<br/>Micro-replan: MICRO_SKETCH -> MICRO_EXPAND -><br/>MICRO_VALIDATE -> COMMITTING"]:::brain
end

%% =====================================================================================
%% 4-STAGE PIPELINE
%% =====================================================================================

subgraph PIPELINE["4-Stage Planning Pipeline"]
  direction TB

  subgraph STAGE1["Stage 1: SKETCH (LLM -- ~2K tokens, 3-8s)"]
    direction TB

    S1_ENTRY["Receive PlanRequest<br/>Extract intent + constraints"]:::step
    S1_DISCOVER["discover_capabilities(domain, intent)<br/>Semantic Top-K from Fabric Retrieval"]:::tool_fabric
    S1_QUERY_CTX["query_planning_context(sections)<br/>Read beliefs, persona, temporal from SessionState"]:::tool_read
    S1_RECALL["recall_for_planning(query)<br/>K0 long-term memory via Bridge"]:::tool_read
    S1_LLM["LLM: Generate rough plan<br/>Input: intent + capabilities + context + memory<br/>Output: sketch{steps[], rationale}<br/>Budget: {max_tokens: 2048, timeout_ms: 8000}"]:::llm
    S1_OUTPUT["SketchResult<br/>rough_steps[], capability_candidates[], rationale"]:::step
  end

  subgraph STAGE2["Stage 2: EXPAND (LLM -- ~1K tokens, 2-5s)"]
    direction TB

    S2_ENTRY["Receive SketchResult<br/>Map rough steps to concrete tools"]:::step
    S2_DISCOVER["discover_capabilities(specific_tools)<br/>Refine Top-K for each step"]:::tool_fabric
    S2_FIND_PROMPTS["find_relevant_prompts(intent, domain)<br/>Semantic Top-K from Prompt Registry"]:::tool_fabric
    S2_LLM["LLM: Expand and parameterize<br/>Input: sketch + refined capabilities + prompts<br/>Output: expanded_plan{steps with params, prompts, deps}<br/>Budget: {max_tokens: 1024, timeout_ms: 5000}"]:::llm
    S2_OUTPUT["ExpandedPlan<br/>steps[] with capability, params, prompt_template,<br/>deps, token_budget, output_schema, tools_granted"]:::step
  end

  subgraph STAGE3["Stage 3: VALIDATE (LLM Arbiter -- ~500 tokens, 1-3s)"]
    direction TB

    S3_ENTRY["Receive ExpandedPlan<br/>Validate coherence and feasibility"]:::step
    S3_DAG_CHECK["DAG Cycle Detection<br/>Verify dependencies form acyclic graph<br/>(deterministic, no LLM)"]:::engine
    S3_CAP_CHECK["Capability Validation<br/>Verify all referenced capabilities exist<br/>in Fabric Registry (deterministic)"]:::engine
    S3_LLM["LLM Arbiter: Validate plan quality<br/>Input: expanded plan + original intent<br/>Checks: coherence, safety, completeness, feasibility<br/>Output: verdict{approved|revise|reject, reasons[]}<br/>Budget: {max_tokens: 512, timeout_ms: 3000}"]:::llm
    S3_VERDICT["ValidationVerdict<br/>status: approved | revise | reject<br/>reasons[], suggested_fixes[]"]:::step
  end

  subgraph STAGE4["Stage 4: COMMIT (Deterministic -- 0 tokens, <100ms)"]
    direction TB

    S4_ENTRY["Receive validated ExpandedPlan<br/>NO LLM call (PLAN-03)"]:::step
    S4_ASSIGN_ID["Assign plan_id (uuid)<br/>Set created_at timestamp"]:::step
    S4_BUILD["Build CommittedPlan<br/>Assemble steps, dependencies, token_budget_max<br/>Freeze plan structure<br/>---<br/>META-AGENT PATTERN (4.5.1-4.5.9):<br/>May include build_agent steps with AgentSpec params:<br/>  capability: tool.meta.build_agent<br/>  params: {name, role, tools_granted, prompt_template, ...}<br/>Subsequent steps can reference created agent:<br/>  capability: $build_step.result.agent_name<br/>Planner commits DAG; Orchestrator executes (PLAN-06)"]:::step
    S4_PERSIST["Persist to K0 WAL<br/>Via IBridgePort (fire-and-forget)<br/>Idempotent: plan_id is dedup key"]:::step
    S4_EMIT["Emit k1.planner.plan.ready.v1<br/>Via IEventPort<br/>Payload: CommittedPlan"]:::step
  end
end

%% =====================================================================================
%% MICRO-REPLAN (ORCH-13: Adaptive Blind DAG)
%% =====================================================================================

subgraph MICRO_REPLAN["Micro-Replan (ORCH-13 -- Partial Pipeline Re-Entry)"]
  direction TB

  %% PROTOCOL: micro_replan() is SYNCHRONOUS (direct return, 10s timeout).
  %% Unlike request_plan() which is fire-and-forget + event delivery,
  %% micro_replan() returns Optional[CommittedPlan] directly to caller.
  %% k1.planner.micro_replan.ready.v1 is TELEMETRY-ONLY (emitted for
  %% Learning Loop observability, NOT used for plan delivery).
  %% Orchestrator does NOT subscribe to micro_replan.ready for delivery.

  MR_ENTRY["Receive MicroReplanRequest<br/>remaining_steps + failure_context<br/>Completed steps are FROZEN (PLAN-12)<br/>---<br/>PROTOCOL: synchronous return (10s timeout)<br/>NOT event-driven like request_plan()"]:::step

  MR_SKETCH["Micro-SKETCH<br/>LLM: re-plan remaining steps only<br/>Input: original intent + remaining + failure<br/>Budget: {max_tokens: 1024, timeout_ms: 5000}"]:::llm

  MR_EXPAND["Micro-EXPAND<br/>LLM: re-map tools for replacement steps<br/>Budget: {max_tokens: 512, timeout_ms: 3000}"]:::llm

  MR_VALIDATE["Micro-VALIDATE<br/>LLM Arbiter: validate replacement plan<br/>Budget: {max_tokens: 256, timeout_ms: 2000}"]:::llm

  MR_OUTPUT["Partial CommittedPlan<br/>Only replacement steps for failed portion<br/>Orchestrator merges with completed steps<br/>---<br/>DELIVERY: Returned directly to caller (synchronous)<br/>TELEMETRY: k1.planner.micro_replan.ready.v1 emitted<br/>for Learning Loop (observability only, not delivery)"]:::step
end

%% =====================================================================================
%% DISCOVERY TOOLS (4 Read-Only Tools)
%% =====================================================================================

subgraph DISCOVERY_TOOLS["Discovery Tools (4 Tools -- ALL Read-Only, PLAN-02)"]
  direction TB

  DTOOL_DISCOVER_CAPS["discover_capabilities(domain?, intent?)<br/>Semantic Top-K search: Tool + Agent registries<br/>Returns: Top-K capabilities with input/output schemas<br/>Route: IFabricRetrievalPort -> Fabric Retrieval API<br/>Latency: <50ms<br/>---<br/>META-AGENT CREATION (4.5.1-4.5.4):<br/>Also discovers prompts, tools, and capabilities<br/>that compose an AgentSpec for build_agent steps.<br/>Planner uses discovery results to populate:<br/>  tools_granted[], prompt_template, seed_context<br/>Planner outputs build_agent as a DAG step (PLAN-06:<br/>  Planner NEVER executes -- Orchestrator runs build_agent)"]:::tool_fabric

  DTOOL_FIND_PROMPTS["find_relevant_prompts(intent?, domain?)<br/>Semantic Top-K search: Prompt Registry<br/>Returns: Top-K prompt templates with variable defs<br/>Route: IFabricRetrievalPort -> Fabric Retrieval API<br/>Latency: <50ms"]:::tool_fabric

  DTOOL_QUERY_CTX["query_planning_context(sections?)<br/>Reads SessionState sections for plan parameterization<br/>Returns: beliefs, persona, entities, temporal context<br/>Route: IStateReadPort -> SessionState (multi-reader)<br/>Latency: <10ms"]:::tool_read

  DTOOL_RECALL["recall_for_planning(query)<br/>K0 long-term memory: historical preferences/outcomes<br/>Returns: facts, prior outcomes, user preferences<br/>Route: IBridgePort -> K0 Bridge<br/>Latency: <100ms"]:::tool_read
end

%% =====================================================================================
%% HIL SYSTEM (Human-In-The-Loop)
%% =====================================================================================

subgraph HIL_SYSTEM["HIL System (2 Interaction Points)"]
  direction TB

  %% HIL NAMESPACE SPLIT:
  %%   k1.hil.clarification*.v1 / k1.hil.approval*.v1 = PLANNING-TIME (Planner owns)
  %%   k1.hil.override*.v1 / k1.hil.fallback*.v1 = EXECUTION-TIME (Orchestrator owns)
  %% These are distinct event families. Concierge routes both to user.

  HIL_CLARIFICATION["Requirement Clarification (Stage 1)<br/>Trigger: intent ambiguous OR missing constraints<br/>LLM generates natural-language question (~300 tokens)<br/>Route: k1.hil.clarification.v1 -> Concierge -> User<br/>Return: k1.hil.clarification_response.v1 via Event Bus<br/>Concierge correlates via request_id in PENDING_CLARIFICATIONS<br/>Max rounds: 2 (PLAN-10)<br/>Timeout: 60s per round, then best-effort"]:::hil

  HIL_APPROVAL["Plan Approval (Stage 3)<br/>Trigger: plan has HIGH-impact operations<br/>LLM formats plan summary + options (~400 tokens)<br/>Route: k1.hil.approval_request.v1 -> Concierge -> User<br/>Return: k1.hil.approval_response.v1 via Event Bus<br/>Concierge correlates via request_id in PENDING_CLARIFICATIONS<br/>Options: approve | modify | reject<br/>Timeout: 120s, then auto-approve if safe"]:::hil
end

%% =====================================================================================
%% PORTS (Hexagonal Architecture Boundary -- 7 Ports)
%% =====================================================================================

subgraph PORTS["Ports (7 Hexagonal Boundaries -- PLAN-01: No Write Ports to SessionState)"]
  direction TB

  PORT_MAILBOX["IMailboxPort<br/>receive() -> PlanRequest | MicroReplanRequest<br/>ack(request_id) -> PlanAck<br/>cancel(request_id) -> void"]:::port

  PORT_LLM["ILLMPort (Routes to Model Hub via LLM Request Bus)<br/>execute(HubRequest) -> HubResponse<br/>---<br/>HubRequest {<br/>  capability: CapabilityType (CHAT | TOOL_CALL | STRUCTURED),<br/>  payload: CapabilityPayload (ChatPayload | ToolCallPayload | StructuredOutputPayload),<br/>  constraints: RequestConstraints {max_tokens, timeout_ms, priority, temperature, consumer_id},<br/>  trace_id: cognitive_trace_id<br/>}<br/>HubResponse {<br/>  result: CapabilityResult,<br/>  metadata: ResponseMetadata {request_id, model_id, provider_id, usage, cost_usd, latency_ms}<br/>}<br/>---<br/>Budget: constraints.max_tokens + constraints.timeout_ms per stage (PLAN-11)<br/>Routing: Planner -> LLMGatewayAdapter -> LLM_REQUEST_BUS -> Model Hub RequestRouter<br/>3 LLM stages + 2 HIL prompt calls route here<br/>See: k1/model_hub/model_hub.mmd IModelHubPort"]:::port

  PORT_FABRIC_RETRIEVAL["IFabricRetrievalPort<br/>discover_capabilities(query) -> RetrievalResult[]<br/>find_relevant_prompts(query) -> RetrievalResult[]<br/>Read-only Fabric Retrieval API access"]:::port

  PORT_STATE_READ["IStateReadPort<br/>read_sections(sections[]) -> StateSnapshot<br/>Multi-reader, lock-free (PLAN-01)<br/>Sections: beliefs, persona, control, temporal"]:::port

  PORT_BRIDGE["IBridgePort<br/>recall(query, selectors[]) -> RecallResponse<br/>persist_plan(CommittedPlan) -> void<br/>K0 read path + WAL write path"]:::port

  PORT_DELTA["IDeltaEmitPort<br/>emit(delta) -> void (fire-and-forget)<br/>All planning deltas: k1.planner.delta.v1<br/>NEVER writes SessionState directly"]:::port

  PORT_EVENT["IEventPort<br/>publish(topic, payload) -> void<br/>subscribe(topic, handler) -> Subscription<br/>Pub: plan.ready, plan.failed, plan.cancelled<br/>Sub: plan.request, plan.cancel,<br/>     k1.hil.clarification_response.v1,<br/>     k1.hil.approval_response.v1"]:::port
end

%% =====================================================================================
%% ADAPTERS (Production + Test -- Port Implementations)
%% =====================================================================================

subgraph ADAPTERS_PROD["Production Adapters (7)"]
  direction TB

  ADAPT_MAILBOX["MailboxAdapter<br/>WFQ mailbox with priority queue<br/>Dequeue: FIFO within priority band<br/>MicroReplanRequest: elevated priority"]:::adapter

  ADAPT_LLM["LLMGatewayAdapter (Routes to Model Hub)<br/>Wraps IModelHubPort.execute(HubRequest) -> HubResponse<br/>Routing: LLM Request Bus (async request-reply)<br/>consumer_id: 'planner' (for cost tracking + audit MH-11)<br/>Budget enforcement: Model Hub handles (MH-04)<br/>Inherits CB_MODEL protection per provider manifest (MH-05)<br/>---<br/>V1: TestLLMAdapter (deterministic, per-stage canned responses)<br/>V2: LLMGatewayAdapter -> LLM_REQUEST_BUS -> Model Hub<br/>See: k1/model_hub/model_hub.mmd"]:::adapter

  ADAPT_FABRIC_RET["FabricRetrievalAdapter<br/>In-process call to FabricRetrieval API (NOT HTTP)<br/>Wraps Fabric.discover_capabilities() + find_relevant_prompts()<br/>Same Python runtime, direct method call<br/>Timeout: 50ms per call, retry: 1<br/>Returns RetrievalResult[] (Top-K)"]:::adapter

  ADAPT_STATE["SessionStateReadAdapter<br/>Multi-reader lock-free access<br/>Reads HOT sections only<br/>No write capability (PLAN-01 enforced at compile time)"]:::adapter

  ADAPT_BRIDGE["BridgeAdapter<br/>K0 Bridge client<br/>recall() for reads, persist_plan() for WAL writes<br/>Fire-and-forget on persist"]:::adapter

  ADAPT_DELTA["DeltaBusAdapter<br/>Publish-only to DeltaBus<br/>k1.planner.delta.v1 topic<br/>Fire-and-forget, log on failure"]:::adapter

  ADAPT_EVENT["EventBusAdapter<br/>Pub/sub on K1 Event Bus<br/>Publish: plan.ready, plan.failed, plan.cancelled<br/>Subscribe: plan.request, plan.cancel"]:::adapter
end

