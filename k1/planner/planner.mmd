  SVC_EXPAND["ExpandService<br/>Stage 2: Tool mapping and parameterization<br/>Calls: discover_capabilities (refined), find_relevant_prompts<br/>Assigns token_budget, output_schema, tools_granted per step<br/>~50 tests"]:::service

  SVC_VALIDATE["ValidateService<br/>Stage 3: Deterministic checks + LLM arbiter<br/>DAG cycle detection, capability existence check<br/>Triggers HIL approval. Verdict: approved|revise|reject<br/>~45 tests"]:::service

  SVC_COMMIT["CommitService<br/>Stage 4: Deterministic commit (PLAN-03)<br/>Builds CommittedPlan, assigns plan_id<br/>Persists K0 WAL, emits plan.ready. NO ILLMPort dep.<br/>~30 tests"]:::service

  SVC_TOOL_ROUTER["ToolCallRouter<br/>Routes 4 discovery tools to correct backends<br/>Fabric Retrieval, SessionState, Bridge<br/>Enforces PLAN-05 (max 6 calls/plan)<br/>~35 tests"]:::service

  SVC_HIL["HILCoordinator<br/>Manages clarification and approval flows<br/>LLM prompt generation for HIL messages<br/>Round counting (PLAN-10: max 2), timeout handling<br/>Subscribes to k1.hil.clarification_response.v1<br/>Subscribes to k1.hil.approval_response.v1<br/>Correlates responses via request_id<br/>~35 tests"]:::service
end

%% =====================================================================================
%% LIFECYCLE (6 Phases)
%% =====================================================================================

subgraph LIFECYCLE["Lifecycle (6 Phases)"]
  direction TB

  LC_INIT["INIT<br/>Create services, wire 7 ports<br/>Subscribe k1.planner.plan.request event<br/>Set state: IDLE"]:::lifecycle

  LC_PLAN_START["PLAN_START<br/>Dequeue PlanRequest from mailbox<br/>Acquire plan lock (single plan V1)<br/>Emit PlanAck{status: accepted}<br/>Set state: SKETCHING"]:::lifecycle

  LC_STAGE_TRANSITION["STAGE_TRANSITION<br/>Advance pipeline state machine<br/>Log stage completion + token usage<br/>Emit k1.planner.delta.v1 per stage"]:::lifecycle

  LC_PLAN_END["PLAN_END<br/>Emit CommittedPlan via k1.planner.plan.ready.v1<br/>Release plan lock, set state: IDLE<br/>Clear stage buffers"]:::lifecycle

  LC_SHUTDOWN["SHUTDOWN<br/>Drain mailbox queue<br/>Flush pending deltas<br/>Cancel in-flight LLM calls<br/>Persist partial plan state for recovery"]:::lifecycle

  LC_CRASH_RECOVERY["CRASH_RECOVERY<br/>Check WAL for in-flight plan<br/>If found: resume at last completed stage<br/>If not: discard partial state, set IDLE<br/>Emit recovery delta"]:::lifecycle
end

%% =====================================================================================
%% CONCURRENCY MODEL
%% =====================================================================================

subgraph CONCURRENCY["Concurrency Model (V1: Single Plan)"]
  direction TB

  CONC_MODEL["V1: Single-Threaded Async<br/>One plan at a time<br/>Plan lock prevents concurrent planning<br/>Mailbox queues additional requests<br/>---<br/>V2: Multi-plan concurrent pipeline<br/>with per-plan state isolation"]:::concurrency

  CONC_CANCEL["Cancellation Support<br/>cancel_plan(request_id)<br/>Interrupts at next await boundary<br/>Sets state: CANCELLED<br/>Emits k1.planner.plan.cancelled.v1"]:::concurrency

  CONC_MICRO["Micro-Replan Priority<br/>MicroReplanRequest: elevated priority in mailbox<br/>V1: Waits for current plan to complete<br/>V2: May preempt SKETCH stage"]:::concurrency
end

%% =====================================================================================
%% EXTERNAL TOUCHPOINTS
%% =====================================================================================

subgraph TOUCHPOINTS["External Touchpoints"]
  direction TB

  subgraph TP_ORCHESTRATOR["Orchestrator (Primary Caller)"]
    direction TB

    ORCH_SENDS["Orchestrator -> Planner Mailbox<br/>PlanRequest{intent, constraints, context}<br/>MicroReplanRequest{remaining_steps, failure_context}"]:::caller

    ORCH_RECEIVES["Planner -> Orchestrator<br/>PlanAck (sync via mailbox ack)<br/>CommittedPlan (async via k1.planner.plan.ready.v1)<br/>plan.failed.v1 | plan.cancelled.v1 (async events)"]:::caller
  end

  subgraph TP_FABRIC_RET["Fabric Retrieval (Read-Only Access)"]
    direction TB

    FABRIC_RET["Fabric Retrieval API<br/>discover_capabilities() -> Top-K RetrievalResult[]<br/>find_relevant_prompts() -> Top-K RetrievalResult[]<br/>Latency: <50ms per call, 3-6 calls per plan"]:::fabric
  end

  subgraph TP_SESSIONSTATE["SessionState (Multi-Reader)"]
    direction TB

    SS_READ["SessionState (HOT tier only)<br/>query_planning_context() -> StateSnapshot<br/>Sections: beliefs_active, persona, control, temporal<br/>Lock-free, multi-reader (PLAN-01)"]:::ss
  end

  subgraph TP_BRIDGE["Cross-Kernel Bridge (2 Paths)"]
    direction TB

    BRIDGE_READ["IKernelQueryPort<br/>recall_for_planning() -> RecallResponse<br/>K0 long-term memory access"]:::bridge

    BRIDGE_WRITE["IKernelCommandPort<br/>persist_plan(CommittedPlan) -> void<br/>Fire-and-forget to K0 WAL"]:::bridge
  end

  subgraph TP_LLM["LLM Gateway (Model Hub -- Standalone Module)"]
    direction TB

    LLM_GW["Model Hub (Capability-Driven Plugin Architecture)<br/>Interface: IModelHubPort.execute(HubRequest) -> HubResponse<br/>Transport: LLM_REQUEST_BUS (async request-reply)<br/>consumer_id: 'planner' for cost tracking (MH-11)<br/>---<br/>Planner uses 3 capabilities:<br/>  CHAT (Stages 1-3 + HIL prompts)<br/>  TOOL_CALL (Stages 1-2 tool routing -- V2)<br/>  STRUCTURED (Stage 3 arbiter verdict)<br/>Total: ~3.5K tokens per plan<br/>Budget: RequestConstraints.max_tokens + timeout_ms (PLAN-11)<br/>Model selection: Model Hub handles (Planner does NOT pick model)<br/>See: k1/model_hub/model_hub.mmd"]:::gateway
  end

  subgraph TP_BUSES["Event Bus + Delta Bus"]
    direction TB

    EVT_BUS["K1 Event Bus<br/>Pub: k1.planner.plan.ready.v1, plan.failed.v1, plan.cancelled.v1<br/>Sub: k1.planner.plan.request.v1, plan.cancel.v1<br/>Consumers: Orchestrator (plan.ready),<br/>Learning Loop (plan.failed, plan.cancelled -> drift detection)<br/>See: k1/learning/learning.mmd"]:::bus

    DLT_BUS["Delta Bus<br/>Pub: k1.planner.delta.v1<br/>(planning stage deltas, NOT SessionState writes)"]:::bus
  end

  subgraph TP_CONCIERGE_HIL["Concierge (HIL Routing)"]
    direction TB

    HIL_ROUTE["Concierge OUTPUT_CHANNEL<br/>k1.hil.clarification.v1 -> User prompt<br/>k1.hil.approval_request.v1 -> User prompt<br/>User responses route back via Event Bus"]:::output
  end

  subgraph TP_CIRCUIT_BREAKERS["Circuit Breakers (Resilience)"]
    direction TB

    CB_PLANNER["CB: Planner<br/>45s timeout, 2/min threshold<br/>Fallback: skip planning, direct execution<br/>Owner: Concierge FabricOrchestratorAdapter"]:::circuit_breaker

    CB_LLM_INHERIT["CB: Model Hub (inherited, per provider manifest)<br/>Config from manifest: default 3/60s -> OPEN 30s<br/>Fallback: capability-aware, stage fails -> degrade or skip<br/>Owner: LLMGatewayAdapter<br/>See: k1/model_hub/model_hub.mmd"]:::circuit_breaker
  end
end

%% =====================================================================================
%% ERROR RECOVERY PATHS
%% =====================================================================================

subgraph ERROR_RECOVERY["Error Recovery (Stage Failure Handling)"]
  direction TB

  ERR_SKETCH_FAIL["Stage 1 SKETCH Failure<br/>LLM timeout or error<br/>Recovery: retry once with simplified prompt<br/>If still fails: emit plan.failed"]:::recovery

  ERR_EXPAND_FAIL["Stage 2 EXPAND Failure<br/>LLM timeout or tool call failure<br/>Recovery: retry once, fallback to SKETCH output as-is<br/>Degraded: less precise tool mapping"]:::recovery

  ERR_VALIDATE_FAIL["Stage 3 VALIDATE Failure<br/>LLM arbiter timeout or reject verdict<br/>Recovery: if reject, retry EXPAND once<br/>If arbiter down: auto-approve if deterministic checks pass"]:::recovery

  ERR_COMMIT_FAIL["Stage 4 COMMIT Failure<br/>WAL persist failure<br/>Recovery: retry persist, emit plan.ready anyway<br/>(plan valid even if WAL fails -- idempotent)"]:::recovery

  ERR_HIL_TIMEOUT["HIL Timeout<br/>Clarification: proceed with best-effort interpretation<br/>Approval: auto-approve if safe (no high-impact ops)"]:::recovery

  ERR_CB_OPEN["CB_PLANNER OPEN<br/>Concierge-owned: skip planning entirely<br/>Orchestrator: execute MED-tier path (direct Fabric)<br/>No Planner involvement"]:::recovery
end

