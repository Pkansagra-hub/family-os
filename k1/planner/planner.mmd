%% =====================================================================================
%% INVARIANTS (PLAN-01 through PLAN-12)
%% =====================================================================================

subgraph INVARIANTS["Invariants (PLAN-01..PLAN-12)"]
  direction TB

  subgraph INV_OWNERSHIP["Ownership and Access Control"]
    direction TB

    INV_01["PLAN-01: NEVER writes SessionState<br/>All reads are lock-free multi-reader<br/>Enforced by: IStateReadPort (no write methods)"]:::invariant

    INV_02["PLAN-02: ALL 4 tools are read-only<br/>Zero side effects on any tool call<br/>Enforced by: ToolCallRouter (no action tools)"]:::invariant

    INV_06["PLAN-06: NEVER executes capabilities<br/>Discovery only -- no invoke_capability()<br/>Enforced by: IFabricRetrievalPort (retrieval-only)"]:::invariant
  end

  subgraph INV_DETERMINISM["Determinism and Safety"]
    direction TB

    INV_03["PLAN-03: Stage 4 COMMIT is deterministic<br/>Zero LLM calls in COMMIT<br/>Enforced by: CommitService (no ILLMPort dependency)"]:::invariant

    INV_09["PLAN-09: Plan deps MUST form DAG<br/>No cycles -- validated in Stage 3<br/>Enforced by: ValidateService DAG cycle detection"]:::invariant

    INV_08["PLAN-08: Each step references valid capability<br/>From Fabric Registry (live validation)<br/>Enforced by: ValidateService capability check"]:::invariant
  end

  subgraph INV_RATE["Rate Limits and Bounds"]
    direction TB

    INV_04["PLAN-04: Max planning time 45s<br/>CB_PLANNER timeout (owned by Concierge)<br/>Enforced by: Concierge FabricOrchestratorAdapter"]:::invariant

    INV_05["PLAN-05: Max 6 discovery tool calls per plan<br/>3 in SKETCH + 3 in EXPAND<br/>Enforced by: ToolCallRouter counter"]:::invariant

    INV_10["PLAN-10: HIL clarification max 2 rounds<br/>Then proceed with best-effort plan<br/>Enforced by: HILCoordinator round counter"]:::invariant
  end

  subgraph INV_TOKEN["Token Management"]
    direction TB

    INV_07["PLAN-07: V1 DEFERRED<br/>token_budget_max + per-step token_budget<br/>removed from types.py (no upstream data)<br/>V2: Planner will populate from Fabric cost estimates<br/>Enforced by: CommitService (V2)"]:::invariant

    INV_11["PLAN-11: All LLM calls carry budget<br/>{max_tokens, timeout_ms} -- no unbounded calls<br/>Enforced by: PipelineController budget injection"]:::invariant
  end

  subgraph INV_MICRO["Micro-Replan Safety"]
    direction TB

    INV_12["PLAN-12: Micro-replan adjusts remaining only<br/>Completed steps are FROZEN<br/>Enforced by: MicroReplanService step filter"]:::invariant
  end
end

