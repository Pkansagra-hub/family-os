  %% ======================================================================================

  SVC_FILTER -.->|"MW-07"| INV_OPS
  SVC_GATE -.->|"MW-07"| INV_OPS
  SVC_EXTRACT -.->|"MW-04,05,06"| INV_CONTENT
  SVC_ENVELOPE -.->|"MW-10"| INV_OPS
