{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://familyos.ai/schemas/k1/kernel.schema.json",
  "title": "K1 Kernel Configuration Schema",
  "description": "Configuration schema for K1 Intelligence Module kernel settings (ADR-0080)",
  "type": "object",
  "required": ["version", "kernel", "runtime"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "K1 configuration version (semantic versioning)"
    },
    "kernel": {
      "type": "object",
      "required": ["name", "session_timeout_ms", "max_agents_per_session"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "K1 kernel instance name"
        },
        "session_timeout_ms": {
          "type": "integer",
          "minimum": 60000,
          "maximum": 3600000,
          "default": 300000,
          "description": "Session timeout in milliseconds (1-60 minutes)"
        },
        "max_agents_per_session": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "default": 3,
          "description": "Maximum concurrent agents per session"
        },
        "supervisor_check_interval_ms": {
          "type": "integer",
          "minimum": 100,
          "maximum": 5000,
          "default": 1000,
          "description": "Agent supervisor health check interval"
        }
      }
    },
    "runtime": {
      "type": "object",
      "required": ["worker_threads", "max_memory_mb"],
      "properties": {
        "worker_threads": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32,
          "default": 4,
          "description": "Number of worker threads for K1 runtime"
        },
        "max_memory_mb": {
          "type": "integer",
          "minimum": 128,
          "maximum": 8192,
          "default": 512,
          "description": "Maximum memory allocation (MB)"
        },
        "enable_hot_reload": {
          "type": "boolean",
          "default": true,
          "description": "Enable config hot-reload (ADR-0080)"
        }
      }
    },
    "k0_bridge": {
      "type": "object",
      "properties": {
        "connection_pool_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20,
          "default": 5,
          "description": "K0 HTTP/2 connection pool size"
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 10,
          "maximum": 5000,
          "default": 100,
          "description": "K0 write timeout (ms)"
        }
      }
    }
  }
}
