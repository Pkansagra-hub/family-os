{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://familyos.ai/schemas/k1/logging.schema.json",
  "title": "K1 Logging Configuration Schema",
  "description": "Configuration schema for K1 structured logging (ADR-0029c)",
  "type": "object",
  "required": ["version", "logging"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "logging": {
      "type": "object",
      "required": ["level", "format"],
      "properties": {
        "level": {
          "type": "string",
          "enum": ["DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL"],
          "default": "INFO",
          "description": "Global log level"
        },
        "format": {
          "type": "string",
          "enum": ["json", "text"],
          "default": "json",
          "description": "Log output format (structured JSON vs text)"
        },
        "output": {
          "type": "object",
          "properties": {
            "console": {
              "type": "boolean",
              "default": true,
              "description": "Enable console logging"
            },
            "file": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": false
                },
                "path": {
                  "type": "string",
                  "default": "/var/log/k1/k1.log"
                },
                "max_size_mb": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1024,
                  "default": 100
                },
                "rotation_count": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 30,
                  "default": 5
                }
              }
            }
          }
        },
        "trace_context": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true,
              "description": "Include trace_id in all logs"
            },
            "baggage_keys": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": ["cognitive_trace_id", "session_id"],
              "description": "OpenTelemetry baggage keys to include in logs"
            }
          }
        }
      }
    }
  }
}
