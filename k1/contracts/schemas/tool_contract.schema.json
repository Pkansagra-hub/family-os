{
  "$id": "tool_contract.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Tool Contract Schema",
  "description": "JSON Schema for validating tool capability contracts. Every MCP, WASM, and Bridge tool MUST declare a contract in this format.",
  "type": "object",
  "required": ["tool_contract"],
  "additionalProperties": false,
  "properties": {
    "tool_contract": {
      "type": "object",
      "required": [
        "name",
        "version",
        "domain",
        "description",
        "required_inputs",
        "output",
        "provider_type",
        "provider_id",
        "safety_band_min",
        "availability"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^tool\\.(execute|read|write|delete)\\.[a-z][a-z0-9_]+$",
          "description": "Canonical capability name. Must follow type convention: tool.<verb>.<name>"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "description": "Semantic version (major.minor.patch)"
        },
        "domain": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true,
          "description": "Domain tags for retrieval ranking (e.g. FOOD, HEALTH, SOCIAL)"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "description": "Human-readable description used for semantic retrieval embedding"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "What this tool CAN do (list of verbs)"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "What this tool CANNOT do (explicit boundaries)"
        },
        "required_inputs": {
          "type": "array",
          "items": { "$ref": "#/definitions/input_spec" },
          "description": "Inputs the tool requires to perform"
        },
        "optional_inputs": {
          "type": "array",
          "items": { "$ref": "#/definitions/input_spec_optional" },
          "description": "Inputs the tool can optionally accept"
        },
        "required_context": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "SessionState sections the tool needs (e.g. beliefs_active.entities)"
        },
        "optional_context": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "SessionState sections the tool can optionally use"
        },
        "output": {
          "type": "object",
          "description": "JSON Schema describing the tool's output format",
          "required": ["type"],
          "properties": {
            "type": {
              "type": "string",
              "enum": ["object", "array", "string", "number", "boolean"]
            },
            "properties": {
              "type": "object"
            },
            "items": {
              "type": "object"
            },
            "required": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "provider_type": {
          "type": "string",
          "enum": ["MCP", "WASM", "BRIDGE", "LOCAL_STUB"],
          "description": "Tool provider type. LOCAL_STUB = in-process deterministic stub used for storyline / demo capabilities (M12.E3)."
        },
        "provider_id": {
          "type": "string",
          "minLength": 1,
          "description": "Identifies the MCP server, WASM module, or Bridge operation"
        },
        "provider_endpoint": {
          "type": "string",
          "description": "Connection string (e.g. mcp://local/opentable, wasm://sandbox/calc)"
        },
        "prompt_template": {
          "type": ["string", "null"],
          "description": "Optional PromptContract name to compile for this tool when no request-level prompt_template is supplied."
        },
        "activity_profile": {
          "type": ["string", "null"],
          "description": "Optional activity profile id used to select concise operating guidance for this capability."
        },
        "tool_instructions": {
          "type": ["string", "null"],
          "description": "Optional inline tool-specific operating guidance. Schemas, policy, and HIL remain authoritative."
        },
        "prompt_variables_schema": {
          "type": ["object", "null"],
          "description": "Optional JSON-schema fragment describing variables expected by prompt_template."
        },
        "context_precision": {
          "oneOf": [
            { "$ref": "#/definitions/context_precision" },
            { "type": "null" }
          ],
          "description": "Optional temporal/spatial precision policy requested by this tool."
        },
        "lease": {
          "oneOf": [
            { "$ref": "#/definitions/lease_policy" },
            { "type": "null" }
          ],
          "description": "Optional grounding lease policy for tools that create or spawn agent work."
        },
        "safety_band_min": {
          "type": "string",
          "enum": ["GREEN", "AMBER", "RED", "CRISIS"],
          "description": "Minimum safety band required to invoke this tool (GREEN < AMBER < RED < CRISIS)"
        },
        "cost_per_call": {
          "type": "number",
          "minimum": 0,
          "description": "Estimated cost in USD per invocation"
        },
        "avg_latency_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "Average execution time in milliseconds"
        },
        "max_latency_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "Maximum expected latency in milliseconds (circuit breaker hint)"
        },
        "availability": {
          "type": "string",
          "enum": ["ONLINE", "DEGRADED", "OFFLINE"],
          "description": "Current availability status"
        },
        "registered_at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of initial registration"
        },
        "last_updated": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of last contract update"
        },
        "success_rate_30d": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Rolling 30-day success rate (0.0 to 1.0)"
        },
        "total_invocations_30d": {
          "type": "integer",
          "minimum": 0,
          "description": "Rolling 30-day invocation count"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Free-form tags for categorization and filtering (e.g. meta, write_operation)"
        },
        "requires_human_confirmation": {
          "type": ["boolean", "null"],
          "description": "Explicit override for HIL gating. true -> always ask user; false -> never ask (overrides safety_band inference, except RED still asks). Omit / null -> infer from safety_band_min and side_effects."
        },
        "side_effects": {
          "type": "array",
          "description": "Structured declaration of side effects this capability produces. Used by HIL service to render approval prompts and by audit log. Empty/omitted -> no side effects.",
          "items": {
            "type": "object",
            "required": ["kind", "target"],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "data_write", "data_delete", "data_modify",
                  "external_api_call", "payment", "physical_actuation",
                  "notification_send", "irreversible_op", "third_party_share"
                ],
                "description": "Category of side effect"
              },
              "target": {
                "type": "string",
                "description": "What the side effect targets (e.g. 'calendar.event', 'payment.card.ending_4242', 'door.front')"
              },
              "reversible": {
                "type": "boolean",
                "default": false,
                "description": "Whether this side effect can be undone after execution"
              },
              "cost_estimate": {
                "type": "object",
                "properties": {
                  "currency": {"type": "string"},
                  "amount": {"type": "number", "minimum": 0}
                }
              },
              "description": {"type": "string"}
            }
          }
        },
        "risk_class": {
          "type": "string",
          "enum": ["low", "medium", "high", "safety_sensitive"],
          "description": "M9.E1 / M12.E2 — declared risk class consumed by IRiskCatalogPort. Drives risk x freshness matrix in the policy gate. Reads = low; writes = medium; safety/medical/payments = high or safety_sensitive."
        },
        "social_act": {
          "type": ["string", "null"],
          "description": "M9.E1 — constitution-level social act this capability manifests (e.g. 'send_message', 'set_medication'). null = infrastructure-only (no conscience binding)."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "requires_human_confirmation": {"const": false},
              "side_effects": {"type": "array", "minItems": 1}
            },
            "required": ["requires_human_confirmation", "side_effects"]
          },
          "then": {
            "properties": {
              "safety_band_min": {"not": {"const": "GREEN"}}
            }
          }
        }
      ]
    }
  },
  "definitions": {
    "input_spec": {
      "type": "object",
      "required": ["name", "type", "description"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Parameter name"
        },
        "type": {
          "type": "string",
          "description": "Data type: STRING, NUMBER, BOOLEAN, DATE, OBJECT, or ARRAY[T]"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable description of the input"
        },
        "enum": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Allowed values (optional constraint)"
        }
      }
    },
    "input_spec_optional": {
      "type": "object",
      "required": ["name", "type", "description"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Parameter name"
        },
        "type": {
          "type": "string",
          "description": "Data type: STRING, NUMBER, BOOLEAN, DATE, OBJECT, or ARRAY[T]"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable description of the input"
        },
        "enum": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Allowed values (optional constraint)"
        },
        "default": {
          "description": "Default value if not provided"
        }
      }
    },
    "context_precision": {
      "type": "object",
      "required": ["temporal", "spatial"],
      "additionalProperties": false,
      "properties": {
        "temporal": {
          "type": "string",
          "enum": ["anchor", "windows", "execution"]
        },
        "spatial": {
          "type": "string",
          "enum": ["hidden", "semantic", "approximate", "place_id", "raw"]
        }
      }
    },
    "lease_policy": {
      "type": "object",
      "required": ["ttl_seconds", "allow_refresh"],
      "additionalProperties": false,
      "properties": {
        "ttl_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "allow_refresh": {
          "type": "boolean"
        }
      }
    }
  }
}
