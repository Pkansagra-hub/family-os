{
  "$id": "tool_contract.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Tool Contract Schema",
  "description": "JSON Schema for validating tool capability contracts. Every MCP, WASM, and Bridge tool MUST declare a contract in this format.",
  "type": "object",
  "required": ["tool_contract"],
  "additionalProperties": false,
  "properties": {
    "tool_contract": {
      "type": "object",
      "required": [
        "name",
        "version",
        "domain",
        "description",
        "required_inputs",
        "output",
        "provider_type",
        "provider_id",
        "safety_band_min",
        "availability"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^tool\\.(execute|read|write|delete)\\.[a-z][a-z0-9_]+$",
          "description": "Canonical capability name. Must follow type convention: tool.<verb>.<name>"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "description": "Semantic version (major.minor.patch)"
        },
        "domain": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true,
          "description": "Domain tags for retrieval ranking (e.g. FOOD, HEALTH, SOCIAL)"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "description": "Human-readable description used for semantic retrieval embedding"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "What this tool CAN do (list of verbs)"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "What this tool CANNOT do (explicit boundaries)"
        },
        "required_inputs": {
          "type": "array",
          "items": { "$ref": "#/definitions/input_spec" },
          "description": "Inputs the tool requires to perform"
        },
        "optional_inputs": {
          "type": "array",
          "items": { "$ref": "#/definitions/input_spec_optional" },
          "description": "Inputs the tool can optionally accept"
        },
        "required_context": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "SessionState sections the tool needs (e.g. beliefs_active.entities)"
        },
        "optional_context": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "SessionState sections the tool can optionally use"
        },
        "output": {
          "type": "object",
          "description": "JSON Schema describing the tool's output format",
          "required": ["type"],
          "properties": {
            "type": {
              "type": "string",
              "enum": ["object", "array", "string", "number", "boolean"]
            },
            "properties": {
              "type": "object"
            },
            "items": {
              "type": "object"
            },
            "required": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "provider_type": {
          "type": "string",
          "enum": ["MCP", "WASM", "BRIDGE"],
          "description": "Tool provider type. Agents and Workflows have their own contract types."
        },
        "provider_id": {
          "type": "string",
          "minLength": 1,
          "description": "Identifies the MCP server, WASM module, or Bridge operation"
        },
        "provider_endpoint": {
          "type": "string",
          "description": "Connection string (e.g. mcp://local/opentable, wasm://sandbox/calc)"
        },
        "safety_band_min": {
          "type": "string",
          "enum": ["GREEN", "AMBER", "RED", "CRISIS"],
          "description": "Minimum safety band required to invoke this tool (GREEN < AMBER < RED < CRISIS)"
        },
        "cost_per_call": {
          "type": "number",
          "minimum": 0,
          "description": "Estimated cost in USD per invocation"
        },
        "avg_latency_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "Average execution time in milliseconds"
        },
        "max_latency_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "Maximum expected latency in milliseconds (circuit breaker hint)"
        },
        "availability": {
          "type": "string",
          "enum": ["ONLINE", "DEGRADED", "OFFLINE"],
          "description": "Current availability status"
        },
        "registered_at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of initial registration"
        },
        "last_updated": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of last contract update"
        },
        "success_rate_30d": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Rolling 30-day success rate (0.0 to 1.0)"
        },
        "total_invocations_30d": {
          "type": "integer",
          "minimum": 0,
          "description": "Rolling 30-day invocation count"
        }
      }
    }
  },
  "definitions": {
    "input_spec": {
      "type": "object",
      "required": ["name", "type", "description"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Parameter name"
        },
        "type": {
          "type": "string",
          "description": "Data type: STRING, NUMBER, BOOLEAN, DATE, OBJECT, or ARRAY[T]"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable description of the input"
        },
        "enum": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Allowed values (optional constraint)"
        }
      }
    },
    "input_spec_optional": {
      "type": "object",
      "required": ["name", "type", "description"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Parameter name"
        },
        "type": {
          "type": "string",
          "description": "Data type: STRING, NUMBER, BOOLEAN, DATE, OBJECT, or ARRAY[T]"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable description of the input"
        },
        "enum": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Allowed values (optional constraint)"
        },
        "default": {
          "description": "Default value if not provided"
        }
      }
    }
  }
}
