{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://familyos.ai/schemas/k1/metrics.schema.json",
  "title": "K1 Metrics Configuration Schema",
  "description": "Configuration schema for K1 Prometheus metrics (ADR-0029, ADR-0029c)",
  "type": "object",
  "required": ["version", "metrics"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "metrics": {
      "type": "object",
      "required": ["enabled", "exporter"],
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable metrics collection"
        },
        "exporter": {
          "type": "object",
          "required": ["host", "port"],
          "properties": {
            "host": {
              "type": "string",
              "default": "0.0.0.0",
              "description": "Metrics exporter bind address"
            },
            "port": {
              "type": "integer",
              "minimum": 1024,
              "maximum": 65535,
              "default": 9090,
              "description": "Metrics exporter HTTP port"
            },
            "path": {
              "type": "string",
              "default": "/metrics",
              "description": "Metrics endpoint path"
            }
          }
        },
        "namespace": {
          "type": "string",
          "pattern": "^[a-z_]+$",
          "default": "k1_intelligence",
          "description": "Prometheus namespace for K1 metrics"
        },
        "histograms": {
          "type": "object",
          "properties": {
            "latency_buckets_ms": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0
              },
              "default": [1, 5, 10, 25, 50, 100, 250, 500, 1000, 2500, 5000, 10000],
              "description": "Histogram buckets for latency metrics (ms)"
            },
            "size_buckets_bytes": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              },
              "default": [100, 500, 1000, 5000, 10000, 50000, 100000, 500000, 1000000],
              "description": "Histogram buckets for size metrics (bytes)"
            }
          }
        },
        "sampling": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true,
              "description": "Enable intelligent trace sampling (ADR-0030)"
            },
            "default_rate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "default": 0.1,
              "description": "Default sampling rate (10%)"
            },
            "high_latency_threshold_ms": {
              "type": "integer",
              "minimum": 100,
              "default": 2000,
              "description": "Latency threshold for 100% sampling"
            }
          }
        }
      }
    }
  }
}
