{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://familyos.ai/schemas/k1/circuit_breaker.schema.json",
  "title": "K1 Circuit Breaker Configuration Schema",
  "description": "Configuration schema for K1 circuit breakers per service (ADR-0009b)",
  "type": "object",
  "required": ["version", "circuit_breakers"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "circuit_breakers": {
      "type": "object",
      "patternProperties": {
        "^[a-z][a-z0-9_]*$": {
          "type": "object",
          "required": ["failure_threshold", "timeout_duration_ms", "success_threshold", "slow_call_threshold_ms", "time_window_ms", "fallback_strategy", "enabled"],
          "properties": {
            "failure_threshold": {
              "type": "integer",
              "minimum": 2,
              "maximum": 20,
              "description": "Number of failures before opening circuit"
            },
            "timeout_duration_ms": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 300000,
              "description": "Circuit OPEN duration before HALF_OPEN (1s-5min)"
            },
            "success_threshold": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10,
              "description": "Consecutive successes to close circuit"
            },
            "slow_call_threshold_ms": {
              "type": "integer",
              "minimum": 100,
              "maximum": 60000,
              "description": "Calls slower than this treated as failures"
            },
            "time_window_ms": {
              "type": "integer",
              "minimum": 10000,
              "maximum": 600000,
              "description": "Sliding window for failure counting (10s-10min)"
            },
            "fallback_strategy": {
              "type": "string",
              "enum": ["default_value", "cached_result", "alternate_model", "raise_error"],
              "description": "Fallback strategy when circuit open"
            },
            "enabled": {
              "type": "boolean",
              "default": true,
              "description": "Enable circuit breaker for this service"
            },
            "alternate_service": {
              "type": "string",
              "description": "Alternate service name for fallback (if strategy=alternate_model)"
            },
            "cache_ttl_ms": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 3600000,
              "description": "Cache TTL for cached_result strategy (1s-1hr)"
            }
          }
        }
      },
      "additionalProperties": false
    },
    "global": {
      "type": "object",
      "properties": {
        "metrics_enabled": {
          "type": "boolean",
          "default": true
        },
        "logging_enabled": {
          "type": "boolean",
          "default": true
        },
        "alert_on_open": {
          "type": "boolean",
          "default": true
        },
        "max_circuits": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 100
        },
        "cleanup_interval_ms": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 600000,
          "default": 60000
        }
      }
    }
  }
}
