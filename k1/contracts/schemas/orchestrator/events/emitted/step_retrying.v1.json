{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "k1://schemas/orchestrator/events/emitted/step_retrying.v1.json",
  "title": "step.retrying.v1",
  "description": "Emitted when a DAG step is about to be retried after a transient failure.",
  "type": "object",
  "required": ["event_id", "topic", "timestamp", "trace_id", "payload"],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier for this event instance."
    },
    "topic": {
      "type": "string",
      "const": "k1.orchestration.step.retrying.v1"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "trace_id": {
      "type": "string",
      "format": "uuid",
      "description": "ORCH-09: cognitive trace ID propagated on all events."
    },
    "source": {
      "type": "string",
      "const": "orchestrator"
    },
    "version": {
      "type": "string",
      "const": "v1"
    },
    "payload": {
      "type": "object",
      "required": ["dag_id", "step_id", "attempt", "reason"],
      "properties": {
        "dag_id": {
          "type": "string",
          "format": "uuid",
          "description": "Parent DAG execution identifier."
        },
        "step_id": {
          "type": "string",
          "description": "Unique step identifier within the DAG."
        },
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "description": "Current retry attempt number (1-based)."
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum retry attempts configured for this step."
        },
        "reason": {
          "type": "string",
          "enum": ["TRANSIENT_ERROR", "TIMEOUT"],
          "description": "Retry trigger reason."
        },
        "delay_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "Backoff delay before this retry attempt."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
