{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "k1://schemas/orchestrator/events/emitted/step_failed.v1.json",
  "title": "step.failed.v1",
  "description": "Emitted when a DAG step fails after exhausting retries.",
  "type": "object",
  "required": ["event_id", "topic", "timestamp", "trace_id", "payload"],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier for this event instance."
    },
    "topic": {
      "type": "string",
      "const": "k1.orchestration.step.failed.v1"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "trace_id": {
      "type": "string",
      "format": "uuid",
      "description": "ORCH-09: cognitive trace ID propagated on all events."
    },
    "source": {
      "type": "string",
      "const": "orchestrator"
    },
    "version": {
      "type": "string",
      "const": "v1"
    },
    "payload": {
      "type": "object",
      "required": ["dag_id", "step_id", "capability", "error_code", "error_message"],
      "properties": {
        "dag_id": {
          "type": "string",
          "format": "uuid",
          "description": "Parent DAG execution identifier."
        },
        "step_id": {
          "type": "string",
          "description": "Unique step identifier within the DAG."
        },
        "capability": {
          "type": "string",
          "description": "Capability name that failed."
        },
        "error_code": {
          "type": "string",
          "enum": [
            "TRANSIENT",
            "PERMANENT",
            "CIRCUIT_OPEN",
            "NOT_FOUND",
            "INTERNAL",
            "TIMEOUT",
            "SCHEMA_VIOLATION"
          ],
          "description": "Categorized error code from Fabric CapabilityResult."
        },
        "error_message": {
          "type": "string",
          "description": "Human-readable error description."
        },
        "retry_attempts": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of retry attempts before final failure."
        },
        "has_side_effects": {
          "type": "boolean",
          "description": "True if the step may have produced side effects requiring compensation."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
