{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "k1://schemas/orchestrator/events/emitted/step_cancelled.v1.json",
  "title": "step.cancelled.v1",
  "description": "Emitted when a DAG step is cancelled before completion.",
  "type": "object",
  "required": ["event_id", "topic", "timestamp", "trace_id", "payload"],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier for this event instance."
    },
    "topic": {
      "type": "string",
      "const": "k1.orchestration.step.cancelled.v1"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "trace_id": {
      "type": "string",
      "format": "uuid",
      "description": "ORCH-09: cognitive trace ID propagated on all events."
    },
    "source": {
      "type": "string",
      "const": "orchestrator"
    },
    "version": {
      "type": "string",
      "const": "v1"
    },
    "payload": {
      "type": "object",
      "required": ["dag_id", "step_id", "reason"],
      "properties": {
        "dag_id": {
          "type": "string",
          "format": "uuid",
          "description": "Parent DAG execution identifier."
        },
        "step_id": {
          "type": "string",
          "description": "Unique step identifier within the DAG."
        },
        "reason": {
          "type": "string",
          "enum": ["USER_INTERRUPT", "DAG_ABORT", "WORKFLOW_ABORT", "SHUTDOWN"],
          "description": "Cancellation reason category."
        },
        "wave_index": {
          "type": "integer",
          "minimum": 0,
          "description": "Wave index the step was in when cancelled."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
