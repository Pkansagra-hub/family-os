{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "k1://schemas/orchestrator/events/consumed/hil_fallback_response.v1.json",
  "title": "hil.fallback_response.v1",
  "description": "Consumed from HIL module when a user responds to a fallback HIL request (degradation choice).",
  "type": "object",
  "required": ["event_id", "topic", "timestamp", "trace_id", "payload"],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier for this event instance."
    },
    "topic": {
      "type": "string",
      "const": "k1.hil.fallback_response.v1"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "trace_id": {
      "type": "string",
      "format": "uuid",
      "description": "ORCH-09: cognitive trace ID propagated on all events."
    },
    "source": {
      "type": "string",
      "const": "hil"
    },
    "version": {
      "type": "string",
      "const": "v1"
    },
    "payload": {
      "type": "object",
      "required": ["request_id", "selected_option"],
      "properties": {
        "request_id": {
          "type": "string",
          "format": "uuid",
          "description": "HILRequest.request_id for PendingHILContext correlation."
        },
        "selected_option": {
          "type": "string",
          "description": "User's selected fallback option from the presented choices."
        },
        "context": {
          "type": "object",
          "description": "Additional context provided with the selection."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
