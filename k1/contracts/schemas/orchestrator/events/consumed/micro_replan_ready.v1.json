{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "k1://schemas/orchestrator/events/consumed/micro_replan_ready.v1.json",
  "title": "micro_replan.ready.v1",
  "description": "Consumed from Planner when a micro-replan produces revised steps mid-DAG.",
  "type": "object",
  "required": ["event_id", "topic", "timestamp", "trace_id", "payload"],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier for this event instance."
    },
    "topic": {
      "type": "string",
      "const": "k1.planner.micro_replan.ready.v1"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "trace_id": {
      "type": "string",
      "format": "uuid",
      "description": "ORCH-09: cognitive trace ID propagated on all events."
    },
    "source": {
      "type": "string",
      "const": "planner"
    },
    "version": {
      "type": "string",
      "const": "v1"
    },
    "payload": {
      "type": "object",
      "required": ["replan_request_id", "original_plan_id", "revised_steps"],
      "properties": {
        "replan_request_id": {
          "type": "string",
          "format": "uuid",
          "description": "Echoed from MicroReplanRequest.request_id."
        },
        "original_plan_id": {
          "type": "string",
          "format": "uuid",
          "description": "Original CommittedPlan.plan_id being revised."
        },
        "revised_steps": {
          "type": "array",
          "items": { "type": "object" },
          "minItems": 1,
          "description": "Replacement steps for the remaining DAG portion."
        },
        "revised_dependencies": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "string" }
          },
          "description": "Revised step dependency graph for the replacement steps."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
