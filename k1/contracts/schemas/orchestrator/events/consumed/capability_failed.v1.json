{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "k1://schemas/orchestrator/events/consumed/capability_failed.v1.json",
  "title": "capability.failed.v1",
  "description": "Consumed from Fabric when a capability invocation fails.",
  "type": "object",
  "required": ["event_id", "topic", "timestamp", "trace_id", "payload"],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier for this event instance."
    },
    "topic": {
      "type": "string",
      "const": "k1.capability.failed.v1"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "trace_id": {
      "type": "string",
      "format": "uuid",
      "description": "ORCH-09: cognitive trace ID propagated on all events."
    },
    "source": {
      "type": "string",
      "const": "fabric"
    },
    "version": {
      "type": "string",
      "const": "v1"
    },
    "payload": {
      "type": "object",
      "required": ["request_id", "capability_name", "error_code"],
      "properties": {
        "request_id": {
          "type": "string",
          "format": "uuid",
          "description": "CapabilityRequest.request_id for step correlation."
        },
        "capability_name": {
          "type": "string",
          "description": "Capability that failed."
        },
        "error_code": {
          "type": "string",
          "description": "Error code from the Fabric execution layer."
        },
        "error_message": {
          "type": "string",
          "description": "Human-readable error description."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
