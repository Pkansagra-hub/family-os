{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "k1://contracts/schemas/memory_writer/memory_atom.v2.schema.json",
  "title": "Memory Atom v2.2",
  "description": "Authoritative JSON Schema for MW v2.2 memory atom. Additive over v2.1: K1 correction signal fields (correction_signal, contradiction_signal, supersedes_concept, correction_source, session_context_id) for EVOLVE/CONTRADICT delegation. All v2.1 atoms validate against v2.2 (new fields have defaults). R2 Epic 7.2.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["2.0", "2.1", "2.2"],
      "description": "Schema version. '2.0' for MW v2, '2.1' for multi-temporal links, '2.2' for K1 correction signals."
    },
    "operation": {
      "type": "string",
      "const": "UPSERT",
      "description": "Operation type constant. Always 'UPSERT' for MW v2."
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "description": "Episodic memory text. 1-50 words, past/present tense, self-contained. MW-04 enforced."
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^person_[a-z0-9_]+$"
      },
      "description": "Person IDs of participants. Resolved by PersonResolver. Format: person_*."
    },
    "participant_relationships": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/ParticipantRelationship"
      },
      "description": "Map of person_id to relationship descriptor with type, target, and confidence."
    },
    "location_name": {
      "type": "string",
      "description": "Place name. Stripped in RED privacy band."
    },
    "location_type": {
      "type": "string",
      "enum": [
        "home",
        "restaurant",
        "hospital",
        "school",
        "office",
        "gym",
        "store",
        "park",
        "church",
        "airport",
        "hotel",
        "other"
      ],
      "description": "Location category. Stripped in AMBER/RED privacy band."
    },
    "place_id": {
      "type": ["string", "null"],
      "pattern": "^place_[a-z0-9_]+$",
      "description": "Stable place identity from PlaceResolver. Pattern: place_<slug>. GAP-002 Epic 3.1."
    },
    "location_hierarchy": {
      "type": "array",
      "items": {"type": "string"},
      "default": [],
      "maxItems": 5,
      "description": "Spatial hierarchy from most specific to most general. Example: ['kitchen', 'home', 'Capitol Hill', 'Seattle']. GAP-002 Epic 4.2."
    },
    "transition_from_place": {
      "type": ["string", "null"],
      "description": "Origin place for spatial transition. Raw place name or resolved place_id. GAP-002 Epic 4.3."
    },
    "transition_mode": {
      "type": ["string", "null"],
      "enum": [null, "walked", "drove", "flew", "took_bus", "took_train", "biked", "other"],
      "description": "Mode of movement from transition_from_place to current location. GAP-002 Epic 4.3."
    },
    "activity_type": {
      "type": "string",
      "enum": [
        "MEAL",
        "TASK",
        "TRAVEL",
        "HEALTH",
        "SOCIAL",
        "WORK",
        "EDUCATION",
        "EXERCISE",
        "SHOPPING",
        "ENTERTAINMENT",
        "CELEBRATION",
        "APPOINTMENT",
        "DIARY",
        "FINANCE",
        "RELATIONSHIP",
        "PLANNING",
        "CONCERN",
        "GRATITUDE",
        "META",
        "MEMORY"
      ],
      "description": "Activity classification. 20-value enum merged from K1 12-type + legacy 12-type."
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "maxItems": 3,
      "description": "Topic tags. 1-3 tags per atom."
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Activity categories."
    },
    "sentiment_label": {
      "type": "string",
      "enum": [
        "very_negative",
        "negative",
        "neutral",
        "positive",
        "very_positive"
      ],
      "description": "Sentiment classification from affective_now."
    },
    "emotion_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Emotion labels from 44-class emotion set via affective_now.current_emotion."
    },
    "affect": {
      "$ref": "#/$defs/Affect",
      "description": "Valence-Arousal-Dominance triple from affective_now.dimensions."
    },
    "social_context": {
      "type": "string",
      "enum": [
        "solo",
        "friends",
        "colleagues",
        "nuclear_family",
        "extended_family",
        "community"
      ],
      "description": "Social context derived from participant_relationships."
    },
    "social_intimacy": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH"
      ],
      "description": "Social intimacy level. family=HIGH, friends=MEDIUM, unknown=LOW."
    },
    "entity_salience": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0.0,
        "maximum": 1.0
      },
      "description": "Map of person_id to salience score (0-1). From scoreboard.salience_map."
    },
    "narrative": {
      "$ref": "#/$defs/Narrative",
      "description": "Narrative thread context from narrative_active."
    },
    "temporal": {
      "$ref": "#/$defs/Temporal",
      "description": "Temporal context from beliefs_active.MentionedTime."
    },
    "intent_type": {
      "type": "string",
      "enum": [
        "log_memory",
        "query_memory",
        "set_reminder",
        "express_feeling",
        "seek_advice",
        "share_news",
        "reflect",
        "other"
      ],
      "description": "Primary intent from control.intents[0] (UltraBERT primary)."
    },
    "goal_context": {
      "type": ["string", "null"],
      "description": "Active thread goal if relevant. From narrative_active.primary_thread.goal."
    },
    "source_type": {
      "type": "string",
      "enum": [
        "user_stated",
        "user_implied",
        "device_observed",
        "system_inferred"
      ],
      "description": "Memory provenance. MW cross-references history_active turns vs extraction origin."
    },
    "novelty": {
      "type": "string",
      "enum": [
        "ROUTINE",
        "EXPECTED",
        "NOVEL",
        "SURPRISING"
      ],
      "description": "Novelty classification. MW compares against beliefs + scoreboard."
    },
    "elaboration_depth": {
      "type": "string",
      "enum": [
        "MENTION",
        "DISCUSSED",
        "ELABORATED",
        "DEEPLY_PROCESSED"
      ],
      "description": "How deeply the topic was discussed. MW counts turns on topic from history."
    },
    "identity_domains": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "parent",
          "child",
          "spouse",
          "professional",
          "health_self",
          "financial_self",
          "social_self",
          "academic_self",
          "spiritual_self"
        ]
      },
      "description": "Identity categories activated by this memory. MW maps domains + topics + relationships."
    },
    "temporal_orientation": {
      "type": "string",
      "enum": [
        "PAST",
        "ONGOING",
        "FUTURE_COMMITMENT"
      ],
      "description": "Temporal orientation. MW compares resolved_epoch_ms vs now."
    },
    "task_context": {
      "type": ["string", "null"],
      "description": "Active task action if extraction relates to a task. From task_state."
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "LLM self-score confidence. Atoms below 0.30 are dropped."
    },
    "session_id": {
      "type": "string",
      "description": "Session UUID from meta.identity.session_id."
    },
    "conversation_turn": {
      "type": "integer",
      "minimum": 0,
      "description": "Turn ordinal from meta.lifecycle.turn_count."
    },
    "extraction_sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5,
      "default": 0,
      "description": "0-based ordinal of this atom within the turn extraction batch."
    },
    "language": {
      "type": "string",
      "minLength": 2,
      "maxLength": 5,
      "description": "ISO 639-1 language code. Default 'en'."
    },
    "conversation_anchor_ms": {
      "type": "integer",
      "minimum": 0,
      "description": "K1 Concierge conversation timestamp (unix ms). Authoritative for R2 episode formation. NEVER overwritten by K0 M08. GAP-002 Epic 1.1.",
      "default": 0
    },
    "temporal_links": {
      "type": "array",
      "items": { "$ref": "#/$defs/TemporalLink" },
      "maxItems": 5,
      "default": [],
      "description": "0-5 temporal references per atom. Replaces single Temporal object. GAP-002 Epic 2.2."
    },
    "correction_signal": {
      "type": "boolean",
      "default": false,
      "description": "K1 LLM detected this atom corrects a previously stored fact. Flags atom as EVOLVE candidate for P03 R3 reconciliation. R2 Epic 7.2."
    },
    "contradiction_signal": {
      "type": "boolean",
      "default": false,
      "description": "K1 LLM detected this atom contradicts stored knowledge with no clear resolution. Flags atom as CONTRADICT candidate for P03 R3 reconciliation. R2 Epic 7.2."
    },
    "supersedes_concept": {
      "type": ["string", "null"],
      "default": null,
      "description": "Namespaced concept key being replaced (e.g. 'cuisine_preference:thai', 'school:riverdale'). Gives P03 a targeted truth lookup instead of brute-force embedding search. R2 Epic 7.2."
    },
    "correction_source": {
      "type": ["string", "null"],
      "enum": [null, "user_explicit", "user_implicit", "context_change"],
      "default": null,
      "description": "How the correction was detected: user_explicit (direct statement), user_implicit (inferred from context shift), context_change (environmental change). R2 Epic 7.2."
    },
    "session_context_id": {
      "type": ["string", "null"],
      "default": null,
      "description": "Session UUID where correction was detected. Enables P03 audit trail for EVOLVE/CONTRADICT decisions. R2 Epic 7.2."
    }
  },
  "required": [
    "schema_version",
    "operation",
    "text",
    "topics",
    "sentiment_label",
    "affect",
    "source_type",
    "novelty",
    "elaboration_depth",
    "temporal_orientation",
    "confidence",
    "session_id",
    "conversation_turn",
    "language"
  ],
  "additionalProperties": false,
  "$defs": {
    "Affect": {
      "type": "object",
      "properties": {
        "valence": {
          "type": "number",
          "minimum": -1.0,
          "maximum": 1.0,
          "description": "Emotional valence (-1 negative to +1 positive)."
        },
        "arousal": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Emotional arousal (0 calm to 1 excited)."
        },
        "dominance": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Emotional dominance (0 submissive to 1 dominant)."
        }
      },
      "required": ["valence", "arousal", "dominance"],
      "additionalProperties": false
    },
    "ParticipantRelationship": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "PARENT_OF",
            "CHILD_OF",
            "SPOUSE_OF",
            "SIBLING_OF",
            "FRIEND_OF",
            "COLLEAGUE_OF",
            "CARETAKER_OF",
            "OTHER"
          ],
          "description": "Relationship type between participant and target."
        },
        "target": {
          "type": "string",
          "pattern": "^person_[a-z0-9_]+$",
          "description": "Target person_id for the relationship."
        },
        "confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Confidence score for this relationship."
        }
      },
      "required": ["type", "target", "confidence"],
      "additionalProperties": false
    },
    "Narrative": {
      "type": "object",
      "properties": {
        "thread_id": {
          "type": "string",
          "description": "UUID from narrative_active.primary_thread.id."
        },
        "arc_position": {
          "type": "string",
          "enum": [
            "EXPOSITION",
            "RISING_ACTION",
            "CLIMAX",
            "RESOLUTION"
          ],
          "description": "Story arc position from narrative_active.arc.position."
        },
        "is_goal_event": {
          "type": "boolean",
          "description": "True if extraction matches thread.goal."
        }
      },
      "required": ["thread_id", "arc_position", "is_goal_event"],
      "additionalProperties": false
    },
    "Temporal": {
      "type": "object",
      "properties": {
        "mentioned_time": {
          "type": "string",
          "description": "Raw time text like 'yesterday evening'."
        },
        "resolved_epoch_ms": {
          "type": "integer",
          "description": "Unix milliseconds (resolved absolute time)."
        },
        "is_backdated": {
          "type": "boolean",
          "description": "True if mentioned_time != now (refers to past/future)."
        }
      },
      "required": ["mentioned_time", "resolved_epoch_ms", "is_backdated"],
      "additionalProperties": false
    },
    "TemporalLink": {
      "type": "object",
      "properties": {
        "mentioned_time": {
          "type": "string",
          "minLength": 1,
          "description": "Raw temporal text from conversation (e.g. 'yesterday evening')."
        },
        "resolved_epoch_ms": {
          "type": "integer",
          "default": 0,
          "description": "Best-guess absolute time (Unix ms)."
        },
        "uncertainty_window_ms": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Precision window in ms (60000 for '7:15pm', 86400000 for 'yesterday')."
        },
        "link_type": {
          "type": "string",
          "enum": ["RETROSPECTIVE", "PROSPECTIVE", "CONCURRENT", "HABITUAL", "CONTEXTUAL", "CONDITIONAL"],
          "default": "CONCURRENT",
          "description": "Temporal link classification."
        },
        "confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "default": 1.0,
          "description": "LLM resolution confidence."
        }
      },
      "required": ["mentioned_time"],
      "additionalProperties": false
    }
  }
}
