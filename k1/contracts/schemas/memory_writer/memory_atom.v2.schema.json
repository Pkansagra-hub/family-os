{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "k1://contracts/schemas/memory_writer/memory_atom.v2.schema.json",
  "title": "Memory Atom v2",
  "description": "Authoritative JSON Schema for MW v2 memory atom -- the 34-field envelope body. Source of truth: docs/pipelines/p03/stage5_proposal_corrections.md LAYER 2 Field Reference.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "2.0",
      "description": "Schema version constant. Always '2.0' for MW v2."
    },
    "operation": {
      "type": "string",
      "const": "UPSERT",
      "description": "Operation type constant. Always 'UPSERT' for MW v2."
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "description": "Episodic memory text. 1-50 words, past/present tense, self-contained. MW-04 enforced."
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^person_[a-z0-9_]+$"
      },
      "description": "Person IDs of participants. Resolved by PersonResolver. Format: person_*."
    },
    "participant_relationships": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/ParticipantRelationship"
      },
      "description": "Map of person_id to relationship descriptor with type, target, and confidence."
    },
    "location_name": {
      "type": "string",
      "description": "Place name. Stripped in RED privacy band."
    },
    "location_type": {
      "type": "string",
      "enum": [
        "home",
        "restaurant",
        "hospital",
        "school",
        "office",
        "gym",
        "store",
        "park",
        "church",
        "airport",
        "hotel",
        "other"
      ],
      "description": "Location category. Stripped in AMBER/RED privacy band."
    },
    "activity_type": {
      "type": "string",
      "enum": [
        "MEAL",
        "TASK",
        "TRAVEL",
        "HEALTH",
        "SOCIAL",
        "WORK",
        "EDUCATION",
        "EXERCISE",
        "SHOPPING",
        "ENTERTAINMENT",
        "CELEBRATION",
        "APPOINTMENT",
        "DIARY",
        "FINANCE",
        "RELATIONSHIP",
        "PLANNING",
        "CONCERN",
        "GRATITUDE",
        "META",
        "MEMORY"
      ],
      "description": "Activity classification. 20-value enum merged from K1 12-type + legacy 12-type."
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "maxItems": 3,
      "description": "Topic tags. 1-3 tags per atom."
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Activity categories."
    },
    "sentiment_label": {
      "type": "string",
      "enum": [
        "very_negative",
        "negative",
        "neutral",
        "positive",
        "very_positive"
      ],
      "description": "Sentiment classification from affective_now."
    },
    "emotion_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Emotion labels from 44-class emotion set via affective_now.current_emotion."
    },
    "affect": {
      "$ref": "#/$defs/Affect",
      "description": "Valence-Arousal-Dominance triple from affective_now.dimensions."
    },
    "social_context": {
      "type": "string",
      "enum": [
        "solo",
        "friends",
        "colleagues",
        "nuclear_family",
        "extended_family",
        "community"
      ],
      "description": "Social context derived from participant_relationships."
    },
    "social_intimacy": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH"
      ],
      "description": "Social intimacy level. family=HIGH, friends=MEDIUM, unknown=LOW."
    },
    "entity_salience": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0.0,
        "maximum": 1.0
      },
      "description": "Map of person_id to salience score (0-1). From scoreboard.salience_map."
    },
    "narrative": {
      "$ref": "#/$defs/Narrative",
      "description": "Narrative thread context from narrative_active."
    },
    "temporal": {
      "$ref": "#/$defs/Temporal",
      "description": "Temporal context from beliefs_active.MentionedTime."
    },
    "intent_type": {
      "type": "string",
      "enum": [
        "log_memory",
        "query_memory",
        "set_reminder",
        "express_feeling",
        "seek_advice",
        "share_news",
        "reflect",
        "other"
      ],
      "description": "Primary intent from control.intents[0] (UltraBERT primary)."
    },
    "goal_context": {
      "type": ["string", "null"],
      "description": "Active thread goal if relevant. From narrative_active.primary_thread.goal."
    },
    "source_type": {
      "type": "string",
      "enum": [
        "user_stated",
        "user_implied",
        "device_observed",
        "system_inferred"
      ],
      "description": "Memory provenance. MW cross-references history_active turns vs extraction origin."
    },
    "novelty": {
      "type": "string",
      "enum": [
        "ROUTINE",
        "EXPECTED",
        "NOVEL",
        "SURPRISING"
      ],
      "description": "Novelty classification. MW compares against beliefs + scoreboard."
    },
    "elaboration_depth": {
      "type": "string",
      "enum": [
        "MENTION",
        "DISCUSSED",
        "ELABORATED",
        "DEEPLY_PROCESSED"
      ],
      "description": "How deeply the topic was discussed. MW counts turns on topic from history."
    },
    "identity_domains": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "parent",
          "child",
          "spouse",
          "professional",
          "health_self",
          "financial_self",
          "social_self",
          "academic_self",
          "spiritual_self"
        ]
      },
      "description": "Identity categories activated by this memory. MW maps domains + topics + relationships."
    },
    "temporal_orientation": {
      "type": "string",
      "enum": [
        "PAST",
        "ONGOING",
        "FUTURE_COMMITMENT"
      ],
      "description": "Temporal orientation. MW compares resolved_epoch_ms vs now."
    },
    "task_context": {
      "type": ["string", "null"],
      "description": "Active task action if extraction relates to a task. From task_state."
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "LLM self-score confidence. Atoms below 0.30 are dropped."
    },
    "session_id": {
      "type": "string",
      "description": "Session UUID from meta.identity.session_id."
    },
    "conversation_turn": {
      "type": "integer",
      "minimum": 0,
      "description": "Turn ordinal from meta.lifecycle.turn_count."
    },
    "language": {
      "type": "string",
      "minLength": 2,
      "maxLength": 5,
      "description": "ISO 639-1 language code. Default 'en'."
    }
  },
  "required": [
    "schema_version",
    "operation",
    "text",
    "topics",
    "sentiment_label",
    "affect",
    "source_type",
    "novelty",
    "elaboration_depth",
    "temporal_orientation",
    "confidence",
    "session_id",
    "conversation_turn",
    "language"
  ],
  "additionalProperties": false,
  "$defs": {
    "Affect": {
      "type": "object",
      "properties": {
        "valence": {
          "type": "number",
          "minimum": -1.0,
          "maximum": 1.0,
          "description": "Emotional valence (-1 negative to +1 positive)."
        },
        "arousal": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Emotional arousal (0 calm to 1 excited)."
        },
        "dominance": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Emotional dominance (0 submissive to 1 dominant)."
        }
      },
      "required": ["valence", "arousal", "dominance"],
      "additionalProperties": false
    },
    "ParticipantRelationship": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "PARENT_OF",
            "CHILD_OF",
            "SPOUSE_OF",
            "SIBLING_OF",
            "FRIEND_OF",
            "COLLEAGUE_OF",
            "CARETAKER_OF",
            "OTHER"
          ],
          "description": "Relationship type between participant and target."
        },
        "target": {
          "type": "string",
          "pattern": "^person_[a-z0-9_]+$",
          "description": "Target person_id for the relationship."
        },
        "confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Confidence score for this relationship."
        }
      },
      "required": ["type", "target", "confidence"],
      "additionalProperties": false
    },
    "Narrative": {
      "type": "object",
      "properties": {
        "thread_id": {
          "type": "string",
          "description": "UUID from narrative_active.primary_thread.id."
        },
        "arc_position": {
          "type": "string",
          "enum": [
            "EXPOSITION",
            "RISING_ACTION",
            "CLIMAX",
            "RESOLUTION"
          ],
          "description": "Story arc position from narrative_active.arc.position."
        },
        "is_goal_event": {
          "type": "boolean",
          "description": "True if extraction matches thread.goal."
        }
      },
      "required": ["thread_id", "arc_position", "is_goal_event"],
      "additionalProperties": false
    },
    "Temporal": {
      "type": "object",
      "properties": {
        "mentioned_time": {
          "type": "string",
          "description": "Raw time text like 'yesterday evening'."
        },
        "resolved_epoch_ms": {
          "type": "integer",
          "description": "Unix milliseconds (resolved absolute time)."
        },
        "is_backdated": {
          "type": "boolean",
          "description": "True if mentioned_time != now (refers to past/future)."
        }
      },
      "required": ["mentioned_time", "resolved_epoch_ms", "is_backdated"],
      "additionalProperties": false
    }
  }
}
