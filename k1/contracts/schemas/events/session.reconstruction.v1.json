{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Emitted during session state reconstruction from K0",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string"
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mode": {
      "type": "string",
      "enum": ["partial", "degraded"]
    }
  },
  "required": ["session_id", "sections", "mode"]
}
