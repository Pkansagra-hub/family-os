// Tool Message Types FlatBuffers Schema
// Purpose: Tool execution lifecycle messages (3 types)
// Research: Tool calling patterns, streaming tool output, ADR-0032 tool governance

namespace K1.WebSocket;

// ============================================================================
// 1. ToolCallStarted
// ============================================================================

table ToolCallStarted {
  turn_id: string (required);                  // Turn ID (matches UserMessage)
  tool_call_id: string (required);             // Unique tool call ID (UUID)
  tool_name: string (required);                // Tool name (e.g., "calculator", "web_search")
  tool_category: string (required);            // Category (SYSTEM, EXTERNAL, USER, ADMIN)
  arguments: string (required);                // Tool arguments (JSON string, redacted PII)
  agent_id: string (required);                 // Agent that requested tool call
  timestamp_ms: int64 (required);              // Server timestamp when tool execution started

  // Optional metadata
  estimated_duration_ms: uint32;               // Estimated execution time
  privacy_band: string (required);             // Privacy band
  requires_approval: bool = false;             // Whether tool requires human approval
}

// ============================================================================
// 2. ToolCallChunk (Streaming Tool Output)
// ============================================================================

table ToolCallChunk {
  turn_id: string (required);                  // Turn ID
  tool_call_id: string (required);             // Tool call ID
  output_delta: string (required);             // NEW output only (not cumulative)
  chunk_index: uint32 (required);              // Monotonic chunk index (0, 1, 2, ...)
  timestamp_ms: int64 (required);              // Server timestamp when chunk sent

  // Optional metadata
  output_type: string = "text";                // text, json, binary, image, etc.
  mime_type: string;                           // MIME type for binary/image output
}

// ============================================================================
// 3. ToolCallCompleted
// ============================================================================

table ToolCallCompleted {
  turn_id: string (required);                  // Turn ID
  tool_call_id: string (required);             // Tool call ID
  tool_name: string (required);                // Tool name
  success: bool (required);                    // true = success, false = error
  result: string;                              // Tool result (JSON string, redacted PII)
  error_code: string;                          // Error code if success = false
  error_message: string;                       // Human-readable error message
  latency_ms: uint32 (required);               // Total execution latency
  timestamp_ms: int64 (required);              // Server timestamp when tool execution completed

  // Optional metadata
  result_size_bytes: uint32;                   // Size of result in bytes
  exit_code: int32;                            // Exit code for shell tools
  violation_type: string;                      // Violation type from ADR-0032 (SAFETY, PRIVACY, QUOTA, DEPENDENCY)
  retry_allowed: bool = true;                  // Whether retry is allowed
}

// ============================================================================
// 4. ClarificationRequest (Tool Approval)
// ============================================================================

table ClarificationRequest {
  turn_id: string (required);                  // Turn ID
  tool_call_id: string (required);             // Tool call ID requesting approval
  tool_name: string (required);                // Tool name
  clarification_type: string (required);       // approval_required, ambiguous_input, missing_context
  prompt: string (required);                   // Human-readable prompt (e.g., "Allow web_search to access example.com?")
  options: [string];                           // Available options (["allow", "deny"], ["option1", "option2"])
  timeout_ms: uint32 = 30000;                  // Timeout for user response (30 seconds)
  timestamp_ms: int64 (required);              // Server timestamp
}

// ============================================================================
// 5. ClarificationResponse (User Approval)
// ============================================================================

table ClarificationResponse {
  turn_id: string (required);                  // Turn ID
  tool_call_id: string (required);             // Tool call ID
  response: string (required);                 // User response (e.g., "allow", "deny", "option1")
  timestamp_ms: int64 (required);              // Client timestamp
}

// ============================================================================
// 6. Error (General Error Message)
// ============================================================================

table Error {
  turn_id: string;                             // Optional turn ID
  error_code: string (required);               // Error code (e.g., "RATE_LIMIT_EXCEEDED", "TOOL_NOT_FOUND")
  message: string (required);                  // Human-readable error message
  details: string;                             // Optional detailed error information (JSON string)
  retry_allowed: bool = true;                  // Whether retry is allowed
  retry_after_ms: uint32;                      // Optional retry delay (milliseconds)
  timestamp_ms: int64 (required);              // Server timestamp
}

// ============================================================================
// Usage Examples
// ============================================================================

