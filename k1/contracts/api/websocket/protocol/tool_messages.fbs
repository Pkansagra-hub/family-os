// ============================================================================
// Tool Execution Lifecycle
// ============================================================================

tool_execution_lifecycle:
  1_tool_call_started:
    - Server: Agent requests tool call
    - Server: Validate tool governance rules (ADR-0032)
    - Server: Send ToolCallStarted (tool_name, arguments, agent_id)
    - Client: Display "Executing tool X..." UI
    - Timing: <50ms from tool request to message sent

  2_tool_approval_if_required:
    - Server: Detect requires_approval = true (ADMIN tools, sensitive operations)
    - Server: Send ClarificationRequest (prompt, options, timeout)
    - Client: Display approval dialog to user
    - Client: Send ClarificationResponse (allow/deny)
    - Server: Proceed with execution or abort
    - Timing: <30000ms timeout for user response

  3_tool_execution_streaming:
    - Server: Execute tool (shell command, API call, etc.)
    - Server: Stream output as ToolCallChunk (delta-based)
    - Client: Append output_delta to accumulator, update UI
    - Timing: Variable (depends on tool)

  4_tool_call_completed:
    - Server: Tool execution finished
    - Server: Send ToolCallCompleted (success, result, latency_ms)
    - Client: Display final result, show metrics
    - Timing: <10ms after tool completion

  error_handling:
    - If tool timeout:
      - Send ToolCallCompleted with success=false, error_code="TIMEOUT"
    - If tool violation (ADR-0032):
      - Send ToolCallCompleted with violation_type, error_message
    - If network interruption:
      - Auto-reconnect (ADR-0040d) resumes from last chunk_index

// ============================================================================
// Tool Categories (ADR-0032)
// ============================================================================

tool_categories:
  SYSTEM:
    description: Built-in K1 tools (SessionState queries, memory retrieval)
    requires_approval: false
    max_latency_budget: 1000ms
    examples: [get_beliefs, query_memory, list_agents]
  EXTERNAL:
    description: External API calls (web search, weather, stock prices)
    requires_approval: false
    max_latency_budget: 5000ms
    examples: [web_search, wikipedia, weather_api]
  USER:
    description: User-defined tools (custom scripts, local files)
    requires_approval: true
    max_latency_budget: 10000ms
    examples: [run_python_script, read_file, execute_shell]
  ADMIN:
    description: Administrative tools (system config, database access)
    requires_approval: true
    max_latency_budget: 30000ms
    examples: [update_config, reset_session, delete_user_data]

// ============================================================================
// Violation Types (ADR-0032)
// ============================================================================

violation_types:
  SAFETY:
    description: Tool attempted unsafe operation (file deletion, network access)
    action: Abort tool execution, send ToolCallCompleted with violation_type
    retry_allowed: false
  PRIVACY:
    description: Tool attempted to access PII without authorization
    action: Abort, log security event, notify user
    retry_allowed: false
  QUOTA:
    description: Tool exceeded quota (rate limit, token limit, storage limit)
    action: Abort, wait for quota reset
    retry_allowed: true (after quota reset)
  DEPENDENCY:
    description: Tool dependency unavailable (API down, network error)
    action: Abort, retry with exponential backoff
    retry_allowed: true

// ============================================================================
// Performance Budgets
// ============================================================================

performance_budgets:
  tool_call_started:
    serialization: <1ms
    size: ~500 bytes (tool_name + arguments)
    target: <50ms from tool request to message sent
  tool_call_chunk:
    serialization: <0.5ms
    size: ~200 bytes (output_delta)
    target: <100ms between chunks
  tool_call_completed:
    serialization: <1ms
    size: ~300 bytes (result + metadata)
    target: <10ms after tool completion

  tool_execution_latency:
    SYSTEM: <1000ms (P95)
    EXTERNAL: <5000ms (P95)
    USER: <10000ms (P95)
    ADMIN: <30000ms (P95)

// ============================================================================
// Security Considerations
// ============================================================================

security:
  pii_redaction:
    - Redact PII in ToolCallStarted.arguments (ADR-0035)
    - Redact PII in ToolCallCompleted.result
    - Store redacted data in SessionState, original in encrypted vault
  tool_approval:
    - Require human approval for ADMIN and USER tools
    - 30-second timeout for approval (abort if no response)
    - Log approval decisions to audit trail (ADR-0038)
  tool_isolation:
    - Execute tools in sandboxed environment (Docker container, VM)
    - Limit network access (whitelist approved domains)
    - Prevent file system access outside allowed directories
  rate_limiting:
    - Max 10 tool calls per minute per user (prevent abuse)
    - Max 100 tool calls per hour per user
    - Emit rate_limit_exceeded metric

// ============================================================================
// Observability
// ============================================================================

metrics:
  - tool_calls_started_total (counter by tool_name, tool_category)
  - tool_call_chunks_sent_total (counter)
  - tool_calls_completed_total (counter by tool_name, success)
  - tool_execution_latency_ms (histogram by tool_name, tool_category)
  - tool_failures_total (counter by tool_name, error_code)
  - tool_violations_total (counter by tool_name, violation_type)
  - clarification_requests_total (counter by clarification_type)
  - clarification_timeouts_total (counter)
  - tool_approval_decisions_total (counter by tool_name, decision: allow/deny)
