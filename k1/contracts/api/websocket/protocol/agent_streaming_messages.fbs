// Agent Streaming Message Types FlatBuffers Schema
// Purpose: Delta-based streaming for agent responses (90% bandwidth reduction)
// Research: Streaming LLM responses, delta encoding, <200ms TTFT (ADR-0040)

namespace K1.WebSocket;

// ============================================================================
// 1. UserMessage
// ============================================================================

table UserMessage {
  turn_id: string (required);                  // Unique turn ID (UUID)
  text: string (required);                     // User message text (redacted PII per ADR-0035)
  attachments: [Attachment];                   // Optional file attachments
  timestamp_ms: int64 (required);              // Client timestamp
  privacy_band: string (required);             // Privacy band (GREEN, AMBER, RED, BLACK)
}

table Attachment {
  file_id: string (required);                  // File ID (UUID)
  file_name: string (required);                // Original filename
  mime_type: string (required);                // MIME type (image/png, application/pdf)
  size_bytes: uint32 (required);               // File size in bytes
  url: string;                                 // Optional presigned URL for download
}

// ============================================================================
// 2. AgentMessageStart
// ============================================================================

table AgentMessageStart {
  turn_id: string (required);                  // Turn ID (matches UserMessage)
  agent_id: string (required);                 // Agent ID (UUID)
  agent_name: string (required);               // Agent name (e.g., "Analyst", "Coder")
  agent_type: string (required);               // Agent type (EXECUTIVE, TOOL, SPECIALIST)
  estimated_tokens: uint32;                    // Estimated total tokens (for progress UI)
  privacy_band: string (required);             // Privacy band
  timestamp_ms: int64 (required);              // Server timestamp when generation started
}

// ============================================================================
// 3. AgentMessageChunk (Delta-Based Streaming)
// ============================================================================

table AgentMessageChunk {
  turn_id: string (required);                  // Turn ID
  agent_id: string (required);                 // Agent ID
  text_delta: string (required);               // NEW tokens only (not cumulative)
  chunk_index: uint32 (required);              // Monotonic chunk index (0, 1, 2, ...)
  timestamp_ms: int64 (required);              // Server timestamp when chunk sent

  // Optional metadata
  token_count: uint32;                         // Token count for this chunk
  cumulative_token_count: uint32;              // Total tokens so far
}

// ============================================================================
// 4. AgentMessageEnd
// ============================================================================

table AgentMessageEnd {
  turn_id: string (required);                  // Turn ID
  agent_id: string (required);                 // Agent ID
  finish_reason: string (required);            // stop, length, tool_call, error
  total_tokens: uint32 (required);             // Total tokens in complete message
  latency_ms: uint32 (required);               // Total generation latency
  timestamp_ms: int64 (required);              // Server timestamp when generation completed

  // Optional error details
  error_code: string;                          // Error code if finish_reason = error
  error_message: string;                       // Human-readable error message
}

// ============================================================================
// 5. TypingIndicator
// ============================================================================

table TypingIndicator {
  agent_id: string (required);                 // Agent ID
  agent_name: string (required);               // Agent name
  is_typing: bool (required);                  // true = started typing, false = stopped
  timestamp_ms: int64 (required);              // Server timestamp
}

// ============================================================================
// Usage Examples
// ============================================================================

// Rust AgentMessageStart serialization:
/*
use flatbuffers::FlatBufferBuilder;
use k1_websocket::{AgentMessageStart, AgentMessageStartArgs};

fn send_agent_message_start(
    turn_id: &str,
    agent_id: &str,
    agent_name: &str,
    agent_type: &str,
    privacy_band: &str,
) -> Vec<u8> {
    let mut builder = FlatBufferBuilder::new();

    let turn_id_offset = builder.create_string(turn_id);
    let agent_id_offset = builder.create_string(agent_id);
    let agent_name_offset = builder.create_string(agent_name);
    let agent_type_offset = builder.create_string(agent_type);
    let privacy_band_offset = builder.create_string(privacy_band);

    let start = AgentMessageStartArgs {
        turn_id: Some(turn_id_offset),
        agent_id: Some(agent_id_offset),
        agent_name: Some(agent_name_offset),
        agent_type: Some(agent_type_offset),
        estimated_tokens: 500,
        privacy_band: Some(privacy_band_offset),
        timestamp_ms: chrono::Utc::now().timestamp_millis(),
    };

    let msg_offset = AgentMessageStart::create(&mut builder, &start);
    builder.finish(msg_offset, None);

    builder.finished_data().to_vec()
}
*/

// Rust AgentMessageChunk serialization (delta-based):
