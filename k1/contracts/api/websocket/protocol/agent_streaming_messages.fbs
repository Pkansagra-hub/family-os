fn send_agent_message_chunk(
    turn_id: &str,
    agent_id: &str,
    text_delta: &str,  // NEW tokens only (e.g., "Hello ", "world", "!")
    chunk_index: u32,
) -> Vec<u8> {
    let mut builder = FlatBufferBuilder::new();

    let turn_id_offset = builder.create_string(turn_id);
    let agent_id_offset = builder.create_string(agent_id);
    let text_delta_offset = builder.create_string(text_delta);

    let chunk = AgentMessageChunkArgs {
        turn_id: Some(turn_id_offset),
        agent_id: Some(agent_id_offset),
        text_delta: Some(text_delta_offset),
        chunk_index,
