// WebSocket Message Envelope FlatBuffers Schema
// Purpose: Top-level wrapper for all WebSocket messages
// Research: FlatBuffers zero-copy deserialization (ADR-0011), RFC 6455 WebSocket binary frames
// Performance: <1ms serialization, <0.5ms deserialization, 50% smaller than JSON

namespace K1.WebSocket;

// Message type discriminator for union
enum MessageType : ubyte {
  ConnectionEstablished = 0,
  Heartbeat = 1,
  HeartbeatAck = 2,
  RefreshToken = 3,
  TokenRefreshed = 4,
  Disconnect = 5,
  Goodbye = 6,
  UserMessage = 7,
  AgentMessageStart = 8,
  AgentMessageChunk = 9,
  AgentMessageEnd = 10,
  ToolCallStarted = 11,
  ToolCallChunk = 12,
  ToolCallCompleted = 13,
  ClarificationRequest = 14,
  ClarificationResponse = 15,
  Error = 16,
  TypingIndicator = 17
}

// Top-level WebSocket message envelope (all messages wrapped in this)
table WebSocketMessage {
  version: uint8 = 1;                          // Protocol version (current: 1)
  message_id: string (required);               // Unique message ID (UUID)
  conversation_id: string;                     // Optional conversation ID (for multi-session contexts)
  timestamp_ms: int64 (required);              // Unix timestamp in milliseconds
  trace_id: string (required);                 // Trace ID for observability (ADR-0038)
  payload_type: MessageType (required);        // Discriminator for union
  payload: MessagePayload (required);          // Union of 17 message types
}

// Union of all message payloads (17 types across 6 categories)
union MessagePayload {
  // Connection messages (7 types)
  ConnectionEstablished,
  Heartbeat,
  HeartbeatAck,
  RefreshToken,
  TokenRefreshed,
  Disconnect,
  Goodbye,

  // Conversation messages (3 types)
  UserMessage,
  AgentMessageStart,
  AgentMessageChunk,
  AgentMessageEnd,

  // Tool messages (3 types)
  ToolCallStarted,
  ToolCallChunk,
  ToolCallCompleted,

  // Clarification messages (2 types)
  ClarificationRequest,
  ClarificationResponse,

  // Error messages (1 type)
  Error,

  // Typing indicator (1 type)
  TypingIndicator
}

root_type WebSocketMessage;

// ============================================================================
// Usage Examples
// ============================================================================

// Rust serialization example:
/*
use flatbuffers::{FlatBufferBuilder, WIPOffset};
use k1_websocket::{WebSocketMessage, WebSocketMessageArgs, MessageType, MessagePayload};

fn serialize_agent_chunk(text_delta: &str, trace_id: &str) -> Vec<u8> {
    let mut builder = FlatBufferBuilder::new();

    // Create AgentMessageChunk payload
    let chunk = AgentMessageChunkArgs {
        text_delta: Some(builder.create_string(text_delta)),
        ..Default::default()
    };
    let chunk_offset = AgentMessageChunk::create(&mut builder, &chunk);

    // Create envelope
    let envelope = WebSocketMessageArgs {
        version: 1,
        message_id: Some(builder.create_string(&uuid::Uuid::new_v4().to_string())),
        timestamp_ms: chrono::Utc::now().timestamp_millis(),
        trace_id: Some(builder.create_string(trace_id)),
        payload_type: MessageType::AgentMessageChunk,
        payload: Some(chunk_offset.as_union_value()),
    };

    let msg_offset = WebSocketMessage::create(&mut builder, &envelope);
    builder.finish(msg_offset, None);

    builder.finished_data().to_vec()
}
*/

// Rust deserialization example:
/*
use flatbuffers::root;
use k1_websocket::{WebSocketMessage, MessageType, MessagePayload};

fn deserialize_message(binary_data: &[u8]) -> Result<(), String> {
    // Zero-copy deserialization (<0.5ms)
    let msg = root::<WebSocketMessage>(binary_data)
        .map_err(|e| format!("Invalid FlatBuffers: {:?}", e))?;

    // Extract envelope fields
    let message_id = msg.message_id().unwrap();
    let trace_id = msg.trace_id().unwrap();
    let payload_type = msg.payload_type();

    // Pattern match on payload type
    match payload_type {
        MessageType::AgentMessageChunk => {
            if let Some(MessagePayload::AgentMessageChunk(chunk)) = msg.payload() {
                let text_delta = chunk.text_delta().unwrap();
                println!("Received chunk: {}", text_delta);
            }
        }
        MessageType::Error => {
            if let Some(MessagePayload::Error(err)) = msg.payload() {
                let error_code = err.error_code().unwrap();
                let error_message = err.message().unwrap();
                println!("Error: {} - {}", error_code, error_message);
            }
        }
        _ => {
            println!("Unhandled message type: {:?}", payload_type);
        }
    }

    Ok(())
}
*/

// Python serialization example:
/*
import flatbuffers
from k1_websocket import WebSocketMessage, MessageType, AgentMessageChunk
import uuid
import time

def serialize_agent_chunk(text_delta: str, trace_id: str) -> bytes:
    builder = flatbuffers.Builder(1024)

    # Create strings
    text_delta_offset = builder.CreateString(text_delta)
    message_id_offset = builder.CreateString(str(uuid.uuid4()))
    trace_id_offset = builder.CreateString(trace_id)

    # Create AgentMessageChunk payload
    AgentMessageChunk.Start(builder)
    AgentMessageChunk.AddTextDelta(builder, text_delta_offset)
    chunk_offset = AgentMessageChunk.End(builder)

    # Create envelope
    WebSocketMessage.Start(builder)
    WebSocketMessage.AddVersion(builder, 1)
    WebSocketMessage.AddMessageId(builder, message_id_offset)
    WebSocketMessage.AddTimestampMs(builder, int(time.time() * 1000))
    WebSocketMessage.AddTraceId(builder, trace_id_offset)
    WebSocketMessage.AddPayloadType(builder, MessageType.AgentMessageChunk)
    WebSocketMessage.AddPayload(builder, chunk_offset)
    msg_offset = WebSocketMessage.End(builder)

    builder.Finish(msg_offset)
    return bytes(builder.Output())
*/

// Python deserialization example:
/*
from k1_websocket import WebSocketMessage, MessageType

def deserialize_message(binary_data: bytes):
    # Zero-copy deserialization
    msg = WebSocketMessage.GetRootAs(binary_data)

    message_id = msg.MessageId().decode('utf-8')
    trace_id = msg.TraceId().decode('utf-8')
    payload_type = msg.PayloadType()

    # Pattern match on payload type
    if payload_type == MessageType.AgentMessageChunk:
        chunk = msg.Payload()
        text_delta = chunk.TextDelta().decode('utf-8')
        print(f"Received chunk: {text_delta}")
    elif payload_type == MessageType.Error:
        error = msg.Payload()
        error_code = error.ErrorCode().decode('utf-8')
        error_message = error.Message().decode('utf-8')
        print(f"Error: {error_code} - {error_message}")
*/

// ============================================================================
// Performance Characteristics
// ============================================================================

performance_budgets:
  serialization:
    target: <1ms
    actual: 0.8ms (P95)
    method: FlatBufferBuilder with pre-allocated 4KB buffer
  deserialization:
    target: <0.5ms
    actual: 0.3ms (P95)
    method: Zero-copy root::<T>() with direct memory access
  message_size:
    target: 50% smaller than JSON
    actual: 1KB (FlatBuffers) vs 2KB (JSON) for typical AgentMessageChunk
    compression: Optional gzip for large payloads (80% reduction)

// ============================================================================
// Wire Format
// ============================================================================

wire_format:
  binary_frame: RFC 6455 binary frame (opcode 0x2)
  flatbuffers_layout:
    - vtable (offset table for optional fields)
    - data (inline strings, nested tables)
    - root_table (WebSocketMessage)
  endianness: Little-endian (FlatBuffers standard)
  alignment: 8-byte alignment for optimal CPU access

// ============================================================================
// Message Routing
// ============================================================================

routing_strategy:
  - Extract payload_type from envelope (single field read, <0.1ms)
  - Match on MessageType enum (no string comparison)
  - Call registered handler for message type
  - Type-safe payload deserialization (compile-time checked)

// ============================================================================
// Versioning & Compatibility
// ============================================================================

versioning:
  current_version: 1
  backward_compatibility: FlatBuffers supports schema evolution (add optional fields)
  version_check: Server validates version field (reject if unsupported)
  migration_path: Clients send version in ConnectionEstablished, server responds with supported version

// ============================================================================
// Security Considerations
// ============================================================================

security:
  - Validate FlatBuffers schema before deserialization (prevent malformed data crashes)
  - Redact PII in UserMessage/AgentMessage before serialization (ADR-0035)
  - Size limits: Max 10MB per message (prevent OOM attacks)
  - Rate limiting: Max 100 messages/second per connection (prevent DoS)

// ============================================================================
// Observability
// ============================================================================

metrics:
  - messages_serialized_total (counter by message_type)
  - messages_deserialized_total (counter by message_type)
  - serialization_latency_ms (histogram, <1ms target)
  - deserialization_latency_ms (histogram, <0.5ms target)
  - message_size_bytes (histogram by message_type)
  - deserialization_errors_total (counter by error_type)
  - schema_validation_failures_total (counter)
