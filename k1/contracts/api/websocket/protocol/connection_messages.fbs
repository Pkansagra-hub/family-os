// Python ConnectionEstablished deserialization:
/*
from k1_websocket import ConnectionEstablished

def handle_connection_established(binary_data: bytes):
    established = ConnectionEstablished.GetRootAs(binary_data)

    session_id = established.SessionId().decode('utf-8')
    user_id = established.UserId().decode('utf-8')
    space_id = established.SpaceId().decode('utf-8')
    server_version = established.ServerVersion().decode('utf-8')
    protocol_version = established.ProtocolVersion()

    # Extract capabilities
    capabilities = []
    for i in range(established.CapabilitiesLength()):
        cap = established.Capabilities(i).decode('utf-8')
        capabilities.append(cap)

    privacy_band = established.PrivacyBand().decode('utf-8')
    heartbeat_interval_ms = established.HeartbeatIntervalMs()

    print(f"Connected: session={session_id}, user={user_id}, band={privacy_band}")
    return session_id, capabilities
*/

// Python Heartbeat handling:
/*
from k1_websocket import Heartbeat, HeartbeatAck, HeartbeatAckArgs
import time

def handle_heartbeat(binary_data: bytes) -> bytes:
    heartbeat = Heartbeat.GetRootAs(binary_data)

    server_timestamp = heartbeat.TimestampMs()
    sequence_number = heartbeat.SequenceNumber()

    # Calculate client-side latency
    client_timestamp = int(time.time() * 1000)
    client_latency_ms = client_timestamp - server_timestamp

    # Build HeartbeatAck response
    builder = flatbuffers.Builder(256)

    HeartbeatAck.Start(builder)
    HeartbeatAck.AddTimestampMs(builder, client_timestamp)
    HeartbeatAck.AddSequenceNumber(builder, sequence_number)
    HeartbeatAck.AddClientLatencyMs(builder, client_latency_ms)
    ack_offset = HeartbeatAck.End(builder)

    builder.Finish(ack_offset)
    return bytes(builder.Output())
*/

// ============================================================================
// Connection Lifecycle Sequences
// ============================================================================

connection_lifecycle:
  establishment:
    - client: Send HTTP Upgrade request with JWT in query param
    - server: Validate JWT, upgrade to WebSocket
    - server: Send ConnectionEstablished message
    - client: Receive ConnectionEstablished, store session_id and capabilities
    - timing: <500ms total (TLS + JWT + upgrade + message)

  heartbeat_cycle:
    - server: Send Heartbeat every 30 seconds (heartbeat_interval_ms)
    - client: Respond with HeartbeatAck within 5 seconds
    - server: Update last_heartbeat timestamp in ConnectionRegistry
    - server: Detect stale connection if no HeartbeatAck in 90 seconds (3× interval)
    - timing: <100ms round-trip for Heartbeat/HeartbeatAck

  token_refresh:
    - server: Detect token expires in <5 minutes (token_refresh_before_ms)
    - server: Send RefreshToken message
    - client: Call refresh token endpoint (POST /auth/refresh)
    - server: Issue new token pair (access + refresh)
    - server: Send TokenRefreshed message
    - client: Update stored tokens
    - timing: <2000ms total (refresh endpoint + TokenRefreshed message)

  graceful_disconnect:
    - server: Send Goodbye message (with session_saved=true)
    - server: Send WebSocket close frame (RFC 6455 close code)
    - server: Remove connection from ConnectionRegistry
    - client: Receive Goodbye, display message
    - client: Close WebSocket connection
    - timing: <50ms total

// ============================================================================
// RFC 6455 Close Codes
// ============================================================================

rfc_6455_close_codes:
  1000: # Normal Closure
    description: Normal graceful disconnect (user logout, session complete)
    reconnect_allowed: true
  1001: # Going Away
    description: Client navigating away or server shutting down
    reconnect_allowed: true
  1008: # Policy Violation
    description: Authentication failure, rate limit exceeded, policy breach
    reconnect_allowed: false
  1011: # Server Error
    description: Internal server error, unexpected condition
    reconnect_allowed: true
  1012: # Service Restart
    description: Server restarting (graceful reload)
    reconnect_allowed: true

// ============================================================================
// Performance Budgets
// ============================================================================

performance_budgets:
  connection_established_message:
    serialization: <1ms
    size: ~500 bytes (session_id + user_id + space_id + capabilities)
  heartbeat_message:
    serialization: <0.1ms
    size: ~50 bytes (timestamp + sequence_number)
  token_refreshed_message:
    serialization: <1ms
    size: ~1KB (JWT tokens)
  goodbye_message:
    serialization: <0.5ms
    size: ~200 bytes (message + close_code + session_saved)

// ============================================================================
// Security Considerations
// ============================================================================

security:
  connection_established:
    - Never include JWT access token in message (already validated during handshake)
    - Include privacy_band to inform client of SessionState encryption status
    - Validate capabilities match JWT claims (prevent privilege escalation)
  token_refresh:
    - Refresh token sent in RefreshToken message (encrypted over wss://)
    - Server validates refresh token before issuing new pair
    - Rotated refresh token prevents reuse attacks (ADR-0037c)
  disconnect:
    - Log disconnect reason to audit trail (ADR-0038)
    - Include close_code for debugging and compliance
    - Cleanup connection from registry to prevent resource leaks

// ============================================================================
// Observability
// ============================================================================

metrics:
  - connection_established_total (counter)
  - heartbeats_sent_total (counter)
  - heartbeat_acks_received_total (counter)
  - token_refreshes_total (counter)
  - token_refresh_failures_total (counter)
  - graceful_disconnects_total (counter by close_code)
  - heartbeat_latency_ms (histogram, client_latency_ms from HeartbeatAck)
  - missed_heartbeats_total (counter, no HeartbeatAck received)
