// Connection Message Types FlatBuffers Schema
// Purpose: Connection lifecycle messages (7 types)
// Research: RFC 6455 WebSocket connection management, JWT refresh flow (ADR-0037)

namespace K1.WebSocket;

// ============================================================================
// 1. ConnectionEstablished
// ============================================================================

table ConnectionEstablished {
  session_id: string (required);               // Unique session ID (UUID)
  user_id: string (required);                  // User ID from JWT claims
  space_id: string (required);                 // Space ID from JWT claims
  server_version: string (required);           // Server version (e.g., "1.0.0")
  protocol_version: uint8 = 1;                 // WebSocket protocol version
  capabilities: [string];                      // Enabled capabilities (TOOL_CALL, MULTIMODAL, etc.)
  privacy_band: string (required);             // Privacy band (GREEN, AMBER, RED, BLACK)
  max_message_size_bytes: uint32 = 10485760;  // Max message size (10MB)
  heartbeat_interval_ms: uint32 = 30000;       // Heartbeat interval (30 seconds)
  token_refresh_before_ms: uint32 = 300000;    // Refresh token 5 minutes before expiry
}

// ============================================================================
// 2. Heartbeat
// ============================================================================

table Heartbeat {
  timestamp_ms: int64 (required);              // Server timestamp (Unix milliseconds)
  sequence_number: uint32 (required);          // Monotonic sequence number (detect missed heartbeats)
}

// ============================================================================
// 3. HeartbeatAck
// ============================================================================

table HeartbeatAck {
  timestamp_ms: int64 (required);              // Client timestamp (Unix milliseconds)
  sequence_number: uint32 (required);          // Echo sequence number from Heartbeat
  client_latency_ms: uint32;                   // Optional client-side latency measurement
}

// ============================================================================
// 4. RefreshToken
// ============================================================================

table RefreshToken {
  reason: string (required);                   // Reason for refresh (expiring_soon, user_requested)
  expires_in_ms: uint32 (required);            // Current token expires in X milliseconds
  refresh_token: string (required);            // Refresh token from initial authentication
}

// ============================================================================
// 5. TokenRefreshed
// ============================================================================

table TokenRefreshed {
  access_token: string (required);             // New access token (JWT)
  refresh_token: string (required);            // New refresh token (rotated)
  expires_in_seconds: uint32 (required);       // New token expires in X seconds (3600)
  token_type: string = "Bearer";               // Token type
}

// ============================================================================
// 6. Disconnect
// ============================================================================

table Disconnect {
  reason: string (required);                   // Disconnect reason (user_requested, session_expired, server_shutdown)
  close_code: uint16 (required);               // RFC 6455 close code (1000, 1008, 1011)
  reconnect_allowed: bool = true;              // Whether client can reconnect
  retry_after_ms: uint32;                      // Optional retry delay (exponential backoff)
}

// ============================================================================
// 7. Goodbye
// ============================================================================

table Goodbye {
  message: string = "Connection closing";      // Goodbye message
  close_code: uint16 (required);               // RFC 6455 close code
  session_saved: bool (required);              // Whether SessionState was saved to K0
  final_turn_number: uint32;                   // Last completed turn number
}

// ============================================================================
// Usage Examples
// ============================================================================

