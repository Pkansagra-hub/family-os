// message_envelope.fbs
// Generic message envelope for actor-to-actor communication
// Research: Actor Model (Hewitt 1973), Message Passing (Agha 1986)
// Related ADRs: ADR-0002 (Actor Model), ADR-0011 (FlatBuffers)

namespace k1.actor_fabric;

/// Message priority levels for mailbox routing
/// Maps to 4-tier priority scheduler (Issue 2.2)
enum MessagePriority: byte {
  URGENT = 0,       // System-critical (max 50 messages)
  REALTIME = 1,     // User input (max 100 messages)
  INTERACTIVE = 2,  // Tool results (max 200 messages)
  BACKGROUND = 3    // Batch operations (max 1024 messages)
}

/// Message type classification
enum MessageType: byte {
  TASK_ANNOUNCEMENT = 0,    // Contract Net Protocol
  BID_SUBMISSION = 1,       // Agent bid
  TASK_ASSIGNMENT = 2,      // Task assignment
  TASK_COMPLETION = 3,      // Task completion
  STATE_UPDATE = 4,         // SessionState delta
  CONTROL_MESSAGE = 5,      // Control signal (pause, resume, terminate)
  FEEDBACK_SIGNAL = 6,      // Learning feedback
  CAPABILITY_GRANT = 7,     // Capability token
  PROTOCOL_VIOLATION = 8,   // Protocol error
  AGENT_HIRE_REQUEST = 9,   // Dynamic agent creation
  AGENT_HIRE_RESPONSE = 10, // Agent creation result
  GENERIC = 127             // Generic payload (max signed byte)
}

/// Generic message envelope for actor mailbox communication
/// Performance: Serialization <1ms P95, zero-copy deserialization
/// Size: ~200 bytes average (small), ~2KB max (medium)
table MessageEnvelope {
  // === Routing Fields ===
  sender_id: string (required);       // UUID of sending actor
  receiver_id: string (required);     // UUID of receiving actor

  // === Message Metadata ===
  message_type: MessageType;          // Type of message payload
  priority: MessagePriority = INTERACTIVE;  // Routing priority

  // === Payload ===
  // Payload is type-specific FlatBuffers serialized data
  // Receiver deserializes based on message_type
  payload: [ubyte];                   // Serialized FlatBuffers payload

  // === Time-To-Live ===
  ttl_ms: uint32 = 5000;              // Message expiry (default 5s)
  created_at: int64;                  // Creation timestamp (unix_ms)

  // === Observability ===
  trace_id: string (required);        // Cognitive trace ID for distributed tracing
  correlation_id: string;             // For request-response correlation

  // === Versioning ===
  version: uint16 = 1;                // Schema version
}

root_type MessageEnvelope;

/// Usage Example:
/// ```python
/// import flatbuffers
/// from k1.actor_fabric import MessageEnvelope, MessagePriority, MessageType
///
/// # Create builder
/// builder = flatbuffers.Builder(2048)
///
/// # Create strings
/// sender = builder.CreateString("agent-123")
/// receiver = builder.CreateString("orchestrator-main")
/// trace = builder.CreateString("trace-abc")
/// payload_data = builder.CreateByteVector(serialized_task_announcement)
///
/// # Create envelope
/// MessageEnvelope.Start(builder)
/// MessageEnvelope.AddSenderId(builder, sender)
/// MessageEnvelope.AddReceiverId(builder, receiver)
/// MessageEnvelope.AddMessageType(builder, MessageType.TASK_ANNOUNCEMENT)
/// MessageEnvelope.AddPriority(builder, MessagePriority.REALTIME)
/// MessageEnvelope.AddPayload(builder, payload_data)
/// MessageEnvelope.AddTtlMs(builder, 5000)
/// MessageEnvelope.AddCreatedAt(builder, int(time.time() * 1000))
/// MessageEnvelope.AddTraceId(builder, trace)
/// MessageEnvelope.AddVersion(builder, 1)
/// envelope = MessageEnvelope.End(builder)
///
/// builder.Finish(envelope)
/// serialized = bytes(builder.Output())
///
/// # Deserialize (zero-copy)
/// msg = MessageEnvelope.GetRootAs(serialized, 0)
/// print(f"From: {msg.SenderId().decode()}")
/// print(f"To: {msg.ReceiverId().decode()}")
/// print(f"Type: {msg.MessageType()}")
/// print(f"Priority: {msg.Priority()}")
/// ```
///
/// Performance Characteristics:
/// - Serialization: <1ms P95 (tested with 200-byte messages)
/// - Deserialization: <0.5ms P95 (zero-copy access)
/// - Memory: 200 bytes average, 2KB max
/// - Throughput: 100K+ messages/sec (async queue)
