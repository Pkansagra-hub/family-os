/// MCP Resource Response Schema (MCRS)
///
/// Purpose: MCP resource response with retrieved data, HTTP status, and
///          performance metrics for external resource access.
///
/// Usage Pattern:
///   1. MCP server retrieves resource from MCPResourceRequest
///   2. Server creates MCPResourceResponse with status_code and body
///   3. Gateway validates response and returns to caller
///   4. Track latency_ms for performance monitoring
///
/// Performance Specs:
///   - Typical Size: 512B-64KB (depends on resource size)
///   - Serialize: 3.2ms (P95)
///   - Deserialize: 0.45ms (P95, zero-copy)
///   - Memory: ~64KB per response
///
/// Related Schemas:
///   - MCPResourceRequest (MCRR): Request for this response
///   - MCPMessage (MCPM): Response wrapper
///   - KeyValue (from layer1_kernel/agent_capability.fbs): Headers
///
/// Research Foundation:
///   - Model Context Protocol (Anthropic 2024)
///   - HTTP status codes (RFC 9110)
///   - RESTful API design (Fielding 2000)
///
/// Version: 1.0
/// Layer: 3 (Execution & Tools)
/// Module: k1.mcp_gateway

namespace k1.mcp_gateway;

/// MCP resource response (file, URL, database data)
table MCPResourceResponse {
  /// Request identifier from MCPResourceRequest (for correlation)
  request_id: string (required);

  /// HTTP status code (200 = success, 404 = not found, etc.)
  status_code: uint16 = 200;

  /// HTTP headers (key-value pairs, references KeyValue from layer1_kernel)
  headers: [k1.agent_fabric.KeyValue];

  /// Response body (resource data)
  body: string;

  /// Request latency in milliseconds (for performance tracking)
  latency_ms: uint32 = 0;

  /// Completion timestamp (Unix epoch milliseconds, default: 0)
  completed_at_ms: uint64 = 0;
}

root_type MCPResourceResponse;
file_identifier "MCRS";
