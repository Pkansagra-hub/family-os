/// Model Response Schema (MRSP)
///
/// Purpose: LLM inference response with completion text, token usage, and
///          performance metrics for Model Hub.
///
/// Usage Pattern:
///   1. Model Hub generates completion_text from ModelRequest
///   2. Track token usage (prompt_tokens, completion_tokens, total_tokens)
///   3. Record performance metrics (latency_ms, ttft_ms)
///   4. Return ModelResponse to caller
///
/// Performance Specs:
///   - Typical Size: 1-32KB (depends on completion length)
///   - Serialize: 1.8ms (P95)
///   - Deserialize: 0.25ms (P95, zero-copy)
///   - Memory: ~32KB per response
///
/// Related Schemas:
///   - ModelRequest (MREQ): Request for this response
///   - ModelStreamChunk (MSCH): Streaming alternative
///   - FeedbackSignal (FBSG): Learning from completion quality
///
/// Research Foundation:
///   - Transformer architecture (Vaswani et al. 2017)
///   - Token accounting for cost management
///   - TTFT (Time to First Token) optimization
///
/// Version: 1.0
/// Layer: 3 (Execution & Tools)
/// Module: k1.model_hub

namespace k1.model_hub;

/// Token usage statistics
table TokenUsage {
  /// Number of tokens in the prompt
  prompt_tokens: uint32 = 0;

  /// Number of tokens in the completion
  completion_tokens: uint32 = 0;

  /// Total tokens (prompt + completion)
  total_tokens: uint32 = 0;
}

/// LLM inference response (non-streaming)
table ModelResponse {
  /// Request identifier from ModelRequest (for correlation)
  request_id: string (required);

  /// Generated completion text
  completion_text: string (required);

  /// Finish reason ("stop", "length", "content_filter", etc.)
  finish_reason: string;

  /// Token usage statistics (prompt, completion, total)
  usage: TokenUsage;

  /// Total latency in milliseconds (request to completion)
  latency_ms: uint32 = 0;

  /// Time to first token in milliseconds (TTFT metric)
  ttft_ms: uint32 = 0;

  /// Completion timestamp (Unix epoch milliseconds, default: 0)
  completed_at_ms: uint64 = 0;
}

root_type ModelResponse;
file_identifier "MRSP";
