/// Tool Call Response Schema (TCRS)
///
/// Purpose: Tool call response with result data, error handling, and performance
///          metrics for MCP tool execution.
///
/// Usage Pattern:
///   1. Tool Runner executes tool and creates ToolCallResponse
///   2. On SUCCESS: Populate result_data and result_type (MIME type)
///   3. On FAILURE/TIMEOUT: Populate error_message and error_code
///   4. Track latency_ms for performance monitoring
///
/// Performance Specs:
///   - Typical Size: 512B-16KB (depends on result size)
///   - Serialize: 0.85ms (P95)
///   - Deserialize: 0.12ms (P95, zero-copy)
///   - Memory: ~16KB per response
///
/// Related Schemas:
///   - ToolCallRequest (TCLR): Request for this call_id
///   - ToolCallProgress (TCPG): Progress updates before completion
///   - FeedbackSignal (FBSG): Learning from tool execution outcomes
///
/// Research Foundation:
///   - Model Context Protocol (Anthropic 2024)
///   - HTTP status codes for error handling
///
/// Version: 1.0
/// Layer: 3 (Execution & Tools)
/// Module: k1.tool_runner

namespace k1.tool_runner;

/// Tool call status enumeration
enum ToolCallStatus : uint8 {
  /// Tool executed successfully
  SUCCESS = 0,

  /// Tool execution failed (see error_message)
  FAILURE = 1,

  /// Tool execution timed out
  TIMEOUT = 2,

  /// Tool execution cancelled by user/system
  CANCELLED = 3
}

/// Tool call response with result or error
table ToolCallResponse {
  /// Call identifier from ToolCallRequest (for correlation)
  call_id: string (required);

  /// Execution status (SUCCESS, FAILURE, TIMEOUT, CANCELLED)
  status: ToolCallStatus = FAILURE;

  /// Result data (JSON, only if status = SUCCESS)
  result_data: string;

  /// Result MIME type (e.g., "application/json", "text/plain")
  result_type: string;

  /// Error message (only if status = FAILURE/TIMEOUT)
  error_message: string;

  /// Error code for structured error handling (e.g., "RATE_LIMIT_EXCEEDED")
  error_code: string;

  /// Execution latency in milliseconds (for performance tracking)
  latency_ms: uint32 = 0;

  /// Completion timestamp (Unix epoch milliseconds, default: 0)
  completed_at_ms: uint64 = 0;
}

root_type ToolCallResponse;
file_identifier "TCRS";
