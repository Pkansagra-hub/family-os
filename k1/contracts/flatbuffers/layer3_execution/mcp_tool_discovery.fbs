/// MCP Tool Discovery Schema (MCTD)
///
/// Purpose: MCP tool discovery response for dynamic tool registry, enabling
///          K1 to discover available tools from MCP servers.
///
/// Usage Pattern:
///   1. MCP Gateway sends "tools/list" request to MCP server
///   2. Server responds with MCPToolDiscovery (available tools + capabilities)
///   3. K1 populates ToolDefinition registry with discovered tools
///   4. Agent Fabric can now use discovered tools via ToolCallRequest
///
/// Performance Specs:
///   - Typical Size: 2-16KB (depends on tool count)
///   - Serialize: 1.2ms (P95)
///   - Deserialize: 0.16ms (P95, zero-copy)
///   - Memory: ~16KB per discovery response
///
/// Related Schemas:
///   - ToolDefinition (TDEF): Populated from discovered tools
///   - MCPMessage (MCPM): Discovery request/response wrapper
///   - ToolCallRequest (TCLR): Uses discovered tools
///
/// Research Foundation:
///   - Model Context Protocol (Anthropic 2024)
///   - Service discovery patterns (Consul, Eureka)
///
/// Version: 1.0
/// Layer: 3 (Execution & Tools)
/// Module: k1.mcp_gateway

namespace k1.mcp_gateway;

/// MCP tool discovery response
table MCPToolDiscovery {
  /// MCP server identifier
  server_id: string (required);

  /// List of available tool names (e.g., ["web_search", "calculator"])
  available_tools: [string];

  /// Server capabilities (e.g., ["tools", "resources", "prompts"])
  capabilities: [string];

  /// Server version string (semantic versioning)
  version: string;

  /// Discovery timestamp (Unix epoch milliseconds, default: 0)
  discovered_at_ms: uint64 = 0;
}

root_type MCPToolDiscovery;
file_identifier "MCTD";
