/// Stream Chunk Schema (STCH)
///
/// Purpose: Stream data chunk for audio, video, text, and multimodal streams,
///          enabling real-time data delivery with synchronization.
///
/// Usage Pattern:
///   1. Streaming Engine generates StreamChunk from media source
///   2. Chunk contains raw data bytes (audio samples, video frames, text)
///   3. is_keyframe flag marks synchronization points (I-frames)
///   4. is_end_of_stream flag marks final chunk
///
/// Performance Specs:
///   - Typical Size: 4-64KB (depends on codec and buffer_size_ms)
///   - Serialize: 3.5ms (P95)
///   - Deserialize: 0.48ms (P95, zero-copy)
///   - Memory: ~64KB per chunk
///
/// Related Schemas:
///   - StreamConfig (STCF): Stream configuration (codec, bitrate, etc.)
///   - StreamControl (STCT): Lifecycle control (START, STOP, etc.)
///   - ModelStreamChunk (MSCH): LLM text streaming
///
/// Research Foundation:
///   - WebRTC data channels (W3C Recommendation)
///   - RTP payload formats (RFC 3550)
///   - Zero-copy buffer management
///
/// Version: 1.0
/// Layer: 3 (Execution & Tools)
/// Module: k1.streaming_engine

namespace k1.streaming_engine;

/// Stream data chunk for real-time delivery
table StreamChunk {
  /// Stream identifier from StreamConfig (for correlation)
  stream_id: string (required);

  /// Chunk sequence number (0-indexed, monotonically increasing)
  chunk_id: uint32 = 0;

  /// Raw chunk data (audio samples, video frames, text bytes)
  data: [uint8] (required);

  /// Chunk timestamp in milliseconds (for synchronization)
  timestamp_ms: uint64 = 0;

  /// Keyframe flag (true for I-frames, false for P/B-frames)
  is_keyframe: bool = false;

  /// End-of-stream flag (true for final chunk)
  is_end_of_stream: bool = false;
}

root_type StreamChunk;
file_identifier "STCH";
