/// Tool Call Progress Schema (TCPG)
///
/// Purpose: Tool call progress updates for long-running operations, enabling
///          progress UI and graceful cancellation.
///
/// Usage Pattern:
///   1. Long-running tools emit ToolCallProgress periodically
///   2. UI displays progress_percent and status_message
///   3. Partial results enable incremental processing
///   4. Progress updates enable informed cancellation decisions
///
/// Performance Specs:
///   - Typical Size: ~512B (compact progress update)
///   - Serialize: 0.28ms (P95)
///   - Deserialize: 0.035ms (P95, zero-copy)
///   - Memory: ~512B per progress update
///
/// Related Schemas:
///   - ToolCallRequest (TCLR): Request for this call_id
///   - ToolCallResponse (TCRS): Final response after completion
///   - ToolCallCancellation (TCCN): Cancellation triggered by progress
///
/// Research Foundation:
///   - Server-Sent Events (W3C Recommendation)
///   - HTTP chunked transfer encoding
///
/// Version: 1.0
/// Layer: 3 (Execution & Tools)
/// Module: k1.tool_runner

namespace k1.tool_runner;

/// Tool call progress update for long-running operations
table ToolCallProgress {
  /// Call identifier from ToolCallRequest (for correlation)
  call_id: string (required);

  /// Progress percentage (0.0-100.0)
  progress_percent: float32 = 0.0;

  /// Human-readable status message (e.g., "Downloading file 3/10")
  status_message: string;

  /// Partial results as JSON (optional, for incremental processing)
  partial_results: string;

  /// Progress report timestamp (Unix epoch milliseconds, default: 0)
  reported_at_ms: uint64 = 0;
}

root_type ToolCallProgress;
file_identifier "TCPG";
