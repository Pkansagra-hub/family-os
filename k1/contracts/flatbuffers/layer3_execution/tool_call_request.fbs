/// Tool Call Request Schema (TCLR)
///
/// Purpose: Tool call request with parameters, caller metadata, and execution
///          constraints for MCP tool execution.
///
/// Usage Pattern:
///   1. Agent creates ToolCallRequest with tool_id and parameters (JSON)
///   2. Tool Runner validates parameters against ToolDefinition schema
///   3. Enforce timeout_ms and priority for scheduling
///   4. Track call_id for correlation with ToolCallResponse
///
/// Performance Specs:
///   - Typical Size: 512B-4KB (depends on parameters complexity)
///   - Serialize: 0.38ms (P95)
///   - Deserialize: 0.052ms (P95, zero-copy)
///   - Memory: ~4KB per request
///
/// Related Schemas:
///   - ToolDefinition (TDEF): Defines tool_id and parameters_schema
///   - ToolCallResponse (TCRS): Response for this call_id
///   - ToolCallProgress (TCPG): Progress updates for long-running calls
///   - ToolCallCancellation (TCCN): Cancellation for this call_id
///
/// Research Foundation:
///   - Model Context Protocol (Anthropic 2024)
///   - JSON-RPC 2.0 (JSONRPC Working Group)
///
/// Version: 1.0
/// Layer: 3 (Execution & Tools)
/// Module: k1.tool_runner

namespace k1.tool_runner;

/// Tool call request for MCP tool execution
table ToolCallRequest {
  /// Unique call identifier for correlation (UUID recommended)
  call_id: string (required);

  /// Tool identifier from ToolDefinition registry
  tool_id: string (required);

  /// Tool parameters as JSON (validated against ToolDefinition.parameters_schema)
  parameters: string (required);

  /// Agent ID making the tool call (for tracing)
  caller_agent_id: string;

  /// Turn ID for correlation with orchestration flow
  turn_id: string;

  /// Execution timeout in milliseconds (default: 3000ms)
  timeout_ms: uint32 = 3000;

  /// Priority for scheduling (0-10, higher = more urgent, default: 5)
  priority: uint8 = 5;

  /// Request timestamp (Unix epoch milliseconds, default: 0)
  requested_at_ms: uint64 = 0;

  /// Deadline timestamp (Unix epoch milliseconds, 0 = no deadline)
  deadline_ms: uint64 = 0;
}

root_type ToolCallRequest;
file_identifier "TCLR";
