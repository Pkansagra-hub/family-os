/// Stream Config Schema (STCF)
///
/// Purpose: Stream configuration for audio, video, text, and multimodal streams,
///          enabling codec negotiation and buffer management.
///
/// Usage Pattern:
///   1. Client/server negotiate stream configuration (codec, bitrate, buffer_size_ms)
///   2. Streaming Engine creates StreamConfig for stream setup
///   3. StreamChunk messages reference stream_id from config
///   4. StreamControl messages manage stream lifecycle
///
/// Performance Specs:
///   - Typical Size: ~256B (compact config message)
///   - Serialize: 0.18ms (P95)
///   - Deserialize: 0.022ms (P95, zero-copy)
///   - Memory: ~256B per stream config
///
/// Related Schemas:
///   - StreamChunk (STCH): Data chunks for this stream
///   - StreamControl (STCT): Lifecycle control (START, STOP, PAUSE, etc.)
///
/// Research Foundation:
///   - WebRTC (W3C Recommendation)
///   - RTP (RFC 3550)
///   - Adaptive bitrate streaming (DASH, HLS)
///
/// Version: 1.0
/// Layer: 3 (Execution & Tools)
/// Module: k1.streaming_engine

namespace k1.streaming_engine;

/// Stream type enumeration
enum StreamType : uint8 {
  /// Audio stream (speech, music)
  AUDIO = 0,

  /// Video stream (camera, screen capture)
  VIDEO = 1,

  /// Text stream (captions, chat)
  TEXT = 2,

  /// Multimodal stream (audio + video + text)
  MULTIMODAL = 3
}

/// Stream configuration for codec negotiation and buffer management
table StreamConfig {
  /// Unique stream identifier (UUID recommended)
  stream_id: string (required);

  /// Stream type (AUDIO, VIDEO, TEXT, MULTIMODAL)
  stream_type: StreamType (required);

  /// Codec identifier (e.g., "opus", "h264", "vp9")
  codec: string;

  /// Bitrate in bits per second (0 = variable bitrate)
  bitrate: uint32 = 0;

  /// Buffer size in milliseconds (latency budget, default: 100ms)
  buffer_size_ms: uint32 = 100;

  /// Configuration timestamp (Unix epoch milliseconds, default: 0)
  configured_at_ms: uint64 = 0;
}

root_type StreamConfig;
file_identifier "STCF";
