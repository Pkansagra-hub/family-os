/// Tool Call Cancellation Schema (TCCN)
///
/// Purpose: Tool call cancellation request for graceful resource cleanup and
///          termination of long-running operations.
///
/// Usage Pattern:
///   1. User/system triggers cancellation (barge-in, timeout, shutdown)
///   2. Tool Runner sends ToolCallCancellation to executing tool
///   3. Tool performs graceful cleanup and releases resources
///   4. Tool returns ToolCallResponse with status = CANCELLED
///
/// Performance Specs:
///   - Typical Size: ~128B (minimal cancellation message)
///   - Serialize: 0.08ms (P95)
///   - Deserialize: 0.012ms (P95, zero-copy)
///   - Memory: ~128B per cancellation
///
/// Related Schemas:
///   - ToolCallRequest (TCLR): Request being cancelled
///   - ToolCallResponse (TCRS): Response with status = CANCELLED
///   - ToolCallProgress (TCPG): Progress before cancellation
///
/// Research Foundation:
///   - Cooperative cancellation (Golang context.Context)
///   - Graceful shutdown patterns (SIGTERM handling)
///
/// Version: 1.0
/// Layer: 3 (Execution & Tools)
/// Module: k1.tool_runner

namespace k1.tool_runner;

/// Cancellation reason enumeration
enum CancellationReason : uint8 {
  /// User explicitly cancelled the operation
  USER_CANCEL = 0,

  /// Operation exceeded timeout deadline
  TIMEOUT = 1,

  /// User barged-in with new request
  BARGE_IN = 2,

  /// System is shutting down gracefully
  SYSTEM_SHUTDOWN = 3
}

/// Tool call cancellation request
table ToolCallCancellation {
  /// Call identifier from ToolCallRequest (for correlation)
  call_id: string (required);

  /// Cancellation reason (USER_CANCEL, TIMEOUT, BARGE_IN, SYSTEM_SHUTDOWN)
  reason: CancellationReason (required);

  /// Cancellation timestamp (Unix epoch milliseconds, default: 0)
  cancelled_at_ms: uint64 = 0;
}

root_type ToolCallCancellation;
file_identifier "TCCN";
