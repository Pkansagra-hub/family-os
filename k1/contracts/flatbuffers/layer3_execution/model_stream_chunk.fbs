/// Model Stream Chunk Schema (MSCH)
///
/// Purpose: LLM streaming chunk for incremental token delivery, enabling
///          low-latency TTFT and responsive user experience.
///
/// Usage Pattern:
///   1. Model Hub generates tokens incrementally from ModelRequest (stream=true)
///   2. Each token emitted as ModelStreamChunk with delta_text
///   3. Client concatenates delta_text to build full completion
///   4. Final chunk has finish_reason populated (e.g., "stop")
///
/// Performance Specs:
///   - Typical Size: ~512B (small token delta)
///   - Serialize: 0.28ms (P95)
///   - Deserialize: 0.035ms (P95, zero-copy)
///   - Memory: ~512B per chunk
///
/// Related Schemas:
///   - ModelRequest (MREQ): Request with stream=true
///   - ModelResponse (MRSP): Non-streaming alternative
///   - StreamChunk (STCH): Generic streaming for audio/video
///
/// Research Foundation:
///   - Server-Sent Events (W3C Recommendation)
///   - Streaming transformers (speculative decoding)
///   - TTFT optimization (Pope et al. 2022)
///
/// Version: 1.0
/// Layer: 3 (Execution & Tools)
/// Module: k1.model_hub

namespace k1.model_hub;

/// LLM streaming chunk (incremental token delivery)
table ModelStreamChunk {
  /// Request identifier from ModelRequest (for correlation)
  request_id: string (required);

  /// Chunk sequence number (0-indexed, monotonically increasing)
  chunk_id: uint32 = 0;

  /// Delta text (new tokens since last chunk)
  delta_text: string (required);

  /// Finish reason (null until final chunk, then "stop", "length", etc.)
  finish_reason: string;

  /// Chunk generation timestamp (Unix epoch milliseconds, default: 0)
  generated_at_ms: uint64 = 0;
}

root_type ModelStreamChunk;
file_identifier "MSCH";
