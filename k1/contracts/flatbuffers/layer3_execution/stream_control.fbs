/// Stream Control Schema (STCT)
///
/// Purpose: Stream control message for lifecycle management (START, STOP, PAUSE,
///          RESUME, SEEK) of audio, video, text, and multimodal streams.
///
/// Usage Pattern:
///   1. Client sends StreamControl to manage stream lifecycle
///   2. Streaming Engine processes control message and updates stream state
///   3. Parameters provide additional context (e.g., seek position)
///   4. Control messages enable responsive playback control
///
/// Performance Specs:
///   - Typical Size: ~128B (minimal control message)
///   - Serialize: 0.08ms (P95)
///   - Deserialize: 0.012ms (P95, zero-copy)
///   - Memory: ~128B per control message
///
/// Related Schemas:
///   - StreamConfig (STCF): Stream configuration
///   - StreamChunk (STCH): Data chunks being controlled
///   - KeyValue (from layer1_kernel/agent_capability.fbs): Parameters
///
/// Research Foundation:
///   - WebRTC peer connection lifecycle (W3C Recommendation)
///   - Media session API (W3C Draft)
///   - RTP session management (RFC 3550)
///
/// Version: 1.0
/// Layer: 3 (Execution & Tools)
/// Module: k1.streaming_engine

namespace k1.streaming_engine;

/// Stream control type enumeration
enum StreamControlType : uint8 {
  /// Start streaming
  START = 0,

  /// Stop streaming (release resources)
  STOP = 1,

  /// Pause streaming (keep resources)
  PAUSE = 2,

  /// Resume streaming from pause
  RESUME = 3,

  /// Seek to specific position (requires "position_ms" parameter)
  SEEK = 4
}

/// Stream control message for lifecycle management
table StreamControl {
  /// Stream identifier from StreamConfig (for correlation)
  stream_id: string (required);

  /// Control type (START, STOP, PAUSE, RESUME, SEEK)
  control_type: StreamControlType (required);

  /// Control parameters (key-value pairs, e.g., {"position_ms": "5000"})
  parameters: [k1.agent_fabric.KeyValue];

  /// Control message timestamp (Unix epoch milliseconds, default: 0)
  sent_at_ms: uint64 = 0;
}

root_type StreamControl;
file_identifier "STCT";
