/// MCP Message Schema (MCPM)
///
/// Purpose: Model Context Protocol (MCP) message for tool discovery, resource
///          access, and event streaming.
///
/// Usage Pattern:
///   1. MCP Gateway sends/receives MCPMessage over JSON-RPC 2.0
///   2. Message types: REQUEST (call), RESPONSE (result), NOTIFICATION (event), ERROR
///   3. Payload contains JSON-RPC 2.0 message body
///   4. Correlate REQUEST/RESPONSE via message_id
///
/// Performance Specs:
///   - Typical Size: 512B-16KB (depends on payload complexity)
///   - Serialize: 0.85ms (P95)
///   - Deserialize: 0.12ms (P95, zero-copy)
///   - Memory: ~16KB per message
///
/// Related Schemas:
///   - MCPToolDiscovery (MCTD): Tool discovery response
///   - MCPResourceRequest (MCRR): Resource access request
///   - MCPResourceResponse (MCRS): Resource access response
///
/// Research Foundation:
///   - Model Context Protocol (Anthropic 2024)
///   - JSON-RPC 2.0 (JSONRPC Working Group)
///
/// Version: 1.0
/// Layer: 3 (Execution & Tools)
/// Module: k1.mcp_gateway

namespace k1.mcp_gateway;

/// MCP message type enumeration
enum MCPMessageType : uint8 {
  /// JSON-RPC 2.0 request (method call)
  REQUEST = 0,

  /// JSON-RPC 2.0 response (result)
  RESPONSE = 1,

  /// JSON-RPC 2.0 notification (no response expected)
  NOTIFICATION = 2,

  /// JSON-RPC 2.0 error response
  ERROR = 3
}

/// MCP protocol message (JSON-RPC 2.0 wrapper)
table MCPMessage {
  /// Message identifier for correlation (JSON-RPC "id" field)
  message_id: string (required);

  /// Message type (REQUEST, RESPONSE, NOTIFICATION, ERROR)
  message_type: MCPMessageType (required);

  /// JSON-RPC 2.0 payload (method, params, result, or error)
  payload: string (required);

  /// Message timestamp (Unix epoch milliseconds, default: 0)
  timestamp_ms: uint64 = 0;
}

root_type MCPMessage;
file_identifier "MCPM";
