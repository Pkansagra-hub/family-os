/// MCP Resource Request Schema (MCRR)
///
/// Purpose: MCP resource request for accessing external resources (files, URLs,
///          databases) via Model Context Protocol.
///
/// Usage Pattern:
///   1. Agent requests resource access via MCP Gateway
///   2. Gateway creates MCPResourceRequest with resource_uri and method
///   3. MCP server validates permissions and retrieves resource
///   4. Server returns MCPResourceResponse with resource data
///
/// Performance Specs:
///   - Typical Size: 512B-16KB (depends on headers/body)
///   - Serialize: 0.85ms (P95)
///   - Deserialize: 0.12ms (P95, zero-copy)
///   - Memory: ~16KB per request
///
/// Related Schemas:
///   - MCPResourceResponse (MCRS): Response for this request
///   - MCPMessage (MCPM): Request/response wrapper
///   - KeyValue (from layer1_kernel/agent_capability.fbs): Headers
///
/// Research Foundation:
///   - Model Context Protocol (Anthropic 2024)
///   - RESTful API design (Fielding 2000)
///   - HTTP semantics (RFC 9110)
///
/// Version: 1.0
/// Layer: 3 (Execution & Tools)
/// Module: k1.mcp_gateway

namespace k1.mcp_gateway;

/// MCP resource request (file, URL, database access)
table MCPResourceRequest {
  /// Unique request identifier (UUID recommended)
  request_id: string (required);

  /// Resource URI (e.g., "file:///path/to/file", "https://example.com/api")
  resource_uri: string (required);

  /// HTTP method (GET, POST, PUT, DELETE)
  method: string (required);

  /// HTTP headers (key-value pairs, references KeyValue from layer1_kernel)
  headers: [k1.agent_fabric.KeyValue];

  /// Request body (for POST/PUT methods)
  body: string;

  /// Request timestamp (Unix epoch milliseconds, default: 0)
  requested_at_ms: uint64 = 0;
}

root_type MCPResourceRequest;
file_identifier "MCRR";
