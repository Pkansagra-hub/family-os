/// Server-Sent Events Schema (SSEV)
/// Layer 4: API Gateway - SSE

namespace k1.api_gateway;

table SSEEvent {
  event_id: string (required);
  event_type: string (required);
  data: string (required);
  retry_ms: uint32 = 3000;

  // Timestamps
  sent_at_ms: uint64 = 0;
}

root_type SSEEvent;
file_identifier "SSEV";
