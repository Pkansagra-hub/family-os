// protocol_state.fbs
// Layer 1 Core Kernel Schema: Protocol State
// Source ADR: ADR-0012a (Layer 1 Core Kernel Schemas)
// File Identifier: PRST
// Version: 1.0

namespace k1.protocol_monitor;

/// Protocol types (6 core protocols)
enum ProtocolType : uint8 {
  AGENT_HIRE = 0,        // Agent hiring protocol
  TASK_EXECUTION = 1,    // Task execution protocol (3-phase orchestration)
  CLARIFICATION = 2,     // Clarification protocol
  BARGE_IN = 3,          // Barge-in protocol (interrupt)
  TOOL_CALL = 4,         // Tool call protocol
  SAGA_ROLLBACK = 5      // Saga rollback protocol (compensating transactions)
}

/// Protocol state (MPST FSM)
///
/// Protocol state for MPST (Multiparty Session Types) validation.
/// Tracks protocol FSM state, valid transitions, and timeout enforcement.
///
/// Size: ~320 bytes (typical)
/// Serialization: <0.20ms P95 (target: <0.5ms) ✅
/// Deserialization: <0.025ms P95 (target: <0.1ms) ✅ (zero-copy)
///
/// Usage patterns:
/// - MPST validation: Validate messages against current_state and valid_transitions
/// - Timeout enforcement: Check (current_time_ms > deadline_ms) → ProtocolViolation(TIMEOUT)
/// - State transitions: On valid message, update current_state and valid_transitions
/// - Protocol completion: When protocol reaches terminal state (e.g., COMPLETED, FAILED)
///
/// Example Protocol FSM (AGENT_HIRE):
/// State 1: IDLE → valid_transitions=[REQUESTING] → message: AgentHireRequest
/// State 2: REQUESTING → valid_transitions=[HIRED, REJECTED, TIMEOUT] → message: AgentHireResponse
/// State 3: HIRED → terminal state
///
/// Example Protocol FSM (TASK_EXECUTION):
/// State 1: IDLE → valid_transitions=[ANNOUNCING] → message: TaskAnnouncement
/// State 2: ANNOUNCING → valid_transitions=[PROPOSING] → message: Proposal
/// State 3: PROPOSING → valid_transitions=[SELECTING] → message: Selection
/// State 4: SELECTING → valid_transitions=[EXECUTING] → message: ExecutionResult
/// State 5: EXECUTING → valid_transitions=[COMPLETED, FAILED] → message: ExecutionResult
table ProtocolState {
  /// Unique protocol instance identifier (ULID format)
  protocol_id: string (required);

  /// Protocol type (AGENT_HIRE, TASK_EXECUTION, etc.)
  protocol_type: ProtocolType (required);

  // FSM state
  /// Current state name (e.g., "NEGOTIATING", "EXECUTING", "COMPLETED")
  current_state: string (required);

  /// Valid next state names (state machine transitions)
  valid_transitions: [string];

  // Participants
  /// Participant IDs (agent IDs, component names)
  participants: [string];

  // Timeout enforcement
  /// Timeout in milliseconds (0 = no timeout)
  timeout_ms: uint32 = 0;

  /// Unix timestamp (ms) when protocol must complete (0 = no deadline)
  deadline_ms: uint64 = 0;

  // Timestamps
  /// Unix timestamp (ms) when protocol started
  started_at_ms: uint64 = 0;

  /// Unix timestamp (ms) of last state transition
  last_transition_ms: uint64 = 0;
}

root_type ProtocolState;
file_identifier "PRST";
