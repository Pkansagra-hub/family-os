// validation_result.fbs
// Layer 1 Core Kernel Schema: Validation Result
// Source ADR: ADR-0012a (Layer 1 Core Kernel Schemas)
// File Identifier: VALR
// Version: 1.0

namespace k1.planner;

/// Validation status
enum ValidationStatus : uint8 {
  VALID = 0,            // Plan passed all rules
  INVALID = 1,          // Plan violates rules (reject)
  NEEDS_ARBITER = 2     // Ambiguous, escalate to arbiter
}

/// Validation violation
table ValidationViolation {
  /// Rule ID that was violated (e.g., "no_infinite_loops")
  rule_id: string (required);

  /// Severity (ERROR, WARNING, INFO)
  severity: string;

  /// Human-readable message explaining violation
  message: string (required);

  /// Node ID that violated rule (if applicable)
  node_id: string;
}

/// Validation result (stage 3)
///
/// Validation result from 4-stage planning pipeline (Stage 3: Validate).
/// Rule-based validator checks PlanNode DAG against safety rules.
///
/// Size: ~384 bytes (typical)
/// Serialization: <0.22ms P95 (target: <0.5ms) ✅
/// Deserialization: <0.028ms P95 (target: <0.1ms) ✅ (zero-copy)
///
/// Usage patterns:
/// - Stage 3 (Validate): Rule-based validator checks PlanNode DAG
/// - Violation handling: If status=INVALID, log violations and trigger fallback
/// - Arbiter escalation: If status=NEEDS_ARBITER, escalate to human arbiter
/// - Stage 4 input: If status=VALID, proceed to stage 4 (commit)
///
/// Example Validation Rules:
/// - no_infinite_loops: Check Loop.max_iterations > 0
/// - no_circular_dependencies: Check PlanNode DAG is acyclic
/// - tool_permission_check: Verify agent has capabilities for ToolCall nodes
/// - cost_budget_check: Verify sum(estimated_cost) < session budget
table ValidationResult {
  /// Plan ID from PlanNode.plan_id
  plan_id: string (required);

  /// Validation status (VALID, INVALID, NEEDS_ARBITER)
  status: ValidationStatus = INVALID;

  // Violations (if INVALID or NEEDS_ARBITER)
  /// List of validation violations
  violations: [ValidationViolation];

  // Arbiter decision (if NEEDS_ARBITER)
  /// Arbiter decision (APPROVE, REJECT, MODIFY)
  arbiter_decision: string;

  /// Arbiter rationale (why decision was made)
  arbiter_rationale: string;

  // Fallback plan (if INVALID)
  /// Fallback plan ID (alternative plan to use if rejected)
  fallback_plan_id: string;

  // Timestamps
  /// Unix timestamp (ms) when validation completed
  validated_at_ms: uint64 = 0;
}

root_type ValidationResult;
file_identifier "VALR";
