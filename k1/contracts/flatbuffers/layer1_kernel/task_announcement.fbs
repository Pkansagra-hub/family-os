// task_announcement.fbs
// Layer 1 Core Kernel Schema: Task Announcement
// Source ADR: ADR-0012a (Layer 1 Core Kernel Schemas)
// File Identifier: TASK
// Version: 1.1

namespace k1.orchestrator;

/// Intent classification (from Planner)
/// Reference ADR: ADR-0007 (4-Stage Planning Pipeline)
enum IntentType : uint8 {
  INFORMATION_RETRIEVAL = 0,
  ACTION_EXECUTION = 1,
  CLARIFICATION = 2,
  MULTI_STEP = 3,
  CONVERSATIONAL = 4
}

/// Agent capability types (from k1.agent_fabric)
enum CapabilityType : uint8 {
  TOOL_CALL = 0,
  MEMORY_READ = 1,
  MEMORY_WRITE = 2,
  LLM_INFERENCE = 3,
  MULTIMODAL = 4,
  VISION = 5,
  AUDIO = 6
}

/// Task announcement (Contract Net Protocol)
///
/// Task announcement broadcast in 3-phase orchestration (Phase 1: Negotiation).
/// Orchestrator broadcasts task to eligible agents, agents respond with proposals.
///
/// Size: ~512 bytes (typical)
/// Serialization: <0.28ms P95 (target: <0.5ms) ✅
/// Deserialization: <0.035ms P95 (target: <0.1ms) ✅ (zero-copy)
///
/// Usage patterns:
/// - Phase 1 (Negotiation): Orchestrator broadcasts TaskAnnouncement to eligible agents
/// - Agent filtering: Agents check required_capabilities, deadline_ms, max_latency_ms
/// - Proposal generation: Eligible agents generate Proposal (PROP) with bid
/// - Timeout enforcement: Reject agents that don't respond before negotiation_deadline_ms
///
/// MPST Protocol Flow (3-Phase Orchestration):
/// Phase 1 (Negotiation):
///   Orchestrator → Agents: TaskAnnouncement (TASK)
///   Agents → Orchestrator: Proposal (PROP) [multiple]
/// Phase 2 (Selection):
///   Orchestrator → Agents: Selection (SELN) [broadcast winner + losers]
/// Phase 3 (Execution):
///   Selected Agent → Orchestrator: ExecutionResult (EXRS)
table TaskAnnouncement {
  /// Unique task identifier (ULID format)
  task_id: string (required);

  /// Turn ID that triggered this task
  turn_id: string (required);

  // Task specification
  /// Intent type (INFORMATION_RETRIEVAL, ACTION_EXECUTION, etc.)
  intent: IntentType (required);

  /// User input text
  user_input: string (required);

  /// Required capabilities for agents (TOOL_CALL, MEMORY_READ, etc.)
  required_capabilities: [CapabilityType];

  // Constraints
  /// Priority level (0-10 scale, default: 5)
  priority: uint8 = 5;

  /// Unix timestamp (ms) deadline for task completion (0 = no deadline)
  deadline_ms: uint64 = 0;

  /// Maximum latency in milliseconds (SLA, default: 2000ms)
  max_latency_ms: uint32 = 2000;

  // Context
  /// Turn context (JSON or FlatBuffers blob)
  turn_context: string;

  /// Session ID for this task
  session_id: string;

  // Timestamps
  /// Unix timestamp (ms) when task was announced
  announced_at_ms: uint64 = 0;

  /// Unix timestamp (ms) deadline for Phase 1 negotiation
  negotiation_deadline_ms: uint64 = 0;
}

root_type TaskAnnouncement;
file_identifier "TASK";
