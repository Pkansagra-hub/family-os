// selection.fbs
// Layer 1 Core Kernel Schema: Task Selection
// Source ADR: ADR-0012a (Layer 1 Core Kernel Schemas)
// File Identifier: SELN
// Version: 1.2

namespace k1.orchestrator;

/// Selection (orchestrator's choice of winner)
///
/// Orchestrator's selection of winning agent (Phase 2: Selection).
/// Broadcast to all agents (winner starts execution, losers release resources).
///
/// Size: ~192 bytes (typical)
/// Serialization: <0.12ms P95 (target: <0.5ms) ✅
/// Deserialization: <0.015ms P95 (target: <0.1ms) ✅ (zero-copy)
///
/// Usage patterns:
/// - Phase 2 (Selection): Orchestrator broadcasts Selection to all agents
/// - Winner notification: Selected agent starts execution
/// - Loser notification: Rejected agents release resources, update scoreboard
/// - Backup planning: If winner fails/times out, retry with backup_agent_ids[0]
table Selection {
  /// Task ID from TaskAnnouncement
  task_id: string (required);

  // Winner
  /// Selected agent ID (winner)
  selected_agent_id: string (required);

  /// Selected proposal ID (from winning agent)
  selected_proposal_id: string (required);

  // Rationale
  /// Rationale for selection (why this agent was chosen)
  rationale: string;

  /// Selection score (confidence * latency^-1 * cost^-1)
  selection_score: float32 = 0.0;

  // Backup agents (for fallback if winner fails)
  /// Backup agent IDs (ordered by preference, fallback if winner fails)
  backup_agent_ids: [string];

  // Timestamps
  /// Unix timestamp (ms) when selection was made
  selected_at_ms: uint64 = 0;

  /// Unix timestamp (ms) deadline for Phase 3 execution
  execution_deadline_ms: uint64 = 0;
}

root_type Selection;
file_identifier "SELN";
