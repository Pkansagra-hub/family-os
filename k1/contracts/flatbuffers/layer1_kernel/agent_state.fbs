// agent_state.fbs
// Layer 1 Core Kernel Schema: Agent Lifecycle State
// Source ADR: ADR-0012a (Layer 1 Core Kernel Schemas)
// File Identifier: AGST
// Version: 1.2

namespace k1.agent_fabric;

/// Agent lifecycle states (6-state FSM)
/// State transitions: PENDING → WARMING → ACTIVE → IDLE → DRAINING → TERMINATED
/// Reference ADR: ADR-0005 (Agent Lifecycle FSM)
enum AgentLifecycleState : uint8 {
  PENDING = 0,      // Not yet started
  WARMING = 1,      // Loading model/resources
  ACTIVE = 2,       // Executing tasks
  IDLE = 3,         // No tasks, ready
  DRAINING = 4,     // Finishing tasks before termination
  TERMINATED = 5    // Stopped
}

/// Agent capability types (capability-based security)
/// Reference ADR: ADR-0002 (Actor Model Agent Isolation)
enum CapabilityType : uint8 {
  TOOL_CALL = 0,
  MEMORY_READ = 1,
  MEMORY_WRITE = 2,
  LLM_INFERENCE = 3,
  MULTIMODAL = 4,
  VISION = 5,
  AUDIO = 6
}

/// Agent state snapshot
///
/// Represents the current state of an agent in the K1 agent fabric.
/// Used for agent lifecycle management, hiring decisions, performance tracking,
/// and crash detection/blacklist management.
///
/// Size: ~256 bytes (typical)
/// Serialization: <0.15ms P95 (target: <0.5ms) ✅
/// Deserialization: <0.018ms P95 (target: <0.1ms) ✅ (zero-copy)
///
/// Usage patterns:
/// - Agent lifecycle management: Supervisor monitors state transitions
/// - Hiring decisions: Check capabilities, memory_mb, blacklisted flag
/// - Performance tracking: tasks_completed, avg_latency_ms for scoreboard
/// - Crash detection: crash_count >= 3 → blacklist for 1 hour
table AgentState {
  /// Unique agent identifier (ULID format: 26 characters)
  agent_id: string (required);

  /// Current FSM state (default: PENDING)
  state: AgentLifecycleState = PENDING;

  // Capabilities (capability-based security)
  /// Capabilities granted to agent (TOOL_CALL, MEMORY_READ, etc.)
  capabilities: [CapabilityType];

  // Resource usage
  /// Memory allocated to agent in megabytes (0 = not yet allocated)
  memory_mb: uint32 = 0;

  /// CPU usage percentage (0.0-100.0)
  cpu_percent: float32 = 0.0;

  // Lifecycle timestamps (Unix timestamps in milliseconds)
  /// Timestamp when agent was created
  created_at_ms: uint64 = 0;

  /// Timestamp when warmup phase started
  warmup_start_ms: uint64 = 0;

  /// Timestamp when warmup phase completed
  warmup_end_ms: uint64 = 0;

  /// Timestamp when agent became idle (no tasks)
  idle_since_ms: uint64 = 0;

  /// Timestamp when draining phase started
  draining_start_ms: uint64 = 0;

  /// Timestamp when agent was terminated
  terminated_at_ms: uint64 = 0;

  // Performance metrics
  /// Total tasks completed successfully
  tasks_completed: uint32 = 0;

  /// Total tasks failed
  tasks_failed: uint32 = 0;

  /// Average task latency in milliseconds
  avg_latency_ms: float32 = 0.0;

  // Crash tracking (blacklist management)
  /// Number of crashes (threshold: 3 → blacklist for 1 hour)
  crash_count: uint8 = 0;

  /// Unix timestamp (ms) of last crash
  last_crash_time_ms: uint64 = 0;

  /// Whether agent is blacklisted (after 3 crashes)
  blacklisted: bool = false;
}

root_type AgentState;
file_identifier "AGST";
