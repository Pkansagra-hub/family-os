// feedback_signal.fbs
// Layer 1 Core Kernel Schema: Feedback Signal
// Source ADR: ADR-0012a (Layer 1 Core Kernel Schemas)
// File Identifier: FBSG
// Version: 1.0

namespace k1.learning_loop;

/// Feedback signal types (with weights)
enum SignalType : uint8 {
  EXPLICIT = 0,      // User thumbs up/down (weight: 1.0)
  IMPLICIT = 1,      // User engagement metrics (weight: 0.5)
  BEHAVIORAL = 2     // System performance metrics (weight: 0.2)
}

/// Feature update (model adjustment)
table FeatureUpdate {
  /// Feature name (e.g., "agent_selection_score", "tool_latency_weight")
  feature_name: string (required);

  /// Old feature value (before update)
  old_value: float32 = 0.0;

  /// New feature value (after update)
  new_value: float32 = 0.0;

  /// Delta (new_value - old_value)
  delta: float32 = 0.0;
}

/// Feedback signal (adaptive learning)
///
/// Feedback signal for adaptive learning loop.
/// Three signal types: EXPLICIT (user feedback), IMPLICIT (engagement), BEHAVIORAL (system metrics).
///
/// Size: ~448 bytes (typical)
/// Serialization: <0.28ms P95 (target: <0.5ms) ✅
/// Deserialization: <0.035ms P95 (target: <0.1ms) ✅ (zero-copy)
///
/// Usage patterns:
/// - Signal collection: Collect feedback signals from users, agents, tools
/// - Weight-based aggregation: Apply weights (EXPLICIT: 1.0, IMPLICIT: 0.5, BEHAVIORAL: 0.2)
/// - Feature updates: Update model features (agent selection scores, tool latency weights, etc.)
/// - Drift detection: Monitor distribution_shift (KL divergence), trigger retraining if threshold exceeded
///
/// Example Feedback Signals:
/// 1. EXPLICIT (weight 1.0):
///    - User thumbs down on response
///    - feature_updates: [agent_selection_score: 0.8 → 0.6 (delta: -0.2)]
///
/// 2. IMPLICIT (weight 0.5):
///    - User engagement: 3 follow-up questions
///    - feature_updates: [conversation_quality: 0.7 → 0.75 (delta: +0.05)]
///
/// 3. BEHAVIORAL (weight 0.2):
///    - Tool latency: 1200ms (above budget)
///    - feature_updates: [tool_latency_weight: 0.5 → 0.6 (delta: +0.1)]
///
/// Drift Detection:
/// - distribution_shift > 0.1 → trigger retraining
/// - KL divergence: D_KL(P || Q) = Σ P(x) log(P(x) / Q(x))
table FeedbackSignal {
  /// Unique signal identifier (ULID format)
  signal_id: string (required);

  /// Signal type (EXPLICIT, IMPLICIT, BEHAVIORAL)
  signal_type: SignalType (required);

  /// Signal weight (1.0 for EXPLICIT, 0.5 for IMPLICIT, 0.2 for BEHAVIORAL)
  weight: float32 = 1.0;

  // Source metadata
  /// Turn ID that generated this signal
  source_turn_id: string (required);

  /// Agent ID that generated this signal (optional)
  source_agent_id: string;

  /// Tool ID that generated this signal (optional)
  source_tool_id: string;

  // Feature updates (model adjustments)
  /// List of feature updates (model adjustments)
  feature_updates: [FeatureUpdate];

  // Drift detection
  /// Distribution shift metric (KL divergence or similar)
  distribution_shift: float32 = 0.0;

  // Timestamps
  /// Unix timestamp (ms) when signal was received
  received_at_ms: uint64 = 0;

  /// Unix timestamp (ms) when signal was applied to model
  applied_at_ms: uint64 = 0;
}

root_type FeedbackSignal;
file_identifier "FBSG";
