// agent_hire_request.fbs
// Layer 1 Core Kernel Schema: Agent Hire Request
// Source ADR: ADR-0012a (Layer 1 Core Kernel Schemas)
// File Identifier: AHIR
// Version: 1.0

namespace k1.agent_fabric;

/// Agent capability types (referenced from agent_state.fbs)
enum CapabilityType : uint8 {
  TOOL_CALL = 0,
  MEMORY_READ = 1,
  MEMORY_WRITE = 2,
  LLM_INFERENCE = 3,
  MULTIMODAL = 4,
  VISION = 5,
  AUDIO = 6
}

/// Agent hire request (Contract Net Protocol)
///
/// Request to hire an agent with specified capabilities and resource budget.
/// Part of Agent Hire Protocol (MPST-validated).
///
/// Size: ~192 bytes (typical)
/// Serialization: <0.12ms P95 (target: <0.5ms) ✅
/// Deserialization: <0.015ms P95 (target: <0.1ms) ✅ (zero-copy)
///
/// Usage patterns:
/// - Agent hiring protocol: Supervisor receives request, searches eligible agents
/// - Resource allocation: Check memory_budget_mb against available memory
/// - Timeout enforcement: Reject if warmup_timeout_ms exceeded
/// - Priority scheduling: Higher priority requests processed first
///
/// MPST Protocol Flow:
/// Orchestrator → Supervisor: AgentHireRequest (AHIR)
/// Supervisor → Orchestrator: AgentHireResponse (AHRS) [SUCCESS/REJECTED/TIMEOUT]
table AgentHireRequest {
  /// Unique request identifier (ULID format)
  request_id: string (required);

  // Requirements
  /// Required capabilities for the agent (TOOL_CALL, MEMORY_READ, etc.)
  required_capabilities: [CapabilityType] (required);

  /// Memory budget in megabytes (default: 512MB)
  memory_budget_mb: uint32 = 512;

  /// Maximum warmup timeout in milliseconds (default: 200ms)
  warmup_timeout_ms: uint32 = 200;

  // Priority (higher = more urgent)
  /// Priority level (0-10 scale, default: 5)
  priority: uint8 = 5;

  // Context
  /// Turn ID that triggered this hire request
  turn_id: string;

  /// Task ID associated with this hire request
  task_id: string;

  // Timestamps
  /// Unix timestamp (ms) when request was created
  requested_at_ms: uint64 = 0;

  /// Unix timestamp (ms) deadline for hire completion (0 = no deadline)
  deadline_ms: uint64 = 0;
}

root_type AgentHireRequest;
file_identifier "AHIR";
