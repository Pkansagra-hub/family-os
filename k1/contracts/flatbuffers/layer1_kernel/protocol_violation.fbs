// protocol_violation.fbs
// Layer 1 Core Kernel Schema: Protocol Violation
// Source ADR: ADR-0012a (Layer 1 Core Kernel Schemas)
// File Identifier: PRVI
// Version: 1.0

namespace k1.protocol_monitor;

/// Violation types
enum ViolationType : uint8 {
  INVALID_TRANSITION = 0,    // Message sent in wrong state
  TIMEOUT = 1,               // Deadline exceeded
  MISSING_MESSAGE = 2,       // Expected message never arrived
  DUPLICATE_MESSAGE = 3,     // Message sent twice
  PARTICIPANT_DROPPED = 4    // Participant crashed/disconnected
}

/// Protocol violation event
///
/// Protocol violation detected by MPST validator.
/// Includes violation details and recovery action.
///
/// Size: ~256 bytes (typical)
/// Serialization: <0.18ms P95 (target: <0.5ms) ✅
/// Deserialization: <0.022ms P95 (target: <0.1ms) ✅ (zero-copy)
///
/// Usage patterns:
/// - Violation detection: Protocol monitor checks messages against ProtocolState
/// - Recovery actions: ABORT (terminate protocol), RETRY (resend message), FALLBACK (alternative path)
/// - Logging: Log violation with detected_at_ms for debugging
/// - Metrics: Increment violation counters by violation_type
///
/// Example Violations:
/// 1. INVALID_TRANSITION:
///    - Expected state: PROPOSING, Actual state: IDLE
///    - Violating message: Selection (sent too early)
///    - Recovery: ABORT protocol
///
/// 2. TIMEOUT:
///    - Expected state: REQUESTING, Actual state: REQUESTING (no response)
///    - Deadline: 1000ms, Current: 1200ms
///    - Recovery: RETRY with exponential backoff
///
/// 3. PARTICIPANT_DROPPED:
///    - Violator: agent-123 (crashed)
///    - Recovery: FALLBACK to backup agent
table ProtocolViolation {
  /// Unique violation identifier (ULID format)
  violation_id: string (required);

  /// Protocol ID from ProtocolState.protocol_id
  protocol_id: string (required);

  /// Violation type (INVALID_TRANSITION, TIMEOUT, etc.)
  violation_type: ViolationType (required);

  // Violation details
  /// Expected state (what protocol expected)
  expected_state: string;

  /// Actual state (what actually happened)
  actual_state: string;

  /// Violating message type (e.g., "Selection", "Proposal")
  violating_message: string;

  /// Violator ID (agent ID or component name that caused violation)
  violator_id: string;

  // Recovery action
  /// Recovery action (ABORT, RETRY, FALLBACK)
  recovery_action: string (required);

  // Timestamps
  /// Unix timestamp (ms) when violation was detected
  detected_at_ms: uint64 = 0;
}

root_type ProtocolViolation;
file_identifier "PRVI";
