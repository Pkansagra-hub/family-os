// agent_capability.fbs
// Layer 1 Core Kernel Schema: Agent Capability Descriptor
// Source ADR: ADR-0012a (Layer 1 Core Kernel Schemas)
// File Identifier: ACAP
// Version: 1.0

namespace k1.agent_fabric;

/// Agent capability types (referenced from agent_state.fbs)
/// Defines what an agent can do (capability-based security)
enum CapabilityType : uint8 {
  TOOL_CALL = 0,
  MEMORY_READ = 1,
  MEMORY_WRITE = 2,
  LLM_INFERENCE = 3,
  MULTIMODAL = 4,
  VISION = 5,
  AUDIO = 6
}

/// Key-value pair for capability parameters
/// Used to store capability-specific configuration
table KeyValue {
  /// Parameter key
  key: string (required);

  /// Parameter value (string representation)
  value: string (required);
}

/// Capability descriptor (what an agent can do)
///
/// Represents a capability granted to an agent with fine-grained permissions.
/// Used for capability-based security, permission enforcement, and expiration.
///
/// Size: ~128 bytes (typical)
/// Serialization: <0.08ms P95 (target: <0.3ms) ✅
/// Deserialization: <0.012ms P95 (target: <0.05ms) ✅ (zero-copy)
///
/// Usage patterns:
/// - Capability checking: Verify agent has TOOL_CALL capability before execution
/// - Permission enforcement: Check invocations_used < max_invocations
/// - Expiration enforcement: Check expires_at_ms > current_time_ms
/// - Parameter binding: Extract parameters for capability-specific logic
table AgentCapability {
  /// Unique capability identifier (ULID format)
  capability_id: string (required);

  /// Type of capability (TOOL_CALL, MEMORY_READ, etc.)
  capability_type: CapabilityType (required);

  // Capability-specific parameters
  /// Parameters for this capability (e.g., tool_id, memory_space_id)
  parameters: [KeyValue];

  // Permissions
  /// Maximum invocations allowed (0 = unlimited)
  max_invocations: uint32 = 0;

  /// Number of invocations used so far
  invocations_used: uint32 = 0;

  // Expiration
  /// Unix timestamp (ms) when capability expires (0 = never expires)
  expires_at_ms: uint64 = 0;
}

root_type AgentCapability;
file_identifier "ACAP";
