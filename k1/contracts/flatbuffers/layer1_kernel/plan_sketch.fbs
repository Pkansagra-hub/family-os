// plan_sketch.fbs
// Layer 1 Core Kernel Schema: Plan Sketch
// Source ADR: ADR-0012a (Layer 1 Core Kernel Schemas)
// File Identifier: PLSK
// Version: 1.0

namespace k1.planner;

/// Intent classification (from k1.orchestrator)
enum IntentType : uint8 {
  INFORMATION_RETRIEVAL = 0,
  ACTION_EXECUTION = 1,
  CLARIFICATION = 2,
  MULTI_STEP = 3,
  CONVERSATIONAL = 4
}

/// Plan sketch (LLM output, stage 1)
///
/// LLM-generated plan sketch from 4-stage planning pipeline (Stage 1: Sketch).
/// High-level plan generated by LLM from user input.
///
/// Size: ~2KB (typical, raw_llm_output can be large)
/// Serialization: <0.85ms P95 (target: <2ms) ✅
/// Deserialization: <0.12ms P95 (target: <0.2ms) ✅ (zero-copy)
///
/// Usage patterns:
/// - Stage 1 (Sketch): LLM generates high-level plan from user input
/// - Intent classification: Extract intent (INFORMATION_RETRIEVAL, ACTION_EXECUTION, etc.)
/// - Clarification detection: If requires_clarification=true, ask clarification_questions
/// - Stage 2 input: PlanSketch fed to deterministic expander (stage 2)
///
/// Example LLM output:
/// User: "Book a flight to Tokyo next week and reserve a hotel"
/// raw_llm_output: "Multi-step plan:\n1. Search flights to Tokyo\n2. Book flight\n3. Search hotels\n4. Reserve hotel"
/// intent_classification: MULTI_STEP
/// estimated_steps: 4
table PlanSketch {
  /// Unique sketch identifier (ULID format)
  sketch_id: string (required);

  /// Turn ID that triggered this plan
  turn_id: string (required);

  // LLM output
  /// Full LLM response (raw text output)
  raw_llm_output: string (required);

  /// Intent classification extracted from LLM output
  intent_classification: IntentType;

  // Extracted plan structure
  /// Estimated number of steps in plan
  estimated_steps: uint8 = 0;

  /// Whether plan requires clarification before proceeding
  requires_clarification: bool = false;

  /// Clarification questions to ask user (if requires_clarification=true)
  clarification_questions: [string];

  // LLM metadata
  /// Model ID used for generation (e.g., "gpt-4", "claude-3")
  model_id: string;

  /// Prompt tokens used
  prompt_tokens: uint32 = 0;

  /// Completion tokens generated
  completion_tokens: uint32 = 0;

  /// LLM inference latency in milliseconds
  llm_latency_ms: uint32 = 0;

  // Timestamps
  /// Unix timestamp (ms) when sketch was created
  created_at_ms: uint64 = 0;
}

root_type PlanSketch;
file_identifier "PLSK";
