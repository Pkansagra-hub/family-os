// session_state.fbs
// Production-ready FlatBuffers schema for SessionState (6 sections)
// Performance targets: serialization <1ms P95, delta-efficient, WAL-friendly
// ADR references: ADR-0002, ADR-0011, ADR-0012, ADR-0038b, ADR-0061, ADR-0061a, ADR-0086
// File Identifier: SSSN
// Version: 2.0 (production upgrade)

namespace k1.l4_runtime.session_state.model;

// ============================================================================
// ENUMS: Strong typing for cardinality-constrained fields
// ============================================================================

/// Multimodal input type
enum Modality:ubyte {
  UNKNOWN = 0,
  AUDIO = 1,
  TEXT = 2,
  VISION = 3
}

/// Persona tone (conversation style)
enum Tone:ubyte {
  DEFAULT = 0,
  FORMAL = 1,
  CASUAL = 2,
  EMPATHETIC = 3,
  PROFESSIONAL = 4
}

/// Backpressure severity tier (3-tier cascade from ADR-0061)
enum BackpressureTier:ubyte {
  NONE = 0,
  WARN = 1,      // 80% threshold
  DEGRADE = 2,   // 90% threshold
  REJECT = 3     // 95% threshold
}

/// Compression algorithm for payload
enum Compression:ubyte {
  NONE = 0,
  GZIP = 1,
  ZSTD = 2
}

/// Checksum algorithm for integrity verification
enum ChecksumAlgo:ubyte {
  NONE = 0,
  XXH3 = 1,      // Fast non-cryptographic hash
  BLAKE3 = 2     // Cryptographic hash
}

/// Task/proposal status
enum TaskStatus:ubyte {
  PENDING = 0,
  NEGOTIATING = 1,
  EXECUTING = 2,
  COMPLETED = 3,
  FAILED = 4,
  CANCELLED = 5
}

/// Score basis (selection algorithm used)
enum ScoreBasis:ubyte {
  UNKNOWN = 0,
  MADM_6FACTOR = 1,    // Multi-Attribute Decision Making
  BANDIT_UCB = 2,      // Upper Confidence Bound
  HEURISTIC = 3,       // Rule-based
  THERMAL = 4          // Thermal placement
}

/// Privacy/PII band (ADR P10 redaction policy)
enum RedactionBand:ubyte {
  GREEN = 0,     // Public, no redaction
  AMBER = 1,     // Sensitive, log with care
  RED = 2        // Private, never log
}

// ============================================================================
// STRUCTS: Zero-copy hot-path data (fixed size, no pointers)
// ============================================================================

/// Agent score (performance tracking for selection, zero-copy struct)
/// Used in hot path for agent selection (MADM 6-factor scoring)
struct AgentScore {
  agent_id: uint32;          // Packed agent ID (ULID → uint32 mapping)
  score: float32;            // Composite score 0.0-1.0
  confidence: float32;       // Confidence in score 0.0-1.0
  basis: ScoreBasis;         // Algorithm used for scoring
  tasks_completed: uint16;   // Success count
  tasks_failed: uint16;      // Failure count
  latency_p95_ms: float32;   // P95 latency
  last_used_ms: uint64;      // Last task assignment timestamp
}

/// Tool score (tool success rate tracking, zero-copy struct)
struct ToolScore {
  tool_id: uint32;           // Packed tool ID
  score: float32;            // Success rate 0.0-1.0
  confidence: float32;       // Confidence in score
  basis: ScoreBasis;         // Scoring algorithm
  calls_total: uint16;       // Total invocations
  calls_success: uint16;     // Successful calls
  avg_latency_ms: float32;   // Average latency
  last_used_ms: uint64;      // Last invocation timestamp
}

// ============================================================================
// BLOB REFERENCES: Immutable multimodal content (hash-addressed)
// ============================================================================

/// Blob reference (audio/vision stored in K0, not in SessionState)
/// Keeps SessionState <10 MB and deltas tiny (250ms K0 flush cadence)
table BlobRef {
  store: string;             // Storage backend ("k0_mm", "s3", etc.)
  key: string;               // Content hash (SHA256 or BLAKE3)
  size_bytes: uint32;        // Blob size for eviction decisions
  created_at_ms: uint64;     // Creation timestamp
  mime_type: string;         // Content type (e.g., "audio/opus")
}

// ============================================================================
// BELIEFS SECTION: User facts, world knowledge, context
// ============================================================================

/// User fact (single belief with provenance and privacy band)
table UserFact {
  id: string;                // Stable fact ID (ULID)
  key: string;               // Fact key (e.g., "user.name")
  value: string;             // Fact value
  confidence: float32 = 1.0; // 0.0-1.0
  source: string;            // Provenance: "user_input" | "tool_result" | "inference"
  turn_id: string;           // Turn where fact originated
  created_at_ms: uint64 = 0; // Creation timestamp
  updated_at_ms: uint64 = 0; // Last update timestamp
  last_accessed_ms: uint64 = 0; // LRU tracking for eviction
  pii_band: RedactionBand = GREEN; // Privacy classification
}

/// World knowledge (general facts, relations)
table WorldKnowledge {
  id: string;                // Stable knowledge ID
  entity: string;            // Subject entity
  relation: string;          // Relation type
  target: string;            // Object entity
  confidence: float32 = 1.0; // 0.0-1.0
  hash: string;              // Content hash for deduplication
  created_at_ms: uint64 = 0; // Creation timestamp
}

/// Temporal context (time-based session info)
table TemporalContext {
  now_ms: uint64 = 0;        // Current session time
  timezone: string;          // IANA timezone (e.g., "America/Los_Angeles")
  session_start_ms: uint64 = 0; // Session start time
}

/// Spatial context (location-based session info)
table SpatialContext {
  room: string;              // Coarse location (e.g., "living_room")
  coarse_location: string;   // City/region (e.g., "Seattle, WA")
  latitude: float64 = 0.0;   // Optional precise coordinates
  longitude: float64 = 0.0;
  accuracy_meters: float32 = 0.0;
}

/// Beliefs section (user model, context, facts)
/// Tier 1 eviction priority (evict first under memory pressure)
table BeliefsSection {
  updated_at_ms: uint64 = 0; // Per-section timestamp for delta tracking
  user_facts: [UserFact];    // Max 100 entries, 16KB soft limit
  world_knowledge: [WorldKnowledge]; // Max 50 entries
  temporal: TemporalContext;
  spatial: SpatialContext;
  section_size_bytes: uint32 = 0; // Computed size for eviction heuristics
}

// ============================================================================
// SCOREBOARD SECTION: Agent/tool performance tracking
// ============================================================================

/// Scoreboard section (performance metrics for agent selection)
/// Uses zero-copy structs for hot-path MADM scoring
table ScoreboardSection {
  updated_at_ms: uint64 = 0; // Per-section timestamp
  agent_scores: [AgentScore]; // Struct vector (zero-copy, max 20 entries)
  tool_scores: [ToolScore];   // Struct vector (zero-copy, max 30 entries)
  section_size_bytes: uint32 = 0;
}

// ============================================================================
// CONTROL SECTION: Orchestration state, contract-net artifacts
// ============================================================================

/// Active task (in-flight execution)
table ActiveTask {
  id: string;                // Stable task ID (ULID)
  parent_id: string;         // Parent task ID (for subtasks)
  turn_id: string;           // Originating turn ID
  agent_id: string;          // Assigned agent ID
  status: TaskStatus = PENDING; // Current status
  started_at_ms: uint64 = 0; // Start timestamp
  deadline_ms: uint64 = 0;   // Hard deadline
  updated_at_ms: uint64 = 0; // Last status change
}

/// Pending proposal (Contract Net Protocol bidding)
table PendingProposal {
  id: string;                // Stable proposal ID (ULID)
  task_id: string;           // Task being bid on
  proposer_id: string;       // Agent ID proposing
  estimated_latency_ms: uint32 = 0; // Bid latency estimate
  confidence_score: float32 = 0.0;  // Bid confidence
  ttl_ms: uint32 = 5000;     // Proposal expiry (default 5s)
  created_at_ms: uint64 = 0; // Creation timestamp
}

/// Saga checkpoint (distributed transaction rollback, Garcia-Molina 1987)
table SagaCheckpoint {
  id: string;                // Stable checkpoint ID (ULID)
  task_id: string;           // Task being checkpointed
  stage: string;             // Saga stage identifier
  payload_hash: string;      // Hash of checkpoint payload (stored in K0)
  compensation_action: string; // Rollback action descriptor
  created_at_ms: uint64 = 0; // Checkpoint timestamp
}

/// Backpressure state (3-tier cascade, ADR-0061/0061a)
table BackpressureState {
  tier: BackpressureTier = NONE; // Current severity
  queue_depth: uint32 = 0;   // Mailbox depth
  latency_p95_ms: float32 = 0.0; // Recent P95 latency
  throttling_enabled: bool = false; // Degradation active?
  rejection_enabled: bool = false;  // Rejection active?
  last_event_ms: uint64 = 0; // Last state change
}

/// Control section (orchestration, backpressure, saga)
/// Tier 3 eviction priority (last resort, keep scoreboard)
table ControlSection {
  updated_at_ms: uint64 = 0; // Per-section timestamp
  active_tasks: [ActiveTask]; // Max 10 entries
  pending_proposals: [PendingProposal]; // Max 50 entries
  saga_checkpoints: [SagaCheckpoint];   // Max 5 entries
  backpressure: BackpressureState;
  section_size_bytes: uint32 = 0;
}

// ============================================================================
// PERSONA SECTION: Agent personality, tone, language
// ============================================================================

/// Persona section (user-facing personality model)
table PersonaSection {
  updated_at_ms: uint64 = 0; // Per-section timestamp
  agent_type: string;        // Persona label (e.g., "assistant")
  traits: [string];          // OCEAN traits or bitset (["openness:0.8", "conscientiousness:0.6"])
  tone: Tone = DEFAULT;      // Conversation style
  language: string;          // BCP-47 language tag (e.g., "en-US")
  section_size_bytes: uint32 = 0;
}

// ============================================================================
// MULTIMODAL SECTION: Blob references + text history
// ============================================================================

/// Multimodal section (audio/text/vision references)
/// Tier 2 eviction priority (evict after beliefs)
/// Audio/vision stored as blob handles (not raw bytes) to keep deltas tiny
table MultimodalSection {
  updated_at_ms: uint64 = 0; // Per-section timestamp
  audio: BlobRef;            // Audio blob reference (not raw bytes)
  vision: BlobRef;           // Vision blob reference (not raw bytes)
  text_history: [string];    // Recent utterances (max 20, rolling window)
  last_modality: Modality = UNKNOWN; // Most recent input modality
  section_size_bytes: uint32 = 0;
}

// ============================================================================
// META SECTION: Schema metadata, checksum, redaction policy
// ============================================================================

/// Meta section (schema version, integrity, privacy)
table MetaSection {
  schema_version: string;    // Schema version (e.g., "2.0")
  checksum: string;          // Integrity checksum (hex)
  checksum_algo: ChecksumAlgo = XXH3; // Checksum algorithm
  compression: Compression = NONE;    // Payload compression
  created_at_ms: uint64 = 0; // Session creation timestamp
  updated_at_ms: uint64 = 0; // Last update timestamp
  notes: string;             // Human-readable annotations
  redaction_band: RedactionBand = GREEN; // Overall privacy band
}

// ============================================================================
// ROOT: SessionState (6 sections + delta tracking)
// ============================================================================

/// Top-level SessionState (production-ready, delta-efficient, WAL-friendly)
///
/// Delta protocol (ADR-0038b):
/// - change_mask bits 0..5 → {beliefs, scoreboard, control, persona, multimodal, meta}
/// - Deltas carry only changed sections; receiver merges by seq_no (idempotent)
/// - Blob lifecycles handled by K0 Bridge (250ms cadence, hash-addressed immutables)
///
/// Performance budgets:
/// - Serialization: <1ms P95 (target: 0.5ms typical)
/// - Deserialization: <1ms P95 (zero-copy reads)
/// - Delta merge: <10ms P95
/// - Memory footprint: <10MB per session
///
/// Eviction priorities (3-tier cascade):
/// - Tier 1: beliefs (least recent user_facts)
/// - Tier 2: multimodal (oldest blob references)
/// - Tier 3: scoreboard (last resort, keep control)
table SessionState {
  // Core identifiers
  session_id: string (required); // Stable session ID (ULID)
  user_id: string;               // User identifier
  trace_id: string;              // OpenTelemetry trace ID (cognitive_trace_id)

  // Versioning & delta tracking (WAL-friendly)
  version: uint16 = 1;           // Schema version compatibility
  seq_no: uint64 = 0;            // Monotonic sequence number for WAL ordering
  change_mask: uint64 = 0;       // Section delta bitmap (bits 0..5)

  // Size tracking (advisory for eviction heuristics)
  total_size_bytes: uint32 = 0;  // Computed by serializer, advisory for client

  // Six sections (production-ready with delta support)
  beliefs: BeliefsSection;       // Section 1: User facts, context
  scoreboard: ScoreboardSection; // Section 2: Performance metrics
  control: ControlSection;       // Section 3: Orchestration state
  persona: PersonaSection;       // Section 4: Personality model
  multimodal: MultimodalSection; // Section 5: Blob references
  meta: MetaSection;             // Section 6: Schema metadata
}

root_type SessionState;
file_identifier "SSSN";

// Production notes:
// - Blob hygiene: Store multimodal content as hash-addressed blobs in K0, not raw bytes
// - Delta efficiency: change_mask + seq_no enable WAL-friendly incremental updates
// - Privacy: RedactionBand + pii_band tags enable P10 redaction policy
// - Zero-copy: Structs (AgentScore, ToolScore) avoid pointer chasing in hot paths
// - Evolution: Enums enable forward-compat schema evolution
// - Performance: Targets <1ms P95 serialization with typical sessions <10MB
