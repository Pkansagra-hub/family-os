// session_state_root.fbs
// Layer 2 State & Persistence: SessionState Root Container
//
// Source ADR: ADR-0012b (Layer 2 State & Persistence Schemas)
// Related ADRs: ADR-0017 (SessionState 6-Section Design), ADR-0019 (FlatBuffers Serialization)
//
// Performance Targets:
// - Serialize: 0.62ms P95 (48-64KB typical)
// - Deserialize: 0.038ms P95 (zero-copy)
// - Memory overhead: 7.2% (vtables, string pointers)
//
// Research: Working Memory (Baddeley & Hitch 1974), Actor Model State Management

namespace k1.session_state;

// Root container for SessionState (6 sections, 64KB soft limit)
table SessionStateRoot {
  session_id: string (required);

  // 6 SessionState sections (from ADR-0017)
  beliefs: BeliefsSection;          // 16KB soft limit - User facts, preferences
  scoreboard: ScoreboardSection;    // 8KB soft limit - Agent performance tracking
  control: ControlSection;          // 12KB soft limit - Orchestration state
  persona: PersonaSection;          // 8KB soft limit - User persona/preferences
  multimodal: MultimodalSection;    // 16KB soft limit - Audio/vision context
  meta: MetaSection;                // 4KB soft limit - Telemetry, timestamps

  // Total memory tracking (3-tier eviction strategy)
  total_size_bytes: uint32 = 0;
  soft_limit_bytes: uint32 = 65536;  // 64KB soft limit
  hard_limit_bytes: uint32 = 131072; // 128KB hard limit

  // Eviction metadata (ADR-0018: 3-Tier Eviction Strategy)
  hot_tier_size: uint32 = 0;         // Frequently accessed
  warm_tier_size: uint32 = 0;        // Occasionally accessed
  cold_tier_size: uint32 = 0;        // Rarely accessed

  // Timestamps (Unix milliseconds)
  created_at_ms: uint64 = 0;
  updated_at_ms: uint64 = 0;
  last_eviction_ms: uint64 = 0;
}

// Metadata section (4KB soft limit)
table MetaSection {
  version: uint32 = 1;
  schema_version: string;
  checksum: uint32 = 0;              // CRC32 checksum for integrity
  compressed: bool = false;
}

// Beliefs section stub (defined in beliefs_section.fbs)
table BeliefsSection {}

// Scoreboard section stub (defined in scoreboard_section.fbs)
table ScoreboardSection {}

// Control section stub (defined in control_section.fbs)
table ControlSection {}

// Persona section stub (defined in persona_section.fbs)
table PersonaSection {}

// Multimodal section stub (defined in multimodal_section.fbs)
table MultimodalSection {}

root_type SessionStateRoot;
file_identifier "SEST";
