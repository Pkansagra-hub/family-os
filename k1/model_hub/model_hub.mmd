flowchart TB
  %% ======================================================================================
  %% K1 MODEL HUB -- Capability-Driven Plugin Architecture (Production-Grade)
  %% ======================================================================================
  %% Updated: 2026-02-06
  %% ADR: 0001b (Model Hub Architecture & LLM Integration)
  %% Related ADRs: 0001, 0005, 0007, 0027 (Placement Cascade), 0027c (Cost-Aware Fallback),
  %%               0027d (Remote Resilience)
  %% ======================================================================================

  %% DESIGN PRINCIPLES:
  %%   1. CAPABILITY-DRIVEN -- Hub routes by capability, not by method name
  %%   2. PLUGIN ARCHITECTURE -- Providers are plugins loaded from manifests
  %%   3. ZERO HUB CHANGES to add a provider -- write manifest YAML + adapter class, register
  %%   4. ZERO HUB CHANGES to add a capability -- extend CapabilityType enum, implement in plugin
  %%   5. Hexagonal Architecture (Ports + Adapters) -- consistent with all K1 modules
  %%   6. Standalone module -- NOT embedded in Fabric (Fabric delegates to Model Hub)
  %%   7. Single Entry Point: IModelHubPort.execute(HubRequest) -- one method, all capabilities
  %%   8. Fabric keeps Prompt Management + Output Validation (SessionState dependent)
  %%   9. Edge-First: local model fallback when remote providers unavailable
  %%  10. Provider manifests are the SINGLE SOURCE OF TRUTH for provider capabilities,
  %%      models, costs, rate limits, circuit breaker config, and health checks

  %% ======================================================================================
  %% EXTENSIBILITY CONTRACT:
  %%
  %%   ADDING A NEW PROVIDER (e.g. Mistral, Cohere, xAI):
  %%     1. Create manifest: k1/config/providers/mistral.manifest.yaml
  %%     2. Implement IProviderPlugin (5 methods)
  %%     3. Place in k1/model_hub/plugins/mistral_plugin.py
  %%     4. ProviderRegistry auto-discovers on startup (scan plugins/ dir)
  %%     5. DONE -- no hub code changes, no routing changes, no config changes
  %%
  %%   ADDING A NEW CAPABILITY (e.g. CODE_EXEC, REALTIME_VOICE):
  %%     1. Add to CapabilityType enum in k1/model_hub/types.py
  %%     2. Define request/response schema in k1/contracts/model_hub/capabilities/
  %%     3. Update relevant provider plugins to declare + handle the capability
  %%     4. Update relevant provider manifests (capabilities[] list)
  %%     5. DONE -- CapabilityRouter auto-discovers, no hub service changes
  %%
  %%   ADDING A NEW MODEL to existing provider:
  %%     1. Edit the provider manifest YAML (add to models[] list)
  %%     2. Hot-reload picks it up within 30s (or restart)
  %%     3. DONE -- ModelSelector auto-includes in selection, CostTracker auto-prices
  %%
  %% ======================================================================================
  %%
  %% CAPABILITY TAXONOMY (Extensible -- add without hub changes)
  %% ======================================================================================
  %% | ID              | Name                    | Streamable | Description                                      |
  %% |-----------------|-------------------------|------------|--------------------------------------------------|
  %% | CHAT            | Chat Completion         | Yes        | Standard message-in, message-out                  |
  %% | TOOL_CALL       | Tool / Function Calling | Yes        | Messages + tool defs -> tool_use blocks + text    |
  %% | STRUCTURED      | Structured Output       | No         | Messages + JSON Schema -> schema-valid JSON       |
  %% | REASON          | Extended Thinking       | Yes        | Deep reasoning with thinking trace (o3, Claude)   |
  %% | EMBED           | Text Embedding          | No         | Text[] -> float[][] vectors                       |
  %% | VISION          | Vision (Image + Text)   | Yes        | Messages with image content -> text response      |
  %% | BATCH           | Batch Processing        | No         | HubRequest[] -> BatchID (async, ~50% cheaper)     |
  %% | MODERATE        | Content Moderation      | No         | Text -> safety categories + scores                |
  %% | TOKEN_COUNT     | Token Counting          | No         | Messages -> count (pre-request budget planning)   |
  %% | CACHE_PROMPT    | Prompt Caching          | No         | Cache management (explicit or auto)               |
  %% | AUDIO_IN        | Audio Input             | Yes        | Messages + audio -> text response                 |
  %% | TTS             | Text-to-Speech          | Yes        | Text + voice config -> audio bytes stream         |
  %% | IMAGE_GEN       | Image Generation        | No         | Prompt -> image bytes/URL                         |
  %% | WEB_SEARCH      | Web Search / Grounding  | No         | Query -> search results with citations            |
  %% | CODE_EXEC       | Code Execution          | No         | Code -> execution result (sandboxed)              |
  %% ======================================================================================
  %% New capabilities added to this table automatically become routable once at least
  %% one provider manifest declares support AND one plugin implements the handler.
  %% ======================================================================================
  %%
  %% PROVIDER MANIFEST SCHEMA (Declarative -- one YAML per provider)
  %% ======================================================================================
  %% File location: k1/config/providers/{provider_id}.manifest.yaml
  %%
  %% provider_id: string          # unique key (e.g. "openai", "anthropic", "ollama")
  %% display_name: string         # human label
  %% plugin_class: string         # Python class path (e.g. "k1.model_hub.plugins.openai_plugin.OpenAIPlugin")
  %% api_base: string             # base URL for API calls
  %% auth:
  %%   type: bearer | api_key_header | none
  %%   credential_key: string     # key in CredentialStore
  %%   header_name: string?       # custom header (e.g. "x-api-key" for Anthropic)
  %% capabilities: CapabilityType[]  # what this provider can do
  %% models:
  %%   - id: string               # model identifier (e.g. "gpt-4o")
  %%     capabilities: CapabilityType[]   # model-level capability subset
  %%     cost_per_1m_input: float         # USD per 1M input tokens
  %%     cost_per_1m_output: float        # USD per 1M output tokens
  %%     max_context: int                 # max context window tokens
  %%     max_output: int?                 # max output tokens (if different from context)
  %%     supports_streaming: bool         # default true
  %%     supports_parallel_tools: bool?   # for TOOL_CALL
  %%     embedding_dimensions: int?       # for EMBED models
  %%     rate_limit_rpm: int?             # requests per minute
  %%     rate_limit_tpm: int?             # tokens per minute
  %%     tier: FAST | STANDARD | PREMIUM  # performance tier hint
  %% circuit_breaker:
  %%   failure_threshold: int     # failures before OPEN (default 3)
  %%   failure_window_s: int      # window for counting failures (default 60)
  %%   cooldown_s: int            # OPEN duration before HALF_OPEN (default 30)
  %% health_check:
  %%   endpoint: string           # lightweight health endpoint
  %%   interval_s: int            # check interval (default 30)
  %%   timeout_s: int             # health check timeout (default 5)
  %% concurrency:
  %%   max_concurrent: int        # max parallel requests to this provider
  %% rate_limits:
  %%   rpm: int                   # requests per minute (provider-level)
  %%   tpm: int                   # tokens per minute (provider-level)
  %%   headroom_pct: float        # stay below this % of limit (default 0.80)
  %% placement:
  %%   type: remote | local_gpu | local_cpu   # where the provider runs
  %%   device_requirements: string?           # e.g. "CUDA GPU >= 8GB VRAM"
  %%
  %% ======================================================================================
  %% On startup, ProviderRegistry scans k1/config/providers/*.manifest.yaml,
  %% validates each manifest, instantiates the plugin_class, calls plugin.initialize(manifest),
  %% and registers in the capability index. Hot-reload watches for file changes.
  %% ======================================================================================
  %%
  %% LLM CALL MATRIX (from skeleton -- all consumers and budgets)
  %% ======================================================================================
  %% | Consumer                    | Capabilities Used                | Tokens  | Priority    |
  %% |-----------------------------|----------------------------------|---------|-------------|
  %% | Concierge TIER_MEDIUM       | CHAT, TOOL_CALL                  | ~2K     | INTERACTIVE |
  %% | Concierge TIER_HIGH         | CHAT, TOOL_CALL, REASON          | ~8K     | INTERACTIVE |
  %% | Concierge DISPATCHING       | CHAT                             | ~200    | REALTIME    |
  %% | Concierge DELIVERING        | CHAT, STRUCTURED                 | 500-8K  | REALTIME    |
  %% | Concierge CLARIFYING        | CHAT                             | ~300    | INTERACTIVE |
  %% | Concierge VISION            | VISION                           | ~2K     | INTERACTIVE |
  %% | Planner STAGE1_SKETCH       | CHAT, TOOL_CALL                  | ~2K     | INTERACTIVE |
  %% | Planner STAGE2_EXPAND       | CHAT, TOOL_CALL                  | ~1K     | INTERACTIVE |
  %% | Planner STAGE3_VALIDATE     | CHAT, STRUCTURED                 | ~500    | INTERACTIVE |
  %% | Planner HIL prompts         | CHAT                             | ~300    | INTERACTIVE |
  %% | Orchestrator EXEC_MONITOR   | CHAT                             | ~200    | BACKGROUND  |
  %% | Orchestrator SOL_VALIDATOR  | CHAT, STRUCTURED                 | ~500    | INTERACTIVE |
  %% | Curiosity Agent             | CHAT                             | ~300    | BACKGROUND  |
  %% | Proactive Decision          | CHAT                             | ~500    | BACKGROUND  |
  %% | Memory Writer Extraction    | CHAT, STRUCTURED                 | ~500    | BACKGROUND  |
  %% | Learning Extractor          | CHAT, STRUCTURED                 | ~1K     | BACKGROUND  |
  %% | Constitutional AI Filter    | MODERATE, CHAT                   | ~200    | BACKGROUND  |
  %% | Dynamic Agents              | Per AgentContract                | Varies  | Variable    |
  %% | Future: Document Processing | VISION (PDF)                     | ~4K     | INTERACTIVE |
  %% | Future: Voice Interface     | AUDIO_IN, TTS                    | ~2K     | REALTIME    |
  %% | Future: Embeddings          | EMBED                            | N/A     | BACKGROUND  |
  %% | Future: Batch Operations    | BATCH                            | Varies  | BACKGROUND  |
  %% ======================================================================================
  %%
  %% MH INVARIANTS (Non-Negotiable Rules -- MH-01 through MH-18)
  %% ======================================================================================
  %% MH-01: NEVER writes SessionState (read-only access for model selection context)
  %% MH-02: ALL provider credentials in CredentialStore (never in config/env/manifest)
  %% MH-03: Every request carries cognitive_trace_id (end-to-end tracing)
  %% MH-04: Budget enforcement is HARD -- request rejected if budget exceeded
  %% MH-05: Circuit breaker per provider (config from manifest, default 3/60s -> OPEN 30s)
  %% MH-06: Fallback cascade is capability-aware: only fail over to providers that support the capability
  %% MH-07: Cost tracking per request (token_count * model_cost from manifest)
  %% MH-08: Daily budget enforcement ($5/day default, configurable per tenant)
  %% MH-09: Response cache keyed by (capability, prompt_hash, model_id, temperature) -- TTL 5min
  %% MH-10: Streaming responses validated chunk-by-chunk (partial output gating)
  %% MH-11: All LLM calls audited: request_id, capability, model, tokens, latency, cost, trace_id
  %% MH-12: Rate limiting per provider (from manifest, default 80% headroom)
  %% MH-13: Model placement cascade: Local(NPU->GPU->CPU) -> Remote -> Cached -> Template
  %% MH-14: Provider health checked per manifest interval (default 30s)
  %% MH-15: Request timeout configurable per priority tier (REALTIME 10s, INTERACTIVE 30s, BACKGROUND 60s)
  %% MH-16: ALL traffic through RequestRouter -- single funnel, no direct provider access
  %% MH-17: Provider plugins are isolated -- one plugin crash does not affect others
  %% MH-18: Manifest is SOLE source of truth for provider capabilities (no hardcoded checks)
  %% ======================================================================================

  %% ======================================================================================
  %% MODULE HEADER
  %% ======================================================================================
  subgraph MODULE_HEADER["MODEL HUB -- Capability-Driven Plugin Architecture (ADR-0001b)"]
    direction TB

    MODULE_ID["Module: k1.model_hub<br/>Layer: L2.5 (Coordination / Infrastructure)<br/>Pattern: Capability-Driven Plugin Registry<br/>Owner: Model Hub<br/>Status: Production<br/>ADR: 0001b, 0027, 0027c, 0027d<br/>Invariants: MH-01..MH-18<br/>---<br/>EXTENSIBILITY:<br/>Add Provider: manifest YAML + IProviderPlugin impl (0 hub changes)<br/>Add Capability: extend CapabilityType + plugin handlers (0 hub changes)<br/>Add Model: edit provider manifest YAML (hot-reload, 0 restart)"]:::module_header
  end

  %% ======================================================================================
  %% CAPABILITY REGISTRY (Visual -- what the hub can route)
  %% ======================================================================================
  subgraph CAPABILITY_REGISTRY["Capability Registry (Runtime-Populated from Provider Manifests)"]
    direction TB

    CAP_CORE["CORE CAPABILITIES (Day 1)<br/>---<br/>CHAT: Standard chat completion (all providers)<br/>TOOL_CALL: Function calling with parallel support<br/>STRUCTURED: JSON Schema-constrained output<br/>REASON: Extended thinking / chain-of-thought<br/>TOKEN_COUNT: Pre-request token estimation"]:::capability

    CAP_MULTIMODAL["MULTIMODAL CAPABILITIES<br/>---<br/>VISION: Image + text input (GPT-4o, Claude, Gemini)<br/>AUDIO_IN: Audio input (GPT-4o-audio, Gemini)<br/>TTS: Text-to-speech output (OpenAI)<br/>IMAGE_GEN: Image generation (DALL-E, Imagen)"]:::capability

    CAP_OPS["OPERATIONAL CAPABILITIES<br/>---<br/>EMBED: Text embeddings (OpenAI, Google, local)<br/>BATCH: Async batch processing (~50% cost)<br/>MODERATE: Content safety check<br/>CACHE_PROMPT: Explicit prompt caching<br/>WEB_SEARCH: Grounded web search<br/>CODE_EXEC: Sandboxed code execution"]:::capability

    CAP_EXTENSIBILITY["FUTURE CAPABILITIES (Zero hub changes)<br/>---<br/>Any new CapabilityType + at least 1 plugin handler<br/>= automatically routable through hub<br/>---<br/>Examples: REALTIME_VOICE, FINE_TUNE, COMPUTER_USE,<br/>MCP_BRIDGE, VIDEO_IN, DOCUMENT_PARSE"]:::capability_future
  end

  %% ======================================================================================
  %% K1 EVENT BUS TOPICS (Model Hub Events)
  %% ======================================================================================
  subgraph MODEL_HUB_EVENTS["Model Hub Event Bus Topics (K1 Internal)"]
    direction TB

    EVT_REQUEST_RECEIVED["k1.model_hub.request.received.v1<br/>Payload: request_id, consumer, capability, budget"]:::event

    EVT_REQUEST_ROUTED["k1.model_hub.request.routed.v1<br/>Payload: request_id, provider_id, model_id, capability"]:::event

    EVT_RESPONSE_COMPLETE["k1.model_hub.response.complete.v1<br/>Payload: request_id, tokens_used, latency_ms, cost"]:::event

    EVT_CACHE_HIT["k1.model_hub.cache.hit.v1<br/>Payload: request_id, cache_key, capability, age_ms"]:::event

    EVT_PROVIDER_FAILURE["k1.model_hub.provider.failure.v1<br/>Payload: request_id, provider_id, error_type, will_fallback"]:::event

    EVT_FALLBACK_TRIGGERED["k1.model_hub.fallback.triggered.v1<br/>Payload: request_id, from_provider, to_provider, reason"]:::event

    EVT_CIRCUIT_STATE["k1.model_hub.circuit.state.v1<br/>Payload: provider_id, old_state, new_state, failure_count"]:::event

    EVT_BUDGET_ALERT["k1.model_hub.budget.alert.v1<br/>Payload: tenant_id, level(WARNING|EXCEEDED), pct, action"]:::event

    EVT_PROVIDER_HEALTH["k1.model_hub.provider.health.v1<br/>Payload: provider_id, status, latency_p50, error_rate"]:::event

    EVT_PROVIDER_REGISTERED["k1.model_hub.provider.registered.v1<br/>Payload: provider_id, capabilities[], model_count"]:::event

    EVT_CAPABILITY_AVAILABLE["k1.model_hub.capability.available.v1<br/>Payload: capability, provider_ids[], model_count"]:::event
  end

  %% ======================================================================================
  %% PORTS -- Hexagonal Boundaries (7 Ports)
  %% MH-01 enforced at compile time: no IStateWritePort exists.
  %% ======================================================================================
  subgraph PORTS["Ports (7 Hexagonal Boundaries -- MH-01: No Write Ports to SessionState)"]
    direction TB

    PORT_HUB_INBOUND["IModelHubPort (Inbound -- THE Single Gateway)<br/>Direction: Inbound<br/>---<br/>execute(HubRequest) -> HubResponse<br/>stream_execute(HubRequest) -> AsyncIterator[HubChunk]<br/>discover_capabilities() -> CapabilityMap<br/>discover_models(capability?) -> ModelInfo[]<br/>health() -> HubHealthReport<br/>---<br/>HubRequest (Unified Envelope):<br/>  capability: CapabilityType<br/>  payload: CapabilityPayload (capability-specific, see below)<br/>  constraints: RequestConstraints<br/>  trace_id: cognitive_trace_id<br/>  idempotency_key: str?<br/>---<br/>RequestConstraints:<br/>  max_tokens: int<br/>  timeout_ms: int (default from priority tier MH-15)<br/>  priority: REALTIME | INTERACTIVE | BACKGROUND<br/>  temperature: float (0.0-1.0, default 0.7)<br/>  model_preference: ModelPreference?<br/>  provider_preference: str?<br/>  cost_limit: float?<br/>  consumer_id: str<br/>---<br/>HubResponse (Unified Envelope):<br/>  result: CapabilityResult (capability-specific)<br/>  metadata: ResponseMetadata<br/>---<br/>ResponseMetadata:<br/>  request_id, model_id, provider_id,<br/>  usage{prompt_tokens, completion_tokens, total},<br/>  cost_usd, latency_ms, cache_hit, capability,<br/>  trace_id, fallback_used"]:::port

    PORT_EVENT["IEventPort<br/>Direction: Both<br/>publish(topic, payload) -> void<br/>subscribe(topics[], handler) -> Subscription<br/>Pub: all k1.model_hub.*.v1 events<br/>Sub: k1.model_hub.config_update.v1"]:::port

    PORT_STATE_READ["IStateReadPort<br/>Direction: Inbound (read-only)<br/>read(sections[]) -> StateSnapshot<br/>Multi-reader, lock-free (MH-01)<br/>Sections: persona (model pref), control (user_band)"]:::port

    PORT_METRICS["IMetricsPort<br/>Direction: Outbound<br/>emit(metric_name, value, labels) -> void<br/>Labels: provider, model, consumer, capability, priority"]:::port

    PORT_CONFIG["IConfigPort<br/>Direction: Inbound<br/>get(key) -> ConfigValue<br/>watch(key, callback) -> Subscription<br/>Keys: budgets, timeouts, placement rules<br/>Provider config: from manifests (not here)"]:::port

    PORT_CREDENTIAL["ICredentialPort<br/>Direction: Inbound<br/>get_key(provider_id) -> APIKey<br/>refresh_key(provider_id) -> APIKey<br/>Source: OS keychain / Vault / env (MH-02)<br/>NEVER stored in manifest YAML"]:::port

    PORT_HEALTH["IHealthPort<br/>Direction: Outbound<br/>report_health(component, status) -> void<br/>check_health() -> HealthReport<br/>Status: HEALTHY | DEGRADED | UNHEALTHY"]:::port
  end

  %% ======================================================================================
  %% CAPABILITY PAYLOAD SCHEMAS (Polymorphic -- one per CapabilityType)
  %% ======================================================================================
  subgraph PAYLOAD_SCHEMAS["CapabilityPayload Schemas (Polymorphic by capability)"]
    direction TB

    PL_CHAT["ChatPayload<br/>messages: Message[]<br/>system_prompt: str?"]:::schema

    PL_TOOL_CALL["ToolCallPayload<br/>messages: Message[]<br/>tools: ToolDefinition[]<br/>tool_choice: auto | required | none | {name}<br/>parallel_tool_calls: bool (default true)"]:::schema

    PL_STRUCTURED["StructuredOutputPayload<br/>messages: Message[]<br/>output_schema: JSONSchema<br/>strict: bool (default true)"]:::schema

    PL_REASON["ReasonPayload<br/>messages: Message[]<br/>reasoning_effort: low | medium | high<br/>include_thinking: bool (default false)"]:::schema

    PL_EMBED["EmbedPayload<br/>texts: str[]<br/>dimensions: int? (model default)<br/>encoding_format: float | base64"]:::schema

    PL_VISION["VisionPayload<br/>messages: Message[] (with image_content)<br/>image_inputs: ImageInput[]<br/>detail: auto | low | high"]:::schema

    PL_BATCH["BatchPayload<br/>requests: HubRequest[]<br/>callback_topic: str?<br/>priority: BACKGROUND (always)"]:::schema

    PL_MODERATE["ModeratePayload<br/>text: str<br/>categories: str[]? (all if omitted)"]:::schema

    PL_TOKEN_COUNT["TokenCountPayload<br/>messages: Message[]<br/>model_id: str? (estimate if omitted)"]:::schema

    PL_CACHE["CachePromptPayload<br/>cache_key: str<br/>messages: Message[]<br/>ttl_s: int (default 300)"]:::schema

    PL_AUDIO["AudioInputPayload<br/>messages: Message[]<br/>audio: AudioInput (base64 + format)<br/>voice_config: VoiceConfig?"]:::schema

    PL_TTS["TTSPayload<br/>text: str<br/>voice: str (e.g. alloy, nova, shimmer)<br/>format: mp3 | opus | aac | flac<br/>speed: float (0.25-4.0)"]:::schema

    PL_FUTURE["FuturePayload (generic fallback)<br/>data: dict[str, Any]<br/>---<br/>Any new capability can use this until<br/>a typed schema is defined"]:::schema_future
  end

  %% ======================================================================================
  %% PROVIDER PLUGIN INTERFACE (Single contract ALL providers implement)
  %% ======================================================================================
  subgraph PLUGIN_INTERFACE["IProviderPlugin Interface (Single Contract for ALL Providers)"]
    direction TB

    PLUGIN_CONTRACT["IProviderPlugin<br/>---<br/>initialize(manifest: ProviderManifest) -> void<br/>  Called once on registration. Setup connections, validate keys.<br/>---<br/>supports(capability: CapabilityType) -> bool<br/>  From manifest. O(1) lookup.<br/>---<br/>execute(request: NormalizedRequest) -> ProviderResponse<br/>  Blocking call. Maps HubRequest -> provider-native API -> HubResponse.<br/>  Raises: ProviderError, TimeoutError, RateLimitError.<br/>---<br/>stream_execute(request: NormalizedRequest) -> AsyncIterator[ProviderChunk]<br/>  Streaming variant. Yields chunks. Supports backpressure + cancel.<br/>---<br/>estimate_tokens(messages: Message[]) -> int<br/>  Fast local estimate. Provider-specific tokenizer or tiktoken fallback.<br/>---<br/>health_check() -> ProviderHealth<br/>  Lightweight probe (from manifest.health_check.endpoint).<br/>---<br/>close() -> void<br/>  Cleanup connections, cancel in-flight.<br/>---<br/>NORMALIZATION:<br/>  NormalizationLayer converts HubRequest -> NormalizedRequest<br/>  which is provider-agnostic. Each plugin translates to native API.<br/>  This means: Hub does NOT know about /chat/completions vs /messages."]:::plugin_contract

    PLUGIN_NOTE["PLUGIN ISOLATION (MH-17)<br/>Each plugin runs in its own error boundary.<br/>Plugin crash -> circuit breaker OPEN -> fallback to next provider.<br/>Plugin hangs -> timeout (from manifest) -> same fallback.<br/>Plugins share NOTHING except the IProviderPlugin interface."]:::plugin_note
  end

  %% ======================================================================================
  %% ADAPTERS -- Production + Test (Infrastructure Bindings)
  %% ======================================================================================
  subgraph ADAPTERS["Adapters (Infrastructure Bindings)"]
    direction TB

    subgraph ADAPTERS_PROD["Production Adapters (7 Core + N Provider Plugins)"]
      direction TB

      ADAPT_HUB_INBOUND["LLMRequestBusAdapter<br/>Receives HubRequest from LLM Request Bus<br/>Deserializes capability-tagged envelope<br/>Returns HubResponse via bus reply channel<br/>Protocol: async request-reply on LLM_REQUEST_BUS<br/>---<br/>Error: RECOVERABLE (timeout -> fallback)"]:::adapter

      ADAPT_EVENT["EventBusAdapter<br/>K1 Event Bus pub/sub binding<br/>All model_hub events with trace_id<br/>---<br/>Error: RECOVERABLE (resubscribe)"]:::adapter

      ADAPT_STATE_READ["SessionStateReadAdapter<br/>Lock-free multi-reader access<br/>Read: persona (model pref), control (user_band)<br/>CB_SESSIONSTATE inherited (100ms, 10/min)<br/>---<br/>Error: DEGRADED (use default model pref)"]:::adapter

      ADAPT_METRICS["PrometheusAdapter<br/>Histograms: latency, tokens, cost per capability<br/>Counters: requests, errors, cache_hits per provider<br/>Gauges: active_requests, circuit_state, budget_pct"]:::adapter

      ADAPT_CONFIG["ConfigAdapter<br/>YAML config with hot-reload (30s watch)<br/>File: k1/config/model_hub.yaml<br/>Env override: MH_* prefix"]:::adapter

      ADAPT_CREDENTIAL["CredentialStoreAdapter<br/>Encrypted (AES256-GCM at rest)<br/>Auto-refresh OAuth tokens<br/>Source: OS keychain / Vault / env<br/>MH-02: keys NEVER in manifest"]:::adapter

      ADAPT_HEALTH["HealthReportAdapter<br/>Reports to Fabric health checks<br/>Integrates with Observability Layer"]:::adapter

      subgraph PROVIDER_PLUGINS["Provider Plugins (Manifest-Driven, Auto-Discovered)"]
        direction TB

        PLUGIN_OPENAI["OpenAIPlugin : IProviderPlugin<br/>Manifest: openai.manifest.yaml<br/>Capabilities: CHAT, TOOL_CALL, STRUCTURED, REASON,<br/>  EMBED, VISION, BATCH, MODERATE, AUDIO_IN, TTS,<br/>  IMAGE_GEN, WEB_SEARCH, TOKEN_COUNT, CACHE_PROMPT<br/>Models: GPT-4o, GPT-4o-mini, o3, o4-mini,<br/>  text-embedding-3-small/large, DALL-E 3, whisper<br/>API: chat.completions / embeddings / images / audio / batches<br/>Auth: Bearer token"]:::provider

        PLUGIN_ANTHROPIC["AnthropicPlugin : IProviderPlugin<br/>Manifest: anthropic.manifest.yaml<br/>Capabilities: CHAT, TOOL_CALL, STRUCTURED, REASON,<br/>  VISION, BATCH, TOKEN_COUNT, CACHE_PROMPT<br/>Models: Claude 4 Opus, Sonnet, Haiku<br/>API: messages / messages.batches / messages.count_tokens<br/>Auth: x-api-key header"]:::provider

        PLUGIN_GOOGLE["GoogleGeminiPlugin : IProviderPlugin<br/>Manifest: google.manifest.yaml<br/>Capabilities: CHAT, TOOL_CALL, STRUCTURED, REASON,<br/>  EMBED, VISION, AUDIO_IN, WEB_SEARCH,<br/>  TOKEN_COUNT, CACHE_PROMPT, CODE_EXEC<br/>Models: Gemini 2.5 Pro, Flash, Embedding<br/>API: generateContent / embedContent / countTokens<br/>Auth: API key"]:::provider

        PLUGIN_VLLM["vLLMPlugin : IProviderPlugin<br/>Manifest: vllm.manifest.yaml<br/>Capabilities: CHAT, TOOL_CALL (model-dependent),<br/>  EMBED, VISION (LLaVA), TOKEN_COUNT<br/>Models: Llama 3.3, Mistral, Qwen, LLaVA<br/>API: OpenAI-compatible /v1/*<br/>Auth: none (local)<br/>Placement: local_gpu"]:::provider

        PLUGIN_OLLAMA["OllamaPlugin : IProviderPlugin<br/>Manifest: ollama.manifest.yaml<br/>Capabilities: CHAT, EMBED, VISION (LLaVA),<br/>  TOKEN_COUNT<br/>Models: Llama 3.3 8B-Q4, Phi-3, Gemma<br/>API: /api/chat, /api/embed, /api/generate<br/>Auth: none (local)<br/>Placement: local_cpu"]:::provider

        PLUGIN_FUTURE["[Future Plugins -- 0 hub changes]<br/>MistralPlugin, CoherePlugin, xAIPlugin,<br/>DeepSeekPlugin, AWSBedrockPlugin ...<br/>---<br/>Each: 1 manifest + 1 IProviderPlugin class<br/>Auto-discovered on startup"]:::provider_future
      end
    end

    subgraph ADAPTERS_TEST["Test Adapters (7 + 1 Mock Plugin)"]
      direction TB

      ADAPT_TEST_INBOUND["TestLLMRequestAdapter<br/>Inject HubRequest, capture HubResponse"]:::adapter_test
      ADAPT_TEST_EVENT["TestEventAdapter<br/>Inject/capture model_hub events"]:::adapter_test
