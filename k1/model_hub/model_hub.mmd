  %% ======================================================================================
  %% LIFECYCLE -- Model Hub Module Lifecycle
  %% ======================================================================================
  subgraph LIFECYCLE["Module Lifecycle"]
    direction TB

    LC_INIT["INIT<br/>1. Load hub config (model_hub.yaml)<br/>2. Initialize CredentialStore<br/>3. Scan k1/config/providers/*.manifest.yaml<br/>4. For each manifest: validate, load plugin_class,<br/>   plugin.initialize(manifest), index capabilities<br/>5. Initialize ResponseCache (empty)<br/>6. Initialize BudgetEnforcer (daily reset)<br/>7. Emit: provider.registered.v1 per provider<br/>8. Emit: capability.available.v1 per capability"]:::lifecycle

    LC_HEALTH_CHECK["HEALTH_CHECK<br/>1. For each provider: plugin.health_check()<br/>2. Set initial health states<br/>3. Start periodic monitor (per manifest interval)<br/>4. Report aggregate health to Fabric"]:::lifecycle

    LC_READY["READY<br/>1. Subscribe to LLM_REQUEST_BUS<br/>2. Register event handlers<br/>3. Start manifest hot-reload watcher<br/>4. Emit: k1.model_hub.ready.v1"]:::lifecycle

    LC_RUNNING["RUNNING<br/>Steady state: route, dispatch, cache, track<br/>Periodic: health checks, budget resets,<br/>  cache eviction, manifest reload"]:::lifecycle

    LC_DEGRADED["DEGRADED<br/>Some providers unavailable<br/>Capability-aware fallback active<br/>Reduced capability surface"]:::lifecycle

    LC_SHUTDOWN["SHUTDOWN<br/>1. Stop accepting new requests<br/>2. Drain in-flight (10s timeout)<br/>3. For each plugin: plugin.close()<br/>4. Flush metrics + audit logs<br/>5. Emit: k1.model_hub.shutdown.v1"]:::lifecycle
  end

  %% ======================================================================================
  %% CONCURRENCY MODEL
  %% ======================================================================================
  subgraph CONCURRENCY["Concurrency Model"]
    direction TB

    CONC_ASYNC["Async Event Loop<br/>All plugin calls are non-blocking async<br/>asyncio.gather for parallel health probes<br/>---<br/>Max concurrent: 50 total (configurable)<br/>Per-provider: from manifest.concurrency.max_concurrent"]:::concurrency

    CONC_CACHE["Cache Concurrency<br/>Thread-safe LRU cache<br/>Lock-free reads (atomic get)<br/>Write lock for put + eviction"]:::concurrency

    CONC_BUDGET["Budget Concurrency<br/>Atomic counters (CAS operations)<br/>Daily reset via scheduled task"]:::concurrency

    CONC_CB["Circuit Breaker Concurrency<br/>Per-provider atomic state machine<br/>Read-heavy, write-rare"]:::concurrency

    CONC_PLUGIN["Plugin Isolation (MH-17)<br/>Each plugin: own semaphore (from manifest max_concurrent)<br/>Plugin timeout: from manifest health_check.timeout_s<br/>Plugin crash: caught at ProviderDispatcher boundary<br/>  -> record_failure -> CB -> fallback"]:::concurrency
  end

  %% ======================================================================================
  %% MODEL SELECTION STRATEGY
  %% ======================================================================================
  subgraph MODEL_SELECTION["Model Selection Strategy"]
    direction TB

    MS_PRIORITY["Priority -> Timeout Mapping (MH-15)<br/>---<br/>REALTIME: 10s (ack, dispatch, delivery)<br/>INTERACTIVE: 30s (plan, response, tools)<br/>BACKGROUND: 60s (extraction, learning, batch)"]:::strategy

    MS_COST_OPT["Cost Optimization (from manifest cost tables)<br/>---<br/>BACKGROUND: always cheapest model for capability<br/>Budget > 80%: cheapest for non-REALTIME<br/>Budget > 95%: cheapest for ALL<br/>BATCH capability: 50% discount (MH-07)"]:::strategy

    MS_PLACEMENT["Placement Cascade (MH-13, ADR-0027)<br/>---<br/>1. Local providers (manifest.placement.type=local_*)<br/>   NPU -> GPU -> CPU (check available plugins)<br/>2. Remote providers (manifest.placement.type=remote)<br/>   Ranked by score (cost, latency, preference)<br/>3. Cached response (stale but available)<br/>4. Template response (canned, last resort)"]:::strategy

    MS_FALLBACK["Capability-Aware Fallback (MH-06)<br/>---<br/>ONLY fail over to providers that:<br/>  1. support the requested capability (MH-18)<br/>  2. have CB in CLOSED or HALF_OPEN<br/>  3. have rate limit headroom<br/>  4. are HEALTHY or DEGRADED<br/>---<br/>Fallback chain: up to 3 alternatives<br/>Built per-request by ModelSelector"]:::strategy
  end

  %% ======================================================================================
  %% DATA FLOWS -- Request Processing Pipeline
  %% ======================================================================================

  %% Consumer -> LLM Request Bus -> Model Hub
  TP_CONCIERGE -->|"HubRequest{CHAT|TOOL_CALL|...}"| LLM_REQUEST_BUS
  TP_PLANNER -->|"HubRequest{CHAT|STRUCTURED|...}"| LLM_REQUEST_BUS
  TP_FABRIC -->|"HubRequest{per AgentContract}"| LLM_REQUEST_BUS
  TP_MEMORY_WRITER -->|"HubRequest{CHAT|STRUCTURED}"| LLM_REQUEST_BUS
  TP_LEARNING -->|"HubRequest{CHAT|MODERATE}"| LLM_REQUEST_BUS

  %% LLM Request Bus -> Hub entry
  LLM_REQUEST_BUS -->|"HubRequest envelope"| SVC_REQUEST_ROUTER

  %% Request Router pipeline
  SVC_REQUEST_ROUTER -->|"1. validate + budget"| SVC_BUDGET_ENFORCER
  SVC_BUDGET_ENFORCER -->|"ALLOW / ALLOW_DEGRADED"| SVC_CAPABILITY_ROUTER
  SVC_BUDGET_ENFORCER -->|"REJECT"| EVT_BUDGET_ALERT
  SVC_CAPABILITY_ROUTER -->|"eligible providers for capability"| SVC_MODEL_SELECTOR
  SVC_MODEL_SELECTOR -->|"chosen (provider, model, fallback[])"| SVC_RESPONSE_CACHE
  SVC_RESPONSE_CACHE -->|"cache miss"| SVC_NORMALIZATION
  SVC_RESPONSE_CACHE -->|"cache hit"| SVC_REQUEST_ROUTER
  SVC_NORMALIZATION -->|"NormalizedRequest"| SVC_PROVIDER_DISPATCHER

  %% Model Selector reads
  SVC_MODEL_SELECTOR -->|"persona model pref"| PORT_STATE_READ
  SVC_MODEL_SELECTOR -->|"health states"| SVC_HEALTH_MONITOR
  SVC_MODEL_SELECTOR -->|"CB states"| SVC_CIRCUIT_BREAKER_MGR

  %% Capability Router reads
  SVC_CAPABILITY_ROUTER -->|"capability index"| SVC_PROVIDER_REGISTRY

  %% Provider Dispatcher -> Plugin
  SVC_PROVIDER_DISPATCHER -->|"acquire CB"| SVC_CIRCUIT_BREAKER_MGR
  SVC_PROVIDER_DISPATCHER -->|"acquire rate"| SVC_RATE_LIMITER
  SVC_PROVIDER_DISPATCHER -->|"get credential"| PORT_CREDENTIAL
  SVC_PROVIDER_DISPATCHER -->|"plugin.execute()"| PLUGIN_OPENAI
  SVC_PROVIDER_DISPATCHER -->|"plugin.execute()"| PLUGIN_ANTHROPIC
  SVC_PROVIDER_DISPATCHER -->|"plugin.execute()"| PLUGIN_GOOGLE
  SVC_PROVIDER_DISPATCHER -->|"plugin.execute()"| PLUGIN_VLLM
  SVC_PROVIDER_DISPATCHER -->|"plugin.execute()"| PLUGIN_OLLAMA

  %% Plugin response flow
  PLUGIN_OPENAI -.->|"ProviderResponse"| SVC_PROVIDER_DISPATCHER
  PLUGIN_ANTHROPIC -.->|"ProviderResponse"| SVC_PROVIDER_DISPATCHER
  PLUGIN_GOOGLE -.->|"ProviderResponse"| SVC_PROVIDER_DISPATCHER
  PLUGIN_VLLM -.->|"ProviderResponse"| SVC_PROVIDER_DISPATCHER
  PLUGIN_OLLAMA -.->|"ProviderResponse"| SVC_PROVIDER_DISPATCHER

  %% Post-dispatch processing
  SVC_PROVIDER_DISPATCHER -.->|"success/failure"| SVC_CIRCUIT_BREAKER_MGR
  SVC_PROVIDER_DISPATCHER -.->|"track cost"| SVC_COST_TRACKER
  SVC_PROVIDER_DISPATCHER -.->|"cache response"| SVC_RESPONSE_CACHE
  SVC_PROVIDER_DISPATCHER -.->|"audit log"| SVC_AUDIT_LOGGER
  SVC_PROVIDER_DISPATCHER -.->|"denormalize"| SVC_NORMALIZATION
  SVC_NORMALIZATION -.->|"HubResponse"| SVC_REQUEST_ROUTER

  %% Response to consumer
  SVC_REQUEST_ROUTER -.->|"HubResponse"| LLM_REQUEST_BUS
  LLM_REQUEST_BUS -.->|"to consumer"| TP_CONCIERGE
  LLM_REQUEST_BUS -.->|"to consumer"| TP_PLANNER
  LLM_REQUEST_BUS -.->|"to consumer"| TP_FABRIC
  LLM_REQUEST_BUS -.->|"to consumer"| TP_MEMORY_WRITER
  LLM_REQUEST_BUS -.->|"to consumer"| TP_LEARNING

  %% Fallback on failure
  SVC_PROVIDER_DISPATCHER -->|"failure: next in chain"| SVC_MODEL_SELECTOR

  %% Provider Registry -> CapabilityRouter
  SVC_PROVIDER_REGISTRY -->|"capability index"| SVC_CAPABILITY_ROUTER

  %% Health monitor -> plugins
  SVC_HEALTH_MONITOR -->|"plugin.health_check()"| PLUGIN_OPENAI
  SVC_HEALTH_MONITOR -->|"plugin.health_check()"| PLUGIN_ANTHROPIC
  SVC_HEALTH_MONITOR -->|"plugin.health_check()"| PLUGIN_GOOGLE
  SVC_HEALTH_MONITOR -->|"plugin.health_check()"| PLUGIN_VLLM
  SVC_HEALTH_MONITOR -->|"plugin.health_check()"| PLUGIN_OLLAMA

  %% Events
  SVC_REQUEST_ROUTER -->|"emit"| EVT_REQUEST_RECEIVED
  SVC_REQUEST_ROUTER -->|"emit"| EVT_REQUEST_ROUTED
  SVC_PROVIDER_DISPATCHER -->|"emit"| EVT_RESPONSE_COMPLETE
  SVC_PROVIDER_DISPATCHER -->|"emit"| EVT_PROVIDER_FAILURE
  SVC_MODEL_SELECTOR -->|"emit"| EVT_FALLBACK_TRIGGERED
  SVC_CIRCUIT_BREAKER_MGR -->|"emit"| EVT_CIRCUIT_STATE
  SVC_BUDGET_ENFORCER -->|"emit"| EVT_BUDGET_ALERT
  SVC_HEALTH_MONITOR -->|"emit"| EVT_PROVIDER_HEALTH
  SVC_PROVIDER_REGISTRY -->|"emit"| EVT_PROVIDER_REGISTERED
  SVC_PROVIDER_REGISTRY -->|"emit"| EVT_CAPABILITY_AVAILABLE

  %% Metrics
  SVC_COST_TRACKER -->|"cost metrics"| PORT_METRICS
  SVC_REQUEST_ROUTER -->|"latency metrics"| PORT_METRICS
  SVC_CIRCUIT_BREAKER_MGR -->|"state metrics"| PORT_METRICS
  SVC_RATE_LIMITER -->|"usage metrics"| PORT_METRICS
  SVC_RESPONSE_CACHE -->|"hit/miss metrics"| PORT_METRICS
  SVC_PROVIDER_REGISTRY -->|"provider count"| PORT_METRICS
  PORT_METRICS -->|"exposition"| OBS_METRICS

  %% Audit
  SVC_AUDIT_LOGGER -->|"structured logs"| OBS_TRACING

  %% Health
  SVC_HEALTH_MONITOR -->|"report"| PORT_HEALTH
  PORT_HEALTH -->|"to Fabric"| OBS_METRICS

  %% Lifecycle
  LC_INIT --> LC_HEALTH_CHECK
  LC_HEALTH_CHECK --> LC_READY
  LC_READY --> LC_RUNNING
  LC_RUNNING -->|"providers fail"| LC_DEGRADED
  LC_DEGRADED -->|"providers recover"| LC_RUNNING
  LC_RUNNING --> LC_SHUTDOWN

  %% Prompt System & Output Validation are UPSTREAM/DOWNSTREAM (Fabric-owned)
  TP_PROMPT_SYSTEM -->|"compiled prompt in HubRequest.payload"| LLM_REQUEST_BUS
  LLM_REQUEST_BUS -->|"raw response -> consumer -> validation"| TP_OUTPUT_VALIDATION

