  %% ======================================================================================
  %% INTERNAL SERVICES (13 Codeable Components -- ~550 Tests)
  %% ======================================================================================
  subgraph SERVICES["Internal Services (13 Components -- ~550 Tests)"]
    direction TB

    SVC_PROVIDER_REGISTRY["ProviderRegistry<br/>register(manifest_path) -> void<br/>unregister(provider_id) -> void<br/>get_plugin(provider_id) -> IProviderPlugin<br/>list_providers() -> ProviderInfo[]<br/>---<br/>STARTUP: scan k1/config/providers/*.manifest.yaml<br/>For each: validate schema -> load plugin_class<br/>  -> call plugin.initialize(manifest) -> index capabilities<br/>HOT RELOAD: watch manifest dir (30s interval)<br/>  changed file -> re-validate -> re-register<br/>  new file -> register new provider (emit registered.v1)<br/>  deleted file -> unregister (graceful drain)<br/>---<br/>CAPABILITY INDEX: dict[CapabilityType, list[ProviderInfo]]<br/>O(1) lookup: which providers support TOOL_CALL?<br/>~50 tests"]:::service

    SVC_CAPABILITY_ROUTER["CapabilityRouter<br/>route(capability, constraints) -> EligibleProvider[]<br/>---<br/>1. Lookup capability in ProviderRegistry index (MH-18)<br/>2. Filter by: model supports capability (model-level)<br/>3. Filter by: circuit breaker not OPEN<br/>4. Filter by: rate limit not exhausted<br/>5. Filter by: health status >= DEGRADED<br/>6. Return ranked list (for ModelSelector)<br/>---<br/>If 0 eligible: check cache -> template fallback<br/>NEVER hardcodes provider names (MH-18)<br/>~55 tests"]:::service

    SVC_REQUEST_ROUTER["RequestRouter<br/>route(HubRequest) -> HubResponse<br/>stream_route(HubRequest) -> AsyncIterator[HubChunk]<br/>---<br/>1. Validate envelope (schema, trace_id MH-03)<br/>2. Check daily budget (MH-04, MH-08)<br/>3. Classify priority -> set timeout (MH-15)<br/>4. CapabilityRouter -> eligible providers<br/>5. ModelSelector -> provider + model + fallback chain<br/>6. Check cache (MH-09)<br/>7. ProviderDispatcher -> execute/stream<br/>8. Post-process: cache, cost, audit, metrics<br/>9. Return HubResponse<br/>---<br/>SINGLE ENTRY POINT for all traffic (MH-16)<br/>~80 tests"]:::service

    SVC_MODEL_SELECTOR["ModelSelector<br/>select(eligible_providers, request) -> ModelChoice<br/>---<br/>Input: eligible providers (from CapabilityRouter),<br/>  constraints (from HubRequest), persona (from SessionState)<br/>Algorithm:<br/>  1. Score each (provider, model) pair:<br/>     - cost_score: cheaper = higher (manifest cost table)<br/>     - latency_score: faster tier = higher (manifest tier)<br/>     - preference_score: user/consumer preference match<br/>     - placement_score: local > remote (MH-13)<br/>     - health_score: HEALTHY > DEGRADED<br/>  2. Weighted sum (weights configurable per priority):<br/>     REALTIME: latency 0.5, cost 0.1, pref 0.2, health 0.2<br/>     INTERACTIVE: latency 0.3, cost 0.2, pref 0.3, health 0.2<br/>     BACKGROUND: cost 0.5, latency 0.1, pref 0.1, health 0.3<br/>  3. Build fallback chain: top 3 choices (MH-06)<br/>Output: {provider_id, model_id, fallback_chain[]}<br/>~60 tests"]:::service

    SVC_NORMALIZATION["NormalizationLayer<br/>normalize(HubRequest, target_provider) -> NormalizedRequest<br/>denormalize(ProviderResponse) -> HubResponse<br/>---<br/>Translates between hub-canonical format and<br/>provider-agnostic NormalizedRequest.<br/>Each IProviderPlugin then translates NormalizedRequest<br/>to its own native API format.<br/>---<br/>Handles: message format, tool schema format,<br/>  image encoding, audio encoding, etc.<br/>Hub NEVER knows about provider-specific wire formats.<br/>~40 tests"]:::service

    SVC_BUDGET_ENFORCER["BudgetEnforcer<br/>check(request) -> BudgetDecision<br/>track(response) -> void<br/>---<br/>Per-request: max_tokens from constraints<br/>Per-session: cumulative token tracking<br/>Per-day: $5/day default (MH-08)<br/>---<br/>Decision: ALLOW | ALLOW_DEGRADED | REJECT<br/>ALLOW_DEGRADED: force cheapest model for capability<br/>REJECT: emit budget.alert.v1 (level=EXCEEDED)<br/>Warning at 80%: emit budget.alert.v1 (level=WARNING)<br/>---<br/>Cost lookup: manifest model cost tables (MH-07)<br/>~50 tests"]:::service

    SVC_RESPONSE_CACHE["ResponseCache<br/>get(cache_key) -> CachedResponse?<br/>put(cache_key, response, ttl) -> void<br/>---<br/>Key: hash(capability + payload_hash + model_id + temperature)<br/>TTL: 5min default (MH-09)<br/>Eviction: LRU with max 1000 entries<br/>---<br/>SKIP CACHE for:<br/>  - TOOL_CALL (side-effect potential)<br/>  - temperature > 0.9 (high randomness)<br/>  - streaming requests<br/>  - BATCH (async by nature)<br/>  - MODERATE (must be fresh)<br/>~40 tests"]:::service

    SVC_CIRCUIT_BREAKER_MGR["CircuitBreakerManager<br/>acquire(provider_id) -> CircuitState<br/>record_success(provider_id) -> void<br/>record_failure(provider_id, error) -> void<br/>---<br/>Config: FROM MANIFEST per provider (MH-05)<br/>Default: 3 failures in 60s -> OPEN for 30s<br/>States: CLOSED -> OPEN -> HALF_OPEN -> CLOSED<br/>---<br/>Emit: circuit.state.v1 on transitions<br/>~55 tests"]:::service

    SVC_RATE_LIMITER["RateLimiter<br/>acquire(provider_id, token_estimate) -> RateDecision<br/>---<br/>Per-provider token bucket:<br/>Config: FROM MANIFEST per provider (MH-12)<br/>Headroom: manifest.rate_limits.headroom_pct (default 80%)<br/>Overflow: queue 5s max wait, then fallback<br/>~35 tests"]:::service

    SVC_PROVIDER_DISPATCHER["ProviderDispatcher<br/>dispatch(routed_request) -> ProviderResponse<br/>stream(routed_request) -> AsyncIterator[Chunk]<br/>---<br/>1. Acquire circuit breaker<br/>2. Acquire rate limiter<br/>3. Get credential (via ICredentialPort MH-02)<br/>4. Call plugin.execute() or plugin.stream_execute()<br/>5. Record success/failure for CB<br/>6. On failure: next in fallback chain (MH-06)<br/>---<br/>Retry: 1 retry on timeout/5xx, then fallback<br/>Max fallback depth: 3 (from ModelSelector chain)<br/>~60 tests"]:::service

    SVC_COST_TRACKER["CostTracker<br/>track(response, model_info) -> CostRecord<br/>---<br/>Cost: tokens * model.cost_per_1m / 1_000_000<br/>Model cost: FROM MANIFEST (not hardcoded MH-07)<br/>Aggregations: per-consumer, per-model, per-capability<br/>~30 tests"]:::service

    SVC_HEALTH_MONITOR["ProviderHealthMonitor<br/>check_all() -> HealthReport<br/>---<br/>Periodic: per manifest.health_check.interval_s (MH-14)<br/>Method: plugin.health_check() (wraps manifest endpoint)<br/>Metrics: latency_p50, error_rate_1m, availability<br/>---<br/>HEALTHY: < 5% error, < 5s p95<br/>DEGRADED: 5-20% error or > 5s p95<br/>UNHEALTHY: > 20% error or > 15s p95<br/>Emit: provider.health.v1 on state change<br/>~25 tests"]:::service

    SVC_AUDIT_LOGGER["AuditLogger<br/>log(request, response, metadata) -> void<br/>---<br/>Every call logged (MH-11):<br/>  request_id, consumer_id, capability,<br/>  model_id, provider_id, prompt_tokens,<br/>  completion_tokens, cost_usd, latency_ms,<br/>  cache_hit, fallback_chain, trace_id<br/>~15 tests"]:::service
  end

