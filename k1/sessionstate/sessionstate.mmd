classDef local_cold fill:#e0f2f1,stroke:#00796b,stroke-width:2px,color:#000
classDef cold fill:#e3f2fd,stroke:#1565c0,stroke-width:2px,color:#000
classDef svc fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px,color:#000
classDef svc_critical fill:#c8e6c9,stroke:#1b5e20,stroke-width:3px,color:#000,font-weight:bold
classDef flow fill:#ede7f6,stroke:#5e35b1,stroke-width:2px,color:#000
classDef warn fill:#fff3e0,stroke:#e65100,stroke-width:2px,color:#000
