SVC_STEP -.->|"ORCH-04 (through Fabric)"| INV_EXECUTION
SVC_WORKFLOW -.->|"ORCH-08 (depth max 3)"| INV_WORKFLOW
SVC_WORKFLOW -.->|"ORCH-12 (cycle detection)"| INV_CROSS
SVC_DAG -.->|"ORCH-13 (max 1 micro-replan)"| INV_ADAPTIVE
SVC_DAG -.->|"ORCH-14 (token budget)"| INV_ADAPTIVE
SVC_DAG -.->|"ORCH-15 (output schema guard)"| INV_AGENT
SVC_DAG -.->|"ORCH-16 (conditional edges)"| INV_AGENT
SVC_STEP -.->|"ORCH-15 (schema retry)"| INV_AGENT

%% =====================================================================================
%% SERVICE -> PORT USAGE
%% Services call ports, never external systems directly.
%% =====================================================================================

SVC_ORCH -.->|"dequeue messages"| PORT_MAILBOX
SVC_ORCH -.->|"read context"| PORT_STATE
SVC_ORCH -.->|"emit deltas"| PORT_DELTA
SVC_ORCH -.->|"send plan request"| PORT_PLANNER
SVC_DAG -.->|"execute steps"| PORT_FABRIC
SVC_DAG -.->|"emit progress"| PORT_DELTA
SVC_STEP -.->|"Fabric.execute()"| PORT_FABRIC
SVC_CONSTRAINT -.->|"registry query"| PORT_FABRIC
SVC_CONSTRAINT -.->|"HIL via delta"| PORT_DELTA
SVC_DAG -.->|"execution monitor progress"| PORT_DELTA
SVC_DAG -.->|"user.override subscription"| PORT_EVENT
SVC_WORKFLOW -.->|"scheduler events"| PORT_EVENT
SVC_WORKFLOW -.->|"audit writes"| PORT_BRIDGE
SVC_WORKFLOW -.->|"read timezone"| PORT_STATE
SVC_CONNECTOR -.->|"register tools"| PORT_FABRIC

%% =====================================================================================
%% LIFECYCLE -> SERVICE DELEGATION
%% =====================================================================================

LC_INIT -->|"create + wire"| SVC_ORCH
LC_INIT -->|"create"| SVC_DAG
LC_INIT -->|"create"| SVC_STEP
LC_INIT -->|"create"| SVC_CONSTRAINT
LC_INIT -->|"create + start scheduler"| SVC_WORKFLOW
LC_INIT -->|"create + discover"| SVC_CONNECTOR

LC_RUN_START -->|"route message"| SVC_ORCH
LC_RUN_END -->|"aggregate + emit"| SVC_ORCH

LC_SHUTDOWN -->|"wait active DAG"| SVC_DAG
LC_SHUTDOWN -->|"stop scheduler"| SVC_WORKFLOW
LC_SHUTDOWN -->|"disconnect"| SVC_CONNECTOR

LC_CRASH_RECOVERY -->|"bootstrap"| SVC_ORCH
LC_CRASH_RECOVERY -->|"resume partial DAG"| SVC_DAG
LC_CRASH_RECOVERY -->|"restart scheduler"| SVC_WORKFLOW
LC_CRASH_RECOVERY -->|"rediscover"| SVC_CONNECTOR

%% =====================================================================================
%% LIFECYCLE -> PORT USAGE
%% =====================================================================================

LC_INIT -.->|"connect all 7 ports"| PORT_MAILBOX
LC_INIT -.->|"subscribe events"| PORT_EVENT
LC_INIT -.->|"register tools"| PORT_FABRIC

LC_RUN_START -.->|"dequeue"| PORT_MAILBOX
LC_RUN_START -.->|"read snapshot"| PORT_STATE

LC_RUN_END -.->|"emit completed delta"| PORT_DELTA
LC_RUN_END -.->|"audit write"| PORT_BRIDGE

LC_SHUTDOWN -.->|"unsubscribe"| PORT_EVENT
LC_SHUTDOWN -.->|"final audit"| PORT_BRIDGE

LC_CRASH_RECOVERY -.->|"check WAL"| PORT_BRIDGE
LC_CRASH_RECOVERY -.->|"resubscribe"| PORT_EVENT
LC_CRASH_RECOVERY -.->|"read state"| PORT_STATE

%% =====================================================================================
%% LIFECYCLE STATE FLOW
%% =====================================================================================

LC_INIT -->|"ready"| CONC_LOOP
LC_RUN_START -->|"processing"| SVC_ORCH
LC_RUN_END -->|"resume loop"| CONC_LOOP
LC_SHUTDOWN -->|"terminated"| PORT_MAILBOX
LC_CRASH_RECOVERY -->|"recovered"| CONC_LOOP

