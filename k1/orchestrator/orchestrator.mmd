%% =====================================================================================
%% ORCHESTRATOR (K1) -- DEEP ARCHITECTURE (Production-Grade)
%% =====================================================================================
%% STATUS: SKELETON + Hexagonal Architecture + Invariants + Performance Baselines
%%         + Internal Services + Lifecycle + Concurrency Model + Error Recovery
%%
%% The Orchestrator is Layer 2 of the K1 Cognitive Kernel. It is:
%%   - A PURE DETERMINISTIC ACTOR (NO LLM, NO tools, NEVER writes SessionState)
%%   - The blind muscle: follows DAG plans mechanically via Fabric
%%   - The workflow engine: manages saved plans as scheduled/event-driven tasks
%%   - The connector host: manages MCP server tool registration into Fabric
%%
%% WHAT ORCHESTRATOR IS NOT (NON-NEGOTIABLE):
%%   - NOT an LLM consumer (zero LLM calls, zero token budget)
%%   - NOT a tool caller (zero tools -- calls Fabric.execute() directly)
%%   - NOT a state writer (NEVER writes SessionState, ORCH-01 / INV-04)
%%   - NOT a planner (walks a plan, does not create one)
%%   - NOT a negotiator (Contract-Net from ADR-0006 is SUPERSEDED)
%%
%% CALL CHAIN:
%%   User -> Concierge (L1) -> Orchestrator (L2) -> Planner (L3, conditional)
%%                                               -> Fabric (L2.5) -> Sub-Agents / Tools
%%
%% TIER INVOLVEMENT:
%%   LOW    -> NO  (Concierge calls Fabric directly via invoke_capability())
%%   MEDIUM -> YES (TaskEnvelope, 1-2 Fabric calls, no planning)
%%   HIGH   -> YES (TaskEnvelope -> PlanRequest -> CommittedPlan -> DAG execution)
%%   CRISIS -> NO  (Safety Agent handles immediately)
%%
%% MESSAGE ENVELOPES:
%%   TaskEnvelope      : Concierge DISPATCHING -> Orchestrator Mailbox
%%   PlanRequest       : Orchestrator -> Planner Mailbox (HIGH tier only)
%%   CommittedPlan     : Planner -> Orchestrator (via k1.planner.plan.ready)
%%   CapabilityRequest : Orchestrator -> Fabric Gateway (per DAG step)
%%   CapabilityResult  : Fabric -> Orchestrator (per DAG step)
%%   AggregatedResult  : Orchestrator -> Concierge COMPANIONING
%%   WorkflowRunRequest: Workflow Scheduler -> Orchestrator Mailbox
%%
%% TIER DEGRADATION CASCADE:
%%   HIGH -> CB_PLANNER OPEN -> degrade to MEDIUM (skip planning)
%%   MEDIUM -> CB_ORCHESTRATOR OPEN -> degrade to LOW (Concierge calls Fabric direct)
%%   LOW -> CB_FABRIC OPEN -> canned response
%%
%% PERFORMANCE BUDGET:
%%   Orchestrator overhead (excl. Fabric + Planner): < 15ms P99
%%   MEDIUM end-to-end: 10s | HIGH end-to-end: 45s
%%   DAG typical: 3-8 steps | max: 50 | concurrent per wave: up to 10
%%   Token budget: plan.token_budget_max enforced at wave boundaries (ORCH-14)
%%
%% ADAPTIVE BLIND DAG (Agent-Aware Extensions):
%%   The Orchestrator remains a PURE DETERMINISTIC ACTOR (NO LLM).
%%   6 extensions handle the non-deterministic nature of LLM agent steps:
%%   1. Output Schema Guard (ORCH-15): validate agent JSON output before param resolution
%%   2. Conditional DAG Edges (ORCH-16): branch on step status/result at wave boundaries
%%   3. Mid-DAG Micro-Replan (ORCH-13): checkpoint + Planner re-plan when discoveries change plan
%%   4. Token Budget Tracker (ORCH-14): cumulative LLM spend with wave-boundary enforcement
%%   5. Quality Gate: soft-fail detection for technically-successful-but-useless agent results
%%   6. Sub-Step Observability: pass-through of Fabric agent sub-step progress events
%%   All 6 are DETERMINISTIC (JSON Schema, boolean conditions, counters, thresholds).
%%
%% GOVERNING DOCUMENTS:
%%   k1/orchestrator/orchestrator.md (28-section design doc)
%%   architecture_diagrams/k1/k1_cognitive_architecture_skeleton.mmd (L2_ORCHESTRATOR)
%%   k1/fabric/fabric.mmd (caller touchpoints)
%%   k1/concierge/concierge.mmd (FabricOrchestratorAdapter, DeltaBusAdapter)
%%   docs/architecture/whiteboard_k1/whiteboard_concierge_orchestrator_planner_fabric.md
%%   ADRs: ADR-0006 (superseded), ADR-0005, ADR-0007, ADR-0017, ADR-0028
%% =====================================================================================

subgraph ORCHESTRATOR["Orchestrator -- Adaptive Blind DAG Executor (L2 Pure Deterministic Actor)"]
  direction TB

  %% ==================================================================================
  %% ORCHESTRATOR CORE -- Central Dispatch (No LLM, No Tools)
  %% ==================================================================================

  subgraph ORCH_CORE["Orchestrator Core (Central Dispatch)"]
    direction TB

    ORCH_ACTOR["OrchestratorActor<br/>Pure deterministic logic, central dispatch<br/>NO LLM, NO tools, NEVER writes SessionState<br/>---<br/>Dequeue from Mailbox, route by type:<br/>  TaskEnvelope(MEDIUM): 1-2 CapReq direct to Fabric<br/>  TaskEnvelope(HIGH): PlanRequest -> Planner -> DAG<br/>  WorkflowRunRequest: rehydrate -> DAG (no Planner)<br/>  CommittedPlan: execute DAG immediately<br/>---<br/>Aggregates all results -> AggregatedResult"]:::actor

    ORCH_MAILBOX["Orchestrator Mailbox<br/>MPSC queue + WFQ priority: REALTIME<br/>Single inbound entry point<br/>---<br/>Producers:<br/>  Concierge DISPATCHING (TaskEnvelope)<br/>  Planner (CommittedPlan via k1.planner.plan.ready)<br/>  Workflow Scheduler (WorkflowRunRequest)<br/>  Workflow Provider (rehydrated sub-workflow plan)"]:::mailbox

    FABRIC_GATEWAY["Fabric Gateway<br/>Bridge to Capability Fabric L2.5<br/>All step execution routes through here<br/>---<br/>execute(CapabilityRequest) -> CapabilityResult<br/>execute_batch(CapReq[]) -> CapResult[] (parallel)<br/>spawn(AgentContract) -> AgentHandle"]:::gateway
  end

  %% ==================================================================================
  %% BLIND DAG EXECUTOR (Supersedes ADR-0006 Contract-Net)
  %% ==================================================================================

  subgraph DAG_EXECUTOR["Adaptive Blind DAG Executor (Heart of HIGH-Tier Execution)"]
    direction TB

    subgraph DAG_ENGINE_GROUP["DAG Engine"]
      direction TB

      DAG_ENGINE["DAG Engine<br/>Builds execution waves from<br/>CommittedPlan.dependencies graph<br/>Topological sort into parallel batches"]:::engine

      TOPO_WALKER["Topological Walker<br/>Walks CommittedPlan.steps[]<br/>Wave N: steps whose deps all in Wave N-1<br/>Steps in same wave run concurrently"]:::engine

      PARALLEL_DAG["Parallel Executor<br/>execute_batch(wave_steps[])<br/>await_all(pending) per wave<br/>Up to 10 concurrent steps per wave"]:::engine
    end

    subgraph PARAM_RESOLUTION["Parameter Resolution"]
      PARAM_RESOLVER["Parameter Reference Resolver<br/>Resolves $step_id.result.path at execution time<br/>e.g. $s3.result.contacts, $s1.result.venue<br/>Referenced step guaranteed complete by DAG order<br/>---<br/>META-AGENT CREATION (4.5.9):<br/>Also resolves CAPABILITY NAMES from prior results:<br/>  capability: $step_1.result.agent_name<br/>  -> resolves to dynamically created agent name<br/>Required for build_agent -> execute created agent flow<br/>Pattern: build_agent returns {agent_name: agent.execute.X}<br/>  next step references $step_1.result.agent_name<br/>  ParamResolver substitutes before Fabric.execute()"]:::engine
    end

    subgraph RETRY_FAILURE["Retry & Failure Handling"]
      direction TB

      STEP_RETRY["Step Retry<br/>Policy: 2 retries then graceful failure (ORCH-06)<br/>Same capability, same params per retry<br/>Retry delay: 0ms (immediate)"]:::recovery

      STEP_CANCEL["Step Cancellation<br/>On parent failure: CANCEL all transitive dependents<br/>Independent steps CONTINUE (ORCH-07)<br/>Cancelled steps appear in AggregatedResult"]:::recovery

      SAGA_RECOVERY["Saga Recovery<br/>When side-effect step fails after earlier side-effect succeeded:<br/>Execute compensations in REVERSE order<br/>Compensation per capability contract YAML<br/>If compensation fails: dead-letter + telemetry alert"]:::recovery
    end

    subgraph CONSTRAINT_ENGINE["Constraint Resolution Engine"]
      direction TB

      CONSTRAINT_MGR["Constraint Manager<br/>Pre-execution validation:<br/>All capabilities exist? Params satisfiable?<br/>Safety band OK? Time within budget?"]:::engine

      ITERATION_CTRL["Iteration Controller<br/>Max 3 resolution cycles<br/>Cycle1: Fabric-aware alternatives<br/>Cycle2: Try alt capabilities, re-validate<br/>Cycle3: Fallback -> HIL question to user<br/>After 3: graceful failure + explanation"]:::engine

      CAP_RESOLVER["Capability Constraint Resolver<br/>Queries Fabric Capability Registry:<br/>Is capability available? Provider ONLINE?<br/>Safety band allowed? Suggests alternatives"]:::engine

      FALLBACK_TRIGGER["Fallback Trigger<br/>Routes to HIL when automated resolution stalls<br/>Question routed via DeltaBus -> Concierge"]:::hil
    end

    RESULT_AGGREGATOR["Result Aggregator<br/>Collects per step: CapResult, duration,<br/>status (COMPLETED|FAILED|CANCELLED|SKIPPED),<br/>error details, retry attempts consumed<br/>---<br/>AggregatedResult:<br/>  total_steps, completed, failed, cancelled, skipped<br/>  total_tokens_consumed, budget_utilization<br/>  success: true only if zero failures"]:::engine

    subgraph ADAPTIVE_DAG["Agent-Aware Extensions (All Deterministic -- NO LLM)"]
      direction TB

      OUTPUT_SCHEMA_GUARD["Output Schema Guard (ORCH-15)<br/>Validates agent result.data against step.output_schema<br/>JSON Schema validation: O(n) in field count<br/>---<br/>PASS: proceed to param resolution<br/>FAIL: retry with schema_hint in CapReq<br/>  (Fabric injects schema into agent prompt)<br/>  Max 1 schema retry (separate from normal retries)<br/>FAIL after retry: step FAILED, deps CANCELLED<br/>Prevents silent data corruption in DAG chain"]:::guard

      CONDITIONAL_EVAL["Conditional Edge Evaluator (ORCH-16)<br/>Evaluates boolean conditions on prior results<br/>at wave boundaries, BEFORE step dispatch<br/>---<br/>Condition language (deterministic):<br/>  step.status == COMPLETED | FAILED | CANCELLED<br/>  step.result.path == literal | > number | != null<br/>  AND | OR | NOT operators<br/>---<br/>FALSE: step marked SKIPPED (intentional branch)<br/>TRUE: step dispatched normally<br/>Topological sort still works (conditions are guards)"]:::guard

      MICRO_REPLAN["Micro-Replan Checkpoint (ORCH-13)<br/>After each wave: check CapResult.discoveries[]<br/>---<br/>Discovery = agent-reported new info<br/>  (facts, constraints, corrections)<br/>Heuristic: discovery.field overlaps remaining params?<br/>---<br/>If yes AND replan not used (max 1 per DAG):<br/>  1. Checkpoint completed results<br/>  2. MicroReplanRequest -> Planner<br/>  3. Planner adjusts remaining steps only<br/>  4. Replace remaining waves, resume<br/>If Planner fails: continue original plan"]:::guard

      TOKEN_TRACKER["Token Budget Tracker (ORCH-14)<br/>Cumulative LLM token counter per DAG<br/>---<br/>plan.token_budget_max set by Planner<br/>After each step: add result.tokens_consumed<br/>At wave boundary:<br/>  >= 80%: WARN event, compress remaining prompts<br/>  >= 95%: skip optional steps (no dependents)<br/>  >= 100%: HARD STOP, aggregate partial results<br/>---<br/>Cost: O(1) per step (counter + threshold)"]:::guard

      QUALITY_GATE["Quality Gate<br/>Soft failure detection for agent results<br/>---<br/>quality_score from Fabric (deterministic):<br/>  0.5 * schema_completeness +<br/>  0.3 * content_density +<br/>  0.2 * (1.0 - null_ratio)<br/>---<br/>quality >= 0.7: PASS<br/>0.3 <= quality < 0.7: RETRY with quality hint<br/>quality < 0.3: SOFT FAIL (treat as FAILED)<br/>null (non-agent): always PASS (bypass gate)"]:::guard

      EXECUTION_MONITOR["Execution Monitor (GAP-2 fix)<br/>Emits step progress narration to user via DeltaBus<br/>---<br/>After each wave completion:<br/>  Emit k1.hil.progress.v1 via PORT_DELTA<br/>  Content: step_id, summary, progress_pct<br/>  Priority: BACKGROUND (~200 tokens narration)<br/>---<br/>user.override handling:<br/>  Receives via PORT_EVENT subscription<br/>  Actions: CANCEL_DAG | MODIFY_PARAMS | CONTINUE<br/>  On CANCEL: interrupt flag set, cancel at next wave"]:::hil
    end
  end

  %% ==================================================================================
  %% USER WORKFLOW SYSTEM (Saved Plans as Scheduled/Event-Driven)
  %% ==================================================================================

  subgraph WORKFLOW_SYSTEM["User Workflow System"]
    direction TB

    WF_REGISTRY["Workflow Registry<br/>Stores WorkflowSpec + TriggerSpec<br/>Created when user says 'do this every Monday'<br/>Source: frozen CommittedPlan from HIGH execution"]:::registry

    WF_VERSION["Workflow Version Pointer<br/>Active version per workflow<br/>Monotonic bump on re-plan"]:::registry

    WF_COMPILER["Workflow Compiler<br/>Rehydrates frozen DAG from WorkflowSpec<br/>Validates: all capabilities still exist?<br/>Resolves dynamic params (today's date, etc.)<br/>Schema mismatch: SMALL (auto-fill) / LARGE (gap)"]:::engine

    WF_SCHEDULER["Workflow Scheduler<br/>Trigger types: cron | event | manual<br/>Shares System Clock with Concierge<br/>Reads user timezone from SessionState<br/>Due -> WorkflowRunRequest -> Orchestrator Mailbox"]:::scheduling

    SYSTEM_CLOCK["System Clock<br/>UTC + device_local_time()<br/>Shared: Concierge Temporal Resolution"]:::engine

    WF_SUPERVISOR["Workflow Run Supervisor<br/>Creates Run Manifest per execution<br/>Manages leases + guards + lifecycle<br/>Status: RUNNING | COMPLETED | FAILED | ABORTED"]:::supervisor

    RUN_MANIFEST["Run Manifest<br/>run_id, workflow_id, version<br/>compiled_hash, trigger_type, status"]:::supervisor

    CROSS_WF_RESOLVER["Cross-Workflow Resolver<br/>Steps with capability workflow.run.* trigger sub-workflows<br/>Looks up in Registry, Compiler rehydrates"]:::engine

    WF_DEPTH_GUARD["Workflow Depth Guard<br/>Max depth: 3 (ORCH-08)<br/>Cycle detection pre-validated by Planner Stage 3"]:::safety

    GAP_DETECTOR["Proactive Gap Detector<br/>Listens: k1.capability.contract_updated.v1<br/>Scans active WorkflowSpecs<br/>SMALL gap: auto-fill defaults, notify user<br/>LARGE gap: store ProactiveGap, ask user when free"]:::engine
  end

  %% ==================================================================================
  %% CONNECTOR ECOSYSTEM (MCP Server Management + Tool Registration)
  %% ==================================================================================

  subgraph CONNECTOR_ECO["Connector Ecosystem"]
    direction TB

    LOCAL_MCP["Local MCP Servers<br/>Device-hosted, always available (Edge-First)<br/>Calendar, contacts, notes, file system"]:::local

    REMOTE_MCP["Remote MCP Servers<br/>Company-hosted, requires network<br/>Restaurant booking, weather, banking"]:::remote

    K0_PROXY["K0 Connector Proxy<br/>Cloud-hosted (optional enhancement)<br/>Auth proxy, caching, rate limiting"]:::k0

    MCP_DISCOVERY["MCP Tool Discovery<br/>Scans MCP servers for available tools<br/>Extracts tool schema (name, params, desc)"]:::engine

    MCP_REGISTRAR["MCP Capability Registrar<br/>Maps to FamilyOS naming: tool.{type}.{name}<br/>Generates tool contract YAML<br/>Registers in Fabric Capability Registry"]:::engine

    MCP_FACTORY["MCP Provider Factory<br/>Creates capability handlers for MCP tools<br/>Instantiates MCP-backed providers for Fabric"]:::engine

    CONNECTOR_SANDBOX["Connector Sandbox<br/>Per-connector isolation:<br/>Process isolation, resource limits,<br/>network allowlist, timeout enforcement,<br/>output schema validation"]:::safety
  end

  %% ==================================================================================
  %% PORTS -- Boundary Contracts (Hexagonal Architecture)
  %% 7 ports define all external interactions. Internal services call ports,
  %% NEVER external systems directly. Same pattern as Concierge.
  %% ==================================================================================

  subgraph PORTS["Ports (Boundary Contracts)"]
    direction TB

    PORT_MAILBOX["IMailboxPort<br/>enqueue(message) -> QueuePosition<br/>dequeue() -> Message | None<br/>depth() -> int<br/>priority_class: REALTIME"]:::port

    PORT_FABRIC["IFabricGatewayPort<br/>execute(CapabilityRequest) -> CapabilityResult<br/>execute_batch(CapReq[]) -> CapResult[]<br/>spawn(AgentContract) -> AgentHandle<br/>query_registry(capability_name) -> RegistryEntry | None"]:::port

    PORT_PLANNER["IPlannerPort<br/>request_plan(PlanRequest) -> PlanAck<br/>await_plan(request_id) -> CommittedPlan<br/>cancel_plan(request_id) -> void<br/>micro_replan(MicroReplanRequest) -> CommittedPlan | null"]:::port

    PORT_STATE["IStateReadPort<br/>read(section) -> SectionData (multi-reader, lock-free)<br/>snapshot(sections[]) -> ContextSnapshot<br/>---<br/>READ ONLY -- Orchestrator NEVER writes (ORCH-01)"]:::port

    PORT_DELTA["IDeltaEmitPort<br/>emit(delta_type, payload, trace_id) -> void<br/>emit_progress(step_id, summary) -> void<br/>FIRE-AND-FORGET, RECOVERABLE on failure"]:::port

    PORT_BRIDGE["IBridgeWritePort<br/>submit_audit(RunManifest) -> void<br/>submit_plan(CommittedPlan, wal_offset) -> void<br/>FIRE-AND-FORGET (Edge-First: continues if K0 offline)"]:::port

    PORT_EVENT["IEventSubscriptionPort<br/>subscribe(topic, handler) -> Subscription<br/>unsubscribe(sub_id) -> void<br/>Topics: k1.planner.plan.ready, k1.capability.*,<br/>        k1.workflow.trigger.due,<br/>        k1.hil.override_response.v1,<br/>        k1.hil.fallback_response.v1"]:::port
  end

  %% ==================================================================================
  %% ADAPTERS -- Infrastructure Bindings (Production + Test)
  %% ==================================================================================

  subgraph ADAPTERS["Adapters (Infrastructure Bindings)"]
    direction TB

    subgraph ADAPTERS_PROD["Production Adapters"]
      direction TB

      ADAPT_MAILBOX["MailboxAdapter<br/>In-memory MPSC + WFQ<br/>Priority: REALTIME<br/>---<br/>Backpressure: reject at depth 100<br/>Error: RECOVERABLE (re-enqueue once)"]:::adapter

      ADAPT_FABRIC["FabricGatewayAdapter<br/>Routes to Capability Fabric L2.5<br/>CB_FABRIC owner (30s, 5/min)<br/>---<br/>Step timeout enforcement per CapReq<br/>Error: DEGRADED (partial results)<br/>CB OPEN: capability unavailable"]:::adapter

      ADAPT_PLANNER["PlannerAdapter<br/>Routes PlanRequest to Planner Mailbox<br/>CB_PLANNER owner (45s, 2/min)<br/>---<br/>Await plan with timeout (Planner budget)<br/>Error: DEGRADED (skip planning, try MEDIUM)<br/>CB OPEN: degrade HIGH -> MEDIUM"]:::adapter

      ADAPT_STATE["StateReadAdapter<br/>Multi-reader lock-free SessionState access<br/>CB_SESSIONSTATE owner (100ms, 10/min)<br/>---<br/>Snapshot at TaskEnvelope dequeue time<br/>Re-read safety_band at wave boundaries (HIGH)<br/>Error: DEGRADED (stale cached snapshot)"]:::adapter

      ADAPT_DELTA["DeltaEmitAdapter<br/>Emits to K1 Event Bus + Delta Bus<br/>---<br/>Fire-and-forget: emit failure = log + skip<br/>Never TERMINAL (Edge-First: best-effort)<br/>Uses cognitive_trace_id on all deltas"]:::adapter

      ADAPT_BRIDGE["BridgeWriteAdapter<br/>Fire-and-forget writes to K0 via Bridge<br/>---<br/>Workflow audit records, CommittedPlan WAL<br/>Error: RECOVERABLE (skip, continues offline)<br/>Edge-First: never blocks on K0"]:::adapter

      ADAPT_EVENT["EventSubscriptionAdapter<br/>K1 Event Bus pub/sub binding<br/>---<br/>Topics: plan.ready, capability.*, workflow.trigger<br/>Error: RECOVERABLE (resubscribe)"]:::adapter
    end

    subgraph ADAPTERS_TEST["Test Adapters"]
      direction TB

      ADAPT_TEST_MAILBOX["TestMailboxAdapter<br/>In-memory queue, inject messages"]:::adapter_test
      ADAPT_TEST_FABRIC["MockFabricAdapter<br/>Scripted CapabilityResults<br/>Simulate failures, timeouts"]:::adapter_test
      ADAPT_TEST_PLANNER["MockPlannerAdapter<br/>Scripted CommittedPlans<br/>Simulate planning failure"]:::adapter_test
      ADAPT_TEST_STATE["MockStateReadAdapter<br/>Scripted SessionState snapshots"]:::adapter_test
      ADAPT_TEST_DELTA["TestDeltaAdapter<br/>Captures emitted deltas for assertion"]:::adapter_test
      ADAPT_TEST_BRIDGE["MockBridgeAdapter<br/>Captures audit writes for assertion"]:::adapter_test
      ADAPT_TEST_EVENT["TestEventAdapter<br/>Fire events on demand for testing"]:::adapter_test
    end
  end

  %% ==================================================================================
  %% INVARIANTS -- Non-Negotiable Rules (12 rules, 5 categories)
  %% ==================================================================================

  subgraph INVARIANTS["Invariants (16 Non-Negotiable Rules)"]
    direction TB

    INV_IDENTITY["IDENTITY (ORCH-01..03)<br/>ORCH-01: NEVER writes SessionState (no IStateWritePort)<br/>ORCH-02: NO LLM -- zero model calls (no ILLMPort)<br/>ORCH-03: ZERO tools -- calls Fabric.execute() directly"]:::invariant

    INV_EXECUTION["EXECUTION (ORCH-04..07)<br/>ORCH-04: Every step through Fabric (never direct provider)<br/>ORCH-05: DAG in topological order (no out-of-order)<br/>ORCH-06: Step retry: 2 retries then graceful failure<br/>ORCH-07: Dependent CANCELLED on parent fail; independent CONTINUE"]:::invariant

    INV_WORKFLOW["WORKFLOW (ORCH-08..09)<br/>ORCH-08: Workflow depth: max 3 (sub-workflow nesting limit)<br/>ORCH-09: All events emitted with cognitive_trace_id"]:::invariant

    INV_TIER["TIER (ORCH-10..11)<br/>ORCH-10: MEDIUM: max 2 Fabric calls (no planning)<br/>ORCH-11: HIGH: CommittedPlan required before execution"]:::invariant

    INV_CROSS["CROSS-WORKFLOW (ORCH-12)<br/>ORCH-12: Cross-workflow triggers validated for cycles"]:::invariant

    INV_ADAPTIVE["ADAPTIVE DAG (ORCH-13..14)<br/>ORCH-13: Max 1 micro-replan per DAG (no infinite loops)<br/>ORCH-14: DAG tokens MUST NOT exceed plan.token_budget_max"]:::invariant

    INV_AGENT["AGENT GUARD (ORCH-15..16)<br/>ORCH-15: Agent output validated against output_schema<br/>before parameter resolution (prevents silent corruption)<br/>ORCH-16: Conditional edges evaluated ONLY at wave boundaries<br/>using deterministic boolean expressions (no LLM)"]:::invariant
  end

  %% ==================================================================================
  %% PERFORMANCE BASELINES (System-Owned + Budget Envelopes)
  %% ==================================================================================

  subgraph PERF_BASELINES["Performance Baselines"]
    direction TB

    PERF_SYSTEM["SYSTEM-OWNED LATENCIES (P99)<br/>Mailbox dequeue + routing decision: < 1ms<br/>DAG wave construction (topological sort): < 5ms<br/>CapabilityRequest construction: < 1ms per step<br/>Parameter reference resolution: < 1ms per step<br/>Output schema validation: < 1ms per step (ORCH-15)<br/>Conditional edge evaluation: < 1ms per wave (ORCH-16)<br/>Token budget check: < 0.1ms per wave (ORCH-14)<br/>Quality gate check: < 0.1ms per step<br/>Discovery heuristic: < 1ms per wave (ORCH-13)<br/>Result aggregation: < 2ms<br/>Progress delta emission: < 1ms (fire-and-forget)<br/>Constraint validation (pre-execution): < 5ms<br/>---<br/>Total Orchestrator overhead: < 18ms<br/>(excludes Fabric + Planner + micro-replan time)"]:::perf

    PERF_ENVELOPES["BUDGET ENVELOPES (Tier Limits)<br/>MEDIUM total: 10s (Orch < 15ms + Fabric 1-9.9s)<br/>HIGH total: 45s (Orch < 15ms + Planner 10-30s + Fabric varies)<br/>15s headroom before CB_ORCHESTRATOR 60s timeout<br/>Step timeout (default): 30s per step<br/>---<br/>DAG targets:<br/>  Typical steps per plan: 3-8<br/>  Max steps per plan: 50<br/>  Concurrent steps per wave: up to 10<br/>  Retry delay: 0ms (immediate)"]:::perf
  end

  %% ==================================================================================
  %% INTERNAL SERVICES -- Codeable Components (~280 tests estimated)
  %% 6 services derived from tracing every subgraph. Each service owns behavioral
  %% flows, enforces invariants, and uses ports from hexagonal architecture.
  %% Dependency: OrchestratorService -> {DAGExecutor, WorkflowEngine, ConnectorManager}
  %%   DAGExecutor -> {StepRunner, ConstraintResolver}
  %%   WorkflowEngine -> {WorkflowCompiler, WorkflowScheduler, GapDetector}
  %% No circular dependencies.
  %% ==================================================================================

  subgraph SERVICES["Internal Services (6 Codeable Components -- ~380 Tests)"]
    direction TB

    SVC_ORCH["OrchestratorService<br/>process(message) -> ProcessResult<br/>route_task(TaskEnvelope) -> RouteDecision (MEDIUM|HIGH)<br/>dispatch_medium(envelope) -> AggregatedResult<br/>dispatch_high(envelope) -> AggregatedResult<br/>dispatch_workflow(WorkflowRunRequest) -> AggregatedResult<br/>receive_plan(CommittedPlan) -> void<br/>receive_micro_replan(MicroReplanResult) -> void<br/>aggregate(step_results[]) -> AggregatedResult<br/>---<br/>Central entry point. Routes by message type.<br/>~55 tests"]:::service

    SVC_DAG["DAGExecutor<br/>execute(CommittedPlan) -> AggregatedResult<br/>build_waves(steps[], deps) -> Wave[]<br/>execute_wave(wave, ctx) -> WaveResult<br/>resolve_params(params, results) -> ResolvedParams<br/>evaluate_conditions(step, deps, results) -> bool (ORCH-16)<br/>validate_output(result, schema) -> SchemaResult (ORCH-15)<br/>check_quality(result) -> QualityDecision<br/>check_discoveries(wave_results) -> Discovery[] (ORCH-13)<br/>cancel_dependents(failed_step, deps) -> CancelledSteps<br/>compensate(completed_with_effects[]) -> CompensationResult<br/>---<br/>Adaptive topological walk: schema guard, conditional edges,<br/>quality gate, token budget, micro-replan, retry, saga.<br/>~120 tests"]:::service

    SVC_STEP["StepRunner<br/>run(step, context, attempt) -> CapabilityResult<br/>retry(step, last_result, attempt) -> CapabilityResult<br/>retry_with_schema_hint(step, schema) -> CapabilityResult<br/>retry_with_quality_hint(step) -> CapabilityResult<br/>should_retry(result) -> bool<br/>build_request(step, resolved_params) -> CapabilityRequest<br/>---<br/>Single step execution with retry policy.<br/>Schema retry + quality retry (separate budgets).<br/>Uses IFabricGatewayPort.execute() per step.<br/>~55 tests"]:::service

    SVC_CONSTRAINT["ConstraintResolver<br/>validate(CommittedPlan) -> ValidationResult<br/>check_capabilities(steps[]) -> CapabilityCheck[]<br/>find_alternatives(missing_cap) -> Alternative[]<br/>resolve_cycle(cycle_num, issues[]) -> ResolutionResult<br/>trigger_hil(unresolved[]) -> HILRequest<br/>receive_hil_response(FallbackResponse) -> ResolutionResult<br/>---<br/>Max 3 cycles. Fabric-aware. HIL fallback.<br/>Fallback response via k1.hil.fallback_response.v1<br/>~40 tests"]:::service

    SVC_WORKFLOW["WorkflowEngine<br/>trigger(WorkflowRunRequest) -> AggregatedResult<br/>save_workflow(CommittedPlan, TriggerSpec) -> WorkflowSpec<br/>compile(workflow_id) -> CommittedPlan<br/>detect_gaps(contract_update_event) -> ProactiveGap[]<br/>resolve_cross(workflow_step) -> CommittedPlan<br/>check_depth(current_depth) -> bool<br/>---<br/>Registry, compiler, scheduler, gap detection.<br/>~45 tests"]:::service

    SVC_CONNECTOR["ConnectorManager<br/>discover_tools(server) -> ToolSchema[]<br/>register_tools(schemas[]) -> RegistrationResult<br/>create_providers(schemas[]) -> Provider[]<br/>health_check(server_id) -> HealthStatus<br/>sandbox_config(server_id) -> SandboxPolicy<br/>---<br/>MCP discovery, registration, factory, sandbox.<br/>~25 tests"]:::service
  end

  %% ==================================================================================
  %% LIFECYCLE -- Orchestrator Lifecycle (5 Phases)
  %% OrchestratorService owns init/shutdown/crash.
  %% Run phases are implicit (mailbox processing loop).
  %% ==================================================================================

  subgraph LIFECYCLE["Lifecycle (5 Phases)"]
    direction TB

    LC_INIT["init(session_id)<br/>Owner: OrchestratorService<br/>---<br/>1. Create 6 services (no I/O)<br/>2. Connect 7 ports<br/>3. Discover MCP servers (ConnectorManager)<br/>4. Register discovered tools in Fabric registry<br/>5. Load active workflows from Registry<br/>6. Start Workflow Scheduler timer<br/>7. Subscribe to event topics (plan.ready, capability.*)<br/>8. Start mailbox processing loop<br/>---<br/>Max init time: 500ms (MCP discovery is async)"]:::lifecycle

    LC_RUN_START["run_start(message)<br/>Owner: OrchestratorService<br/>---<br/>1. Dequeue message from Mailbox<br/>2. Read SessionState snapshot via IStateReadPort<br/>3. Classify message: TaskEnvelope | CommittedPlan |<br/>   WorkflowRunRequest<br/>4. Emit k1.orchestration.task.accepted delta<br/>5. Route to dispatch_medium | dispatch_high |<br/>   dispatch_workflow | receive_plan"]:::lifecycle

    LC_RUN_END["run_end(aggregated_result)<br/>Owner: OrchestratorService<br/>---<br/>1. Emit k1.orchestration.dag.completed delta<br/>2. Send AggregatedResult to Concierge COMPANIONING<br/>3. Write audit record via IBridgeWritePort<br/>   (fire-and-forget, Edge-First)<br/>4. If workflow: update Run Manifest status<br/>5. Resume mailbox processing loop"]:::lifecycle

    LC_SHUTDOWN["shutdown()<br/>Owner: OrchestratorService<br/>---<br/>1. Stop accepting new messages (mailbox drain)<br/>2. Wait active DAG execution (30s) or force-cancel<br/>3. Compensate any in-flight side-effect steps (Saga)<br/>4. Stop Workflow Scheduler timer<br/>5. Unsubscribe from event topics<br/>6. Final audit write to K0 (5s wait)<br/>7. Disconnect ports (LIFO)"]:::lifecycle

    LC_CRASH_RECOVERY["crash_recovery(session_id)<br/>Owner: OrchestratorService<br/>---<br/>1. Bootstrap (6 services + 7 ports)<br/>2. Detect: check K0 WAL for in-flight CommittedPlan<br/>3. If found: load plan, check step completion markers<br/>4. Resume from last completed wave (skip completed steps)<br/>5. If no WAL: clean start (no state to recover)<br/>6. Restart MCP discovery + workflow scheduler<br/>7. Resume mailbox processing loop<br/>---<br/>Max loss: partial DAG progress (retry from last wave)"]:::lifecycle
  end

  %% ==================================================================================
  %% CONCURRENCY MODEL -- Mailbox Processing Loop
  %% Single-threaded async event loop (same pattern as Concierge).
  %% One message at a time from mailbox. Parallel only within DAG waves.
  %% ==================================================================================

  subgraph CONCURRENCY["Concurrency Model"]
    direction TB

    CONC_LOOP["Mailbox Processing Loop<br/>---<br/>while running:<br/>  msg = mailbox.dequeue()  # blocks until available<br/>  run_start(msg)<br/>  result = process(msg)    # may fan out DAG waves<br/>  run_end(result)<br/>---<br/>Single-threaded: one message at a time<br/>Parallel only within execute_batch() per wave<br/>No concurrent DAG executions (V1)"]:::concurrency

    CONC_INTERRUPT["Interrupt Handling<br/>---<br/>Concierge sends interrupt via DeltaBus:<br/>  k1.orchestration.cancel_request<br/>At next wave boundary: check interrupt flag<br/>If set: cancel remaining waves, compensate (Saga)<br/>Return partial AggregatedResult"]:::concurrency
  end

end

