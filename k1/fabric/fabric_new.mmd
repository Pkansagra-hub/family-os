  subgraph CONTRACT_SYSTEM["Subsystem 1: Capability Contract System (Contract Plane)"]
    direction TB

    subgraph CONTRACT_TYPES["Contract Types (YAML in k1/contracts/)"]
      direction TB

      TOOL_CONTRACTS["Tool Contracts<br/>k1/contracts/tools/*.yaml<br/>---<br/>name: tool.execute.* | tool.read.* | tool.write.* | tool.delete.*<br/>provider_type: MCP | WASM | BRIDGE<br/>required_inputs[], output schema<br/>required_context[], optional_context[]<br/>safety_band_min, cost_per_call, avg_latency_ms<br/>---<br/>15 implemented tools:<br/>tool.execute.send_message, .schedule_event, .set_reminder,<br/>  .run_diagnostic, .create_invitation, .reserve_table,<br/>  .set_thermostat, .order_groceries<br/>tool.read.weather, .contact_lookup, .calendar_events,<br/>  .recipe_search, .note_search<br/>tool.write.build_agent, .save_note"]:::contract

      AGENT_CONTRACTS["Agent Contracts<br/>k1/contracts/agents/*.yaml<br/>---<br/>name: agent.execute.* | agent.spawn.*<br/>prompt_template, tools_granted[]<br/>llm_budget_tokens, max_tool_calls<br/>max_execution_time_ms<br/>template_file reference<br/>---<br/>Known Agents:<br/>memory_writer, curiosity_agent,<br/>reminder_agent, gap_answer_writer,<br/>learning_extractor"]:::contract

      PROMPT_CONTRACTS["Prompt Contracts<br/>k1/contracts/prompts/*.yaml<br/>---<br/>name, version, domain[]<br/>intent_match[] (retrieval triggers)<br/>variables[] (must be filled)<br/>template_file, max_tokens<br/>compatible_agents[], output_format"]:::contract

      WORKFLOW_CONTRACTS["Workflow Contracts<br/>k1/contracts/workflows/*.yaml<br/>---<br/>name: workflow.run.*<br/>source_plan_id (from CommittedPlan)<br/>trigger: cron | event | manual<br/>steps[] (frozen DAG)<br/>max_depth: 3, allows_sub_workflows"]:::contract
    end

