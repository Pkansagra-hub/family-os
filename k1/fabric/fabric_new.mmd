      CONTRACT_VALIDATOR["ContractValidator (contract_validator.py)<br/>Schema validation for ALL contracts<br/>---<br/>Name pattern: type.verb.name (3 segments)<br/>  tool.execute.send_message<br/>  agent.spawn.health_agent<br/>  workflow.run.morning_routine<br/>  concierge.state.update<br/>---<br/>Validates: name, version, domain[], description,<br/>required_inputs[], output schema,<br/>provider_type in {MCP,WASM,BRIDGE,AGENT,WORKFLOW,CONCIERGE},<br/>safety_band_min, availability"]:::validator

      CONTRACT_SCHEMAS["Contract Schemas<br/>k1/contracts/schemas/<br/>---<br/>tool_contract.schema.json<br/>agent_contract.schema.json<br/>prompt_contract.schema.json<br/>workflow_contract.schema.json"]:::contract
    end

    subgraph CONTRACT_LOADING["Contract Loading (3 Registration Paths)"]
