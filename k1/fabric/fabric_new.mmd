  end

  %% ==================================================================================
  %% SUBSYSTEM 2: CAPABILITY REGISTRY
  %% ==================================================================================

  subgraph REGISTRY_SYSTEM["Subsystem 2: Capability Registry (In-Memory Indexed Catalog)"]
    direction TB

    CAPABILITY_REGISTRY["CapabilityRegistry (registry.py)<br/>Agent/Tool/Workflow/Prompt index<br/>100K+ items at scale<br/>---<br/>by_name: dict (O(1) exact lookup)<br/>by_domain: inverted index<br/>by_type: grouped by prefix<br/>by_provider: grouped by provider_id<br/>metadata_cache: hot contract metadata"]:::registry

    EMBEDDING_INDEX["EmbeddingIndex (embedding_index.py)<br/>FAISS (flat L2 or IVF for >10K)<br/>---<br/>vectors: ndarray[float32] (N x dim)<br/>texts: description + capabilities per contract<br/>Rebuild: startup (full), on register (incremental)"]:::registry
  end

  %% ==================================================================================
  %% SUBSYSTEM 3: SEMANTIC RETRIEVAL ENGINE (Role 1: Serves Planner)
  %% ==================================================================================

  subgraph RETRIEVAL_ENGINE["Subsystem 3: Semantic Retrieval Engine (Role 1 -- Serves Planner)"]
    direction TB

    RETRIEVAL_ENGINE_CORE["RetrievalEngine (retrieval_engine.py)<br/>Orchestrates 4-step retrieval pipeline<br/>Receives SearchQuery{text, domain?, intent?, band, top_k}"]:::engine

    subgraph RETRIEVAL_PIPELINE["4-Step Retrieval Pipeline"]
      direction TB

      EMBED_QUERY["Step 1: Embed Query<br/>Same model that indexed registry<br/>query_vector = embed(query_text)<br/>< 5ms per query"]:::step

      HARD_FILTER["Step 2: HardFilter (hard_filter.py)<br/>Eliminates non-candidates<br/>---<br/>Rule 1: Safety band access (band_min <= user_band)<br/>Rule 2: Availability != OFFLINE (DEGRADED kept, penalized)<br/>Rule 3: Required inputs satisfiable from context<br/>---<br/>ANY hard rule fail = eliminated (FAB-05)<br/>< 2ms (field comparisons, no I/O)"]:::safety

      SOFT_RANKER["Step 3: SoftRanker (soft_ranker.py)<br/>Scores remaining candidates<br/>---<br/>Score = (0.4 x semantic_similarity)<br/>      + (0.3 x domain_match)<br/>      + (0.15 x success_rate_30d)<br/>      + (0.15 x cost_latency_score)<br/>---<br/>DEGRADED penalty: score x 0.7<br/>< 10ms (dot products + field reads)"]:::engine

      TOP_K_SELECTOR["Step 4: TopKSelector (top_k_selector.py)<br/>Default K=10, max K=25<br/>---<br/>Returns: contract + input/output schema<br/>+ score + provider type"]:::engine
    end
  end

  %% ==================================================================================
  %% SUBSYSTEM 4: PROVIDER RESOLUTION ENGINE (Role 2: Exact Name Lookup)
  %% ==================================================================================

  subgraph RESOLUTION_ENGINE["Subsystem 4: Provider Resolution Engine (Role 2 -- Exact Match)"]
    direction TB

    subgraph RESOLUTION_PIPELINE["5-Step Resolution Pipeline"]
      direction TB

      REGISTRY_LOOKUP["Step 1: Registry Lookup<br/>contract = registry.lookup(request.name)<br/>O(1) via by_name dict<br/>Not found -> CapabilityResult{error: capability_not_found}"]:::step

      PROVIDER_MATCHER["Step 2: ProviderMatcher (provider_matcher.py)<br/>Find all providers for this contract<br/>Usually 1:1 (one provider per capability)"]:::engine

      POLICY_EVALUATION["Step 3: Policy Evaluation<br/>(See Subsystem 5: Policy Engine)<br/>Security hard gate + 3 soft dimensions"]:::engine

      PROVIDER_SELECTOR["Step 4: ProviderSelector (provider_selector.py)<br/>Highest composite score wins<br/>Ties: lower avg_latency_ms, then alphabetical<br/>All fail security: error=access_denied<br/>Deterministic (FAB-10)"]:::engine

      PROVIDER_INSTANTIATION["Step 5: Provider Instantiation<br/>ProviderFactory creates handler by type:<br/>MCPProvider | WASMProvider | BridgeProvider<br/>AgentProvider | WorkflowProvider | ConciergeProvider"]:::factory
    end

    RESOLVER["Resolver (resolver.py)<br/>Chains: Matcher -> Policy -> Selector<br/>Returns: resolved ProviderConfig"]:::engine

    PROVIDER_REGISTRY["ProviderRegistry (provider_registry.py)<br/>Maps provider_id -> ProviderConfig<br/>---<br/>Populated by _auto_register_providers()<br/>Bridges Contract Plane -> Execution Plane:<br/>Scans registry for unique provider_ids,<br/>creates ProviderConfig per provider<br/>---<br/>MCP: endpoint, transport (stdio/SSE/HTTP), max_concurrent<br/>WASM: module_path, sandbox_memory_mb, max_execution_ms<br/>Bridge: bridge_endpoint, operations[]<br/>Agent: template, budget, tools_granted[]<br/>Workflow: dag_spec, trigger<br/>Concierge: fsm_handler"]:::registry

    PROVIDER_FACTORY["ProviderFactory (provider_factory.py)<br/>Instantiate capability handlers<br/>---<br/>_register_provider_handlers() registers 6 types:<br/>MCP, WASM, BRIDGE, AGENT, WORKFLOW, CONCIERGE<br/>create(config) -> CapabilityProvider"]:::factory
  end

  %% ==================================================================================
  %% SUBSYSTEM 5: POLICY ENGINE (4 Dimensions)
  %% ==================================================================================

  subgraph POLICY_ENGINE["Subsystem 5: Policy Engine (4 Dimensions)"]
    direction TB

    SECURITY_CONTEXT["Dimension 1: SecurityContext (security_context.py) HARD GATE<br/>---<br/>FIRST check. Fail = immediate reject.<br/>user_band >= capability_band_min<br/>Band ordering: GREEN < AMBER < RED < CRISIS<br/>---<br/>Also checks: Sub-Agent tool scoping (tools_granted[]),<br/>Rate limiting per capability, Tenant isolation (family_id)<br/>---<br/>META-OPERATION GATES (4.5.5):<br/>build_agent requires AMBER minimum<br/>Created agents inherit creator max band<br/>Restricted domains: META, SECURITY, ADMIN<br/>No recursive creation (build_agent not grantable)<br/>Depth=1: agents cannot invoke other agents"]:::safety

    AFFECTIVE_ROUTING["Dimension 2: AffectiveRouting (affective_routing.py)<br/>---<br/>Reads affective_now from SessionState<br/>High sadness/anxiety (>0.7): +0.1 empathetic providers<br/>Output: affective_score (0.0 - 0.2)"]:::policy

    COGNITIVE_LOAD["Dimension 3: CognitiveLoadRouting (cognitive_load_routing.py)<br/>---<br/>Reads complexity_tier + cognitive state<br/>High load: +0.1 fast/simple providers<br/>Output: cognitive_score (0.0 - 0.15)"]:::policy

    QOS_INTEGRATION["Dimension 4: QoSIntegration (qos_integration.py)<br/>---<br/>Budget-aware + latency-aware selection<br/>Output: qos_score (0.0 - 0.2)"]:::policy

    POLICY_ENGINE_CORE["PolicyEngine (policy_engine.py)<br/>Composite Provider Score<br/>---<br/>final_score = base_relevance_score<br/>            + affective_score<br/>            + cognitive_score<br/>            + qos_score<br/>Highest score selected, deterministic"]:::engine
  end

  %% ==================================================================================
  %% SUBSYSTEM 6: EXECUTION RUNTIME (6 Provider Types)
  %% ==================================================================================

  subgraph EXECUTION_RUNTIME["Subsystem 6: Execution Runtime (6 Provider Types)"]
    direction TB

    PROVIDER_INTERFACE["CapabilityProvider Protocol (base_provider.py)<br/>---<br/>execute(request, context, trace_id) -> CapabilityResult<br/>health_check() -> ProviderHealth<br/>capabilities() -> list[str]<br/>---<br/>BaseProvider ABC: common error handling, tracing, metrics"]:::engine

    subgraph PROVIDERS["Provider Implementations"]
      direction TB

      MCP_PROVIDER["MCPProvider (mcp_provider.py)<br/>---<br/>Uses IMCPTransport (NOT Bridge routing)<br/>Direct: tool_call msg -> MCP server -> parse result<br/>---<br/>4 implemented MCP servers:<br/>calendar_mcp_server, weather_mcp_server,<br/>notes_mcp_server, recipes_mcp_server<br/>---<br/>CB per provider_id, timeout: local 10s, remote 15s"]:::provider

      WASM_PROVIDER["WASMProvider (wasm_provider.py)<br/>---<br/>Uses IWASMRuntime (sandboxed computation)<br/>Memory: default 64MB, Timeout: default 5s<br/>No network access (pure computation)<br/>---<br/>2 implemented WASM modules:<br/>date_calc, unit_convert<br/>---<br/>CB per provider_id, timeout: 5s"]:::provider

      BRIDGE_PROVIDER["BridgeProvider (bridge_provider.py)<br/>---<br/>Uses IBridgePort -> Cross-Kernel Bridge -> K0<br/>Operations: memory.store, memory.recall,<br/>memory.delta, checkpoint, feedback.signal<br/>---<br/>Offline fallback: LOCAL COLD (K1 SQLite)<br/>CB per provider_id, timeout: 10s"]:::provider

      AGENT_PROVIDER["AgentProvider (agent_provider.py)<br/>---<br/>For agent.execute.* and agent.spawn.* capabilities<br/>Spawns per-step workers with own LLM<br/>Uses IModelGatewayPort for LLM access<br/>(See Agent Factory subgraph below)<br/>---<br/>tokens_consumed, quality_score (FAB-13),<br/>discoveries[], schema_hint injection<br/>---<br/>CB per provider_id, timeout: 30s"]:::provider

      WORKFLOW_PROVIDER["WorkflowProvider (workflow_provider.py)<br/>---<br/>Rehydrates frozen WorkflowSpec<br/>Validates capabilities still exist (drift detection)<br/>Creates Run Manifest (pinned version + hash)<br/>Routes to Orchestrator for DAG execution<br/>---<br/>Max depth: 3 (sub-workflow nesting limit)<br/>CB per provider_id, timeout: 60s"]:::provider

      CONCIERGE_PROVIDER["ConciergeProvider (concierge_provider.py)<br/>---<br/>Handles concierge.state.* capabilities<br/>Routes to FSM state handlers<br/>Modifies FSM state via Concierge Single Writer<br/>CB per provider_id, timeout: 10s"]:::provider
    end
  end

  %% ==================================================================================
  %% SUBSYSTEM 7: CONTEXT BUILDER
  %% ==================================================================================

  subgraph CONTEXT_BUILDER_SYSTEM["Subsystem 7: Context Builder"]
    direction TB

    CONTEXT_BUILDER["ContextBuilder (context_builder.py)<br/>SessionState -> ExecutionContext<br/>---<br/>Uses ISessionStateReader (multi-reader, lock-free)<br/>Uses IPromptSystemPort (template resolution)"]:::engine

    subgraph CONTEXT_PIPELINE["6-Step Context Assembly"]
      direction TB

      CTX_READ_CONTRACT["Step 1: Read Contract Requirements<br/>sections_needed = required_context + optional_context"]:::step

      CTX_FETCH_STATE["Step 2: Fetch From SessionState<br/>Multi-reader, lock-free reads via ISessionStateReader<br/>Optional missing: skip | Required missing: log warning"]:::step

      CTX_INJECT_PARAMS["Step 3: Inject Request Params<br/>context.params = request.params<br/>context.intent = request.intent"]:::step

      CTX_RESOLVE_PROMPT["Step 4: Resolve Prompt Template + Schema Hint<br/>Via IPromptSystemPort: resolve -> version -> inject -> compile<br/>---<br/>Schema Hint Injection (ORCH-15):<br/>If request.schema_hint != null: append schema guidance<br/>If request.output_schema != null: append format guidance"]:::step

      CTX_APPLY_BUDGET["Step 5: Apply Token Budget<br/>Ceiling: 128K tokens (FAB-08)<br/>---<br/>Compression strategy if > 80%:<br/>1. Drop optional_context<br/>2. Truncate history (keep last 3)<br/>3. Summarize beliefs<br/>4. Emergency: drop WARM, keep only HOT"]:::step

      CTX_PACKAGE["Step 6: Package and Return<br/>ExecutionContext{session_sections, params,<br/>prompt (compiled), token_count, trace_id}"]:::step
    end
  end

  %% ==================================================================================
  %% OUTPUT VALIDATION PIPELINE (Inside Fabric execute() -- Step 6)
  %% ==================================================================================

  subgraph OUTPUT_VALIDATION_SYSTEM["Output Validation Pipeline (Inside execute() -- Step 6)"]
    direction TB

    OUTPUT_VALIDATION["OutputValidationPipeline (pipeline.py)<br/>Orchestrates 3-Tier validation<br/>Called at step 6 of execute()"]:::engine

    TIER1_FORMAT["T1: FORMAT (<1ms, sync)<br/>Valid text, within max_tokens, no template markers<br/>FAIL: retry LLM once, 2 retries max, accept with warning"]:::safety

    TIER2_SCHEMA["T2: SCHEMA (SchemaValidator with coercion)<br/>Required fields + types<br/>Coercion strategies: string -> number, etc.<br/>FAIL: retry with schema_hint"]:::engine

    TIER3_SEMANTIC["T3: SEMANTIC (<50ms, async)<br/>Business rules + hallucination detection<br/>Cross-ref SessionState via ISessionStateReader<br/>FAIL: strip contradictions, retry if >50%"]:::engine

    VALIDATION_FALLBACK["ValidationFallback<br/>Graceful degradation: skip tier if it errors<br/>Never block execution on validation failure"]:::engine
  end

  %% ==================================================================================
  %% AGENT FACTORY (Inside Execution Runtime)
  %% ==================================================================================

  subgraph AGENT_FACTORY_SYSTEM["Agent Factory (Role 3 -- Spawns Per-Step Workers)"]
    direction TB

    subgraph AGENT_INSTANTIATION["8-Step Agent Instantiation"]
      direction TB

      AF_LOAD_TEMPLATE["Step 1: Load Template<br/>YAML from contract.template_file<br/>Validate against agent contract schema"]:::step

      AF_CREATE_MAILBOX["Step 2: Create Mailbox<br/>MPSC Mailbox, WFQ Priority: INTERACTIVE<br/>Capacity: 100 messages"]:::step

      AF_GRANT_LLM["Step 3: Grant LLM Access<br/>model_hub.create_handle(budget, capabilities, trace_id)<br/>Via IModelGatewayPort -> Model Hub"]:::step

      AF_GRANT_STATE["Step 4: Grant SessionState Read<br/>Multi-reader, lock-free via ISessionStateReader<br/>Scoped to contract.required_context sections"]:::step

      AF_SCOPE_TOOLS["Step 5: Scope Tool Access (FAB-07)<br/>---<br/>Start: contract.tools_granted[]<br/>Override: plan_step.tools_granted[]<br/>Plan step takes precedence<br/>NEVER grant outside union of both"]:::step

      AF_BUILD_CONTEXT["Step 6: Build Initial Context<br/>Uses Context Builder (Subsystem 7)"]:::step

      AF_INSTANTIATE["Step 7: Instantiate Agent<br/>Agent(id, contract, mailbox, llm,<br/>state_reader, tools, context, lifecycle=PENDING)"]:::step

      AF_START_LIFECYCLE["Step 8: Start Lifecycle<br/>PENDING -> WARMING -> ACTIVE<br/>ACTIVE -> IDLE (pool, 60s TTL)<br/>ACTIVE -> DRAINING -> TERMINATED"]:::step
    end

    AGENT_LIFECYCLE["Agent Lifecycle (ADR-0005)<br/>---<br/>PENDING -> WARMING -> ACTIVE -> IDLE<br/>IDLE -> ACTIVE (fast reactivate)<br/>ACTIVE -> DRAINING -> TERMINATED<br/>---<br/>IDLE pool: same-type agent reuse<br/>TERMINATED: release all resources"]:::lifecycle

    TOOL_SCOPE["Tool Scope Enforcer<br/>---<br/>allowed_tools: set[str]<br/>validate(capability_name) -> bool<br/>Raises AccessDeniedError if not in allowed set"]:::safety
  end

  %% ==================================================================================
