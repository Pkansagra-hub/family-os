%% ROLE 2: EXECUTION FLOW (CapabilityRequest -> Resolve -> Execute -> Result)
%% =====================================================================================

CALLER_CONCIERGE -->|"LOW: CapabilityRequest"| CAPABILITY_FABRIC
CALLER_ORCHESTRATOR -->|"MED/HIGH: CapabilityRequest per step"| CAPABILITY_FABRIC
CALLER_SUBAGENTS -->|"scoped invoke_capability()"| CAPABILITY_FABRIC

%% Fabric execute() 9-step pipeline
CAPABILITY_FABRIC -->|"1. emit invoked"| EVENT_EMITTER
CAPABILITY_FABRIC -->|"2. resolve"| RESOLVER
RESOLVER -->|"lookup"| REGISTRY_LOOKUP
REGISTRY_LOOKUP -->|"contract"| PROVIDER_MATCHER
PROVIDER_MATCHER -->|"candidates"| POLICY_EVALUATION
POLICY_EVALUATION -->|"scored"| PROVIDER_SELECTOR
PROVIDER_SELECTOR -->|"best provider"| PROVIDER_INSTANTIATION
PROVIDER_INSTANTIATION -->|"create handler"| PROVIDER_FACTORY

%% Registry lookup
REGISTRY_LOOKUP -->|"lookup(name)"| CAPABILITY_REGISTRY

%% Policy Engine evaluation
POLICY_EVALUATION -->|"security gate (HARD)"| SECURITY_CONTEXT
POLICY_EVALUATION -->|"affective score"| AFFECTIVE_ROUTING
POLICY_EVALUATION -->|"cognitive score"| COGNITIVE_LOAD
POLICY_EVALUATION -->|"QoS score"| QOS_INTEGRATION
SECURITY_CONTEXT -->|"user_band from"| SS_CONTROL
AFFECTIVE_ROUTING -->|"emotion from"| SS_AFFECTIVE
POLICY_ENGINE_CORE -->|"final ranking"| PROVIDER_SELECTOR

%% Context Build (step 3)
CAPABILITY_FABRIC -->|"3. build context"| CONTEXT_BUILDER
CTX_READ_CONTRACT --> CTX_FETCH_STATE
CTX_FETCH_STATE --> CTX_INJECT_PARAMS
CTX_INJECT_PARAMS --> CTX_RESOLVE_PROMPT
CTX_RESOLVE_PROMPT --> CTX_APPLY_BUDGET
CTX_APPLY_BUDGET --> CTX_PACKAGE
CTX_FETCH_STATE -->|"ISessionStateReader"| SS_BELIEFS
CTX_FETCH_STATE -->|"ISessionStateReader"| SS_HISTORY
CTX_FETCH_STATE -->|"ISessionStateReader"| SS_PERSONA
CTX_FETCH_STATE -->|"ISessionStateReader"| SS_TEMPORAL
CTX_RESOLVE_PROMPT -->|"IPromptSystemPort"| PROMPT_SYSTEM

%% Execute via CB (step 5)
CAPABILITY_FABRIC -->|"5. execute via CB + provider"| PROVIDER_INTERFACE
PROVIDER_INTERFACE -->|"MCP"| MCP_PROVIDER
PROVIDER_INTERFACE -->|"WASM"| WASM_PROVIDER
PROVIDER_INTERFACE -->|"Bridge"| BRIDGE_PROVIDER
PROVIDER_INTERFACE -->|"Agent"| AGENT_PROVIDER
PROVIDER_INTERFACE -->|"Workflow"| WORKFLOW_PROVIDER
PROVIDER_INTERFACE -->|"Concierge"| CONCIERGE_PROVIDER

%% Output Validation (step 6, INSIDE execute())
CAPABILITY_FABRIC -->|"6. validate output"| OUTPUT_VALIDATION
OUTPUT_VALIDATION --> TIER1_FORMAT
TIER1_FORMAT --> TIER2_SCHEMA
TIER2_SCHEMA --> TIER3_SEMANTIC

%% Provider -> external connections
MCP_PROVIDER -->|"IMCPTransport"| MCP_CALENDAR
MCP_PROVIDER -->|"IMCPTransport"| MCP_WEATHER
MCP_PROVIDER -->|"IMCPTransport"| MCP_NOTES
MCP_PROVIDER -->|"IMCPTransport"| MCP_RECIPES
MCP_PROVIDER -->|"IFL via Bridge"| BRIDGE_GATEWAY_PORT
WASM_PROVIDER -->|"IWASMRuntime"| WASM_DATE
WASM_PROVIDER -->|"IWASMRuntime"| WASM_UNITS
BRIDGE_PROVIDER -->|"IBridgePort recall"| BRIDGE_QUERY_PORT
BRIDGE_PROVIDER -->|"IBridgePort submit"| BRIDGE_CMD_PORT
WORKFLOW_PROVIDER -->|"rehydrated DAG"| ORCHESTRATOR_MAILBOX

%% Agent Provider -> Agent Factory
AGENT_PROVIDER -->|"trigger instantiation"| AF_LOAD_TEMPLATE
AF_LOAD_TEMPLATE --> AF_CREATE_MAILBOX
AF_CREATE_MAILBOX --> AF_GRANT_LLM
AF_GRANT_LLM -->|"IModelGatewayPort"| MODEL_ROUTER
AF_GRANT_LLM --> AF_GRANT_STATE
AF_GRANT_STATE -->|"ISessionStateReader"| SS_BELIEFS
AF_GRANT_STATE --> AF_SCOPE_TOOLS
AF_SCOPE_TOOLS -->|"enforce FAB-07"| TOOL_SCOPE
AF_SCOPE_TOOLS --> AF_BUILD_CONTEXT
AF_BUILD_CONTEXT -->|"via Context Builder"| CONTEXT_BUILDER
AF_BUILD_CONTEXT --> AF_INSTANTIATE
AF_INSTANTIATE --> AF_START_LIFECYCLE
AF_START_LIFECYCLE -->|"lifecycle transitions"| AGENT_LIFECYCLE

%% Agent results
AGENT_LIFECYCLE -->|"CapabilityResult (tokens, quality, discoveries)"| CAPABILITY_FABRIC
AGENT_LIFECYCLE -->|"state deltas (NEVER direct write)"| DELTA_BUS

