%% =====================================================================================
%% CAPABILITY FABRIC (K1) -- DEEP AI AGENT ARCHITECTURE
%% =====================================================================================
%% STATUS: COMPLETE (Matches implemented code as of 2026-02-08)
%%
%% The Capability Fabric is K1's central resolution, retrieval, and execution engine.
%% Layer 2.5 in K1 Cognitive Architecture Skeleton.
%%
%% THREE ROLES:
%%   Role 1: Intelligent Retrieval -- serves Planner (semantic Top-K, discovery tools)
%%   Role 2: Resolution + Execution -- serves Orchestrator and Concierge (all tiers)
%%   Role 3: Agent Factory -- spawns per-step workers from YAML templates
%%
%% CONCURRENCY MODEL (ADR-1.1.9):
%%   Hybrid async/await + Semaphore(10). NO actor mailbox.
%%   ADR-1.1.9 bypassed Epic 4.4 (Fabric Mailbox). All requests are
%%   async coroutines gated by a Semaphore(10) for backpressure.
%%
%% CALLERS:
%%   Concierge (LOW tier -- direct fast path, < 2s)
%%   Orchestrator (MEDIUM/HIGH tier -- DAG execution, 2-60s)
%%   Planner (HIGH tier -- discovery only, read-only, < 50ms per call)
%%   Sub-Agents (spawned by Fabric, scoped invoke_capability)
%%
%% WHAT FABRIC IS NOT:
%%   NOT an orchestrator (Orchestrator walks the DAG)
%%   NOT a planner (Planner decides what to do)
%%   NOT an LLM (deterministic: lookup, filter, rank, route, execute)
%%   NOT a state writer (NEVER writes SessionState, ADR-0017)
%%
%% CONTRACT REGISTRATION (3 Paths):
%%   Path 1: YAML scan at startup via ModuleLoader.scan_directory()
%%   Path 2: Hot-reload via daemon thread _watch_loop()
%%   Path 3: Programmatic via ModuleLoader.register_from_dict()
%%
%% PERFORMANCE TARGETS (Fabric overhead, excl. provider execution):
%%   Registry lookup: < 1ms (hash table O(1))
%%   Retrieval search (10K caps): < 20ms
%%   Retrieval search (100K caps): < 50ms
%%   Provider resolution: < 5ms
%%   Context build (small): < 10ms
%%   Full Fabric overhead: < 100ms P95, < 500ms max
%%
%% TOOL INVENTORY (Who Has What -- Complete K1 Tool Map):
%%
%%   CONCIERGE LLM (13 tools, available ALL tiers):
%%     Cognitive Tools (6) -- writes SessionState via MutationGuard (NOT Fabric):
%%       update_scoreboard, update_beliefs, update_clarifications,
%%       update_narrative, refine_affect, promote_belief
%%     Read Tools (3) -- 1 of 3 touches Fabric:
%%       recall_memory (Bridge), discover_capabilities (Fabric), summarize_context (internal)
%%     Action Tools (3) -- ALL route to Fabric:
%%       invoke_capability, spawn_via_fabric, execute_workflow
%%     Signal Tools (1) -- NOT Fabric:
%%       acknowledge_request (direct to OUTPUT_CHANNEL)
%%
%%   PLANNER LLM (4 tools, ALL read-only):
%%     discover_capabilities, find_relevant_prompts -> Fabric Retrieval
%%     query_planning_context, recall_for_planning -> NOT Fabric
%%
%%   ORCHESTRATOR: ZERO TOOLS (Blind DAG Executor, calls Fabric.execute() per step)
%%   SUB-AGENTS: SCOPED SUBSET from tools_granted[] (FAB-07)
%%   FABRIC: ZERO TOOLS (Fabric IS the tool runtime)
%%
%% BRIDGE CONNECTION (3 Ports):
%%   IKernelQueryPort      <-- BRIDGE_PROVIDER (recall), recall_memory(), recall_for_planning()
%%   IKernelCommandPort    <-- BRIDGE_PROVIDER (memory.delta, checkpoint, feedback.signal)
%%   IConnectorGatewayPort <-- IFL (ALL external: devices, APIs, services, sensors)
%%
%% IFL UNIVERSAL CONNECTOR PROTOCOL:
%%   IFL is NOT device-only. It is the universal language for ALL external services.
%%   Tool naming: tool.{type}.{category}.{adapter}.{action}
%%   Event taxonomy: ifl.{category}.{adapter}.{event}
%%   See: architecture_diagrams/bridge/interkernel_fabric_layer.mmd
%%
%% GOVERNING DOCUMENTS:
%%   Design: k1/fabric/fabric_discussion.md (26 sections)
%%   Skeleton: architecture_diagrams/k1/k1_cognitive_architecture_skeleton.mmd
%%   Integration Guide: k1/fabric/docs/fabric_integration_guide.md
%%   ADRs: ADR-K004, ADR-0005, ADR-0017, ADR-0028, ADR-1.1.9
%% =====================================================================================

subgraph FABRIC["Capability Fabric -- Layer 2.5 (Resolution + Retrieval + Execution -- NO LLM)"]
