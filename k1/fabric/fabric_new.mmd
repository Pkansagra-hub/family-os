CALLER_PLANNER -->|"find_relevant_prompts(intent, domain)"| FABRIC_RETRIEVAL_API
FABRIC_RETRIEVAL_API -->|"SearchQuery"| RETRIEVAL_ENGINE_CORE
RETRIEVAL_ENGINE_CORE -->|"embed query"| EMBED_QUERY
EMBED_QUERY -->|"query_vector"| HARD_FILTER
HARD_FILTER -->|"filtered_set"| SOFT_RANKER
SOFT_RANKER -->|"scored_set"| TOP_K_SELECTOR
TOP_K_SELECTOR -->|"Top-K RetrievalResult[]"| FABRIC_RETRIEVAL_API
RETRIEVAL_ENGINE_CORE -->|"query registries"| CAPABILITY_REGISTRY
EMBEDDING_INDEX -->|"cosine similarity"| RETRIEVAL_ENGINE_CORE
HARD_FILTER -->|"safety_band check"| SS_CONTROL

