  subgraph FABRIC_CORE["Fabric Core (API Surface + Central Coordination)"]
    direction TB

    CAPABILITY_FABRIC["CapabilityFabric (fabric.py)<br/>execute(CapabilityRequest) -> CapabilityResult<br/>execute_batch(list[CapReq]) -> list[CapResult]<br/>---<br/>CapabilityRequest:<br/>  name, params, intent, trace_id, tier,<br/>  output_schema: JsonSchema | null (ORCH-15),<br/>  schema_hint: string | null (retry with shape guidance)<br/>---<br/>CapabilityResult:<br/>  success, data, error, duration_ms,<br/>  tokens_consumed: int (0 for non-LLM providers),<br/>  quality_score: float | null (agent only, FAB-13),<br/>  discoveries: object[] | null (agent-reported new info)<br/>---<br/>9-step pipeline: emit -> resolve -> context -> instantiate<br/>  -> CB execute -> validate output -> emit -> metrics -> learn<br/>---<br/>Concurrency: Semaphore(10) (ADR-1.1.9, NO mailbox)<br/>Stateless per-request (FAB-03)<br/>CB timeout: 30s (FAB-04)"]:::fabric_core

    FABRIC_RETRIEVAL_API["FabricRetrieval (fabric.py)<br/>discover_capabilities(domain?, intent?, band, ctx, top_k=10)<br/>find_relevant_prompts(intent?, domain?, band, top_k=10)<br/>---<br/>Serves Planner discovery tools only<br/>Read-only (no execution triggered)<br/>< 50ms per call"]:::fabric_core

