%% =====================================================================================
%% CAPABILITY FABRIC (K1) -- DEEP ARCHITECTURE DIAGRAM
%% =====================================================================================
%% STATUS: COMPLETE DESIGN (from fabric_discussion.md, 26 sections)
%%
%% Capability Fabric is K1's central resolution, retrieval, and execution engine.
%% Layer 2.5 in K1 Cognitive Architecture Skeleton.
%%
%% THREE ROLES:
%%   Role 1: Intelligent Retrieval -- serves Planner (semantic Top-K, discovery tools)
%%   Role 2: Resolution + Execution -- serves Orchestrator and Concierge (all tiers)
%%   Role 3: Agent Factory -- spawns per-step workers from YAML templates
%%
%% HARD INVARIANTS (12):
%%   FAB-01: Fabric NEVER writes to SessionState
%%   FAB-02: Fabric NEVER calls an LLM
%%   FAB-03: Fabric is stateless per-request
%%   FAB-04: Every execution returns CapabilityResult within CB timeout (30s)
%%   FAB-05: Hard filters run BEFORE soft ranking (safety first)
%%   FAB-06: Safety band access is ALWAYS checked before provider execution
%%   FAB-07: Sub-Agent tool access scoped to plan-specified tools_granted[] only
%%   FAB-08: Context Builder respects 128K token budget for agent context
%%   FAB-09: All events emitted on K1 Event Bus with cognitive_trace_id
%%   FAB-10: Provider selection is deterministic given same inputs + same registry state
%%   FAB-11: Capability names follow type conventions (agent.spawn.*, tool.execute.*, etc.)
%%   FAB-12: All contracts validated against schema before registration
%%   FAB-13: quality_score computed deterministically (no LLM, no randomness)
%%
%% CALLERS:
%%   Concierge (LOW tier -- direct fast path, < 2s)
%%   Orchestrator (MEDIUM/HIGH tier -- DAG execution, 2-60s)
%%   Planner (HIGH tier -- discovery only, read-only, < 50ms per call)
%%   Sub-Agents (spawned by Fabric, scoped invoke_capability)
%%
%% WHAT FABRIC IS NOT:
%%   NOT an orchestrator (Orchestrator walks the DAG)
%%   NOT a planner (Planner decides what to do)
%%   NOT an LLM (deterministic: lookup, filter, rank, route, execute)
%%   NOT a state writer (NEVER writes SessionState, ADR-0017)
%%
%% PERFORMANCE TARGETS (Fabric overhead, excl. provider execution):
%%   Registry lookup: < 1ms (hash table O(1))
%%   Retrieval search (10K caps): < 20ms
%%   Retrieval search (100K caps): < 50ms
%%   Provider resolution: < 5ms
%%   Context build (small): < 10ms
%%   Full Fabric overhead: < 100ms P95, < 500ms max
%%
%% TOOL INVENTORY (Who Has What -- Complete K1 Tool Map):
%%
%%   CONCIERGE LLM (13 tools, available ALL tiers):
%%     Cognitive Tools (6) -- LLM detects what to update, writes SessionState via MutationGuard:
%%       update_scoreboard()       -- referents, QUD, salience, topic shift -> scoreboard
%%       update_beliefs()          -- new facts, corrections, invalidations -> beliefs_active
%%       update_clarifications()   -- semantic gaps, resolved gaps -> clarifications
%%       update_narrative()        -- thread switch/resume/new/continue -> narrative_active
%%       refine_affect()           -- override UltraBERT emotion on sarcasm/nuance -> affective_now
%%       promote_belief()          -- WARM to HOT fact promotion -> beliefs_active
%%       ** NONE of these touch Fabric. All go through IStatePort -> MutationGuard.
%%
%%     Read Tools (3) -- context retrieval, no state mutation:
%%       recall_memory()           -- K0 long-term query via IMemoryPort -> Bridge (NOT Fabric)
%%       discover_capabilities()   -- Capability Registry query -> Fabric Retrieval API
%%       summarize_context()       -- token budget compression -> ContextAssembler (NOT Fabric)
%%       ** Only discover_capabilities() routes to Fabric.
%%
%%     Action Tools (3) -- execution and delegation, ALL route to Fabric:
%%       invoke_capability()       -- direct execution via Fabric.execute() (LOW tier fast path)
%%       spawn_via_fabric()        -- dynamic agent creation via Fabric Agent Factory
%%       execute_workflow()        -- pre-compiled workflow via Fabric Workflow Provider (max depth 3)
%%       ** All 3 route through IDispatchPort -> FabricOrchAdapter -> Fabric.
%%
%%     Signal Tools (1) -- emit-only, no state mutation, no Fabric:
%%       acknowledge_request()     -- immediate intent ack to user (~150 tokens, ~50ms)
%%                                    LLM first tool call in ACKING, parallel with cognitive tools
%%                                    Skipped on trivial turns. Goes direct to OUTPUT_CHANNEL.
%%
%%   PLANNER LLM (4 tools, ALL read-only, NEVER writes/executes/spawns):
%%     discover_capabilities(domain?, intent?)  -- semantic Top-K from Tool+Agent registries -> Fabric Retrieval
%%     find_relevant_prompts(intent?, domain?)  -- semantic Top-K from Prompt Registry -> Fabric Retrieval
%%     query_planning_context(sections?)         -- reads SessionState sections -> NOT Fabric (direct multi-reader)
%%     recall_for_planning(query)                -- K0 long-term memory -> NOT Fabric (via Bridge direct)
%%     ** Only discover_capabilities() and find_relevant_prompts() route to Fabric.
%%
%%   ORCHESTRATOR: ZERO TOOLS (Blind DAG Executor, NO LLM, calls Fabric.execute() per step)
%%
%%   SUB-AGENTS: SCOPED SUBSET of action tools from tools_granted[] (FAB-07)
%%     - Defined in AgentContract YAML + overridden by CommittedPlan step
%%     - All calls route through Fabric.execute() (same path as any caller)
%%     - Example: invitation_sender gets only tool.execute.send_message + tool.read.contact_lookup
%%
%%   FABRIC: ZERO TOOLS (Fabric IS the tool runtime, not a consumer)
%%
%%   TOOL-TO-FABRIC ROUTING SUMMARY:
%%     Fabric.execute()         <-- invoke_capability(), spawn_via_fabric(), execute_workflow(),
%%                                   Orchestrator per-step calls, Sub-Agent scoped calls
%%     Fabric Retrieval API     <-- discover_capabilities() (Concierge + Planner),
%%                                   find_relevant_prompts() (Planner)
%%     NOT Fabric               <-- 6 cognitive tools, recall_memory(), summarize_context(),
%%                                   acknowledge_request(), query_planning_context(),
%%                                   recall_for_planning()
%%
%% BRIDGE CONNECTION (3 Ports -- see architecture_diagrams/bridge/bridge_architecture.mmd):
%%   IKernelQueryPort      <-- BRIDGE_PROVIDER (recall), MCP_PROVIDER (local MCP), recall_memory(), recall_for_planning()
%%   IKernelCommandPort    <-- BRIDGE_PROVIDER (memory.delta, checkpoint, feedback.signal)
%%   IConnectorGatewayPort <-- MCP_PROVIDER (ALL external: devices, APIs, services, sensors via IFL)
%%
%% IFL UNIVERSAL CONNECTOR PROTOCOL:
%%   IFL is NOT device-only. It is the universal language for ALL external services.
%%   Companies build IFL-compliant adapters (FamilyOS-signed, company-verified).
%%   Adapter hosting: company-hosted (primary) or WASM sandboxed (offline/local).
%%   Auto-registration: adapter manifest -> ManifestTranslator -> Fabric tool contracts.
%%   Tool naming: tool.{type}.{category}.{adapter}.{action}
%%     e.g. tool.read.finance.chase.check_balance
%%          tool.execute.home.hue.set_brightness
%%          tool.execute.transport.uber.request_ride
%%   Event taxonomy: ifl.{category}.{adapter}.{event}
%%     e.g. ifl.finance.chase.transaction.alert
%%          ifl.health.fitbit.heart_rate
%%   IFL detail: architecture_diagrams/bridge/interkernel_fabric_layer.mmd
%%
%% GOVERNING DOCUMENTS:
%%   Design: k1/fabric/fabric_discussion.md (26 sections)
%%   Skeleton: architecture_diagrams/k1/k1_cognitive_architecture_skeleton.mmd (L2_5_FABRIC)
%%   Whiteboard: docs/architecture/whiteboard_k1/whiteboard_concierge_orchestrator_planner_fabric.md
%%   ADRs: ADR-K004 (Capability Fabric), ADR-0005 (Agent Lifecycle),
%%         ADR-0017 (Single Writer), ADR-0028 (Performance Scheduling)
%% =====================================================================================

subgraph FABRIC["Capability Fabric -- Layer 2.5 (Resolution + Retrieval + Execution -- NO LLM)"]
  direction TB

  %% ==================================================================================
  %% FABRIC CORE -- Main Entry Points and Central Components
  %% ==================================================================================

  subgraph FABRIC_CORE["Fabric Core (API Surface + Central Coordination)"]
    direction TB

    CAPABILITY_FABRIC["CapabilityFabric<br/>execute(CapabilityRequest) -> CapabilityResult<br/>execute_batch(list[CapReq]) -> list[CapResult]<br/>---<br/>CapabilityRequest (extended for Adaptive DAG):<br/>  name, params, intent, trace_id, tier,<br/>  output_schema: JsonSchema | null (ORCH-15),<br/>  schema_hint: string | null (retry with shape guidance)<br/>---<br/>CapabilityResult (extended for Adaptive DAG):<br/>  success, data, error, duration_ms,<br/>  tokens_consumed: int (0 for non-LLM providers),<br/>  quality_score: float | null (agent only, FAB-13),<br/>  discoveries: object[] | null (agent-reported new info)<br/>---<br/>Stateless per-request (FAB-03)<br/>CB timeout: 30s (FAB-04)<br/>Safety check before execution (FAB-06)<br/>Events on K1 Bus with trace_id (FAB-09)"]:::fabric_core

    FABRIC_RETRIEVAL_API["FabricRetrieval<br/>discover_capabilities(domain?, intent?, band, ctx, top_k=10)<br/>find_relevant_prompts(intent?, domain?, band, top_k=10)<br/>---<br/>Serves Planner discovery tools only<br/>Read-only (no execution triggered)<br/>< 50ms per call"]:::fabric_core

    CAPABILITY_REGISTRY_API["CapabilityRegistryAPI<br/>register(contract) | unregister(name)<br/>lookup(name) -> Contract | None<br/>update_availability(name, status)<br/>update_metrics(name, success, latency_ms)<br/>reload() | health() -> RegistryHealth"]:::fabric_core

    FABRIC_MAILBOX["Fabric Mailbox<br/>WFQ Priority: REALTIME<br/>MPSC Queue<br/>---<br/>Open Question: sync per-request<br/>vs queued mailbox model"]:::mailbox
  end

  %% ==================================================================================
  %% SUBSYSTEM 1: CAPABILITY CONTRACT SYSTEM
  %% ==================================================================================

  subgraph CONTRACT_SYSTEM["Subsystem 1: Capability Contract System"]
    direction TB

    subgraph CONTRACT_TYPES["Contract Types (YAML in k1/contracts/)"]
      direction TB

      TOOL_CONTRACTS["Tool Contracts<br/>k1/contracts/tools/*.yaml<br/>---<br/>name: tool.execute.* | tool.read.*<br/>provider_type: MCP | WASM | BRIDGE<br/>required_inputs[], output schema<br/>required_context[], optional_context[]<br/>prompt_template?, activity_profile?<br/>tool_instructions?, prompt_variables_schema?<br/>safety_band_min, cost_per_call, avg_latency_ms"]:::contract

      AGENT_CONTRACTS["Agent Contracts<br/>k1/contracts/agents/*.yaml<br/>---<br/>name: agent.execute.* | agent.spawn.*<br/>prompt_template, tools_granted[]<br/>llm_budget_tokens, max_tool_calls<br/>max_execution_time_ms<br/>template_file reference<br/>---<br/>Known Agents (MW + Learning):<br/>memory_writer, curiosity_agent,<br/>reminder_agent, gap_answer_writer,<br/>learning_extractor<br/>See: memory_writer.mmd, learning.mmd"]:::contract

      PROMPT_CONTRACTS["Prompt Contracts<br/>k1/contracts/prompts/*.yaml<br/>---<br/>name, version, domain[]<br/>intent_match[] (retrieval triggers)<br/>variables[] (must be filled)<br/>template_file -> k1/prompts/** markdown<br/>compatible_agents[], compatible_tools[], output_format"]:::contract

      WORKFLOW_CONTRACTS["Workflow Contracts<br/>k1/contracts/workflows/*.yaml<br/>---<br/>name: workflow.run.*<br/>source_plan_id (from CommittedPlan)<br/>trigger: cron | event | manual<br/>steps[] (frozen DAG)<br/>max_depth: 3, allows_sub_workflows"]:::contract
    end

    subgraph CONTRACT_VALIDATION["Contract Validation (Module Validator)"]
      direction TB

      MODULE_VALIDATOR["Module Validator<br/>Schema validation for ALL contracts<br/>---<br/>12 validation rules enforced:<br/>1. name follows type convention<br/>2. version is valid semver<br/>3. domain[] has >= 1 tag<br/>4. description non-empty (for embedding)<br/>5. required_inputs[] complete<br/>6. output has JSON Schema<br/>7. provider_type in {MCP,WASM,BRIDGE,AGENT}<br/>8. safety_band_min in {GREEN,AMBER,RED,CRISIS}<br/>9. availability in {ONLINE,DEGRADED,OFFLINE}<br/>10. agents: tools_granted[] refs valid<br/>11. prompts: required vars satisfiable<br/>12. workflows: DAG is acyclic"]:::validator

      CONTRACT_SCHEMAS["Contract Schemas<br/>k1/contracts/schemas/<br/>---<br/>tool_contract.schema.json<br/>agent_contract.schema.json<br/>prompt_contract.schema.json<br/>workflow_contract.schema.json"]:::contract
    end

    CAPABILITY_VERSIONING["Versioning and Compatibility<br/>Semver per contract<br/>Hot-reload: atomic per-contract<br/>Schema drift detection on workflows"]:::contract
  end

  %% ==================================================================================
  %% SUBSYSTEM 2: CAPABILITY REGISTRY
  %% ==================================================================================

  subgraph REGISTRY_SYSTEM["Subsystem 2: Capability Registry (In-Memory Indexed Catalog)"]
    direction TB

    CAPABILITY_REGISTRY["Capability Registry<br/>Agent/Tool/Workflow/Prompt index<br/>100K+ items at scale<br/>---<br/>by_name: dict (O(1) exact lookup)<br/>by_domain: inverted index<br/>by_type: grouped by prefix<br/>by_provider: grouped by provider_id<br/>metadata_cache: hot contract metadata"]:::registry

    EMBEDDING_INDEX["Embedding Index<br/>FAISS (flat L2 or IVF for >10K)<br/>---<br/>vectors: ndarray[float32] (N x dim)<br/>texts: description + capabilities per contract<br/>Same embedding model as K1 default<br/>Rebuild: startup (full), on register (incremental)"]:::registry

    MODULE_LOADER["Module Loader<br/>Watches k1/contracts/ for changes<br/>---<br/>On file create/modify/delete:<br/>1. Parse modified YAML<br/>2. Validate via Module Validator<br/>3. Valid: unregister(old) + register(new)<br/>4. Invalid: log error, keep old, emit event<br/>No downtime: atomic per-contract"]:::engine

    MODULE_CACHE["Module Cache<br/>Hot-loaded contracts<br/>---<br/>In-memory cache of parsed contracts<br/>Invalidated on hot-reload<br/>Serves fast lookup for resolve path"]:::registry
  end

  %% ==================================================================================
  %% SUBSYSTEM 3: SEMANTIC RETRIEVAL ENGINE (Role 1: Serves Planner)
  %% ==================================================================================

  subgraph RETRIEVAL_ENGINE["Subsystem 3: Semantic Retrieval Engine (Role 1 -- Serves Planner)"]
    direction TB

    SEMANTIC_SEARCH["Semantic Search Engine<br/>Embedding cosine similarity<br/>across 100K+ tools/agents/prompts<br/>---<br/>Receives SearchQuery{text, domain?, intent?, band, top_k}<br/>Planner tools: discover_capabilities(), find_relevant_prompts()"]:::engine

    subgraph RETRIEVAL_PIPELINE["4-Step Retrieval Pipeline"]
      direction TB

      EMBED_QUERY["Step 1: Embed Query<br/>Same model that indexed registry<br/>query_vector = embed(query_text)<br/>< 5ms per query"]:::step

      HARD_FILTER["Step 2: Hard Filter (Eliminates Non-Candidates)<br/>---<br/>Rule 1: Safety band access (band_min <= user_band)<br/>Rule 2: Availability != OFFLINE (DEGRADED kept, penalized)<br/>Rule 3: Required inputs satisfiable from context<br/>---<br/>ANY hard rule fail = eliminated<br/>< 2ms (field comparisons, no I/O)"]:::safety

      SOFT_RANKER["Step 3: Soft Ranking (Scores Remaining)<br/>---<br/>Score = (0.4 x semantic_similarity)<br/>      + (0.3 x domain_match)<br/>      + (0.15 x success_rate_30d)<br/>      + (0.15 x cost_latency_score)<br/>---<br/>DEGRADED penalty: score x 0.7<br/>< 10ms (dot products + field reads)"]:::engine

      TOP_K_SELECTOR["Step 4: Top-K Selection<br/>Default K=10, max K=25<br/>---<br/>Returns: contract + input/output schema<br/>+ score (debug only, not exposed to Planner LLM)<br/>+ provider type"]:::engine
    end
  end

  %% ==================================================================================
  %% SUBSYSTEM 4: PROVIDER RESOLUTION ENGINE (Role 2: Exact Name Lookup)
  %% ==================================================================================

  subgraph RESOLUTION_ENGINE["Subsystem 4: Provider Resolution Engine (Role 2 -- Exact Match)"]
    direction TB

    subgraph RESOLUTION_PIPELINE["5-Step Resolution Pipeline"]
      direction TB

      REGISTRY_LOOKUP["Step 1: Registry Lookup<br/>contract = registry.lookup(request.name)<br/>O(1) via by_name dict<br/>Not found: CapabilityResult{error: capability_not_found}"]:::step

      PROVIDER_MATCHER["Step 2: Provider Matching<br/>Find all providers for this contract<br/>Usually 1:1 (one provider per capability)<br/>Some capabilities: multiple providers<br/>(e.g., opentable_mcp + resy_mcp)"]:::engine

      POLICY_EVALUATION["Step 3: Policy Evaluation<br/>(See Subsystem 5: Policy Engine)<br/>Security hard gate + 3 soft dimensions<br/>Per-provider composite score"]:::engine

      PROVIDER_SELECTOR["Step 4: Provider Selection<br/>Highest composite score wins<br/>Ties: lower avg_latency_ms, then alphabetical<br/>All fail security: error=access_denied<br/>Deterministic (FAB-10)"]:::engine

      PROVIDER_INSTANTIATION["Step 5: Provider Instantiation<br/>Provider Factory creates handler:<br/>MCPProvider | WASMProvider | BridgeProvider<br/>AgentProvider | WorkflowProvider | ConciergeProvider"]:::factory
    end

    PROVIDER_REGISTRY["Provider Registry (Internal)<br/>Maps provider_id -> ProviderConfig<br/>---<br/>MCP: endpoint, transport (stdio/SSE/HTTP), max_concurrent<br/>WASM: module_path, sandbox_memory_mb, max_execution_ms<br/>Bridge: bridge_endpoint, operations[]<br/>---<br/>health_check() per provider<br/>health_check_interval: 60s"]:::registry

    PROVIDER_FACTORY["Provider Factory<br/>Instantiate capability handlers<br/>---<br/>Creates: MCPProvider, WASMProvider,<br/>BridgeProvider, AgentProvider,<br/>WorkflowProvider, ConciergeProvider"]:::factory
  end

  %% ==================================================================================
  %% SUBSYSTEM 5: POLICY ENGINE (4 Dimensions)
  %% ==================================================================================

  subgraph POLICY_ENGINE["Subsystem 5: Policy Engine (4 Dimensions)"]
    direction TB

    SECURITY_CONTEXT["Dimension 1: Security Context (HARD GATE)<br/>---<br/>FIRST check. Fail = immediate reject.<br/>user_band >= capability_band_min<br/>Band ordering: GREEN < AMBER < RED < CRISIS<br/>---<br/>Also checks:<br/>Sub-Agent tool scoping (tools_granted[])<br/>Rate limiting per capability<br/>Tenant isolation (family_id)<br/>---<br/>META-OPERATION GATES (4.5.5):<br/>build_agent requires AMBER minimum<br/>Created agents inherit creator max band<br/>Restricted domains: META, SECURITY, ADMIN<br/>No recursive creation (build_agent not grantable)<br/>Depth=1: agents cannot invoke other agents"]:::safety

    AFFECTIVE_ROUTING["Dimension 2: Affective Routing (Soft Score)<br/>---<br/>Reads affective_now from SessionState<br/>High sadness/anxiety (>0.7): +0.1 empathetic providers<br/>High joy/excitement: +0.05 detail-rich providers<br/>Neutral/low: no adjustment<br/>Output: affective_score (0.0 - 0.2)"]:::policy

    COGNITIVE_LOAD["Dimension 3: Cognitive Load Routing (Soft Score)<br/>---<br/>Reads complexity_tier + cognitive state<br/>High load (user overwhelmed): +0.1 fast/simple providers<br/>Low load (user fresh): +0.05 comprehensive providers<br/>Output: cognitive_score (0.0 - 0.15)"]:::policy

    QOS_INTEGRATION["Dimension 4: QoS Integration (Soft Score)<br/>---<br/>Budget-aware + latency-aware selection<br/>Tight budget (<20%): heavy cost preference (0.8 weight)<br/>Tight latency (<30%): heavy speed preference (0.8 weight)<br/>Ample resources: balanced (0.3 each)<br/>Output: qos_score (0.0 - 0.2)"]:::policy

    COMPOSITE_SCORE["Composite Provider Score<br/>---<br/>final_score = base_relevance_score<br/>            + affective_score<br/>            + cognitive_score<br/>            + qos_score<br/>---<br/>Highest score selected<br/>Ties: lower latency, then alphabetical name"]:::engine
  end

  %% ==================================================================================
  %% SUBSYSTEM 6: EXECUTION RUNTIME (6 Provider Types)
  %% ==================================================================================

  subgraph EXECUTION_RUNTIME["Subsystem 6: Execution Runtime (6 Provider Types)"]
    direction TB

    PROVIDER_INTERFACE["CapabilityProvider Protocol<br/>---<br/>execute(request, context, trace_id) -> CapabilityResult<br/>health_check() -> ProviderHealth<br/>capabilities() -> list[str]<br/>---<br/>CapabilityResult contract (ALL providers):<br/>  success: bool, data: any, error: str | null,<br/>  duration_ms: int,<br/>  tokens_consumed: int (0 for non-LLM: MCP, WASM, Bridge),<br/>  quality_score: float | null (null for non-agent),<br/>  discoveries: object[] | null (null for non-agent)<br/>Non-agent providers set tokens=0, quality=null, discoveries=null"]:::engine

    subgraph PROVIDERS["Provider Implementations"]
      direction TB

      MCP_PROVIDER["MCP Provider<br/>---<br/>Local MCP (stdio): file_system, calculator, sqlite<br/>Remote MCP (SSE/HTTP): weather_api, opentable<br/>K0 Connector Proxy: HomeKit, Tesla, Google Home (via Bridge/IFL)<br/>---<br/>Flow: CapReq -> MCP tool_call msg -> server -> parse result<br/>Prompt/profile metadata under reserved __metadata__<br/>CB timeout: local 10s, remote 15s"]:::provider

      WASM_PROVIDER["WASM Provider<br/>---<br/>Sandboxed computation<br/>Memory: default 64MB, configurable<br/>Timeout: default 5s, configurable<br/>No network access (pure computation)<br/>---<br/>Flow: CapReq -> load module (cached) -> sandbox -> execute -> unmarshal<br/>Prompt/profile metadata under reserved __metadata__<br/>CB timeout: 5s"]:::provider

      BRIDGE_PROVIDER["Bridge Provider<br/>---<br/>Routes to K0 via Cross-Kernel Bridge<br/>Operations: memory.store, memory.recall,<br/>memory.delta, checkpoint, feedback.signal<br/>---<br/>Offline fallback: LOCAL COLD (K1 SQLite)<br/>CB timeout: 10s"]:::provider

      AGENT_PROVIDER["Agent Provider (triggers Agent Factory)<br/>---<br/>For agent.execute.* and agent.spawn.* capabilities<br/>Spawns per-step workers with own LLM<br/>(See Agent Factory subgraph below)<br/>---<br/>ADAPTIVE DAG EXTENSIONS (serves ORCH-13..16):<br/>1. tokens_consumed: sum of LLM input+output tokens<br/>   from Model Hub handle per agent execution<br/>2. quality_score (FAB-13, deterministic):<br/>   0.5 * schema_completeness (output vs output_schema)<br/>   + 0.3 * content_density (non-empty fields / total)<br/>   + 0.2 * (1.0 - null_ratio)<br/>   null for non-agent providers (bypass gate)<br/>3. discoveries[]: structured new info from agent output<br/>   Agent marks discoveries in tool_result metadata<br/>   e.g. {field: 'venue_closed', value: true, source: 's2'}<br/>4. schema_hint injection: if request.schema_hint != null,<br/>   Context Builder appends schema shape to agent prompt<br/>---<br/>SUB-STEP EVENTS (pass-through for Orchestrator observability):<br/>  fabric.agent.{id}.tool_call.{tool_name} per tool invocation<br/>  fabric.agent.{id}.llm_call.{call_num} per LLM round-trip<br/>  fabric.agent.{id}.iteration.{n} per agent loop iteration<br/>  All emitted on K1 Event Bus with trace_id (FAB-09)<br/>---<br/>CB timeout: 30s"]:::provider

      WORKFLOW_PROVIDER["Workflow Provider<br/>---<br/>Rehydrates frozen WorkflowSpec<br/>Validates capabilities still exist (drift detection)<br/>Creates Run Manifest (pinned version + hash)<br/>Routes to Orchestrator for DAG execution<br/>---<br/>Max depth: 3 (sub-workflow nesting limit)<br/>CB timeout: 60s"]:::provider

      CONCIERGE_PROVIDER["Concierge Provider<br/>---<br/>Handles concierge.state.* capabilities<br/>Routes to FSM state handlers<br/>Modifies FSM state via Concierge Single Writer<br/>CB timeout: 10s"]:::provider
    end
  end

  %% ==================================================================================
  %% SUBSYSTEM 7: CONTEXT BUILDER
  %% ==================================================================================

  subgraph CONTEXT_BUILDER_SYSTEM["Subsystem 7: Context Builder"]
    direction TB

    CONTEXT_BUILDER["Context Builder<br/>SessionState + context_override -> ExecutionContext<br/>---<br/>Assembles execution context for<br/>agents and tool calls<br/>Multi-reader, lock-free SessionState reads<br/>Preserves prompt/profile override metadata"]:::engine

    subgraph CONTEXT_PIPELINE["6-Step Context Assembly"]
      direction TB

      CTX_READ_CONTRACT["Step 1: Read Contract Requirements<br/>sections_needed = required_context + optional_context"]:::step

      CTX_FETCH_STATE["Step 2: Fetch From SessionState<br/>Multi-reader, lock-free reads<br/>Optional missing: skip (no error)<br/>Required missing: log warning, continue partial"]:::step

      CTX_INJECT_PARAMS["Step 3: Inject Request Params<br/>context.params = request.params<br/>context.intent = request.intent"]:::step

      CTX_RESOLVE_PROMPT["Step 4: Resolve Prompt Template + Schema Hint<br/>Priority: request.prompt_template -> contract.prompt_template<br/>  -> tool_instructions fallback -> no prompt<br/>variables = schema defaults + params + context_override.prompt_variables<br/>compiled = prompt_compiler.compile()<br/>---<br/>SCHEMA HINT INJECTION (serves ORCH-15):<br/>If request.schema_hint != null:<br/>  Append to compiled prompt:<br/>  'Your output MUST match this JSON schema:<br/>   {request.output_schema}<br/>   Previous attempt failed: {request.schema_hint}'<br/>If request.output_schema != null AND no schema_hint:<br/>  Append output_schema as response format guidance<br/>Cost: < 1ms (string concat, no LLM)"]:::step

      CTX_APPLY_BUDGET["Step 5: Apply Token Budget<br/>Ceiling: 128K tokens (FAB-08)<br/>---<br/>Compression strategy if > 80%:<br/>1. Drop optional_context sections<br/>2. Truncate history (keep last 3 turns)<br/>3. Summarize beliefs (drop low-confidence)<br/>4. Summarize scoreboard (keep current QUD)<br/>5. Emergency: drop WARM, keep only HOT"]:::step

      CTX_PACKAGE["Step 6: Package and Return<br/>ExecutionContext{<br/>  session_sections incl. context_override,<br/>  params, prompt (compiled), token_count,<br/>  trace_id<br/>}"]:::step
    end

    CONTEXT_BUDGET["Context Budget Manager<br/>Token: 128K ceiling<br/>Strategy: recency + relevance<br/>---<br/>System prompt: 2K-5K<br/>Compiled prompt: 500-2K<br/>SessionState: 10K-40K<br/>Request params: 1K-5K<br/>Tool results: 5K-20K<br/>Response headroom: 2K-8K"]:::engine
  end

  %% ==================================================================================
  %% AGENT FACTORY (Inside Execution Runtime)
  %% ==================================================================================

  subgraph AGENT_FACTORY_SYSTEM["Agent Factory (Role 3 -- Spawns Per-Step Workers)"]
    direction TB

    subgraph AGENT_INSTANTIATION["8-Step Agent Instantiation"]
      direction TB

      AF_LOAD_TEMPLATE["Step 1: Load Template<br/>YAML from contract.template_file<br/>Validate against agent contract schema"]:::step

      AF_CREATE_MAILBOX["Step 2: Create Mailbox<br/>MPSC Mailbox<br/>WFQ Priority: INTERACTIVE<br/>Capacity: 100 messages"]:::step

      AF_GRANT_LLM["Step 3: Grant LLM Access<br/>model_hub.create_handle(<br/>  budget_tokens, capabilities[], model_preference, trace_id<br/>)<br/>Routes HubRequest via LLM Request Bus to Model Hub<br/>Capabilities scoped per AgentContract<br/>See: k1/model_hub/model_hub.mmd"]:::step

      AF_GRANT_STATE["Step 4: Grant SessionState Read<br/>Multi-reader, lock-free<br/>Scoped to contract.required_context sections"]:::step

      AF_SCOPE_TOOLS["Step 5: Scope Tool Access (FAB-07)<br/>---<br/>Start: contract.tools_granted[]<br/>Override: plan_step.tools_granted[]<br/>Plan step takes precedence<br/>NEVER grant outside union of both"]:::step

      AF_BUILD_CONTEXT["Step 6: Build Initial Context<br/>Uses Context Builder (Subsystem 7)<br/>Prompt + SessionState + params + budget"]:::step

      AF_INSTANTIATE["Step 7: Instantiate Agent<br/>Agent(id, contract, mailbox, llm,<br/>state_reader, tools, context, lifecycle=PENDING)"]:::step

      AF_START_LIFECYCLE["Step 8: Start Lifecycle<br/>PENDING -> WARMING (model preload)<br/>WARMING -> ACTIVE (execute task)<br/>ACTIVE -> IDLE (pool for reuse, 60s TTL)<br/>or ACTIVE -> DRAINING -> TERMINATED"]:::step
    end

    AGENT_LIFECYCLE["Agent Lifecycle (ADR-0005)<br/>---<br/>PENDING --(Supervisor Hire)--> WARMING<br/>WARMING --(Model Ready)-----> ACTIVE<br/>ACTIVE ---(60s Idle TTL)----> IDLE<br/>IDLE -----(New Task)--------> ACTIVE (fast reactivate)<br/>ACTIVE ---(Supervisor Drain)-> DRAINING<br/>DRAINING -(Tasks Complete)--> TERMINATED<br/>---<br/>IDLE pool: same-type agent reuse<br/>TERMINATED: release mailbox, LLM handle, state reader, tools"]:::lifecycle

