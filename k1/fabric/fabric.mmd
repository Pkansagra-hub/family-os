    EVENT_BUS["K1 Bus — Event lane<br/>Topics: k1.*<br/>All Fabric events with trace_id"]:::bus
    DELTA_BUS["K1 Bus — Delta lane<br/>Sub-Agents emit state deltas here<br/>k1.agent.{id}.delta.v1"]:::bus
  end

  subgraph TP_ORCHESTRATOR_MAILBOX["Orchestrator Integration"]
    direction TB

    ORCHESTRATOR_MAILBOX["Orchestrator Mailbox<br/>Receives TaskEnvelope (MED/HIGH)<br/>Returns CapabilityResult via K1 Bus"]:::caller
    TOPOLOGICAL_WALKER["Topological Walker<br/>DAG step ordering<br/>Parallel steps where no deps"]:::engine
  end

  subgraph TP_MEMORY_WRITER_LEARNING["Memory Writer + Learning Loop (Background Consumers)"]
    direction TB

    MW_TP["Memory Writer<br/>Subscribes: turn.complete.v1 via IEventPort<br/>Spawns: agent.spawn.memory_writer<br/>Pipeline: filter -> extract -> envelope -> submit<br/>See: k1/memory_writer/memory_writer.mmd"]:::caller

    LL_TP["Learning Loop<br/>Subscribes: turn.complete.v1, fabric.learning.signal.v1<br/>Spawns: curiosity_agent, gap_answer_writer,<br/>reminder_agent, learning_extractor<br/>See: k1/learning/learning.mmd"]:::caller
  end
end

