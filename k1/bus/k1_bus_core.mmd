            ENV_OPS["Rust Envelope Ops<br/>#[pyclass(frozen)] -- 12 fields<br/>from_bytes(): zero-copy FlatBuffers reader<br/>to_bytes(): single-alloc FlatBuffers builder<br/>with_bus_fields(): cheap struct copy (~128 bytes)<br/>Cross-lang: Py to_bytes -> Rust from_bytes"]:::rust_envelope
        end
    end

