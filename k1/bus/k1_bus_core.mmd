            SUB_EVENTS["Subscription Lifecycle Events<br/>k1.bus.subscription.created<br/>k1.bus.subscription.removed<br/>Internal fast-path (no ring buffer)<br/>Operators subscribe to monitor"]:::rust_obs
        end

