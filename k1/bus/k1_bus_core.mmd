%% ========================================================================================================
%% K1 BUS V2 -- RUST CORE ARCHITECTURE (k1_bus_core via PyO3)
%% ========================================================================================================
%% STATUS: V2 Design -- Post V1 completion (446 tests, 3464 source lines, 4504 test lines)
%% GOAL:   Replace hot-path internals with Rust via PyO3. Same IBus/IMailboxRouter interfaces.
%%         Zero module code changes. Python V1 stays as permanent fallback.
%% ========================================================================================================
%% IMMUTABLE DESIGN DECISIONS:
%%   1. TWO components: IBus (unified pub/sub) + IMailboxRouter (point-to-point actor messaging)
%%   2. Bus is BLIND: payload = opaque bytes. Bus reads ONLY FlatBuffers envelope header.
%%   3. FlatBuffers zero-copy envelope: 12 fields (10 V1 + ttl_ms + payload_format)
%%   4. Trie-based topic matching with subscription cache (O(1) repeat topics)
%%   5. Timing Chain: causal ordering + sequence gap detection + per-prefix delivery modes
%%   6. Adapter pattern: Fabric(Dict) and SessionState(Any) -> Bus canonical bytes interface
%%   7. Ring Buffer (LMAX Disruptor pattern): pre-allocated, cache-line padded, zero-alloc dispatch
%%   8. Lock-free concurrency: AtomicU64, DashMap, parking_lot::RwLock -- no GIL on hot path
%%   9. Deficit Round-Robin WFQ: true weighted fairness, starvation impossible
%%  10. Circuit breaker per handler, DLQ for rejected/expired envelopes, built-in sweep timer
%% ========================================================================================================
%% REFERENCE SYSTEMS: NATS, Aeron, LMAX Disruptor, ZeroMQ, Kafka, tokio, crossbeam, Seastar
%% ========================================================================================================
%% V1 WEAKNESS CROSS-REFERENCE (28 items, all addressed):
%%   CRITICAL: W-01 sync dispatch, W-02 no true WFQ, W-03 no batching
%%   HIGH:     W-04 JSON ser, W-05 Python obj overhead, W-06 with_bus_fields copy,
%%             W-07 Python RWLock, W-08 per-topic lock, W-09 GIL, W-10 causal global lock
%%   MEDIUM:   W-11 list alloc, W-12 no cache, W-13 tombstones, W-14 no topic validation,
%%             W-15 strict priority, W-16 no DLQ, W-17 no ack, W-18 mailbox blocks thread,
%%             W-19 no handler latency, W-20 no TTL, W-21 no pub backpressure,
%%             W-22 approx stats, W-23 no sub lifecycle, W-24 no middleware ordering
%%   LOW:      W-25 no circuit breaker, W-26 no replay, W-27 external sweep, W-28 no retry
%% ========================================================================================================

flowchart TB

    %% ========================================================================
    %% PYTHON LAND -- Interfaces, Adapters, Middleware, Factory
    %% ========================================================================
    subgraph PYTHON_LAND["PYTHON LAND -- Stable Interfaces + Module Integration"]
        direction TB

        subgraph PY_PORTS["Port Interfaces (type declarations only, zero runtime)"]
            direction LR
            IBUS_PORT["IBus Protocol<br/>publish(topic, payload: bytes) -> u64<br/>subscribe(pattern, handler) -> handle<br/>unsubscribe(handle) -> bool<br/>stats() -> BusStats<br/>close()"]:::py_iface
            IMR_PORT["IMailboxRouter Protocol<br/>register(actor_id, config) -> IMailbox<br/>send_to(actor_id, envelope: bytes)<br/>get_mailbox(actor_id) -> IMailbox<br/>unregister(actor_id)"]:::py_iface
            IMB_PORT["IMailbox Protocol<br/>send(envelope: bytes)<br/>receive(timeout_ms) -> bytes?<br/>depth -> int<br/>close()"]:::py_iface
        end

        subgraph PY_MIDDLEWARE["Middleware Chain (Python -- OTel + Prometheus SDKs)"]
            direction LR
            MW_TRACE["TracingMiddleware<br/>OpenTelemetry spans<br/>cognitive_trace_id propagation"]:::py_middleware
            MW_METRICS["MetricsMiddleware<br/>Prometheus counters<br/>p50/p95/p99 histograms"]:::py_middleware
            MW_VALIDATE["TopicValidation<br/>TopicRegistry check<br/>Versioned topic enforcement"]:::py_middleware
        end

        subgraph PY_ADAPTERS["Module Adapters (Python -- runs once per publish, not hot path)"]
            direction LR
            FABRIC_ADAPTER["FabricBusAdapter<br/>IBus(bytes) <-> IEventPort(Dict)<br/>FlatBuffers ser/deser"]:::py_adapter
            SESSION_ADAPTER["SessionBusAdapter<br/>IBus(bytes) <-> IEventPort(Any)<br/>Strips topic from handler"]:::py_adapter
