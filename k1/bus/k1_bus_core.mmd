    %% ========================================================================
    %% PyO3 BOUNDARY -- The bridge between worlds
    %% ========================================================================
    PYO3_BOUNDARY["--- PyO3 FFI BOUNDARY ---<br/>GIL released on Rust entry | GIL acquired for Python callbacks<br/>FlatBuffers bytes cross boundary (zero-copy)<br/>Python handler refs stored as PyObject in Rust HashMap"]:::pyo3_boundary

    %% ========================================================================
    %% RUST LAND -- High-performance core (k1_bus_core crate)
    %% ========================================================================
    subgraph RUST_LAND["RUST LAND (k1_bus_core) -- Lock-Free High-Performance Core"]
        direction TB

        subgraph RUST_BUS["RustBus -- #[pyclass] Unified Pub/Sub Engine"]
            direction TB

            subgraph STAMP_ROUTE["Stamp + Route (zero GIL, zero alloc)"]
                direction LR
                ATOMIC_ID["AtomicU64<br/>Global Envelope ID<br/>fetch_add(1, Relaxed)<br/>No lock, no GIL"]:::rust_lockfree
                ATOMIC_SEQ["DashMap + AtomicU64<br/>Per-topic Sequence<br/>get_or_insert via entry()<br/>Zero cross-topic contention"]:::rust_lockfree
                TOPIC_VALID["Topic Validator<br/>Reject: empty, empty-segment,<br/>dots-only BEFORE stamping<br/>Err(InvalidTopic)"]:::rust_core
            end

            subgraph RING_BUFFER["Ring Buffer (LMAX Disruptor Pattern)"]
                direction TB
                RING_LAYOUT["Pre-allocated Fixed Slots<br/>Default: 64KB per slot<br/>Power-of-2 size (bitwise mod)<br/>#[repr(align(64))] cache-line padded"]:::rust_ring
                RING_CURSORS["Cursor Architecture<br/>publisher_cursor: AtomicU64<br/>consumer_cursors: Vec of AtomicU64<br/>CAS-based publish, no locks"]:::rust_lockfree
                RING_BP["Backpressure Strategy<br/>Ring full? Configurable:<br/>Block (spin-wait)<br/>Error(BusFullError)<br/>DropOldest"]:::rust_ring
                RING_FANOUT["Multi-Consumer Fan-Out<br/>Each subscriber group gets own cursor<br/>Independent advancement<br/>Zero-copy reads from slots"]:::rust_ring
            end

            subgraph TRIE_CACHE["TopicTrie + Subscription Cache"]
                direction LR
                RUST_TRIE["Rust TopicTrie<br/>DashMap-backed concurrent trie<br/>Wildcards: * (single) > (greedy)<br/>Epoch-based reclamation (RCU)<br/>No tombstones, clean GC"]:::rust_core
                SUB_CACHE["SubscriptionCache<br/>DashMap: topic -> Vec of handler_ids<br/>generation: AtomicU64<br/>Invalidate on subscribe/unsubscribe<br/>Stale entries auto-discard<br/>Target: cached match < 100ns"]:::rust_lockfree
            end

            subgraph DISPATCH["Async Fan-Out Dispatch"]
                direction TB
                GIL_BATCH["GIL Batching Strategy<br/>1. Collect handler_ids from trie (no GIL)<br/>2. Acquire GIL ONCE per publish<br/>3. Invoke all Python handlers<br/>4. Release GIL<br/>Minimizes GIL acquisitions"]:::rust_dispatch
                HANDLER_ISO["Per-Handler Isolation<br/>catch_unwind() per handler.call1()<br/>Never propagate panics<br/>Record success/fail in circuit breaker"]:::rust_dispatch
                HANDLER_LAT["Handler Latency Histogram<br/>Instant::now() before/after each call<br/>DashMap: handler_id -> LatencyHistogram<br/>p50/p95/p99 per handler pattern<br/>Exposed: handler_stats() -> dict"]:::rust_dispatch
            end
        end

        subgraph RUST_TIMING["Rust Timing Chain (lock-free causal + gap engine)"]
            direction TB
            CAUSAL["Causal Ordering<br/>AtomicU64 parent_id tracking<br/>Child waits for parent delivery<br/>Lock-free via atomic CAS<br/>(was: single global threading.Lock)"]:::rust_timing
            GAP_DETECT["Sequence Gap Detection<br/>Per-topic monotonic AtomicU64<br/>Gap buffered until filled<br/>Covers: F68 per-agent delta ordering"]:::rust_timing
            TIMING_CFG["TimingConfig (Prefix Trie)<br/>Trie-based prefix match<br/>(was: linear scan)<br/>STRICT | RELAXED | BEST_EFFORT"]:::rust_timing
            SWEEP_TIMER["Built-in Sweep Timer<br/>Dedicated thread: park/unpark<br/>No external caller needed<br/>Co-op via select! in async<br/>Auto-drains stuck STRICT envelopes"]:::rust_timing
        end

        subgraph RUST_WFQ["WFQ Deficit Round-Robin Scheduler"]
            direction TB
            WFQ_ALGO["Deficit Round-Robin Algorithm<br/>URGENT: weight=4, deficit+=4<br/>REALTIME: weight=3, deficit+=3<br/>INTERACTIVE: weight=2, deficit+=2<br/>BACKGROUND: weight=1, deficit+=1<br/>Dequeue when deficit >= 1<br/>Starvation IMPOSSIBLE"]:::rust_wfq
            WFQ_SHARED["Shared Scheduler<br/>Used by BOTH pub/sub dispatch<br/>AND mailbox dequeue<br/>True fairness across all paths"]:::rust_wfq
        end

        subgraph RUST_MAILBOX["Rust Mailbox (bounded ring + WFQ)"]
            direction TB
            MB_RING["Bounded Ring per Actor<br/>crossbeam::channel + 4-priority ring<br/>Deficit round-robin dequeue<br/>No thread-blocking receive<br/>(was: threading.Condition.wait)"]:::rust_mailbox
            MB_ACK["Delivery Acknowledgment<br/>Sender knows: enqueued vs consumed<br/>Async ack via ring slot status"]:::rust_mailbox
        end

        subgraph RUST_RESILIENCE["Resilience Layer"]
            direction LR
            CIRCUIT_BRK["Circuit Breaker<br/>Per-handler state machine:<br/>CLOSED -> OPEN (N failures)<br/>OPEN -> HALF_OPEN (cooldown)<br/>HALF_OPEN -> CLOSED (success)<br/>Zero-cost when circuit closed"]:::rust_resilience
            DLQ["Dead Letter Queue<br/>Bounded ring buffer<br/>Captures: backpressure rejects,<br/>handler errors, expired TTL<br/>Exposed to Python: drain/inspect"]:::rust_resilience
            TTL_CHECK["TTL Expiry Check<br/>At dispatch time (lazy):<br/>if now_ns - created_ns > ttl_ms * 1M<br/>-> route to DLQ, skip handlers<br/>Zero cost when ttl_ms = 0"]:::rust_resilience
        end

        subgraph RUST_STATS["Observability (lock-free atomics)"]
