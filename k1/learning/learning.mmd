%% =====================================================================================
%% LEARNING LOOP (K1) -- DEEP ARCHITECTURE DIAGRAM
%% =====================================================================================
%% STATUS: COMPLETE DESIGN (Architecture-Ready, Implementation Deferred)
%%
%% The Learning Loop is K1's Two-System intelligence refinement layer.
%% It spans K0 (gap detection, feedback storage) and K1 (agents, signal collection).
%%
%% TWO SYSTEMS:
%%   System 1: Gap Resolution (Active Learning)
%%     K0 detects knowledge gaps -> SSE -> K1 asks user -> answer flows back to K0
%%     Direction: K0 -> Bridge SSE -> K1 -> User -> K0 (circular)
%%     Pipelines: P03 -> P06 -> P05 -> K1 Curiosity Agent -> P02 -> P03
%%
%%   System 2: Model Refinement (Feedback Loop)
%%     K1 detects behavioral signals -> FeedbackEnvelope -> K0 tunes parameters
%%     Direction: K1 -> Bridge Obs Port -> K0 (one-way)
%%     Pipelines: K1 detectors -> P21 -> P02/P03/P08 feedback handlers
%%
%% POSITION IN K1 STACK:
%%   L0 Rhythm -> L1 Concierge -> L6 LEARNING LOOP
%%                                 ^ we are here (spans all layers)
%%   System 1 agents: spawned by Fabric on SSE trigger (Proactive Flow)
%%   System 2 agents: run inline per conversation turn (Feedback Detectors)
%%   Memory Writers: spawned per session (observe LLM conversations)
%%
%% GOVERNING DOCS:
%%   - docs/architecture/ideas/0001-active-learning-loop.md (Idea -- theory + roadmap)
%%   - docs/pipelines/P03_consolidation_dossier_v2.md Section 5 (P06 integration)
%%   - k0/ports/FEEDBACK.md (K1 developer guide for feedback wiring)
%%   - architecture_diagrams/bridge/bridge_architecture.mmd (SSE + Obs Port)
%%   - architecture_diagrams/k1/k1_cognitive_architecture_skeleton.mmd (skeleton nodes)
%%
%% SKELETON TRACEABILITY:
%%   K0_SSE_SERVER            -> SSE_INBOUND_HANDLER (this diagram)
%%   PROACTIVE_AGENT_FLOW     -> SYSTEM_1_GAP_RESOLUTION (this diagram)
%%   LEARNING_LOOP_FRAMEWORK  -> top-level layout (this diagram)
%%   MEMORY_WRITER_SYSTEM     -> memory_writer.mmd (SEPARATE DIAGRAM at k1/memory_writer/)
%%   FEEDBACK_SIGNAL_COLLECTOR -> SYSTEM_2_FEEDBACK (this diagram)
%%   DRIFT_DETECTOR           -> DRIFT_DETECTION (this diagram)
%%   ADVISORY_EMITTER         -> ADVISORY_EMISSION (this diagram)
%%
%% CROSS-DIAGRAM INTEGRATION POINTS:
%%   concierge.mmd:
%%     OUTPUT_CHANNEL receives proactive question text for user delivery
%%     HIL_RESPONSE_DETECTOR routes gap answers back to Learning Loop
%%     ACKING_CORE can detect implicit feedback (reformulation patterns)
%%   orchestrator.mmd:
%%     Not directly involved (proactive flows bypass Orchestrator)
%%     EXECUTION_MONITOR may emit outcome feedback signals
%%   fabric.mmd:
%%     Agent Factory spawns CuriosityAgent, ReminderAgent, GapAnswerWriter
%%     Agent Registry holds contracts for all Learning Loop agents
%%     Capability execution results feed outcome feedback
%%   memory_writer.mmd:
%%     SEPARATE SYSTEM at k1/memory_writer/ (not part of Learning Loop)
%%     Memory Writer extracts FACTS from turns (always runs)
%%     Learning Extractor extracts META-SIGNALS (learning-specific)
%%     Both observe turns but for completely different purposes
%%   planner.mmd:
%%     Not directly involved (proactive questions are pre-planned)
%%   sessionstate:
%%     conversation_context provides correlation IDs for feedback
%%     NOT written by Learning Loop agents (Single Writer = Concierge only)
%%
%% =====================================================================================
%% HARD INVARIANTS (LEARN-01 through LEARN-14)
%% =====================================================================================
%%
%% LEARN-01: Learning Loop agents NEVER write SessionState (ADR-0017 Single Writer)
%% LEARN-02: All K0 writes go through Bridge Command Port (memory.delta, feedback.signal)
%% LEARN-03: Attention Budget hard cap: 3 questions/day per user (Token Bucket)
%% LEARN-04: Curiosity Agent max 300 tokens per question (15 words target)
%% LEARN-05: Constitutional AI filter runs on EVERY generated question before delivery
%% LEARN-06: Privacy band enforcement: RED data questions need explicit user consent
%% LEARN-07: GapAutoResolver (implicit path) has 24h grace period before explicit ask
%% LEARN-08: Feedback correlation MUST include session_id + event_ids + recall_id
%% LEARN-09: Feedback payload_hash used for dedup (same hash within 5s = ignored)
%% LEARN-10: Rate limit: 100 feedback signals/minute per tenant
%% LEARN-11: DriftDetector threshold: 20% confidence shift in 30-day window
%% LEARN-12: Memory Writer batch window: 250ms (aggregate before K0 write)
%% LEARN-13: All events carry cognitive_trace_id for observability
%% LEARN-14: System 1 SSE events require Bridge SSE Port healthy (CB_SSE fallback)
%%
%% =====================================================================================
%% STORAGE TABLES (K0-side, written via Bridge)
%% =====================================================================================
%%
%% | Table                    | Role                            | Written By              |
%% |--------------------------|---------------------------------|-------------------------|
%% | st_learning_queue        | Gap records for P06             | P03 R8, P06 entropy     |
%% | st_anchors               | Bayesian beliefs (Beta dist)    | P03 consolidation       |
%% | st_anchor_observations   | Evidence audit trail            | P03 consolidation       |
%% | st_feedback_signals      | K1 feedback persistence         | K0 observe.py           |
%% | st_question_history      | Question analytics              | K1 Curiosity Agent      |
%% | st_learned_weights       | Pipeline tuned parameters       | Pipeline handlers       |
%%
%% =====================================================================================
%% SSE EVENT MATRIX (K0 -> Bridge -> K1)
%% =====================================================================================
%%
%% | Topic                              | Producer     | Consumer              | Purpose                    |
%% |------------------------------------|--------------|-----------------------|----------------------------|
%% | curiosity.intent.v1                | P05/P06      | SSE Inbound Handler   | Gap question trigger       |
%% | k0.learning.advisory.v1            | P06          | Advisory Handler      | System learning advisories |
%% | k0.proactive.signal.v1             | P05          | Proactive Decision    | Proactive engagement       |
%% | curiosity.intent.visual.v1         | Multimodal   | Visual Handler        | Visual gap (future)        |
%% | curiosity.intent.counterfactual.v1 | Causal       | Socratic Coach        | Causal gap (future)        |
%% | curiosity.intent.values.v1         | CRDT Sync    | Family Mediator       | Value conflict (future)    |
%%
%% =====================================================================================
%% FEEDBACK SIGNAL CLASSES (K1 -> K0)
%% =====================================================================================
%%
%% | Class        | Source         | Confidence | Priority | Handler Action             |
%% |--------------|---------------|------------|----------|----------------------------|
%% | CORRECTION   | User explicit | 0.85       | P0       | Update entity, mark corrected |
%% | VALIDATION   | User confirm  | 0.90       | P0       | Boost/reduce salience      |
%% | EXPLICIT     | Thumbs up/down| High       | P1       | Direct rating signal       |
%% | IMPLICIT     | Behavior      | 0.50-0.75  | P2       | Reduce salience proportional |
%% | OUTCOME      | System        | Medium     | P2       | Pipeline performance signal |
%%
%% =====================================================================================
%% AGENT INVENTORY (All spawned by Fabric Agent Factory)
%% =====================================================================================
%%
%% | Agent                  | System | LLM? | Tools Granted                         | Budget    |
%% |------------------------|--------|------|---------------------------------------|-----------|
%% | CuriosityAgent         | 1      | YES  | recall_memory (read-only)             | 300 tok   |
%% | ReminderAgent          | 1      | YES  | recall_memory, invoke_capability      | 200 tok   |
%% | GapAnswerWriter        | 1      | NO   | memory.delta (Bridge Command Port)    | 0 tok     |
%% | FeedbackCollectorAgent | 2      | NO   | feedback.signal (Bridge Obs Port)     | 0 tok     |
%% | MemoryWriterAgent      | Both   | YES  | memory.delta (Bridge Command Port)    | 500 tok   |
%% | LearningExtractorAgent | Both   | YES  | recall_memory (read-only)             | 400 tok   |
%% | DriftDetectorAgent     | 2      | NO   | none (pure computation)               | 0 tok     |
%%
%% =====================================================================================
%% PERFORMANCE BUDGET
%% =====================================================================================
%%
%% | Operation                    | Latency Target  | Tokens  | Owner           |
%% |------------------------------|-----------------|---------|-----------------|
%% | SSE event receive            | < 50ms          | 0       | Bridge SSE Port |
%% | Attention budget check       | < 5ms           | 0       | Budget Gate     |
%% | Context readiness assessment | < 100ms         | 0       | Context Monitor |
%% | Curiosity question gen       | 1-3s            | ~300    | Curiosity Agent |
%% | Constitutional filter        | 500ms-2s        | ~200    | Constitution    |
%% | Gap detection (P03)          | < 500ms P95     | 0       | K0 P03          |
%% | Entropy scan (P06)           | < 5min / 10K    | 0       | K0 P06          |
%% | Feedback emit to K0          | < 200ms         | 0       | Feedback Emit   |
%% | Feedback detection           | < 50ms          | 0       | Detectors       |
%% | Memory writer batch          | 250ms window    | ~500    | Memory Writer   |
%% | Drift detection              | < 30s / 1K      | 0       | Drift Detector  |
%% | End-to-end gap-to-question   | < 5s            | ~500    | Composite       |
%%
%% =====================================================================================

subgraph LEARNING_LOOP["Learning Loop -- Layer 6 (Two-System Intelligence Refinement)"]
  direction TB

  %% ==================================================================================
  %% SSE INBOUND -- Receives K0 events via Bridge SSE Port
  %% ==================================================================================

  subgraph SSE_INBOUND["SSE Inbound Handler (K0 Events via Bridge)"]
    direction TB

    SSE_LISTENER["SSE Listener<br/>Subscribes: Bridge IKernelSSEPort<br/>Endpoint: /v1/k0/events/stream<br/>Reconnect: exponential backoff<br/>Ack protocol: per-event"]:::sse

    SSE_ROUTER["SSE Event Router<br/>Routes by event topic:<br/>curiosity.intent.v1 -> System 1<br/>k0.learning.advisory.v1 -> Advisory<br/>k0.proactive.signal.v1 -> Proactive<br/>curiosity.intent.visual.v1 -> Visual (future)<br/>curiosity.intent.counterfactual.v1 -> Causal (future)<br/>curiosity.intent.values.v1 -> Mediator (future)"]:::routing

    SSE_DESERIALIZER["Event Deserializer<br/>Validates payload against<br/>AsyncAPI schema contract<br/>Rejects malformed events"]:::validator
  end

  %% ==================================================================================
  %% SYSTEM 1: GAP RESOLUTION (Active Learning)
  %% ==================================================================================

  subgraph SYSTEM_1_GAP_RESOLUTION["System 1: Gap Resolution (Active Learning -- K0 Gap -> User Question -> K0 Answer)"]
    direction TB

    subgraph PROACTIVE_DECISION_ENGINE["Proactive Decision Engine"]
      direction TB

      PROACTIVE_DECISION["Proactive Decision<br/>Receives: curiosity.intent.v1,<br/>k0.proactive.signal.v1<br/>Evaluates: priority, gap_type,<br/>contextual relevance<br/>Decides: ask now, defer, suppress"]:::brain

      ATTENTION_BUDGET_GATE["Attention Budget Gate<br/>Token Bucket Algorithm<br/>---<br/>tokens: 3/day (max_tokens: 3)<br/>refill_rate: 1 token per 8 hours<br/>---<br/>can_ask_question(): tokens >= 1.0<br/>spend_token(): tokens -= 1.0<br/>refill(): min(max, tokens + hours * rate)<br/>---<br/>Per-user, per-day<br/>Persisted in K1 local state"]:::gate

      CONTEXT_MONITOR["Context Monitor<br/>assess_readiness(user) -> 0.0 to 1.0<br/>---<br/>0.0: user stressed / driving / safety-critical<br/>0.1: user at work / high cognitive load<br/>0.2: user in important_call<br/>0.3: default (possible but not ideal)<br/>0.6: user idle > 5 minutes<br/>0.9: user discussing related topic<br/>     (cosine similarity > 0.7)<br/>---<br/>Reads: user_state, active_task,<br/>last_interaction_time, recent_topics<br/>Source: SessionState (multi-reader)"]:::service

      PROACTIVE_QUEUE["Proactive Queue<br/>Priority queue sorted by importance_score<br/>importance = entropy * (1 / (confidence + 0.1))<br/>     * recency_boost * type_weight<br/>---<br/>type_weights:<br/>  CONTRADICTION: 1.5<br/>  AMBIGUOUS_ENTITY: 1.3<br/>  MISSING_ATTRIBUTE: 1.0<br/>  LOW_CONFIDENCE_EDGE: 0.9<br/>  CONCEPT_DRIFT: 0.7<br/>  STRUCTURAL_HOLE: 0.6<br/>  STALE_ANCHOR: 0.5<br/>---<br/>Max depth: 50 pending items<br/>Expiry: 7 days per gap record"]:::mailbox
    end

    subgraph CURIOSITY_ENGINE["Curiosity Engine (Question Generation)"]
      direction TB

      CURIOSITY_AGENT["Curiosity Agent<br/>Spawned by: Fabric Agent Factory<br/>Template: k1/contracts/agents/curiosity_agent.yaml<br/>---<br/>Persona: Curious, humble, brief<br/>Max output: 15 words (~300 tokens budget)<br/>Tools granted: recall_memory (read-only)<br/>---<br/>Strategies by gap_type:<br/>  AMBIGUOUS_ENTITY -> disambiguation Q<br/>  MISSING_ATTRIBUTE -> attribute Q<br/>  CONTRADICTION -> preference Q<br/>  CONCEPT_DRIFT -> validation Q<br/>  STRUCTURAL_HOLE -> relationship Q<br/>  STALE_ANCHOR -> re-check Q<br/>---<br/>Example: Is Sarah from work, or a friend?"]:::agent

      CONSTITUTIONAL_FILTER["Constitutional AI Filter<br/>Self-critique against Family Constitution<br/>---<br/>Question Principles checked:<br/>1. Not during high-stress moments<br/>2. Respect I dont want to answer<br/>3. Avoid family conflict questions<br/>4. Question count <= budget<br/>5. Genuine curiosity framing<br/>---<br/>Privacy Band enforcement:<br/>  RED (medical/financial): explicit consent required<br/>  AMBER (moderate): consent required<br/>  GREEN: always okay<br/>---<br/>Child Safety (age < 13):<br/>  Require parental consent<br/>  Age-appropriate language<br/>  Block sensitive topics<br/>---<br/>If violation detected: revise or suppress<br/>Max revision rounds: 2"]:::safety

      QUESTION_FORMATTER["Question Formatter<br/>Wraps validated question into<br/>user-facing message<br/>---<br/>Metadata attached:<br/>  gap_id, gap_type, priority<br/>  trace_id, session_id<br/>---<br/>Output: CuriosityOutput envelope"]:::service
    end

    subgraph GAP_ANSWER_PATH["Gap Answer Path (User Response -> K0)"]
      direction TB

      ANSWER_DETECTOR["Answer Detector<br/>Monitors user responses for<br/>gap_id correlation<br/>---<br/>Detection: Concierge routes<br/>user reply matching active gap<br/>to Learning Loop via Event Bus<br/>---<br/>Topic: k1.learning.gap_answer.v1"]:::service

      GAP_ANSWER_WRITER["Gap Answer Writer<br/>Non-LLM agent (deterministic)<br/>---<br/>Builds K0 command envelope:<br/>  op: memory.delta<br/>  body: user_answer_text<br/>  meta: { gap_id, gap_type,<br/>          confidence: 1.0,<br/>          source: user_explicit }<br/>---<br/>Sends: POST /k0/command.submit<br/>via Bridge Command Port<br/>---<br/>On success: emit k1.learning.gap_resolved.v1<br/>On failure: retry 2x, then mark EXPIRED"]:::memory

      REMINDER_AGENT["Reminder Agent<br/>Spawned by: Fabric Agent Factory<br/>Template: k1/contracts/agents/reminder_agent.yaml<br/>---<br/>Follows up on ASKED gaps with no answer<br/>after configurable delay (default 24h)<br/>Max reminders: 1 per gap<br/>Respects attention budget<br/>---<br/>Tools: recall_memory, invoke_capability<br/>Budget: 200 tokens"]:::agent
    end
  end

  %% ==================================================================================
  %% SYSTEM 2: MODEL REFINEMENT (Feedback Loop)
  %% ==================================================================================

  subgraph SYSTEM_2_FEEDBACK["System 2: Model Refinement (K1 Behavior -> K0 Parameter Tuning)"]
    direction TB

    subgraph FEEDBACK_DETECTION["Feedback Signal Detection (Per Conversation Turn)"]
      direction TB

      CONVERSATION_CONTEXT["Conversation Context Tracker<br/>Per-session state (NOT SessionState):<br/>  session_id, message_id<br/>  event_ids[] (from K0 recall)<br/>  recall_id (K0 query.recall correlation)<br/>  response_id (LLM response ID)<br/>  grounded_event_ids[] (memories in response)<br/>  wal_positions[] (WAL pos for events)<br/>---<br/>record_recall(): after K0 query<br/>record_response(): after LLM generation<br/>Cached for feedback correlation"]:::service

      subgraph DETECTORS["Signal Detectors (5 types, inline per turn)"]
        direction TB

        CORRECTION_DETECTOR["Correction Detector<br/>Patterns: no actually, thats wrong,<br/>  I stopped, its not X its Y<br/>---<br/>Confidence: 0.85<br/>Target: grounded_event_ids[0]<br/>Signal class: CORRECTION<br/>Priority: P0 (highest)"]:::detector

        VALIDATION_DETECTOR["Validation Detector<br/>Positive: yes, thats right, exactly<br/>Negative: no, thats wrong, I dont think so<br/>---<br/>Confidence: 0.90<br/>Target: grounded_event_ids[0]<br/>Signal class: VALIDATION<br/>Priority: P0"]:::detector

        REFORMULATION_DETECTOR["Reformulation Detector<br/>High semantic similarity (> 0.7)<br/>+ different wording = retry<br/>---<br/>Confidence: 0.60-0.75<br/>Polarity: negative<br/>Signal class: IMPLICIT<br/>Priority: P2"]:::detector

        ABANDONMENT_DETECTOR["Abandonment Detector<br/>No activity for 5+ minutes<br/>after recall without positive signal<br/>---<br/>Confidence: 0.70<br/>Signal class: IMPLICIT<br/>Priority: P2"]:::detector

        HEDGING_DETECTOR["Hedging Detector<br/>LLM response uncertainty markers<br/>---<br/>Confidence: 0.50<br/>Signal class: IMPLICIT<br/>Priority: P2"]:::detector
      end
    end

    subgraph FEEDBACK_EMISSION["Feedback Emission (K1 -> K0 via Bridge)"]
      direction TB

      FEEDBACK_ENVELOPE_BUILDER["Feedback Envelope Builder<br/>Builds FeedbackEnvelope from signal:<br/>---<br/>feedback_id: uuid<br/>pipeline_id: P02 | P03 | P08<br/>tenant_id, space_id<br/>signal_class: CORRECTION | VALIDATION |<br/>  IMPLICIT | EXPLICIT | OUTCOME<br/>signal_subtype: user_correction,<br/>  reformulation_detected, etc.<br/>---<br/>correlation: {<br/>  session_id, message_id,<br/>  wal_positions, event_ids[],<br/>  recall_id, response_id,<br/>  target_entity_type: event,<br/>  target_entity_id<br/>}<br/>---<br/>provenance: {<br/>  source_message_id,<br/>  recall_context_hash (SHA-256),<br/>  feedback_timestamp<br/>}<br/>---<br/>payload: pipeline-specific schema"]:::service

      FEEDBACK_EMITTER["Feedback Emitter<br/>POST /k0/obs.emit kind=feedback<br/>via Bridge Obs Port<br/>---<br/>Timeout: 10s<br/>Retry: 2x with backoff<br/>On persistent failure: log + discard<br/>---<br/>Rate limit: 100/min per tenant<br/>Dedup: payload_hash within 5s"]:::bridge_out

      FEEDBACK_TOPICS["K0 Bus Topics (downstream):<br/>feedback.signal.p02.v1 -> P02FeedbackHandler<br/>feedback.signal.p03.v1 -> P03FeedbackHandler (future)<br/>feedback.signal.p08.v1 -> P08FeedbackHandler<br/>---<br/>K0 validates via FeedbackSchemaRegistry<br/>Persists to st_feedback_signals<br/>BusDispatcher routes to pipeline handlers"]:::routing
    end

    subgraph DRIFT_DETECTION["Drift Detection (Background Process)"]
      direction TB

      DRIFT_DETECTOR["Drift Detector<br/>Periodic analysis of signal patterns<br/>---<br/>Checks:<br/>1. Embedding retrieval relevance decay<br/>   (retrieval_hit rate dropping)<br/>2. User correction rate increase<br/>   (> 2 corrections per 10 recalls)<br/>3. Abandonment rate spike<br/>   (> 3 abandonments per session)<br/>---<br/>Window: rolling 30 days<br/>Threshold: 20% shift triggers alert<br/>---<br/>Output: DriftSignal{<br/>  magnitude, direction,<br/>  affected_pipeline, evidence[]}"]:::detector

      ADVISORY_EMITTER["Advisory Emitter<br/>Emits k0.learning.advisory.v1<br/>to K0 via Bridge Obs Port<br/>---<br/>Advisory types:<br/>  EMBEDDING_DECAY: P08 reindex needed<br/>  CORRECTION_SPIKE: P02 review needed<br/>  CONFIDENCE_DRIFT: P03 re-consolidate<br/>---<br/>K0 P06 consumes advisory<br/>and updates st_learned_weights"]:::bridge_out
    end
  end

  %% ==================================================================================
  %% MEMORY WRITER SUBSYSTEM (Spans Both Systems)
  %% ==================================================================================

  subgraph LEARNING_EXTRACTOR_SUBSYSTEM["Learning Extractor (Meta-Signal Extraction)"]
    direction TB

    LEARNING_EXTRACTOR_AGENT["Learning Extractor Agent<br/>Spawned by: Fabric Agent Factory<br/>Template: k1/contracts/agents/learning_extractor.yaml<br/>---<br/>Extracts META-KNOWLEDGE from interactions:<br/>  - Which question styles work best<br/>  - User preferred response length<br/>  - Topic sensitivity patterns<br/>---<br/>Output: learning.signal payloads<br/>Feeds into System 2 advisory path<br/>Budget: 400 tokens<br/>---<br/>NOTE: This is NOT the Memory Writer.<br/>Memory Writer is a SEPARATE system<br/>at k1/memory_writer/memory_writer.mmd"]:::agent
  end

  %% MEMORY WRITER is a SEPARATE SYSTEM (k1/memory_writer/memory_writer.mmd)
  %% It extracts FACTS from turns -> K0 command envelopes -> Bridge -> P02.
  %% Learning Extractor extracts META-SIGNALS -> System 2 feedback path.
  %% Both observe conversation turns but for completely different purposes.

