  subgraph CONCURRENCY["Concurrency Model"]
    direction TB

    CONC_SSE["SSE Listener (Background Async)<br/>---<br/>Async event loop, non-blocking<br/>Processes one SSE event at a time<br/>Reconnects on disconnect (exponential backoff)<br/>Does NOT block turn processing"]:::concurrency

    CONC_DETECTORS["Feedback Detectors (Inline Per-Turn)<br/>---<br/>Triggered by turn.complete.v1<br/>Run synchronously within turn context<br/>5 detectors sequential (< 50ms total)<br/>Runs AFTER Concierge turn_end completes"]:::concurrency

    CONC_PROACTIVE["Proactive Queue (Timer-Driven)<br/>---<br/>Dequeue timer: check every 30s<br/>One question at a time<br/>Budget gate serializes (no parallel questions)"]:::concurrency

    CONC_DRIFT["Drift Detection (Periodic Background)<br/>---<br/>Runs: every 4 hours<br/>Window: rolling 30 days<br/>Does NOT block any other subsystem"]:::concurrency
  end

