    CONTRACT_CURIOSITY["curiosity_agent.yaml<br/>name: agent.execute.curiosity<br/>---<br/>prompt_template: curiosity_persona.md<br/>tools_granted: [recall_memory]<br/>llm_budget_tokens: 300<br/>max_tool_calls: 1<br/>max_execution_time_ms: 3000<br/>safety_band_min: GREEN"]:::contract

    CONTRACT_REMINDER["reminder_agent.yaml<br/>name: agent.execute.reminder<br/>---<br/>prompt_template: reminder_persona.md<br/>tools_granted: [recall_memory, invoke_capability]<br/>llm_budget_tokens: 200<br/>max_tool_calls: 2<br/>max_execution_time_ms: 5000<br/>safety_band_min: GREEN"]:::contract

    CONTRACT_LEARNING_EXTRACTOR["learning_extractor.yaml<br/>name: agent.execute.learning_extractor<br/>---<br/>prompt_template: learning_extractor_persona.md<br/>tools_granted: [recall_memory]<br/>llm_budget_tokens: 400<br/>max_tool_calls: 2<br/>max_execution_time_ms: 5000<br/>safety_band_min: GREEN"]:::contract

    %% NOTE: memory_writer.yaml contract is in memory_writer.mmd (separate system)

    CONTRACT_GAP_WRITER["gap_answer_writer.yaml<br/>name: agent.execute.gap_answer_writer<br/>---<br/>prompt_template: null (deterministic, no LLM)<br/>tools_granted: [memory.delta]<br/>llm_budget_tokens: 0<br/>max_tool_calls: 1<br/>max_execution_time_ms: 2000<br/>safety_band_min: GREEN"]:::contract
  end

  %% ==================================================================================
  %% K1 EVENT BUS TOPICS (Internal)
  %% ==================================================================================

  subgraph LEARNING_EVENTS["Learning Loop Event Bus Topics (K1 Internal)"]
    direction TB

    EVT_GAP_RECEIVED["k1.learning.gap_received.v1<br/>SSE curiosity.intent.v1 arrived<br/>Payload: gap_id, gap_type, priority"]:::event

    EVT_QUESTION_READY["k1.learning.question_ready.v1<br/>Curiosity Agent generated question<br/>Payload: gap_id, question_text, trace_id<br/>Consumer: Concierge OUTPUT_CHANNEL"]:::event

    EVT_QUESTION_DELIVERED["k1.learning.question_delivered.v1<br/>Question shown to user<br/>Payload: gap_id, delivered_at"]:::event

    EVT_GAP_ANSWER["k1.learning.gap_answer.v1<br/>User responded to question<br/>Payload: gap_id, answer_text, session_id"]:::event

    EVT_GAP_RESOLVED["k1.learning.gap_resolved.v1<br/>Gap closed in K0<br/>Payload: gap_id, resolution_type"]:::event

    EVT_FEEDBACK_DETECTED["k1.learning.feedback_detected.v1<br/>Signal detector found feedback<br/>Payload: signal_class, target_event_id"]:::event

    EVT_FEEDBACK_EMITTED["k1.learning.feedback_emitted.v1<br/>Feedback sent to K0 Obs Port<br/>Payload: feedback_id, pipeline_id"]:::event

    EVT_DRIFT_ALERT["k1.learning.drift_alert.v1<br/>Drift detected in retrieval/correction patterns<br/>Payload: drift_type, magnitude, pipeline"]:::event

