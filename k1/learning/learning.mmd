  subgraph SERVICES["Internal Services (8 Codeable Components -- ~350 Tests)"]
    direction TB

    SVC_SSE_INBOUND["SSEInboundService<br/>listen() -> void (background loop)<br/>route(event) -> RouteDecision<br/>deserialize(raw) -> ValidatedEvent<br/>---<br/>Subscribes Bridge SSE Port<br/>Routes: curiosity -> System 1, advisory -> Drift<br/>Uses: ISSEPort<br/>~35 tests"]:::service

    SVC_PROACTIVE["ProactiveDecisionService<br/>evaluate(gap) -> Decision (ask | defer | suppress)<br/>check_budget() -> bool (LEARN-03)<br/>assess_readiness(user) -> float 0.0-1.0<br/>enqueue(gap, importance) -> QueuePosition<br/>dequeue_next() -> GapRecord | None<br/>---<br/>Token Bucket: 3/day, 1 per 8h refill<br/>Context Monitor: user state awareness<br/>Priority Queue: importance = entropy * ...<br/>Uses: IEventPort, IStateReadPort<br/>~65 tests"]:::service

    SVC_CURIOSITY["CuriosityService<br/>generate_question(gap) -> CuriosityOutput<br/>apply_constitution(question) -> FilterResult<br/>format(question, metadata) -> FormattedOutput<br/>---<br/>Spawns CuriosityAgent via IFabricPort<br/>Constitutional filter: 5 principles + privacy<br/>Max revision rounds: 2<br/>~55 tests"]:::service

    SVC_GAP_ANSWER["GapAnswerService<br/>detect_answer(user_msg) -> MatchResult | None<br/>write_answer(gap_id, answer) -> WriteResult<br/>schedule_reminder(gap_id) -> void<br/>---<br/>Answer Detector: gap_id correlation<br/>GapAnswerWriter: deterministic K0 envelope<br/>ReminderAgent: 24h follow-up (max 1 per gap)<br/>Uses: IBridgeCommandPort, IFabricPort, IEventPort<br/>~45 tests"]:::service

    SVC_FEEDBACK_DETECTION["FeedbackDetectionService<br/>detect(turn_context) -> Signal[]<br/>track_context(recall, response) -> ConversationCtx<br/>---<br/>5 detectors: Correction (P0), Validation (P0),<br/>  Reformulation (P2), Abandonment (P2), Hedging (P2)<br/>Runs: inline per conversation turn<br/>Trigger: turn.complete.v1 via IEventPort<br/>~60 tests"]:::service

    SVC_FEEDBACK_EMISSION["FeedbackEmissionService<br/>build_envelope(signal) -> FeedbackEnvelope<br/>emit(envelope) -> EmitResult<br/>dedup(hash) -> bool (LEARN-09)<br/>---<br/>POST /k0/obs.emit via IBridgeObsPort<br/>Rate limit: 100/min (LEARN-10)<br/>Correlation: session_id + event_ids + recall_id<br/>~40 tests"]:::service

    SVC_DRIFT["DriftDetectionService<br/>analyze(signals[]) -> DriftSignal | None<br/>emit_advisory(drift) -> void<br/>---<br/>Periodic: rolling 30-day window<br/>Checks: retrieval decay, correction spike,<br/>  abandonment rate, confidence shift<br/>Threshold: 20% shift (LEARN-11)<br/>Uses: IBridgeObsPort<br/>~30 tests"]:::service

    SVC_LEARNING_EXTRACTOR["LearningExtractorService<br/>extract_meta(turn) -> LearningSignal[]<br/>---<br/>Meta-knowledge extraction:<br/>  question styles, response preferences,<br/>  topic sensitivity patterns<br/>Output: feeds FeedbackEmissionService<br/>Budget: 400 tokens<br/>~20 tests"]:::service
  end

  %% ==================================================================================
  %% LIFECYCLE (5 Phases)
  %% ==================================================================================

  subgraph LIFECYCLE["Lifecycle (5 Phases)"]
    direction TB

    LC_INIT["init(session_id)<br/>Owner: Learning Loop Controller<br/>---<br/>1. Create 8 services (no I/O)<br/>2. Wire 6 ports<br/>3. Start SSE listener (ISSEPort)<br/>4. Subscribe turn.complete.v1 for detectors<br/>5. Subscribe k1.fabric.learning.signal.v1 (GAP-B2)<br/>6. Subscribe k1.learning.gap_answer.v1<br/>7. Start ProactiveQueue dequeue timer<br/>8. Set state: ACTIVE"]:::lifecycle

    LC_SESSION_START["session_start()<br/>Owner: Learning Loop Controller<br/>---<br/>1. Activate FeedbackDetectionService<br/>2. Reset per-session counters<br/>3. Start DriftDetectionService timer<br/>4. Load pending gaps from local state<br/>5. Resume Proactive Queue processing"]:::lifecycle

    LC_SESSION_END["session_end()<br/>Owner: Learning Loop Controller<br/>---<br/>1. Flush pending feedback (FeedbackEmissionService)<br/>2. Persist Proactive Queue state (local)<br/>3. Persist Attention Budget state (local)<br/>4. Stop per-session timers"]:::lifecycle

    LC_SHUTDOWN["shutdown()<br/>Owner: Learning Loop Controller<br/>---<br/>1. Stop SSE listener (ISSEPort.close)<br/>2. Drain Proactive Queue (best-effort flush)<br/>3. Flush pending feedback<br/>4. Unsubscribe from all event topics<br/>5. Stop drift timer<br/>6. Terminate spawned agents via IFabricPort<br/>7. Disconnect ports (LIFO)"]:::lifecycle

    LC_CRASH_RECOVERY["crash_recovery(session_id)<br/>---<br/>1. Bootstrap (8 services + 6 ports)<br/>2. Reconnect SSE (exponential backoff)<br/>3. Restore pending gaps from local state<br/>4. Restore Attention Budget tokens<br/>5. Resume: subscriptions, timers, ACTIVE<br/>---<br/>Max loss: in-flight question or feedback"]:::lifecycle
  end

