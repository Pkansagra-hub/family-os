  end

  %% ==================================================================================
  %% PORTS -- Hexagonal Boundaries (6 Ports)
  %% LEARN-01 enforced at compile time: no IStateWritePort exists.
  %% ==================================================================================

  subgraph PORTS["Ports (6 Hexagonal Boundaries -- LEARN-01: No Write Ports to SessionState)"]
    direction TB

    PORT_SSE["ISSEPort<br/>Direction: Inbound<br/>subscribe(endpoint) -> SSEStream<br/>reconnect(backoff) -> void<br/>Endpoint: Bridge /v1/k0/events/stream<br/>Topics: curiosity.intent.v1, k0.learning.advisory.v1,<br/>  k0.proactive.signal.v1"]:::port

    PORT_EVENT["IEventPort<br/>Direction: Both<br/>subscribe(topics[]) -> EventStream<br/>publish(topic, payload) -> void<br/>Sub: k1.learning.gap_answer.v1,<br/>  k1.fabric.learning.signal.v1, turn.complete.v1<br/>Pub: k1.learning.question_ready.v1,<br/>  k1.learning.feedback_detected.v1,<br/>  k1.learning.gap_resolved.v1,<br/>  k1.learning.drift_alert.v1"]:::port

    PORT_STATE_READ["IStateReadPort<br/>Direction: Inbound (read-only)<br/>read(sections[]) -> StateSnapshot<br/>Multi-reader, lock-free (LEARN-01)<br/>Sections: history_active, beliefs_active,<br/>  affective_now, scoreboard, persona"]:::port

    PORT_BRIDGE_CMD["IBridgeCommandPort<br/>Direction: Outbound<br/>submit(topic, schema_uri, body) -> void<br/>Topic: memory.delta (gap answers)<br/>ONE-WAY fire-and-forget (LEARN-02)"]:::port

    PORT_BRIDGE_OBS["IBridgeObsPort<br/>Direction: Outbound<br/>emit(kind, payload) -> void<br/>kind: feedback<br/>POST /k0/obs.emit (LEARN-02)<br/>Rate limit: 100/min per tenant (LEARN-10)"]:::port

