%% =====================================================================================
%% FLOW EDGES -- SYSTEM 1: GAP RESOLUTION
%% =====================================================================================

%% SSE Inbound Flow
TP_BRIDGE_SSE -->|"SSE stream"| SSE_LISTENER
SSE_LISTENER -->|"raw event"| SSE_DESERIALIZER
SSE_DESERIALIZER -->|"validated event"| SSE_ROUTER
SSE_ROUTER -->|"curiosity.intent.v1"| PROACTIVE_DECISION
SSE_ROUTER -->|"k0.proactive.signal.v1"| PROACTIVE_DECISION
SSE_ROUTER -->|"k0.learning.advisory.v1"| DRIFT_DETECTOR

%% Proactive Decision Flow
PROACTIVE_DECISION -->|"evaluate priority"| PROACTIVE_QUEUE
PROACTIVE_QUEUE -->|"highest importance gap"| ATTENTION_BUDGET_GATE
ATTENTION_BUDGET_GATE -->|"tokens >= 1?"| CONTEXT_MONITOR
CONTEXT_MONITOR -->|"readiness >= 0.6"| CURIOSITY_AGENT
ATTENTION_BUDGET_GATE -.->|"no tokens"| EVT_GAP_RECEIVED
CONTEXT_MONITOR -.->|"readiness < 0.3: defer"| PROACTIVE_QUEUE

%% Curiosity Agent Flow
CURIOSITY_AGENT -->|"raw question"| CONSTITUTIONAL_FILTER
CONSTITUTIONAL_FILTER -->|"validated question"| QUESTION_FORMATTER
CONSTITUTIONAL_FILTER -.->|"violation: suppress"| EVT_GAP_RECEIVED
QUESTION_FORMATTER -->|"CuriosityOutput"| EVT_QUESTION_READY
EVT_QUESTION_READY -->|"to Concierge"| TP_CONCIERGE
TP_CONCIERGE -->|"after user sees question"| EVT_QUESTION_DELIVERED

%% Answer Path
TP_CONCIERGE -->|"user answer with gap_id"| ANSWER_DETECTOR
ANSWER_DETECTOR -->|"k1.learning.gap_answer.v1"| GAP_ANSWER_WRITER
GAP_ANSWER_WRITER -->|"memory.delta + gap_id"| TP_BRIDGE_CMD
TP_BRIDGE_CMD -->|"command.submit"| TP_P02
TP_P02 -->|"next P03 cycle"| TP_P03
GAP_ANSWER_WRITER -->|"success"| EVT_GAP_RESOLVED

%% Reminder Path
EVT_QUESTION_DELIVERED -.->|"no answer after 24h"| REMINDER_AGENT
REMINDER_AGENT -->|"follow-up question"| QUESTION_FORMATTER

%% =====================================================================================
%% FLOW EDGES -- SYSTEM 2: FEEDBACK
%% =====================================================================================

%% Detection Flow
TP_SESSIONSTATE -.->|"multi-reader: correlation IDs"| CONVERSATION_CONTEXT
CONVERSATION_CONTEXT -->|"per-turn context"| CORRECTION_DETECTOR
CONVERSATION_CONTEXT -->|"per-turn context"| VALIDATION_DETECTOR
CONVERSATION_CONTEXT -->|"per-turn context"| REFORMULATION_DETECTOR
CONVERSATION_CONTEXT -->|"per-turn context"| ABANDONMENT_DETECTOR
CONVERSATION_CONTEXT -->|"per-turn context"| HEDGING_DETECTOR

%% Emission Flow
CORRECTION_DETECTOR -->|"CORRECTION signal"| FEEDBACK_ENVELOPE_BUILDER
VALIDATION_DETECTOR -->|"VALIDATION signal"| FEEDBACK_ENVELOPE_BUILDER
REFORMULATION_DETECTOR -->|"IMPLICIT signal"| FEEDBACK_ENVELOPE_BUILDER
ABANDONMENT_DETECTOR -->|"IMPLICIT signal"| FEEDBACK_ENVELOPE_BUILDER
HEDGING_DETECTOR -->|"IMPLICIT signal"| FEEDBACK_ENVELOPE_BUILDER
FEEDBACK_ENVELOPE_BUILDER -->|"FeedbackEnvelope"| FEEDBACK_EMITTER
FEEDBACK_EMITTER -->|"POST /k0/obs.emit"| TP_BRIDGE_OBS
TP_BRIDGE_OBS -->|"kind=feedback"| TP_P21
FEEDBACK_EMITTER -->|"success"| EVT_FEEDBACK_EMITTED

%% Drift + Advisory Flow
DRIFT_DETECTOR -->|"DriftSignal"| ADVISORY_EMITTER
DRIFT_DETECTOR -->|"alert"| EVT_DRIFT_ALERT
ADVISORY_EMITTER -->|"advisory"| TP_BRIDGE_OBS

%% =====================================================================================
%% FLOW EDGES -- MEMORY WRITER
%% =====================================================================================

%% Learning Extractor Flow (meta-signal extraction, NOT memory writing)
%% Memory Writer is a SEPARATE system (k1/memory_writer/memory_writer.mmd)
TP_CONCIERGE -.->|"interaction patterns"| LEARNING_EXTRACTOR_AGENT
LEARNING_EXTRACTOR_AGENT -->|"learning.signal"| FEEDBACK_ENVELOPE_BUILDER

%% =====================================================================================
%% FLOW EDGES -- FABRIC INTEGRATION
%% =====================================================================================

%% Agent Factory spawns all Learning Loop agents
TP_FABRIC -.->|"spawn CuriosityAgent"| CURIOSITY_AGENT
TP_FABRIC -.->|"spawn ReminderAgent"| REMINDER_AGENT
TP_FABRIC -.->|"spawn GapAnswerWriter"| GAP_ANSWER_WRITER
%% NOTE: MemoryWriterAgent is spawned by Fabric but managed in memory_writer.mmd
TP_FABRIC -.->|"spawn LearningExtractorAgent"| LEARNING_EXTRACTOR_AGENT

%% Contracts registered in Fabric
CONTRACT_CURIOSITY -.->|"registered"| TP_FABRIC
CONTRACT_REMINDER -.->|"registered"| TP_FABRIC
%% memory_writer.yaml registered via memory_writer.mmd (separate system)
CONTRACT_LEARNING_EXTRACTOR -.->|"registered"| TP_FABRIC
CONTRACT_GAP_WRITER -.->|"registered"| TP_FABRIC

%% =====================================================================================
%% FLOW EDGES -- PORT -> ADAPTER BINDINGS (Hexagonal Wiring)
%% =====================================================================================

PORT_SSE --> ADAPT_SSE
PORT_SSE --> ADAPT_TEST_SSE
PORT_EVENT --> ADAPT_EVENT
PORT_EVENT --> ADAPT_TEST_EVENT
PORT_STATE_READ --> ADAPT_STATE_READ
PORT_STATE_READ --> ADAPT_TEST_STATE
PORT_BRIDGE_CMD --> ADAPT_BRIDGE_CMD
PORT_BRIDGE_CMD --> ADAPT_TEST_BRIDGE_CMD
PORT_BRIDGE_OBS --> ADAPT_BRIDGE_OBS
PORT_BRIDGE_OBS --> ADAPT_TEST_BRIDGE_OBS
PORT_FABRIC --> ADAPT_FABRIC
PORT_FABRIC --> ADAPT_TEST_FABRIC

%% =====================================================================================
%% FLOW EDGES -- SERVICE -> PORT USAGE
%% Services call ports, never external systems directly (LEARN-01, LEARN-02).
%% =====================================================================================

SVC_SSE_INBOUND -.->|"SSE stream"| PORT_SSE
SVC_PROACTIVE -.->|"pub/sub events"| PORT_EVENT
SVC_PROACTIVE -.->|"read user state"| PORT_STATE_READ
SVC_CURIOSITY -.->|"spawn CuriosityAgent"| PORT_FABRIC
SVC_GAP_ANSWER -.->|"submit memory.delta"| PORT_BRIDGE_CMD
SVC_GAP_ANSWER -.->|"event bus"| PORT_EVENT
SVC_FEEDBACK_DETECTION -.->|"subscribe turn.complete"| PORT_EVENT
SVC_FEEDBACK_DETECTION -.->|"read conversation ctx"| PORT_STATE_READ
SVC_FEEDBACK_EMISSION -.->|"POST /k0/obs.emit"| PORT_BRIDGE_OBS
SVC_DRIFT -.->|"emit advisory"| PORT_BRIDGE_OBS
SVC_LEARNING_EXTRACTOR -.->|"read SS for extraction"| PORT_STATE_READ

%% =====================================================================================
%% FLOW EDGES -- LIFECYCLE -> SERVICE USAGE
%% =====================================================================================

LC_INIT -->|"create + wire"| SVC_SSE_INBOUND
LC_INIT -->|"create"| SVC_PROACTIVE
LC_INIT -->|"create"| SVC_CURIOSITY
LC_INIT -->|"create"| SVC_GAP_ANSWER
LC_INIT -->|"create"| SVC_FEEDBACK_DETECTION
LC_INIT -->|"create"| SVC_FEEDBACK_EMISSION
LC_INIT -->|"create"| SVC_DRIFT
LC_INIT -->|"create"| SVC_LEARNING_EXTRACTOR

LC_SESSION_END -->|"flush"| SVC_FEEDBACK_EMISSION
LC_SESSION_END -->|"persist queue"| SVC_PROACTIVE

LC_SHUTDOWN -->|"stop SSE"| SVC_SSE_INBOUND
LC_SHUTDOWN -->|"drain queue"| SVC_PROACTIVE
LC_SHUTDOWN -->|"flush feedback"| SVC_FEEDBACK_EMISSION
LC_SHUTDOWN -.->|"terminate agents"| PORT_FABRIC
LC_SHUTDOWN -.->|"unsubscribe"| PORT_EVENT

LC_CRASH_RECOVERY -->|"bootstrap"| SVC_SSE_INBOUND
LC_CRASH_RECOVERY -->|"restore gaps"| SVC_PROACTIVE
LC_CRASH_RECOVERY -.->|"reconnect SSE"| PORT_SSE
LC_CRASH_RECOVERY -.->|"resubscribe"| PORT_EVENT

%% =====================================================================================
%% FLOW EDGES -- INVARIANT ENFORCEMENT
%% =====================================================================================

SVC_PROACTIVE -.->|"LEARN-03 (3/day budget)"| INV_BUDGET
SVC_CURIOSITY -.->|"LEARN-04 (300 tok), LEARN-05 (constitutional)"| INV_BUDGET
SVC_FEEDBACK_EMISSION -.->|"LEARN-09 (dedup), LEARN-10 (rate limit)"| INV_TIMING
SVC_DRIFT -.->|"LEARN-11 (20% threshold)"| INV_OPERATIONAL
SVC_GAP_ANSWER -.->|"LEARN-01 (no SS write), LEARN-02 (Bridge only)"| INV_OWNERSHIP

%% =====================================================================================
%% FLOW EDGES -- K0 GAP DETECTION (upstream)
%% =====================================================================================

TP_P03 -->|"p03.gap.detected.v1"| TP_P06
TP_P06 -->|"priority queue + grace check"| TP_P05
TP_P05 -->|"curiosity.intent.v1 SSE"| TP_BRIDGE_SSE

