// k1/contracts/flatbuffers/layer2_orchestration/proposal.fbs
// FlatBuffers schema for Contract Net Proposal bids

namespace K1.Orchestration;

table Proposal {
  agent_id: string (required);
  task_id: string (required);
  estimated_latency_ms: uint32;
  estimated_cost: float;
  confidence: float;
  strategy: string;
  tools_required: [string];
  reasoning: string;
  submission_time_ms: double;
}

table ProposalBatch {
  proposals: [Proposal];
  batch_id: string;
  timestamp_ms: double;
}

root_type Proposal;
