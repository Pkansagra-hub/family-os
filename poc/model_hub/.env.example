# Model Hub POC - Environment Configuration
# Copy this file to .env and fill in your API keys

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_DEFAULT_MODEL=gpt-4
OPENAI_TIMEOUT=30.0
OPENAI_MAX_RETRIES=3

# Anthropic Configuration
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
ANTHROPIC_DEFAULT_MODEL=claude-3-sonnet-20240229
ANTHROPIC_TIMEOUT=30.0
ANTHROPIC_MAX_RETRIES=3

# Google AI Configuration
GOOGLE_API_KEY=your-google-ai-api-key-here
GOOGLE_DEFAULT_MODEL=gemini-pro
GOOGLE_TIMEOUT=30.0
GOOGLE_MAX_RETRIES=3

# Groq Configuration
GROQ_API_KEY=gsk-your-groq-api-key-here
GROQ_DEFAULT_MODEL=mixtral-8x7b-32768
GROQ_TIMEOUT=30.0
GROQ_MAX_RETRIES=3

# Local Models Configuration (requires transformers + torch)
LOCAL_DEFAULT_MODEL=microsoft/DialoGPT-medium
LOCAL_TIMEOUT=60.0
LOCAL_MAX_RETRIES=1
