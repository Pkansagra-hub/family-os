// flowdef.fbs - Committed flow definition for WAL storage (Stage 4 output)
namespace K1.Planning;

table CommittedStep {
    id: string;
    tool: string;
    agent: string;
    band_required: uint8;
    est_latency_ms: uint32;
    cost_hint: float;
    needs: [string];
}

table FlowDef {
    flow_id: string;
    sketch_id: string;
    turn_id: string;
    intent: string;
    steps: [CommittedStep];
    complexity: uint8;
    agents_required: [string];
    status: string;               // COMMITTED, FAILED, etc
    created_at: string;
    pipeline_latency_ms: uint32;  // Total E2E latency
}

root_type FlowDef;
