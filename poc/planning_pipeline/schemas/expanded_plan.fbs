// expanded_plan.fbs - Fully resolved plan with schemas + agent assignments (Stage 2 output)
namespace K1.Planning;

table FlowStep {
    id: string;
    op: uint8;                    // 0=Tool, 1=Model, 2=Ask
    description: string;
    tool: string;
    agent: string;                // Recommended agent
    band_required: uint8;         // 0=GREEN, 1=AMBER, 2=RED, 3=BLACK
    caps_required: [string];
    est_latency_ms: uint32;
    cost_hint: float;
    critical: bool;
    needs: [string];              // Dependency IDs
}

table ExpandedPlan {
    sketch_id: string;
    turn_id: string;
    intent: string;
    steps: [FlowStep];
    complexity: uint8;            // 0=simple, 1=medium, 2=complex
    agents_required: [string];
    expand_latency_ms: uint32;
}

root_type ExpandedPlan;
