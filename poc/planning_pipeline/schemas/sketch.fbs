// sketch.fbs - Minimal LLM-generated sketch plan (Stage 1 output)
namespace K1.Planning;

table PlanStep {
    id: string;
    op: uint8;                    // 0=Tool, 1=Model, 2=Ask
    description: string;
    tool: string;
    needs: [string];              // Dependency IDs
}

table Sketch {
    sketch_id: string;            // Trace/flow ID
    turn_id: string;              // Session/turn ID
    intent: string;
    steps: [PlanStep];
    complexity: uint8;            // 0=simple, 1=medium, 2=complex
    model_id: string;
    llm_latency_ms: uint32;
    prompt_tokens: uint32;
    completion_tokens: uint32;
    raw_llm_output: string;       // Keep for audit only
}

root_type Sketch;
