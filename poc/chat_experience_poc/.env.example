# Environment Variables Template
# Copy to .env and fill in your values

# Groq API Configuration
GROQ_API_KEY="your-groq-api-key-here"
GROQ_MODEL="groq/compound"  # Using Groq's compound model for enhanced reasoning

# K1 PoC Configuration Overrides
# Uncomment and modify to override config/poc_config.yml values
# K1_POC_ENVIRONMENT=development
# K1_POC_DEBUG=false
# K1_POC_SESSION_TIMEOUT=600
# K1_POC_AGENT_POOL_SIZE=5
# K1_POC_K0_API_URL=http://localhost:8003
