# Environment Variables Template
# Copy to .env and fill in your values

# LLM Provider Selection: "google", "vertex", or "groq"
LLM_PROVIDER="google"

# Google AI Configuration (google-generativeai SDK)
# Get your API key from: https://aistudio.google.com/apikey
GOOGLE_API_KEY="your-google-api-key-here"
GOOGLE_MODEL="gemini-1.5-flash"

# Vertex AI Configuration (alternative to Google AI)
# Requires GCP project with Vertex AI API enabled
# GOOGLE_PROJECT_ID="your-gcp-project-id"
# GOOGLE_LOCATION="us-central1"
# VERTEX_MODEL="gemini-1.5-flash"

# Legacy Groq API Configuration (deprecated - use Google AI instead)
# GROQ_API_KEY="your-groq-api-key-here"
# GROQ_MODEL="groq/compound"

# K1 PoC Configuration Overrides
# Uncomment and modify to override config/poc_config.yml values
# K1_POC_ENVIRONMENT=development
# K1_POC_DEBUG=false
# K1_POC_SESSION_TIMEOUT=600
# K1_POC_AGENT_POOL_SIZE=5
# K1_POC_K0_API_URL=http://localhost:8003
