      "id": "web_search",
      "name": "web_search",
      "description": "Search the web for current information, news, and general knowledge",
      "category": "research",
      "parameters": {
        "query": {
          "type": "string",
          "required": true,
          "description": "Search query string"
        },
        "num_results": {
          "type": "integer",
          "required": false,
          "default": 5,
          "description": "Number of results to return (1-10)"
        }
