      "returns": {
        "type": "array",
        "description": "List of search results with titles, URLs, and snippets"
      },
      "usage_tier": "tier1",
      "privacy_band": "GREEN",
      "endpoint": "mock_mcp://web_search",
      "timeout_ms": 2000,
      "enabled": true
    },
