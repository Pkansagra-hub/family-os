"""Generated SSE emitter for the ``{{ topic.topic }}`` contract.

Producer side (K0). Real K0 emit goes through the K0 SSE replay buffer
(see :mod:`k0.sse.replay_buffer`, MS-3d Epic 3d.3) before fanning out
to live SSE subscribers. The :meth:`{{ topic.client_class }}.emit`
method is the typed seam K0 emitters call once the body is built.

In Epic 3d.1 the runtime binding is intentionally left for Epic 3d.3
to fill in: until then, ``emit`` raises :class:`NotImplementedError`
so accidental cross-kernel calls fail loudly rather than silently
dropping events.
"""

from __future__ import annotations

from typing import TYPE_CHECKING, Any

from bridge._generated.{{ kernel }}.models.{{ topic.method_name }} import (
    {{ topic.model_class }},
)

if TYPE_CHECKING:  # pragma: no cover - typing only
    from bridge.runtime import BridgeRuntime


class {{ topic.client_class }}:
    """Generated K0-side emitter for ``{{ topic.topic }}``.

    Direct construction outside the runtime is forbidden by the
    ``manifest_implementation_bound`` CI gate. The replay-buffer wiring
    lands in MS-3d Epic 3d.3.
    """

    __transport__ = "{{ topic.transport }}"
    __topic__ = "{{ topic.topic }}"
    __schema_uri__ = "{{ topic.schema_uri }}"

    def __init__(self, runtime: "BridgeRuntime") -> None:
        self._runtime = runtime

    async def emit(self, payload: {{ topic.model_class }}) -> Any:
        """Emit ``payload`` on the ``{{ topic.topic }}`` SSE stream.

        K0-only call site. Wiring to the replay buffer + live fanout
        ships in MS-3d Epic 3d.3.
        """
        emitter = getattr(self._runtime, "_sse_emitter", None)
        if emitter is None:
            raise NotImplementedError(
                "{{ topic.client_class }}.emit: K0 SSE emitter not bound "
                "(MS-3d Epic 3d.3)."
            )
        return await emitter.emit(
            topic=self.__topic__,
            schema_uri=self.__schema_uri__,
            payload=payload,
        )
