"""Generated obs/feedback client for the ``{{ topic.topic }}`` contract.

Producer side (K1). MS-3e: this client posts ``{kind, body}`` to
``/k0/obs.emit`` via a runtime-bound :class:`bridge.core.transport.obs_emitter.ObsHttpEmitter`.
Bypasses the signed-envelope path used by ``/k0/command.submit`` because
observability/feedback ingestion is unsigned and queueable. The K0 side
dispatches by ``kind`` directly inside :mod:`k0.ports.observe`; no
codegen handler is emitted (the consumer-side stub is a no-op).
"""

from __future__ import annotations

from typing import TYPE_CHECKING, Any

from bridge._generated.{{ kernel }}.models.{{ topic.method_name }} import (
    {{ topic.model_class }},
)

if TYPE_CHECKING:  # pragma: no cover - typing only
    from bridge.runtime import BridgeRuntime


class {{ topic.client_class }}:
    """Generated K1-side obs/feedback client for ``{{ topic.topic }}``.

    Direct construction outside the runtime is forbidden by the
    ``manifest_implementation_bound`` CI gate.
    """

    __transport__ = "{{ topic.transport }}"
    __topic__ = "{{ topic.topic }}"
    __schema_uri__ = "{{ topic.schema_uri }}"
    __obs_kind__ = "{{ topic.obs_kind }}"

    def __init__(self, runtime: "BridgeRuntime") -> None:
        self._runtime = runtime

    async def publish(self, payload: {{ topic.model_class }}) -> Any:
        """Publish ``payload`` to ``/k0/obs.emit`` with kind=``{{ topic.obs_kind }}``.

        Wraps the Pydantic body as ``{"kind": "{{ topic.obs_kind }}", "body": payload}``
        before posting. Raises :class:`NotImplementedError` if the runtime
        has no ``_obs_emitter`` bound (boot-time wiring fault).
        """
        emitter = getattr(self._runtime, "_obs_emitter", None)
        if emitter is None:
            raise NotImplementedError(
                "{{ topic.client_class }}.publish: K1 obs emitter not bound "
                "(MS-3e). Ensure BridgeRuntime.from_registry was called with "
                "an HttpTransport so _obs_emitter could be wired."
            )
        return await emitter.emit(
            topic=self.__topic__,
            kind=self.__obs_kind__,
            schema_uri=self.__schema_uri__,
            payload=payload,
        )
