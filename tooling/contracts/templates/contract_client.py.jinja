"""Generated client for the ``{{ topic.topic }}`` contract.

Producer side. Imported by the {{ kernel }} kernel as the only legitimate
publishing interface for this contract. The bridge runtime injects a real
transport at boot; in-process tests use ``InProcessHttpTransport``.
"""

from __future__ import annotations

from typing import TYPE_CHECKING, Any

from bridge._generated.{{ kernel }}.models.{{ topic.method_name }} import (
    {{ topic.model_class }},
)
from bridge._generated.{{ kernel }}.models.{{ topic.paired_response_method_name }} import (
    {{ topic.paired_response_model_class }},
)

if TYPE_CHECKING:  # pragma: no cover - typing only
    from bridge.runtime import BridgeRuntime


class {{ topic.client_class }}:
    """Generated client for ``{{ topic.topic }}``.

    The runtime supplies the transport. Direct construction outside the
    runtime is forbidden by the
    ``manifest_implementation_bound`` CI gate.
    """

    __transport__ = "{{ topic.transport }}"
    __topic__ = "{{ topic.topic }}"
    __schema_uri__ = "{{ topic.schema_uri }}"
    __codec__ = "{{ topic.codec }}"
    __codecs_allowed__ = ({% for c in topic.codecs_allowed %}"{{ c }}",{% endfor %})
    __codec_negotiation__ = "{{ topic.codec_negotiation }}"

    def __init__(self, runtime: "BridgeRuntime") -> None:
        self._runtime = runtime

    async def request(self, payload: {{ topic.model_class }}) -> {{ topic.paired_response_model_class }}:
        """Send ``payload`` on ``{{ topic.topic }}`` and return the paired response.

        Synchronous request/response: ``transport.publish`` returns the
        parsed HTTP response body as a ``dict``; we validate it through
        the paired ``{{ topic.paired_response_model_class }}`` model so the
        caller never sees raw dicts. Raises ``RuntimeError`` if no
        transport is bound.
        """
        if self._runtime.transport is None:
            raise RuntimeError(
                "{{ topic.client_class }}: no transport bound on BridgeRuntime"
            )
        body = await self._runtime.transport.publish(
            topic=self.__topic__,
            schema_uri=self.__schema_uri__,
            payload=payload,
            codec=self.__codec__,
        )
        if isinstance(body, {{ topic.paired_response_model_class }}):
            return body
        return {{ topic.paired_response_model_class }}.model_validate(body)

    async def publish(self, payload: {{ topic.model_class }}) -> Any:
        """Compatibility alias for :meth:`request`. Prefer ``request``."""
        return await self.request(payload)
