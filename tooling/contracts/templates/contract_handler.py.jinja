"""Generated obs-channel handler stub for the ``{{ topic.topic }}`` contract.

Consumer side (K0). Obs/feedback dispatch happens inside
:mod:`k0.ports.observe` directly — the ``/k0/obs.emit`` route routes
by inner ``kind`` (feedback|metrics|logs) and writes either to
``st_feedback_signals`` or to the ForwardedMetricsBuffer / log
re-emitter. There is no per-topic handler registration on the bridge
runtime: the K0 endpoint is the dispatcher.

This stub exists only so the codegen layout stays uniform and so
imports of ``bridge._generated.k0.handlers.{{ topic.method_name }}``
do not fail. It provides the topic constant and the generated model
class for tests that wish to validate fixtures end-to-end without
booting K0.
"""

from __future__ import annotations

from bridge._generated.{{ kernel }}.models.{{ topic.method_name }} import (
    {{ topic.model_class }},
)

__topic__ = "{{ topic.topic }}"
__model__ = {{ topic.model_class }}
{% else %}
"""Generated handler-registry stub for the ``{{ topic.topic }}`` contract.

Consumer side. The hand-written implementation
``bridge/_generated/{{ kernel }}/handlers/{{ topic.method_name }}_impl.py``
provides the actual K0-side function; this file wires it into the
:class:`bridge.runtime.BridgeRuntime` dispatcher.
"""

from __future__ import annotations

from collections.abc import Awaitable, Callable
from typing import TYPE_CHECKING

from bridge._generated.{{ kernel }}.models.{{ topic.method_name }} import (
    {{ topic.model_class }},
)

if TYPE_CHECKING:  # pragma: no cover - typing only
    from bridge.runtime import BridgeRuntime


HandlerImpl = Callable[[{{ topic.model_class }}], Awaitable[object]]
"""Type alias for the hand-written impl signature."""


def register_handlers(runtime: "BridgeRuntime", *, impl: HandlerImpl) -> None:
    """Register ``impl`` as the K0-side handler for ``{{ topic.topic }}``.

    The dispatcher looks the topic up by exact match and routes Pydantic
    payloads to ``impl``. Idempotency, signing verification, and audit
    logging happen upstream of this call inside the runtime; ``impl`` may
    assume the body has already been validated against
    ``{{ topic.model_class }}``.
    """
    runtime.register_handler(
        topic="{{ topic.topic }}",
        model=  {{ topic.model_class }},
        impl=impl,
    )


__topic__ = "{{ topic.topic }}"
{% endif %}
