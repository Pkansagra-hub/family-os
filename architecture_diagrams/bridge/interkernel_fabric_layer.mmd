    classDef bridge_security fill:#ef5350,stroke:#b71c1c,stroke-width:2px,color:#fff,font-weight:bold

    %% IFL Components (Purple - Bridge owned)
    classDef fabric fill:#ce93d8,stroke:#7b1fa2,stroke-width:2px,color:#000,font-weight:bold
    classDef fabric_adapter fill:#e1bee7,stroke:#6a1b9a,stroke-width:2px,color:#000
    classDef fabric_schema fill:#f3e5f5,stroke:#9c27b0,stroke-width:1px,color:#000

    %% K0 Storage (Green)
    classDef port fill:#a5d6a7,stroke:#2e7d32,stroke-width:2px,color:#000
    classDef storage fill:#81c784,stroke:#1b5e20,stroke-width:2px,color:#000
    classDef core fill:#c8e6c9,stroke:#388e3c,stroke-width:2px,color:#000

    %% Physical Devices (Gray)
    classDef device fill:#78909c,stroke:#37474f,stroke-width:2px,color:#fff
