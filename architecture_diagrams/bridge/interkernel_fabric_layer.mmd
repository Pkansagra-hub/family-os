            ADAPTER_TRUST["AdapterTrustScore<br/>---<br/>Per-adapter rolling score (0.0 - 1.0)<br/>Factors: response validity, latency accuracy,<br/>error rate, schema compliance<br/>Below 0.5: flag for review<br/>Below 0.2: auto-suspend"]:::ifl_core
        end

