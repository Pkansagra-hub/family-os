            direction TB

            MT_RECEIVE["receive_manifest(adapter_id, manifest)<br/>Triggered by: k1.ifl.adapter.connected.v1"]:::k1_engine

            MT_TRANSLATE["translate_capabilities(manifest)<br/>For each capability in manifest:<br/>  IFL capability -> Fabric tool contract<br/>  name: tool.{type}.{category}.{adapter}.{action}<br/>  provider_type: BRIDGE (always -- routes via IFL)<br/>  safety_band_min: from manifest (FamilyOS-signed)<br/>  required_inputs: from manifest input schema<br/>  output: from manifest output schema<br/>  cost_per_call: from manifest latency_hint<br/>  description: from manifest (used for embedding)"]:::k1_engine

            MT_VALIDATE["validate_contracts(contracts[])<br/>Module Validator (12 rules, FAB-12)<br/>Schema validation, name conventions,<br/>safety band checks, input/output schemas"]:::k1_validator

            MT_REGISTER["register_in_fabric(contracts[])<br/>Capability Registry: register(contract)<br/>Embedding Index: add(description)<br/>Emit: k1.fabric.capability.registered.v1"]:::k1_engine

            MT_UNREGISTER["unregister_adapter(adapter_id)<br/>Remove all capabilities for adapter<br/>Emit: k1.fabric.capability.unregistered.v1<br/>Triggered by: k1.ifl.adapter.disconnected.v1"]:::k1_engine
