%% ======================================================================================
%% INTERKERNEL FABRIC LANGUAGE (IFL) - DETAILED ARCHITECTURE DIAGRAM
%% ======================================================================================
%% Created: 2026-02-01
%% Updated: 2026-02-01 - Option B: Bridge owns IFL entirely
%% Location: bridge/architecture_diagrams/ (Bridge owns ALL of IFL)
%% ARCHITECTURE (Option B - Bridge Owns IFL):
%%   - IFL Gateway lives in BRIDGE (bridge/ifl/gateway.py)
%%   - IFL Core lives in BRIDGE (bridge/ifl/core/)
%%   - IFL Adapters live in BRIDGE (bridge/ifl/adapters/)
%%   - K0 only stores device registry/credentials (no protocol logic)
%% Components:
%%   1. K1 TOOLS: Tool classes that call Bridge (PhilipsHueTool, NestTool, etc.)
%%   2. BRIDGE IFL GATEWAY: Security, auth, rate limiting
%%   3. BRIDGE IFL CORE: Parser, Translator, Registry, Schemas
%%   4. BRIDGE IFL ADAPTERS: Protocol-specific adapters (HomeKit, Nest, Tesla, etc.)
%%   5. PHYSICAL DEVICES: External IoT devices, smart home, vehicles, wearables
%% Data Flow:
%%   K1 Tool.execute() → Bridge Gateway → IFL Gateway → IFL Core → IFL Adapter → Device
%%   Device → IFL Adapter → IFL Core → Bridge → K0 (store event) + K1 (notify)
%% ======================================================================================

flowchart TB
    %% ======================================================================================
    %% LAYER -1: K1 TOOLS (Callers of IFL via Bridge)
    %% ======================================================================================
    subgraph L_NEG1_K1_TOOLS["🧠 K1 KERNEL: Tools That Call Bridge IFL"]
        direction LR

        subgraph K1_SMART_HOME_TOOLS["Smart Home Tools (k1/tools/)"]
            K1_PHILIPS_TOOL["PhilipsHueTool<br/>set_brightness()<br/>set_color()"]:::k1_tool
            K1_NEST_TOOL["NestTool<br/>set_temperature()<br/>set_mode()"]:::k1_tool
            K1_RING_TOOL["RingTool<br/>get_snapshot()<br/>arm_alarm()"]:::k1_tool
        end

        subgraph K1_VEHICLE_TOOLS["Vehicle Tools"]
            K1_TESLA_TOOL["TeslaTool<br/>unlock()<br/>climate_on()"]:::k1_tool
            K1_CARPLAY_TOOL["CarPlayTool<br/>navigate()<br/>play_music()"]:::k1_tool
        end

        subgraph K1_HEALTH_TOOLS["Health Tools"]
            K1_HEALTH_TOOL["HealthTool<br/>get_heart_rate()<br/>get_steps()"]:::k1_tool
            K1_FITNESS_TOOL["FitnessTool<br/>get_workout()<br/>start_tracking()"]:::k1_tool
        end

        subgraph K1_CUSTOM_TOOLS["Custom Tools"]
            K1_WEBHOOK_TOOL["WebhookTool<br/>trigger_action()"]:::k1_tool
            K1_MQTT_TOOL["MqttTool<br/>publish()<br/>subscribe()"]:::k1_tool
        end
    end

    %% ======================================================================================
    %% BRIDGE GATEWAY (Entry point to IFL)
    %% ======================================================================================
    subgraph BRIDGE_GATEWAY["🔐 BRIDGE: Connector Gateway (bridge/connector/)"]
        direction TB

        GATEWAY_PORT["IConnectorGatewayPort<br/>execute(tool_request)"]:::bridge_port
        GATEWAY_ROUTER["RequestRouter<br/>tool → adapter mapping"]:::bridge_internal
        GATEWAY_AUTH["CredentialStore<br/>OAuth tokens, API keys"]:::bridge_security
        GATEWAY_RATE["RateLimiter<br/>per-tool, per-device"]:::bridge_security
        GATEWAY_FORWARD["IFLForwarder<br/>route to IFL Core"]:::bridge_port
    end

    %% K1 Tools → Bridge Gateway
    K1_PHILIPS_TOOL -->|"execute()"| GATEWAY_PORT
    K1_NEST_TOOL -->|"execute()"| GATEWAY_PORT
    K1_RING_TOOL -->|"execute()"| GATEWAY_PORT
    K1_TESLA_TOOL -->|"execute()"| GATEWAY_PORT
    K1_CARPLAY_TOOL -->|"execute()"| GATEWAY_PORT
    K1_HEALTH_TOOL -->|"execute()"| GATEWAY_PORT
    K1_FITNESS_TOOL -->|"execute()"| GATEWAY_PORT
    K1_WEBHOOK_TOOL -->|"execute()"| GATEWAY_PORT
    K1_MQTT_TOOL -->|"execute()"| GATEWAY_PORT

    %% Gateway internal flow
    GATEWAY_PORT -->|"route"| GATEWAY_ROUTER
    GATEWAY_ROUTER -->|"auth"| GATEWAY_AUTH
    GATEWAY_AUTH -->|"rate limit"| GATEWAY_RATE
    GATEWAY_RATE -->|"forward"| GATEWAY_FORWARD

