    %% ======================================================================================
    %% LAYER 5: K0 STORAGE (Adapter Registry, Credentials, Events)
    %% ======================================================================================
    subgraph L5_K0_STORAGE["K0: Storage (Adapter Data + Event Persistence)"]
        direction TB

        subgraph K0_ADAPTER_STORAGE["Adapter Storage"]
            K0_ADAPTER_REG["st_ifl_adapter_registry<br/>adapter_id, company, category,<br/>manifest_hash, status, connected_at"]:::k0_storage

            K0_ADAPTER_CREDS["st_ifl_credentials<br/>adapter_id, oauth_token (encrypted),<br/>refresh_token, expires_at, scopes[]"]:::k0_storage

            K0_ADAPTER_MANIFESTS["st_ifl_manifests<br/>adapter_id, manifest_yaml,<br/>familyos_signature, version"]:::k0_storage
        end

        subgraph K0_EVENT_STORAGE["Event Storage"]
            K0_IFL_EVENTS["st_ifl_events<br/>event_id, adapter_id, topic,<br/>data (JSONB), timestamp,<br/>safety_band, processed"]:::k0_storage
        end

        subgraph K0_PIPELINES["K0 Pipelines"]
            K0_P02["P02: Write/Ingest<br/>Persist IFL events as episodic memory"]:::k0_pipeline
            K0_P07["P07: Sync/CRDT<br/>Family device sync persistence"]:::k0_pipeline
        end
    end

    %% ======================================================================================
    %% DATA FLOWS: Auto-Registration (Manifest -> Fabric)
    %% ======================================================================================

    %% Manifest ingestion pipeline
    INGEST_PULL -->|"fetch"| INGEST_VERIFY_SIG
    INGEST_VERIFY_SIG -->|"valid signature"| INGEST_VALIDATE
    INGEST_VALIDATE -->|"valid schema"| INGEST_STORE

    %% Manifest store -> emit event -> ManifestTranslator
    INGEST_STORE -->|"emit: k1.ifl.adapter.connected.v1"| MT_RECEIVE
    MT_RECEIVE -->|"translate capabilities"| MT_TRANSLATE
    MT_TRANSLATE -->|"validate contracts"| MT_VALIDATE
    MT_VALIDATE -->|"register tools"| MT_REGISTER

    %% Unregister flow
    ADAPTER_REG -->|"adapter disconnected"| MT_UNREGISTER

    %% ======================================================================================
    %% DATA FLOWS: Outbound (K1 Fabric -> Bridge -> IFL -> External)
    %% ======================================================================================

    %% Fabric auto-registered tools -> Bridge Gateway
    K1_CHASE_BAL -->|"CapabilityRequest"| GATEWAY_PORT
    K1_HUE_LIGHT -->|"CapabilityRequest"| GATEWAY_PORT
    K1_FITBIT_HR -->|"CapabilityRequest"| GATEWAY_PORT
    K1_UBER_RIDE -->|"CapabilityRequest"| GATEWAY_PORT
    K1_INSTACART_ORDER -->|"CapabilityRequest"| GATEWAY_PORT
    K1_GCAL_CREATE -->|"CapabilityRequest"| GATEWAY_PORT

    %% Gateway security pipeline
    GATEWAY_PORT -->|"verify token"| GW_TOKEN_VERIFY
    GW_TOKEN_VERIFY -->|"verify adapter"| GW_ADAPTER_VERIFY
    GW_ADAPTER_VERIFY -->|"rate limit"| GW_RATE_LIMITER
    GW_RATE_LIMITER -->|"circuit check"| GW_CIRCUIT_BREAKER
    GW_CIRCUIT_BREAKER -->|"route"| GW_REQUEST_ROUTER

    %% Gateway -> IFL Protocol Engine
    GW_REQUEST_ROUTER -->|"translate"| TRANSLATE_TO_IFL
    TRANSLATE_TO_IFL -->|"validate"| VALIDATE_REQUEST
    VALIDATE_REQUEST -->|"dispatch"| DISPATCH_ROUTER

    %% Dispatch to appropriate hosting mode
    DISPATCH_ROUTER -->|"company_hosted"| HOSTED_DISPATCHER
    DISPATCH_ROUTER -->|"wasm_sandboxed"| WASM_DISPATCHER

    %% Company-hosted -> External services
    HOSTED_DISPATCHER -->|"HTTPS/2 + TLS 1.3"| EXT_CHASE
    HOSTED_DISPATCHER -->|"HTTPS/2"| EXT_HUE
    HOSTED_DISPATCHER -->|"HTTPS/2"| EXT_NEST
    HOSTED_DISPATCHER -->|"HTTPS/2"| EXT_FITBIT
    HOSTED_DISPATCHER -->|"HTTPS/2"| EXT_TESLA
    HOSTED_DISPATCHER -->|"HTTPS/2"| EXT_UBER
    HOSTED_DISPATCHER -->|"HTTPS/2"| EXT_INSTACART
    HOSTED_DISPATCHER -->|"HTTPS/2"| EXT_GCAL
    HOSTED_DISPATCHER -->|"HTTPS/2"| EXT_GMAIL
    HOSTED_DISPATCHER -->|"HTTPS/2"| EXT_CLASSROOM

    %% WASM sandboxed -> Local adapters
    WASM_DISPATCHER -->|"sandbox exec"| EXT_MQTT
    WASM_DISPATCHER -->|"sandbox exec"| EXT_ZIGBEE
    WASM_DISPATCHER -->|"sandbox exec"| EXT_BLE
    WASM_DISPATCHER -->|"sandbox exec"| EXT_WEBHOOK
    WASM_DISPATCHER -->|"sandbox exec"| EXT_APPLE_HEALTH
    WASM_DISPATCHER -->|"sandbox exec"| EXT_FAMILY

    %% Response flow back
    EXT_CHASE -.->|"IFLResponse"| TRANSLATE_FROM_IFL
    EXT_HUE -.->|"IFLResponse"| TRANSLATE_FROM_IFL
    EXT_FITBIT -.->|"IFLResponse"| TRANSLATE_FROM_IFL
    EXT_TESLA -.->|"IFLResponse"| TRANSLATE_FROM_IFL
    TRANSLATE_FROM_IFL -.->|"CapabilityResult"| GATEWAY_PORT

    %% ======================================================================================
    %% DATA FLOWS: Inbound Events (External -> IFL -> K0 + K1)
    %% ======================================================================================

    %% External services push events
    EXT_CHASE -.->|"transaction alert"| EVT_WEBHOOK_RECEIVER
    EXT_FITBIT -.->|"heart rate"| EVT_SSE_RECEIVER
    EXT_NEST -.->|"temp changed"| EVT_WEBHOOK_RECEIVER
    EXT_RING -.->|"motion detected"| EVT_WEBHOOK_RECEIVER
    EXT_TESLA -.->|"charge complete"| EVT_WEBHOOK_RECEIVER
    EXT_MQTT -.->|"sensor data"| EVT_POLL_RECEIVER

    %% Event validation and routing
    EVT_WEBHOOK_RECEIVER -.->|"validate"| VALIDATE_EVENT
    EVT_SSE_RECEIVER -.->|"validate"| VALIDATE_EVENT
    EVT_POLL_RECEIVER -.->|"validate"| VALIDATE_EVENT
    VALIDATE_EVENT -.->|"translate"| TRANSLATE_EVENT
    TRANSLATE_EVENT -.->|"persist"| EVT_TO_K0
    TRANSLATE_EVENT -.->|"notify"| EVT_TO_K1

    %% K0 persistence
    EVT_TO_K0 -.->|"Envelope(topic, data)"| K0_P02
    K0_P02 -.->|"store"| K0_IFL_EVENTS

    %% Family sync
    EXT_FAMILY -.->|"CRDT delta"| K0_P07

    %% ======================================================================================
    %% DATA FLOWS: Adapter Registry -> K0 Persistence
    %% ======================================================================================

    ADAPTER_REG -.->|"persist"| K0_ADAPTER_REG
    ADAPTER_CRED -.->|"persist encrypted"| K0_ADAPTER_CREDS
    INGEST_STORE -.->|"persist manifest"| K0_ADAPTER_MANIFESTS

    %% ======================================================================================
    %% DATA FLOWS: Connection Flow Steps
    %% ======================================================================================

    CONN_STEP1 -->|"select adapter"| CONN_STEP2
    CONN_STEP2 -->|"OAuth complete"| CONN_STEP3
    CONN_STEP3 -->|"tokens stored"| CONN_STEP4
    CONN_STEP4 -->|"manifest ingested"| CONN_STEP5
    CONN_STEP5 -->|"capabilities registered"| CONN_STEP6

