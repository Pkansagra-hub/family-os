    %% ======================================================================================
    %% DATA FLOWS: K1 → Bridge Gateway → IFL → Devices
    %% ======================================================================================

    %% K1 Tools → Bridge Gateway
    K1_PHILIPS_TOOL -->|"execute(set_brightness)"| GATEWAY_PORT
    K1_NEST_TOOL -->|"execute(set_temp)"| GATEWAY_PORT
    K1_RING_TOOL -->|"execute(arm)"| GATEWAY_PORT
    K1_TESLA_TOOL -->|"execute(unlock)"| GATEWAY_PORT
    K1_CARPLAY_TOOL -->|"execute(navigate)"| GATEWAY_PORT
    K1_HEALTH_TOOL -->|"execute(get_heart_rate)"| GATEWAY_PORT
    K1_FITNESS_TOOL -->|"execute(get_workout)"| GATEWAY_PORT
    K1_WEBHOOK_TOOL -->|"execute(trigger)"| GATEWAY_PORT
    K1_MQTT_TOOL -->|"execute(publish)"| GATEWAY_PORT

    %% Bridge Gateway internal
    GATEWAY_PORT -->|"route"| GATEWAY_ROUTER
    GATEWAY_ROUTER -->|"auth"| GATEWAY_AUTH
    GATEWAY_AUTH -->|"rate limit"| GATEWAY_RATE
    GATEWAY_RATE -->|"forward"| GATEWAY_FORWARD

    %% Bridge Gateway → IFL Core
    GATEWAY_FORWARD -->|"parse"| IFL_PARSE
    IFL_PARSE -->|"translate"| IFL_TRANSLATE
    IFL_TRANSLATE -->|"lookup"| IFL_GET_DEVICE
    IFL_GET_DEVICE -->|"validate"| IFL_SCHEMA_VALIDATE

    %% IFL Core → IFL Adapters
    IFL_SCHEMA_VALIDATE -->|"route"| ADAPT_HOMEKIT
    IFL_SCHEMA_VALIDATE -->|"route"| ADAPT_HEALTHKIT
    IFL_SCHEMA_VALIDATE -->|"route"| ADAPT_TESLA
    IFL_SCHEMA_VALIDATE -->|"route"| ADAPT_MQTT
    IFL_SCHEMA_VALIDATE -->|"route"| ADAPT_FAMILY_SYNC

    %% IFL Adapters → Physical Devices
    ADAPT_HOMEKIT -->|"HomeKit API"| DEV_HUE
    ADAPT_HOMEKIT -->|"HomeKit API"| DEV_NEST
    ADAPT_HOMEKIT -->|"HomeKit API"| DEV_LOCKS
    ADAPT_HOMEKIT -->|"Ring API"| DEV_RING
    ADAPT_HOMEKIT -->|"Sonos API"| DEV_SONOS
    ADAPT_TESLA -->|"Tesla API"| DEV_TESLA
    ADAPT_HEALTHKIT -->|"HealthKit"| DEV_APPLE_WATCH
    ADAPT_FITBIT -->|"Fitbit API"| DEV_FITBIT
    ADAPT_GARMIN -->|"Connect IQ"| DEV_GARMIN
    ADAPT_MQTT -->|"MQTT"| DEV_MQTT_SENSOR
    ADAPT_ZIGBEE -->|"Zigbee"| DEV_ZIGBEE
    ADAPT_WEBHOOK -->|"HTTP"| DEV_WEBHOOK

    %% Family Sync Adapter → Other Family Devices
    ADAPT_FAMILY_SYNC -->|"P2P E2EE"| DEV_IPHONE
    ADAPT_FAMILY_SYNC -->|"P2P E2EE"| DEV_LAPTOP
    ADAPT_FAMILY_SYNC -->|"P2P E2EE"| DEV_TABLET

    %% ======================================================================================
    %% DATA FLOWS: Devices → IFL → K0 (Inbound events)
    %% ======================================================================================

    %% Device events → IFL Adapters (inbound)
    DEV_APPLE_WATCH -.->|"heart rate"| ADAPT_HEALTHKIT
    DEV_NEST -.->|"temp change"| ADAPT_HOMEKIT
    DEV_TESLA -.->|"location"| ADAPT_TESLA
    DEV_MQTT_SENSOR -.->|"sensor data"| ADAPT_MQTT

    %% IFL Adapters → IFL Core (parse inbound)
    ADAPT_HEALTHKIT -.->|"parse"| IFL_PARSE
    ADAPT_HOMEKIT -.->|"parse"| IFL_PARSE
    ADAPT_TESLA -.->|"parse"| IFL_PARSE
    ADAPT_MQTT -.->|"parse"| IFL_PARSE

    %% IFL Core → Bridge → K0 (store events)
    IFL_TO_ENVELOPE -.->|"store event"| CMD_SUBMIT_FN
    CMD_SUBMIT_FN -.->|"persist"| K0_P02

    %% IFL registry → K0 storage
    IFL_REG_DEVICE -.->|"persist"| DB_DEVICE_REG
    IFL_ACQUIRE_LEASE -.->|"persist"| DB_DEVICE_CREDS

    %% Family sync → K0 P07
    ADAPT_FAMILY_SYNC -.->|"CRDT merge"| K0_P07

