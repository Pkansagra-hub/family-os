            end

            subgraph IFL_EVENT_ROUTING["Event Routing"]
                EVT_TO_K0["Route to K0 (Persistence)<br/>IFLEvent -> Envelope(topic, data)<br/>-> Bridge CMD_PORT -> K0 P02<br/>All events persisted for memory"]:::ifl_core

