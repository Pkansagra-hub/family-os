                HOSTED_CONN_POOL["ConnectionPool<br/>Per-adapter connection pooling<br/>Max connections: 10 per adapter<br/>Keep-alive: 30s<br/>Health check: via pool ping"]:::ifl_hosted
            end

            subgraph IFL_WASM_SANDBOXED["WASM Sandboxed Adapters (Lightweight / Offline)"]
                WASM_DISPATCHER["WASMSandboxDispatcher<br/>---<br/>dispatch(ifl_request, wasm_module) -> ifl_response<br/>Sandbox: memory 64MB, CPU 5s timeout<br/>No network access (must use provided APIs)<br/>---<br/>Use cases: offline adapters, local sensors,<br/>MQTT protocol translation, Zigbee, BLE<br/>FamilyOS downloads signed WASM at install"]:::ifl_wasm

                WASM_SANDBOX["WASMSandbox<br/>Memory: configurable (default 64MB)<br/>CPU timeout: configurable (default 5s)<br/>Filesystem: none<br/>Network: none (uses host IFL APIs)<br/>Import: ifl_host_send(), ifl_host_receive()"]:::ifl_wasm

                WASM_CACHE["WASMModuleCache<br/>Cached compiled modules<br/>Validated: signature check on load<br/>Version: auto-update from Marketplace"]:::ifl_wasm
            end

            DISPATCH_ROUTER["DispatchRouter<br/>---<br/>manifest.hosting_mode == 'company_hosted'<br/>  -> CompanyHostedDispatcher<br/>manifest.hosting_mode == 'wasm_sandboxed'<br/>  -> WASMSandboxDispatcher"]:::ifl_core
        end

