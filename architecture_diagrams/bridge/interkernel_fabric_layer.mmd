            EXT_UBER["Uber<br/>com.uber.rides<br/>company_hosted"]:::ext_service
            EXT_GOOGLE_MAPS["Google Maps<br/>com.google.maps<br/>company_hosted"]:::ext_service
            EXT_TRANSIT["Transit API<br/>com.transit.local<br/>company_hosted"]:::ext_service
        end

        subgraph EXT_SHOPPING["Shopping Adapters"]
