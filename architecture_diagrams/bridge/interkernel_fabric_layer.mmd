        %% IFL MANIFEST SYSTEM (Marketplace + Signing + Ingestion)
        %% ==================================================================================
        subgraph IFL_MANIFEST_SYSTEM["IFL Manifest System (bridge/ifl/manifest/)"]
            direction TB

            subgraph IFL_MARKETPLACE["Adapter Marketplace Registry"]
                MKT_CATALOG["AdapterCatalog<br/>All published adapters<br/>Searchable by category, name<br/>---<br/>Source: FamilyOS Marketplace API<br/>Cached locally, refreshed daily"]:::ifl_core

                MKT_CATEGORIES["Adapter Categories<br/>---<br/>home: Smart Home, IoT, Sensors<br/>health: Wearables, Medical, Fitness<br/>finance: Banking, Payments, Investment<br/>transport: Vehicles, Ride-share, Maps<br/>shopping: Grocery, Delivery, E-commerce<br/>calendar: Scheduling, Events<br/>education: Schools, Learning<br/>communication: Email, Messaging<br/>media: Music, Video, Podcasts<br/>security: Cameras, Locks, Alarms<br/>energy: Solar, EV Charging, Utilities<br/>custom: Developer-built (still signed)"]:::ifl_schema

                MKT_SEARCH["search_adapters(category?, query?)<br/>browse_categories()<br/>get_adapter_info(adapter_id)"]:::ifl_core
            end

            subgraph IFL_SIGNING["FamilyOS Signing Authority"]
                SIGN_CA["FamilyOS Certificate Authority<br/>Root CA for adapter signing<br/>---<br/>Signs: adapter manifest + binary<br/>Verifies: company domain ownership<br/>Revokes: compromised adapters"]:::ifl_security

                SIGN_COMPANY_VERIFY["Company Verification<br/>---<br/>com.chase.* -> Chase Bank (verified)<br/>com.plaid.* -> Plaid Inc (verified)<br/>com.tesla.* -> Tesla Inc (verified)<br/>com.philips.hue.* -> Signify (verified)<br/>---<br/>ENFORCED: Only owning company can publish<br/>No third-party adapter development<br/>Domain claim + legal entity verification"]:::ifl_security

                SIGN_MANIFEST_SIGN["ManifestSigner<br/>sign(manifest, company_cert) -> signed_manifest<br/>verify(signed_manifest) -> bool<br/>check_revocation(adapter_id) -> bool"]:::ifl_security

                SIGN_REVIEW["FamilyOS Review Process<br/>---<br/>1. Company submits adapter + manifest<br/>2. Automated: schema validation, safety audit<br/>3. Manual: privacy review, capability audit<br/>4. Signed: FamilyOS CA signs manifest<br/>5. Published: appears in Marketplace<br/>---<br/>Safety band overrides: FamilyOS can<br/>escalate declared bands (never lower)"]:::ifl_security
            end

            subgraph IFL_MANIFEST_SCHEMA["IFL Capability Manifest (ifl_manifest.schema.yaml)"]
                direction TB

                MANIFEST_HEADER["Manifest Header<br/>---<br/>ifl_version: '1.0'<br/>adapter_id: 'com.chase.banking'<br/>adapter_name: 'Chase Banking'<br/>company: 'JPMorgan Chase'<br/>category: 'finance'<br/>hosting_mode: 'company_hosted' | 'wasm_sandboxed'<br/>endpoint: 'https://ifl.chase.com/v1'  (if company_hosted)<br/>wasm_module: 'chase_banking.wasm'    (if wasm_sandboxed)<br/>auth_flow: 'oauth2_authorization_code'<br/>auth_url: 'https://chase.com/oauth/authorize'<br/>icon_url, description, privacy_policy_url<br/>familyos_signature: '...'  (FamilyOS CA signed)"]:::ifl_manifest

                MANIFEST_CAPABILITIES["Capabilities Declaration<br/>---<br/>capabilities[]:<br/>  - name: 'check_balance'<br/>    type: 'read' | 'execute' | 'subscribe'<br/>    description: 'Check account balance...'<br/>    safety_band_min: 'AMBER'<br/>    inputs: [{name, type, required, enum}]<br/>    output: {json_schema}<br/>    latency_hint_ms: 2000<br/>    rate_limit: {max_per_minute: 10}<br/>    requires_confirmation: false<br/>    cost_tier: 'free' | 'metered'"]:::ifl_manifest

                MANIFEST_EVENTS["Events Declaration<br/>---<br/>events_inbound[]:<br/>  - topic: 'transaction.alert'<br/>    full_topic: 'ifl.finance.chase.transaction.alert'<br/>    description: 'Real-time transaction notification'<br/>    schema: {json_schema}<br/>    frequency_hint: 'per_transaction'<br/>    safety_band_min: 'AMBER'<br/>---<br/>events_outbound[]:<br/>  - topic: 'balance.threshold'<br/>    trigger: 'balance < user_config.threshold'"]:::ifl_manifest

                MANIFEST_PERMISSIONS["Permissions Declaration<br/>---<br/>permissions_required[]:<br/>  - scope: 'accounts:read'<br/>    reason: 'View account balances'<br/>  - scope: 'transfers:write'<br/>    reason: 'Initiate money transfers'<br/>---<br/>data_retention: 'none' | 'session' | '30d'<br/>data_shared_with: [] (transparency)"]:::ifl_manifest
            end

            subgraph IFL_MANIFEST_INGESTION["Manifest Ingestion Pipeline"]
                INGEST_PULL["pull_manifest(adapter_endpoint)<br/>Fetch manifest from adapter"]:::ifl_core

                INGEST_VERIFY_SIG["verify_signature(manifest)<br/>Check FamilyOS CA signature<br/>Check company domain match<br/>Check not revoked"]:::ifl_security

                INGEST_VALIDATE["validate_manifest(manifest)<br/>Schema validation against ifl_manifest.schema.yaml<br/>Safety band audit (no GREEN for financial writes)<br/>Input/output schema completeness"]:::ifl_core

                INGEST_STORE["store_manifest(manifest)<br/>Persist in IFL AdapterRegistry<br/>Credentials in CredentialStore<br/>Emit: ifl.adapter.manifest.ingested.v1"]:::ifl_core
            end
        end

