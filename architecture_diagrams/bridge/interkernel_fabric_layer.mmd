            EXT_DOORDASH["DoorDash<br/>com.doordash.delivery<br/>company_hosted"]:::ext_service
            EXT_AMAZON["Amazon<br/>com.amazon.shopping<br/>company_hosted"]:::ext_service
        end

        subgraph EXT_CALENDAR["Calendar and Communication"]
            EXT_GCAL["Google Calendar<br/>com.google.calendar<br/>company_hosted"]:::ext_service
            EXT_OUTLOOK["Outlook<br/>com.microsoft.outlook<br/>company_hosted"]:::ext_service
