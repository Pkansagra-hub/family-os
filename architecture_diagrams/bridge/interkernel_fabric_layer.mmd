    %% ======================================================================================
    %% LAYER 2: BRIDGE CONNECTOR GATEWAY (Security, Auth, Rate Limiting)
    %% ======================================================================================
    subgraph L2_BRIDGE_GATEWAY["Bridge: ConnectorGateway (bridge/connector/)"]
        direction TB

        GATEWAY_PORT["IConnectorGatewayPort<br/>execute(adapter_id, action, params)<br/>register_adapter(manifest, oauth_token)<br/>unregister_adapter(adapter_id)<br/>list_adapters() -> AdapterStatus[]<br/>---<br/>ALL external traffic enters here<br/>Devices, APIs, services, sensors"]:::bridge_port

        subgraph GATEWAY_SECURITY["Gateway Security Pipeline"]
            direction TB

            GW_TOKEN_VERIFY["TokenVerifier<br/>Verify FamilyOS capability token<br/>Check: user_band >= action safety_band"]:::bridge_security

            GW_ADAPTER_VERIFY["AdapterVerifier<br/>Verify adapter signature (FamilyOS CA)<br/>Verify company domain ownership<br/>Check: adapter not revoked"]:::bridge_security

            GW_RATE_LIMITER["RateLimiter<br/>Per-adapter, per-user, per-action<br/>TokenBucket sliding window<br/>Limits from manifest rate_limits{}"]:::bridge_security

            GW_CIRCUIT_BREAKER["CircuitBreaker<br/>Per-adapter failure protection<br/>Threshold: from manifest or default 5/min<br/>Half-open: 30s"]:::bridge_security

            GW_REQUEST_ROUTER["RequestRouter<br/>Route to IFL Runtime<br/>adapter_id -> hosting_mode -> dispatch"]:::bridge_internal
        end
    end

