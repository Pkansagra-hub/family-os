        %% IFL PROTOCOL ENGINE (Message Translation, Routing)
        %% ==================================================================================
        subgraph IFL_PROTOCOL_ENGINE["IFL Protocol Engine (bridge/ifl/protocol/)"]
            direction TB

            subgraph IFL_MESSAGE_FORMAT["IFL Message Format (Universal Envelope)"]
                IFL_REQUEST_ENV["IFLRequest Envelope<br/>---<br/>ifl_version: '1.0'<br/>request_id: uuid<br/>adapter_id: 'com.chase.banking'<br/>action: 'check_balance'<br/>params: {account_type: 'checking'}<br/>auth_token: '...' (user's OAuth token)<br/>trace_id: cognitive_trace_id<br/>timestamp: ISO8601"]:::ifl_protocol

                IFL_RESPONSE_ENV["IFLResponse Envelope<br/>---<br/>request_id: uuid (correlation)<br/>status: 'success' | 'error' | 'pending'<br/>data: {balance: 5420.50, currency: 'USD'}<br/>error: {code, message} (if error)<br/>latency_ms: actual<br/>adapter_version: '2.1.0'"]:::ifl_protocol

                IFL_EVENT_ENV["IFLEvent Envelope<br/>---<br/>event_id: uuid<br/>adapter_id: 'com.chase.banking'<br/>topic: 'ifl.finance.chase.transaction.alert'<br/>data: {amount: -42.50, merchant: 'Starbucks'}<br/>timestamp: ISO8601<br/>safety_band: 'AMBER'"]:::ifl_protocol
            end

            subgraph IFL_TRANSLATOR["Protocol Translator (bridge/ifl/protocol/translator.py)"]
                TRANSLATE_TO_IFL["to_ifl(fabric_request) -> IFLRequest<br/>Fabric CapabilityRequest -> IFL envelope"]:::ifl_core

                TRANSLATE_FROM_IFL["from_ifl(ifl_response) -> CapabilityResult<br/>IFL response -> Fabric result"]:::ifl_core

                TRANSLATE_EVENT["translate_event(ifl_event) -> K0 Envelope<br/>IFL inbound event -> K0 command.submit<br/>topic: ifl.{category}.{adapter}.{event}"]:::ifl_core
            end

            subgraph IFL_VALIDATOR["Payload Validator (bridge/ifl/protocol/validator.py)"]
                VALIDATE_REQUEST["validate_request(request, manifest)<br/>Check params against capability input schema<br/>Check required fields present<br/>Check types match"]:::ifl_core

                VALIDATE_RESPONSE["validate_response(response, manifest)<br/>Check output matches declared schema<br/>Flag: unexpected fields, type mismatches<br/>Adapter trust score adjustment"]:::ifl_core

                VALIDATE_EVENT["validate_event(event, manifest)<br/>Check event matches declared event schema<br/>Check topic matches declared topics<br/>Reject undeclared event topics"]:::ifl_core
            end
        end

        %% ==================================================================================
        %% IFL ADAPTER REGISTRY (Connected Adapters + Credentials)
        %% ==================================================================================
        subgraph IFL_ADAPTER_REGISTRY["IFL Adapter Registry (bridge/ifl/registry/)"]
            direction TB

            ADAPTER_REG["AdapterRegistry<br/>---<br/>register(adapter_id, manifest, credentials)<br/>unregister(adapter_id)<br/>get(adapter_id) -> AdapterRecord<br/>list(category?) -> AdapterRecord[]<br/>update_status(adapter_id, status)<br/>---<br/>Status: CONNECTED, DEGRADED, OFFLINE, REVOKED"]:::ifl_core

            ADAPTER_CRED["CredentialStore<br/>---<br/>store(adapter_id, oauth_token, refresh_token)<br/>get(adapter_id) -> Credentials<br/>refresh(adapter_id) -> new_token<br/>revoke(adapter_id)<br/>---<br/>Encrypted at rest (AES256-GCM)<br/>Auto-refresh before expiry"]:::ifl_security

