    %% ======================================================================================
    %% INTERNAL FLOW MATRIX: Concierge → Orchestrator → Planner → Tools
    %% ======================================================================================
    %% CONCIERGE FSM CONTROL:
    %%   CONCIERGE_FSM manages state transitions for all FSM states (LISTENING, ACKING, etc.)
    %%   Single Writer pattern: Only Concierge writes to SessionState
    %%
    %% COMPLEXITY-BASED ROUTING (from DISPATCHING):
    %% | Tier   | Path                                                    | Latency   |
    %% |--------|---------------------------------------------------------|-----------|
    %% | LOW    | DISPATCHING → CAPABILITY_FABRIC → COMPANIONING          | <2s       |
    %% | MEDIUM | DISPATCHING → ORCHESTRATOR → CAPABILITY_FABRIC          | 2-10s     |
    %% | HIGH   | DISPATCHING → ORCHESTRATOR → PLANNER → CAPABILITY_FABRIC| 10-60s    |
    %%
    %% MESSAGE ENVELOPES:
    %% | Sender     | Receiver     | Envelope                               |
    %% |------------|--------------|----------------------------------------|
    %% | DISPATCHING| ORCHESTRATOR | TaskEnvelope{intent, context, tier}    |
    %% | ORCHESTRATOR| PLANNER     | PlanRequest{intent, constraints}       |
    %% | PLANNER    | ORCHESTRATOR | CommittedPlan{steps[], dependencies}   |
    %% | ORCHESTRATOR| FABRIC      | CapabilityRequest{name, params, ctx}   |
    %% | FABRIC     | ORCHESTRATOR | CapabilityResult{success, data, error} |
    %%
    %% PLAN EXECUTION:
    %%   STAGE4_COMMIT → CommittedPlan → ORCHESTRATOR → PARALLEL_DAG → CAPABILITY_FABRIC
    %%   Each step in plan.steps[] spawns tools via Fabric
    %%   Results aggregate back through PARALLEL_DAG → ORCHESTRATOR → COMPANIONING
    %% ======================================================================================

    %% ======================================================================================
    %% LLM TOOL ARCHITECTURE — Who has which tools, when, and how they flow
    %% ======================================================================================
    %%
    %% DESIGN PRINCIPLE: LLMs interact with the system ONLY through tool/function calls.
    %% SessionState cognitive updates are tool calls, not structured output fields.
    %% The LLM calls a tool ONLY when it detects something worth updating.
    %% "ok cool" turn = 0 tool calls. "Actually Thursday not Wednesday" = update_beliefs().
    %%
    %% TWO-PHASE WRITE PER TURN:
    %% ┌─────────────────────────────────────────────────────────────────────────────────┐
    %% │ PHASE 1: Pre-LLM Classification (deterministic, ~3ms)                           │
    %% │   Concierge FSM writes directly (NOT tool calls):                               │
    %% │   ├─ control.intents        ← Intent classification (multi-label)               │
    %% │   ├─ control.domains        ← Domain classification                            │
    %% │   ├─ control.safety_band    ← Safety band                                      │
    %% │   ├─ beliefs_active.entities← Entity extraction (PERSON, LOC, TIME)             │
    %% │   └─ affective_now.raw      ← Emotion + Sentiment                              │
    %% │                                                                                 │
    %% │ PHASE 2: LLM with Tools (semantic understanding)                                │
    %% │   LLM decides which tools to call based on conversation understanding:          │
    %% │   ├─ update_scoreboard()    ← pronoun resolution, QUD, salience, topic shift    │
    %% │   ├─ update_beliefs()       ← implicit facts, corrections, invalidations        │
    %% │   ├─ update_clarifications() ← semantic gaps only LLM can detect                │
    %% │   ├─ update_narrative()     ← thread switches, resumptions                     │
    %% │   ├─ refine_affect()        ← sarcasm/nuance the classifier missed              │
    %% │   └─ promote_belief()       ← bring old facts back to HOT                      │
    %% │   Each tool call → Concierge FSM → MutationGuard.preflight() → Write            │
    %% └─────────────────────────────────────────────────────────────────────────────────┘
    %%
    %% THREE-TIER ROUTING (Front → Back → Planner/Orchestrator)
    %% ┌──────────┬────────────────────────────────────────────────────────────────────┐
    %% │ TIER 1   │ FRONT LLM: Talks to user. Reads K0 memories. Reads native app      │
    %% │ (LOW)    │ state (read-only K1 surface). Bypasses resolver for reads.          │
    %% │          │ Terminates: text WITHOUT tool calls.                                │
    %% ├──────────┼────────────────────────────────────────────────────────────────────┤
    %% │ TIER 2   │ BACK LLM: Executes actions. Calls resolve_situation(action_text).   │
    %% │ (MEDIUM) │ Resolver returns envelope {connector, tools[], constitution}.       │
    %% │          │ Back picks tool, calls invoke_capability. Straightforward tasks.    │
    %% │          │ Terminates: submit_result().                                        │
    %% ├──────────┼────────────────────────────────────────────────────────────────────┤
    %% │ TIER 3   │ BACK LLM calls submit_result(tier=high) when task is BIG + VAGUE.  │
    %% │ (HIGH)   │ Routes through Planner (4-stage Sketch→Expand→Validate→Commit)      │
    %% │          │ then Orchestrator (DAG execution via Fabric).                       │
    %% │          │ For: multi-step plans, cross-domain tasks, ambiguous objectives.    │
    %% └──────────┴────────────────────────────────────────────────────────────────────┘
    %% ─────────────────────────────────────────────────────────────────────────────────
    %% HOW FAMILY NATIVE APPS CONNECT TO KERNEL:
    %%   family.shopping, family.calendar, family.food, etc. are REGISTERED in GPS
    %%   via manifest admission. Their tools are what Back LLM sees in the envelope.
    %%   Front LLM reads their state (read-only K1 surface). Back LLM calls
    %%   invoke_capability on their tools. Native app inbound API feeds LPS with
    %%   connected backends. Native app fans out to external backends (Walmart API,
    %%   etc.) which are HIDDEN from Back LLM — Back sees only ~50 native app tools.
    %%
    %% RESOLVER (MiniLM-L6, 22MB, 3ms/q, 87% Conn@1):
    %%   action_text → MiniLM-L6 dense retrieval → namespace prior → routing decision
    %%   → ResolutionEnvelope {verdict:can_execute, connector, tools[], constitution,
    %%      search_confidence, alternative_connectors, is_resolved, disambiguation_signal}
    %%   → LPS dynamic enum injection (session-aware backend_id enums)
    %% TOOL AVAILABILITY BY TIER:
    %% ┌──────────┬───────────────────┬───────────────────┬───────────────────────────────┐
    %% │ Tier     │ Cognitive Tools   │ Read Tools        │ Action Tools                  │
    %% ├──────────┼───────────────────┼───────────────────┼───────────────────────────────┤
    %% │ LOW      │ ALL (6 tools)     │ ALL (3 tools)     │ invoke_capability (direct)    │
    %% │ MEDIUM   │ ALL (6 tools)     │ ALL (3 tools)     │ FSM delegates to Orchestrator │
    %% │ HIGH     │ ALL (6 tools)     │ ALL (3 tools)     │ FSM delegates to Orchestrator │
    %% └──────────┴───────────────────┴───────────────────┴───────────────────────────────┘
    %%
    %% WHEN LLM TOOL CALLS HAPPEN PER TIER:
    %% ┌──────────┬────────────────────────────────────────────────────────────────────────┐
    %% │ LOW      │ DISPATCHING: LLM call with cognitive + action tools                   │
    %% │          │   → LLM generates response + calls invoke_capability() + cognitive     │
    %% │          │   → Tool executes via Fabric → Result in same LLM call                │
    %% ├──────────┼────────────────────────────────────────────────────────────────────────┤
    %% │ MEDIUM   │ DISPATCHING: LLM call with cognitive tools only (~200 token ack)      │
    %% │          │   → LLM generates preliminary ack + calls cognitive tools              │
    %% │          │   → FSM sends TaskEnvelope to Orchestrator (NOT a tool call)           │
    %% │          │ DELIVERING: LLM call with cognitive tools (final response)             │
    %% │          │   → LLM gets tool_results[] + generates response + cognitive tools     │
    %% ├──────────┼────────────────────────────────────────────────────────────────────────┤
    %% │ HIGH     │ Same as MEDIUM, but Orchestrator routes through Planner first          │
    %% │          │   → Planner LLM runs 4-stage pipeline with read-only discovery tools    │
    %% │          │   → discover_capabilities(), find_relevant_prompts(),                    │
    %% │          │     query_planning_context(), recall_for_planning()                      │
    %% │          │   → CommittedPlan → Orchestrator → Blind DAG execution via Fabric        │
    %% │          │   → Results aggregate → DELIVERING with cognitive tools                │
    %% └──────────┴────────────────────────────────────────────────────────────────────────┘
    %%
    %% HOW ORCHESTRATOR, PLANNER, AND FABRIC FIT IN:
    %% ┌─────────────────────────────────────────────────────────────────────────────────┐
    %% │ ORCHESTRATOR (Pure Deterministic Actor — NO LLM, NO tool calls)                 │
    %% │   Receives: TaskEnvelope{intent, context, tier} from Concierge FSM             │
    %% │   MEDIUM path: Routes directly to Capability Fabric                             │
    %% │   HIGH path:   Sends PlanRequest to Planner → waits for CommittedPlan           │
    %% │   Executes:    Plan steps via PARALLEL_DAG → Capability Fabric                  │
    %% │   Returns:     Aggregated CapabilityResult[] → Concierge COMPANIONING           │
    %% │   Reads:       SessionState (multi-reader, lock-free) for execution context     │
    %% │   Writes:      NEVER (emits deltas to DELTA_BUS → Concierge aggregates)         │
    %% ├─────────────────────────────────────────────────────────────────────────────────┤
    %% │ PLANNER (LLM-Powered — uses read-only discovery tools)                          │
    %% │   Receives: PlanRequest{intent, constraints} from Orchestrator                  │
    %% │   Stage 1 (Sketch):   LLM + discover_capabilities() + recall_for_planning()     │
    %% │                        + query_planning_context() → rough plan (~2K tokens)      │
    %% │   Stage 2 (Expand):   LLM + find_relevant_prompts() → tool mapping (~1K tokens) │
    %% │     → Planner queries Fabric retrieval (semantic Top-K) for capabilities         │
    %% │   Stage 3 (Validate): LLM arbiter prompt → validation (~500 tokens)             │
    %% │   Stage 4 (Commit):   Deterministic — persist plan to K0 WAL                    │
    %% │   Returns: CommittedPlan{steps[], dependencies} to Orchestrator                 │
    %% │   Reads:   SessionState (multi-reader) for planning context                     │
    %% │   Writes:  NEVER (planning deltas → DELTA_BUS → Concierge aggregates)           │
    %% ├─────────────────────────────────────────────────────────────────────────────────┤
    %% │ CAPABILITY FABRIC (Dual Role: Retrieval Engine + Execution Engine — NO LLM)     │
    %% │   ROLE 1 — Intelligent Retrieval (Serves Planner):                              │
    %% │     Receives: discover_capabilities(domain?, intent?) from Planner              │
    %% │     Performs: Semantic Top-K search across 100K+ tools/agents/prompts            │
    %% │     Filters:  Hard (safety band, availability) then Soft (semantic 0.4,          │
    %% │               domain 0.3, success 0.15, cost 0.15)                              │
    %% │     Returns:  Top-10 relevant capabilities with schemas                         │
    %% │   ROLE 2 — Resolution & Execution (Serves Orchestrator + Concierge):            │
    %% │     Receives: CapabilityRequest{name, params, context}                          │
    %% │     Resolves: Capability name → Provider (Agent/Tool/Workflow)                  │
    %% │     Selects:  Provider via Policy Engine (Affective + Cognitive Load + QoS)     │
    %% │     Builds:   Context from SessionState (via Context Builder + Token Budget)    │
    %% │     Executes: Provider → MCP Runner / WASM Sandbox / Bridge                    │
    %% │     Returns:  CapabilityResult{success, data, error}                           │
    %% │   Reads:    SessionState (multi-reader) for context building                   │
    %% │   Writes:   NEVER                                                              │
    %% └─────────────────────────────────────────────────────────────────────────────────┘
    %%
    %% DYNAMIC AGENT LLM TOOLS:
    %% │ Agents spawned via Fabric (health_agent, finance_agent, etc.)                   │
    %% │   Tools: invoke_capability() — for sub-tool execution                           │
    %% │   Context: SessionState sections injected via Capability Context Builder         │
    %% │   Writes: NEVER directly — emit deltas to DELTA_BUS                            │
    %% │   Results: CapabilityResult → back through Fabric → Orchestrator → Concierge   │
    %% ======================================================================================

