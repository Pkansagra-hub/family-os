    %% ======================================================================================
    %% EXPERIENCE LAYER (Runs every 20-30 turns, not every turn)
    %% NOTE: These are HEURISTIC processes, NOT LLM calls
    %% They compute metrics from SessionState history (valence trends, thread clustering)
    %% LLM is used in DELIVERING for final response, which incorporates these insights
    %% Analyzes long-term emotional patterns, user preferences, conversation threads
    %% ======================================================================================
    DELIVERING -->|"turn_count % 25 == 0"| EMOTIONAL_PROCESSING
    EMOTIONAL_PROCESSING -->|"emotional trajectory"| EMOTIONAL_MIRRORING
    EMOTIONAL_MIRRORING -->|"tone adjustments"| CONCIERGE_STYLE
    EMOTIONAL_MIRRORING -->|"update persona hints"| CONCIERGE_PERSONA

    DELIVERING -->|"turn_count % 20 == 0"| NARRATIVE_WEAVING
    NARRATIVE_WEAVING -->|"active threads"| CONVERSATIONAL_NARRATIVE_ENGINE
    NARRATIVE_WEAVING -->|"update session"| NARRATIVE_ACTIVE

    DELIVERING -->|"turn_count % 30 == 0"| ANTICIPATORY_RESPONSE
    ANTICIPATORY_RESPONSE -->|"predicted needs"| CONVERSATIONAL_ANTICIPATION_ENGINE
    ANTICIPATORY_RESPONSE -->|"prefetch context"| CAPABILITY_FABRIC
    CONVERSATIONAL_NARRATIVE_ENGINE -->|"Update Threads"| CONVERSATION_THREADS
    CONVERSATIONAL_NARRATIVE_ENGINE -->|"Update Arc"| NARRATIVE_ARC
    LLM_MODEL_ENGINE -->|"Route to Providers"| HUB_ROUTER
    HUB_ROUTER -->|"OpenAI API"| HUB_OPENAI
    HUB_ROUTER -->|"Anthropic API"| HUB_ANTHROPIC
    HUB_ROUTER -->|"Other APIs"| HUB_OTHERS
