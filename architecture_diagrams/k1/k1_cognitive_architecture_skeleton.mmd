    %% CIRCUIT BREAKER PROTECTION EDGES
    %% Each CB wraps calls to protected component, handles timeout/failure gracefully
    %% ======================================================================================
    CB_MODEL_GATEWAY -.->|"protects"| MODEL_GATEWAY
    CB_ORCHESTRATOR -.->|"protects"| ORCHESTRATOR_MAILBOX
    CB_PLANNER -.->|"protects"| PLANNER_MAILBOX
    CB_FABRIC -.->|"protects"| CAPABILITY_FABRIC
    CB_MCP_CONNECTOR -.->|"protects"| LOCAL_MCP_SERVERS
    CB_MCP_CONNECTOR -.->|"protects"| REMOTE_MCP_SERVERS
    CB_SESSIONSTATE -.->|"protects"| SESSIONSTATE_STORE
    CB_SSE -.->|"protects"| SSE_CONNECTION_MGR
    CB_SSE -.->|"protects"| BRIDGE_SSE

    %% Circuit breaker state reporting
    CB_MODEL_GATEWAY -->|"state: CLOSED/OPEN/HALF"| HEALTH_CHECK_ORCHESTRATOR
    CB_ORCHESTRATOR -->|"state"| HEALTH_CHECK_ORCHESTRATOR
    CB_PLANNER -->|"state"| HEALTH_CHECK_ORCHESTRATOR
    CB_FABRIC -->|"state"| HEALTH_CHECK_ORCHESTRATOR
    CB_MCP_CONNECTOR -->|"state"| HEALTH_CHECK_ORCHESTRATOR
    CB_SESSIONSTATE -->|"state"| HEALTH_CHECK_ORCHESTRATOR
    CB_SSE -->|"state"| HEALTH_CHECK_ORCHESTRATOR

    %% Fallback flows when circuit is OPEN
    CB_ORCHESTRATOR -->|"OPEN: degrade"| CAPABILITY_FABRIC
    CB_PLANNER -->|"OPEN: skip planning"| CAPABILITY_FABRIC
    CB_MODEL_GATEWAY -->|"OPEN: cached/template"| CONCIERGE_FSM

    MODULE_SCANNER -->|"discovers"| MODULES_DIR
    MODULE_SCANNER -->|"registers"| TOOL_REGISTRY
    MODULE_SCANNER -->|"registers prompts"| PROMPT_REGISTRY
    MODULE_SCANNER -->|"registers agent templates"| AGENT_REGISTRY
    MODULE_SCANNER -->|"registers schemas"| SCHEMA_REGISTRY
    TOOL_REGISTRY -->|"exposes"| CAPABILITY_REGISTRY
    AGENT_REGISTRY -->|"templates"| AGENT_FACTORY
    AGENT_FACTORY -->|"spawns"| DYNAMIC_INSTANCES

    %% ======================================================================================
    %% PROMPT MANAGEMENT FLOWS
    %% All LLM calls go through Prompt Management before Model Gateway
    %% ======================================================================================

    %% ======================================================================================
    %% PROMPT MANAGEMENT (Collapsed Pipeline)
    %% Internal flow: RESOLVER → TEMPLATE_STORE → VERSION_CTRL → VAR_INJECTOR → COMPILER
    %% All consumers route through single PROMPT_SYSTEM entry point
    %% ======================================================================================
    %% Consumers → Prompt System (consolidated entry point)
    CONCIERGE_FSM -->|"prompt request"| PROMPT_SYSTEM
    PLANNER_AGENT -->|"prompt request"| PROMPT_SYSTEM
    DYNAMIC_AGENTS -->|"prompt request"| PROMPT_SYSTEM
    %% NOTE: MEMORY_WRITER_AGENTS, SOLUTION_VALIDATOR, PROACTIVE_DECISION also use PROMPT_SYSTEM

    %% Prompt System internal (collapsed - see Prompt Management subgraph for details)
    PROMPT_SYSTEM -->|"context lookup"| SESSIONSTATE_STORE
    PROMPT_SYSTEM -->|"compiled prompt"| MODEL_ROUTER

    %% Dynamic Agent Schema Registration (at spawn time)
    AGENT_FACTORY -->|"register agent schema"| SCHEMA_COMPILER
    SCHEMA_COMPILER -->|"compile FlatBuffer schema"| SCHEMA_REGISTRY
    AGENT_TEMPLATES -->|"schema reference"| SCHEMA_COMPILER

    %% ======================================================================================
    %% OUTPUT VALIDATION FLOWS
    %% All LLM responses go through Output Validation before returning to consumer
    %% ======================================================================================

    %% ======================================================================================
    %% OUTPUT VALIDATION PIPELINE (Collapsed)
    %% Internal 3-tier flow: T1_STRUCTURAL → T2_SCHEMA → T3_SEMANTIC
    %% Failure paths: any tier → VALIDATION_FALLBACK → retry/repair/reject
    %% ======================================================================================

    %% LLM Response → Validation Pipeline (collapsed)
    HUB_ROUTER -->|"raw LLM response"| OUTPUT_VALIDATION_PIPELINE
    OUTPUT_VALIDATION_PIPELINE["Output Validation Pipeline<br/>T1: Structural → T2: Schema → T3: Semantic<br/>Fallback: Retry(2) → Repair → Reject"]:::engine

    %% Validation uses Schema Registry and SessionState for cross-ref
    OUTPUT_VALIDATION_PIPELINE -->|"schema lookup"| SCHEMA_REGISTRY
    OUTPUT_VALIDATION_PIPELINE -->|"fact cross-ref"| SESSIONSTATE_STORE
    OUTPUT_VALIDATION_PIPELINE -->|"failures"| VALIDATION_FALLBACK
    VALIDATION_FALLBACK -->|"retry"| PROMPT_SYSTEM

    %% Validated Response → LLM Request Bus (returns to callers)
    OUTPUT_VALIDATION_PIPELINE -->|"validated response"| LLM_REQUEST_BUS

    %% Core vs Generic Schema Selection (schemas registered in SCHEMA_HIERARCHY subgraph)
    %% NOTE: CORE, CONCIERGE, PLANNER, MEMORY, GENERIC schemas are looked up from SCHEMA_REGISTRY
    %% Edge consolidation: Schema lookup happens via OUTPUT_VALIDATION_PIPELINE → SCHEMA_REGISTRY

