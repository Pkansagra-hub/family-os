    %% ======================================================================================
    %% MAIN CONVERSATION FLOW
    %% ======================================================================================

    %% ======================================================================================
    %% CONCIERGE FSM CONTROL (State Machine Orchestration)
    %% CONCIERGE_FSM is the controller that manages state transitions
    %% ======================================================================================
    CONCIERGE_FSM -->|"current_state"| LISTENING
    CONCIERGE_FSM -->|"transition"| ACKING
    CONCIERGE_FSM -->|"transition"| CLARIFYING
    CONCIERGE_FSM -->|"transition"| DISPATCHING
    CONCIERGE_FSM -->|"transition"| COMPANIONING
    CONCIERGE_FSM -->|"transition"| PROGRESSING
    CONCIERGE_FSM -->|"transition"| DELIVERING
    CONCIERGE_FSM -->|"transition"| INTERRUPT_HANDLING

    LISTENING -->|"k1.concierge.user_input"| ACKING

    %% ACKING routes based on complexity tier (determined by UltraBERT)
    %% LOW: Skip preliminary ack, execute tool fast (<2s), then LLM response with result
    %% MEDIUM/HIGH: Generate preliminary ack for conversational continuity (tasks may take 10-30s)
    ACKING -->|"uncertainty ≥ 0.2"| CLARIFYING
    ACKING -->|"uncertainty < 0.2 (ready to execute)"| DISPATCHING
    UNCERTAINTY_ESTIMATOR -->|"uncertainty"| ACKING
    CLARIFYING -->|"user_response"| ACKING

    %% ======================================================================================
    %% LOW TIER FLOW (Fast Path - No Preliminary Ack)
    %% User: "Remind me at 5pm" → Tool executes (~500ms) → LLM response with result
    %% ======================================================================================
    DISPATCHING -->|"simple task (LOW)"| CAPABILITY_FABRIC
    %% Tool result flows through pipeline (see TOOL EXECUTION & RESULT PIPELINE section)
    %% CAPABILITY_FABRIC → TOOL_PROVIDERS → execute → result → COMPANIONING → TOOL_RESULT_BUFFER
    COMPANIONING -->|"LOW: tool done"| DELIVERING
    %% DELIVERING fetches from TOOL_RESULT_BUFFER and sends to MODEL_GATEWAY
    DELIVERING -->|"fetch tool_results"| TOOL_RESULT_BUFFER
    TOOL_RESULT_BUFFER -->|"LOW: tool_result[]"| DELIVERING
    DELIVERING -->|"LOW: tool_result + context (~500 tokens)"| LLM_REQUEST_BUS
    LLM_REQUEST_BUS -->|"LOW: response with result"| DELIVERING

    %% ======================================================================================
    %% MEDIUM/HIGH TIER FLOW (With Conversational Continuity)
    %% User: Complex multi-step task → Preliminary ack → Background execution → Progress → Final
    %% ======================================================================================

    %% DISPATCHING creates TaskEnvelope and routes through mailbox
    DISPATCHING -->|"TaskEnvelope{intent, context, tier}"| ORCHESTRATOR_MAILBOX
    ORCHESTRATOR_MAILBOX -->|"dequeue task"| ORCHESTRATOR_ACTOR
    ORCHESTRATOR_ACTOR -->|"k1.orchestration.task.accepted"| CONCIERGE_FSM

    %% Preliminary ack for MEDIUM/HIGH: "Let me work on that..." (keeps conversation flowing)
    DISPATCHING -->|"MEDIUM/HIGH: preliminary ack (~200 tokens)"| LLM_REQUEST_BUS
    LLM_REQUEST_BUS -->|"preliminary ack sent"| COMPANIONING

    %% Orchestrator execution with progress updates
    DISPATCHING -->|"k1.orchestration.execution.started"| COMPANIONING
    COMPANIONING -->|"k1.agent.*.delta.v1"| PROGRESSING
    PROGRESSING -->|"k1.orchestration.execution.completed"| DELIVERING

    %% Final response for MEDIUM/HIGH - includes all tool results
    DELIVERING -->|"fetch all tool_results"| TOOL_RESULT_BUFFER
    TOOL_RESULT_BUFFER -->|"MEDIUM/HIGH: all tool_results[]"| DELIVERING
    DELIVERING -->|"MEDIUM/HIGH: tool_results + context (2-8K tokens)"| LLM_REQUEST_BUS
    LLM_REQUEST_BUS -->|"final response"| DELIVERING

    %% Clear buffer after response sent
    DELIVERING -->|"clear buffer"| TOOL_RESULT_BUFFER
    DELIVERING -->|"user.ack"| LISTENING

    %% ======================================================================================
    %% SYSTEM → USER OUTPUT FLOW (All outbound messages to user)
    %% Every message the system sends to user goes through OUTPUT_CHANNEL
    %% ======================================================================================

    %% Final Response Delivery (after LLM generation)
    DELIVERING -->|"k1.response.final.v1"| OUTPUT_CHANNEL
    OUTPUT_CHANNEL -->|"message sent"| LISTENING

    %% Preliminary Ack (MEDIUM/HIGH tier conversational continuity)
    COMPANIONING -->|"k1.response.ack.v1"| OUTPUT_CHANNEL

    %% Clarification Questions (need more info from user)
    CLARIFYING -->|"k1.response.clarification.v1"| OUTPUT_CHANNEL

    %% Progress Updates (streaming deltas during execution)
    PROGRESSING -->|"k1.response.progress.v1"| OUTPUT_CHANNEL

    %% HIL Requests (Planner needs user decision)
    REQUIREMENT_CLARIFICATION -->|"k1.hil.clarification.v1"| OUTPUT_CHANNEL
    PLAN_APPROVAL -->|"k1.hil.approval_request.v1"| OUTPUT_CHANNEL
    EXECUTION_MONITORING -->|"k1.hil.progress.v1"| OUTPUT_CHANNEL
    FALLBACK_TRIGGER -->|"k1.hil.fallback.v1"| OUTPUT_CHANNEL

    %% Proactive Messages (system-initiated engagement)
    CURIOSITY_AGENT -->|"k1.proactive.question.v1"| OUTPUT_CHANNEL
    PROACTIVE_DECISION -->|"k1.proactive.message.v1"| OUTPUT_CHANNEL

    %% Output Queue prioritization
    OUTPUT_CHANNEL -->|"enqueue"| OUTPUT_QUEUE
    OUTPUT_QUEUE -->|"dequeue + send"| L0_EXTERNAL

    %% Interrupts
    LISTENING -->|"k1.concierge.user_input (interrupt)"| INTERRUPT_HANDLING
    INTERRUPT_HANDLING -->|"user.intent.override"| ACKING
    ACKING -->|"invoke capability: k0.query_recall"| TOOL_INVOKE_CAPABILITY
    CLARIFYING -->|"retrieve evidence"| TOOL_INVOKE_CAPABILITY
    BRIDGE_CLIENT -->|"query transport"| PORT_QRY
    PORT_QRY -->|"selector bundle"| QUERY_AGG
    QUERY_AGG -->|"multi-driver query"| WAL_DRIVER
    QUERY_AGG -->|"semantic search"| VECTOR_DRIVER
    WAL_DRIVER -->|"episodic memories"| TOOL_RECALL_MEMORY
    VECTOR_DRIVER -->|"semantic matches"| TOOL_RECALL_MEMORY
    TOOL_RECALL_MEMORY -->|"recall bundle"| CAPABILITY_CONTEXT_BUILDER
    %% UltraBERT Flow (22ms single forward pass)
    %% NOTE: UltraBERT runs all heads in single forward pass - shown as grouped subgraph
    %% Heads: INTENT, INGRESS, SAFETY, EMOTIONS, SENTIMENT, NER, RELATIONS (12 total)
    ACKING -->|"user_input"| ULTRABERT_CORE
    ULTRABERT_CORE -->|"12 heads parallel: INTENT, INGRESS, SAFETY, EMOTIONS, NER"| ULTRABERT_ENGINE

    %% Safety Gate (FIRST - before any routing)
    ULTRABERT_SAFETY -->|"safety_band"| CRISIS_DETECTOR
    CRISIS_DETECTOR -->|"CRISIS detected"| SAFETY_OVERRIDE
    SAFETY_OVERRIDE -->|"immediate"| TIER_CRISIS
    TIER_CRISIS -->|"safety.crisis.protocol"| SAFETY_MAILBOX

    %% Complexity Routing (after safety clear) - Multi-Label Flow
    ULTRABERT_INTENT -->|"intents[] + scores{}"|MULTI_INTENT_SCORER
    ULTRABERT_INGRESS -->|"domains[]"|CROSS_DOMAIN_DETECTOR
    MULTI_INTENT_SCORER -->|"intent_complexity"|COMPLEXITY_CLASSIFIER
    CROSS_DOMAIN_DETECTOR -->|"domain_complexity"|COMPLEXITY_CLASSIFIER
    ULTRABERT_SAFETY -->|"safety_band"| COMPLEXITY_CLASSIFIER
    ULTRABERT_EMOTIONS -->|"emotion_intensity"| COMPLEXITY_CLASSIFIER

    COMPLEXITY_CLASSIFIER -->|"LOW: single intent + single domain"| TIER_LOW
    COMPLEXITY_CLASSIFIER -->|"MEDIUM: multi-intent OR multi-domain"| TIER_MEDIUM
    COMPLEXITY_CLASSIFIER -->|"HIGH: complex + emotional"| TIER_HIGH

    %% LOW tier: Tool executes FIRST, then LLM generates response with tool result
    TIER_LOW -->|"route to tool execution"| DISPATCHING

    %% MEDIUM/HIGH: LLM reasoning first (may need planning), then execution
    %% NOTE: LLM calls routed via LLM_REQUEST_BUS
    TIER_MEDIUM -->|"llm.reasoning (2K tokens)"| LLM_REQUEST_BUS
    TIER_HIGH -->|"llm.planning (8K tokens)"| LLM_REQUEST_BUS
    LLM_REQUEST_BUS -->|"reasoning/plan complete"| DISPATCHING

    %% Feed other ACKING components (Multi-Label aware)
    ULTRABERT_INTENT -->|"intents[] explicit"| HYPOTHESIS_GENERATOR
    ULTRABERT_INGRESS -->|"domains[] for context"| HYPOTHESIS_GENERATOR
    HYPOTHESIS_GENERATOR -->|"all_intent_requirements"| CONTRACT_SIGNAL_GAPS
    CONTRACT_SIGNAL_GAPS -->|"signals"| SIGNAL_LIBRARY
    ULTRABERT_NER -->|"entities"| CONTEXT_INFERENCE
    ULTRABERT_NER -->|"TIME/DATE/DURATION entities"| TIME_PARSER
    TIME_PARSER -->|"parsed temporal expressions"| TIME_RESOLVER
    TIME_RESOLVER -->|"query user TZ"| TIMEZONE_CONTEXT
    TIMEZONE_CONTEXT -->|"TZ info"| TIME_RESOLVER
    TIME_RESOLVER -->|"anchor reference"| TEMPORAL_ANCHOR
    TIME_RESOLVER -->|"resolved absolute time"| CONTEXT_INFERENCE
    TIME_RESOLVER -->|"ambiguous (AM/PM?)"| SIGNAL_LIBRARY
    SIGNAL_LIBRARY -->|"time_ambiguity signal"| ENTROPY_MIN_QUESTION_PLANNER
    ULTRABERT_RELATIONS -->|"relations"| CONTEXT_INFERENCE
    CONTRACT_SIGNAL_GAPS -->|"slot_fill_request"| CONTEXT_INFERENCE
    CONTEXT_INFERENCE -->|"filled_intent + provenance"| TINY_SANITY_ARBITER
    TINY_SANITY_ARBITER -->|"verdict + flags"| UNCERTAINTY_ESTIMATOR
    ULTRABERT_INTENT -->|"confidence_score"| UNCERTAINTY_ESTIMATOR
    UNCERTAINTY_ESTIMATOR -->|"score + reasons"| ENTROPY_MIN_QUESTION_PLANNER
    ENTROPY_MIN_QUESTION_PLANNER -->|"question_plan"| CLARIFYING
    CLARIFYING -->|"generate clarification (~300 tokens)"| LLM_REQUEST_BUS
    ULTRABERT_EMOTIONS -->|"tone_hint"| AFFECTIVE_MIRRORING_ENGINE
    ULTRABERT_SENTIMENT -->|"sentiment"| AFFECTIVE_MIRRORING_ENGINE

    %% UltraBERT → SessionState Updates (Multi-Label)
    ULTRABERT_EMOTIONS -->|"update AFFECTIVE_NOW"| AFFECTIVE_NOW
    ULTRABERT_NER -->|"update BELIEFS_ACTIVE"| BELIEFS_ACTIVE
    TIME_RESOLVER -->|"update TEMPORAL_CONTEXT"| TEMPORAL_CONTEXT
    ULTRABERT_SAFETY -->|"update CONTROL.safety_band"| CONTROL
    ULTRABERT_INTENT -->|"update CONTROL.intents{primary,all[],scores}"| CONTROL
    ULTRABERT_INGRESS -->|"update CONTROL.domains[]"| CONTROL

    CONTRACT_SIGNAL_GAPS -.->|capability requirements| CAPABILITY_REGISTRY
    ACKING -->|"pre_execution_check"| CONSTRAINT_MANAGER
    CONSTRAINT_MANAGER -->|"gaps_found"| ACKING
    ACKING -->|"gap_detection"| THEORY_OF_MIND_ENGINE
    ACKING -->|"early_validation"| STAGE3_VALIDATE
    CLARIFYING -->|"clarification"| PENDING_CLARIFICATIONS
    PENDING_CLARIFICATIONS -->|"resolved"| ACKING

    %% Clarification cycle completion (user provides answer)
    CLARIFYING -->|"user_response received"| ACKING
    ACKING -->|"uncertainty < 0.2 (resolved)"| DISPATCHING

    %% Sub-agent clarification flow (respects Single Writer pattern)
    %% Sub-agents CANNOT write to SessionState - they emit to DELTA_BUS
    L4_SUBAGENTS -->|"clarification_request delta"| DELTA_BUS
    DELTA_BUS -->|"clarification deltas"| AGGREGATION_WINDOW
    %% Concierge (Single Writer) adds to PENDING_CLARIFICATIONS
    AGGREGATION_WINDOW -->|"clarification_request"| CONCIERGE_FSM
    CONCIERGE_FSM -->|"write pending"| PENDING_CLARIFICATIONS
    PENDING_CLARIFICATIONS -->|"interrupt for clarification"| INTERRUPT_HANDLING
    INTERRUPT_HANDLING -->|"route to user"| CLARIFYING
    STATE_PENDING -->|"Supervisor Hire"| STATE_WARMING
    STATE_WARMING -->|"Model Ready"| STATE_ACTIVE
    STATE_ACTIVE -->|"60s Idle TTL"| STATE_IDLE
    STATE_IDLE -->|"New Task"| STATE_ACTIVE
    STATE_ACTIVE -->|"Supervisor Drain"| STATE_DRAINING
    STATE_IDLE -->|"Supervisor Drain"| STATE_DRAINING
    STATE_DRAINING -->|"Tasks Complete"| STATE_TERMINATED
    TASK_ANNOUNCEMENT -->|"Task Announced"| PROPOSAL_BIDDING
    PROPOSAL_BIDDING -->|"Proposals Received"| MULTI_CRITERIA_SCORING
    MULTI_CRITERIA_SCORING -->|"Winner Selected"| PARALLEL_DAG
    PARALLEL_DAG -->|"Execution Started"| SAGA_RECOVERY
    TOOL_INVOKE_CAPABILITY -->|"Fabric Invocation"| CAPABILITY_FABRIC
    TOOL_DISCOVER_CAPABILITIES -->|"Registry Query"| CAPABILITY_REGISTRY
    TOOL_SPAWN_VIA_FABRIC -->|"Agent Spawning"| AGENT_PROVIDERS
    %% Orchestrator invokes capabilities (tools/agents) via Fabric
    ORCHESTRATOR_ACTOR -->|"CapabilityRequest{name, params, context}"| CAPABILITY_FABRIC
    ORCHESTRATOR_ACTOR -->|"SpawnRequest{agent_type, config}"| CAPABILITY_FABRIC

    %% Planner notifies Orchestrator when plan is ready
    PLANNER_AGENT -->|"k1.planner.plan.ready"| ORCHESTRATOR_MAILBOX

    %% ======================================================================================
    %% TOOL EXECUTION & RESULT PIPELINE (Complete Round-Trip)
    %% Call → Execute → Result → Context → LLM Response
    %% ======================================================================================

    %% Step 1: Fabric routes to appropriate provider
    CAPABILITY_FABRIC -->|"invoke tool capability"| TOOL_PROVIDERS

    %% Step 2: Provider executes via appropriate runner
    TOOL_PROVIDERS -->|"MCP tool call"| MCP_RUNNERS
    TOOL_PROVIDERS -->|"K0 memory operation"| BRIDGE_CLIENT
    TOOL_PROVIDERS -->|"sandboxed execution"| WASM_SANDBOX

    %% Step 3: Tool execution completes, results return
    MCP_RUNNERS -->|"tool_result JSON"| TOOL_PROVIDERS
    BRIDGE_CLIENT -->|"K0 response"| TOOL_PROVIDERS
    WASM_SANDBOX -->|"sandbox output"| TOOL_PROVIDERS

    %% Step 4: Provider packages result, returns to Fabric
    TOOL_PROVIDERS -->|"CapabilityResult{success, data, error}"| CAPABILITY_FABRIC

    %% Error handling flow (tool/capability failures)
    CAPABILITY_FABRIC -->|"k1.capability.failed.v1"| EVENT_BUS
    EVENT_BUS -->|"error routing"| CONCIERGE_MAILBOX
    CONCIERGE_FSM -->|"error recovery"| DELIVERING

    %% Step 5: Fabric emits completion event with result
    CAPABILITY_FABRIC -->|"k1.capability.completed.v1 + result"| EVENT_BUS

    %% Step 6: Result routes based on complexity tier
    %% LOW path: Direct to COMPANIONING (fast path)
    CAPABILITY_FABRIC -->|"LOW: tool_result"| COMPANIONING

    %% MEDIUM/HIGH path: Via Orchestrator for aggregation
    CAPABILITY_FABRIC -->|"MEDIUM/HIGH: tool_result"| ORCHESTRATOR_ACTOR
    ORCHESTRATOR_ACTOR -->|"aggregated results"| COMPANIONING

    %% Step 7: COMPANIONING stages result for LLM context
    COMPANIONING -->|"stage tool_result for LLM"| TOOL_RESULT_BUFFER

    %% Step 8: DELIVERING retrieves results (see MAIN CONVERSATION FLOW section)
    %% DELIVERING --> TOOL_RESULT_BUFFER --> DELIVERING --> MODEL_GATEWAY

    %% ======================================================================================

    FABRIC_GATEWAY -->|"Bridge to Fabric"| CAPABILITY_FABRIC
    CAPABILITY_FABRIC -->|"Spawn Agents"| AGENT_PROVIDERS
    AGENT_PROVIDERS -->|"Instantiate"| L4_SUBAGENTS
    CAPABILITY_FABRIC -->|"Read Context"| SESSIONSTATE_STORE
    CAPABILITY_CONTEXT_BUILDER -->|"Build Context"| SESSIONSTATE_STORE
    QUERY_AGG -->|"return recall bundle"| CONTEXT_BUDGET
    CONTEXT_BUDGET -->|"apply token budget"| CAPABILITY_CONTEXT_BUILDER
    WORKFLOW_COMPILER -->|"Capability DAG"| CAPABILITY_FABRIC

    %% Temporal-Workflow Integration
    SYSTEM_CLOCK -->|"current_time"| WORKFLOW_SCHEDULER
    SYSTEM_CLOCK -->|"UTC now"| TEMPORAL_ANCHOR
    WORKFLOW_SCHEDULER -->|"check user TZ"| TEMPORAL_CONTEXT
    TIME_RESOLVER -->|"scheduled_time"| WORKFLOW_SCHEDULER
    WORKFLOW_SCHEDULER -->|"trigger due"| WORKFLOW_RUN_SUPERVISOR

    CONSTRAINT_MANAGER -->|"Capability Validation"| CAPABILITY_CONSTRAINT_RESOLVER
    CAPABILITY_CONSTRAINT_RESOLVER -->|"Query Fabric"| CAPABILITY_FABRIC
    %% Note: Learning signals flow handled in CROSS_KERNEL_BRIDGE section above
    CAPABILITY_LEARNING_BRIDGE -->|"Enhance Contracts"| FABRIC_CONTRACTS
    MCP_CAPABILITY_REGISTRAR -->|"Register Tools"| CAPABILITY_REGISTRY
    LOCAL_MCP_SERVERS -->|"Expose Capabilities"| MCP_CAPABILITY_REGISTRAR
    CONCIERGE_FSM -->|"Deterministic Updates"| SINGLE_WRITER
    ORCHESTRATOR_ACTOR -->|"Read Access"| MULTI_READER
    PLANNER_AGENT -->|"Planning State"| MULTI_READER
    L4_SUBAGENTS -->|"Execution State"| MULTI_READER
    L4_SUBAGENTS -->|"State Deltas"| DELTA_BUS
    PLANNER_AGENT -->|"Planning Deltas"| DELTA_BUS
    ORCHESTRATOR_ACTOR -->|"Orchestration Deltas"| DELTA_BUS
    DELTA_BUS -->|"All Agent Deltas"| AGGREGATION_WINDOW
    AGGREGATION_WINDOW -->|"Aggregated State"| CONCIERGE_FSM
    CONCIERGE_FSM -->|"Coherent State Write"| SINGLE_WRITER
    SINGLE_WRITER -->|"Write to Store"| SESSIONSTATE_STORE

    %% SessionState Internal Data Flow (HOT → WARM → COLD)
    SESSIONSTATE_STORE -->|"turn complete"| HISTORY_ACTIVE
    HISTORY_ACTIVE -->|"evict turns 11+"| HISTORY_RECENT
    HISTORY_RECENT -->|"archive turns 41+"| ST_HISTORY_ARCHIVE
    BELIEFS_ACTIVE -->|"evict old facts"| BELIEFS_HISTORY
    BELIEFS_HISTORY -->|"archive"| ST_BELIEFS_ARCHIVE
    CLARIFICATIONS -->|"track discourse"| SCOREBOARD
    CONCIERGE_PERSONA -->|"personality config"| PERSONA
    METRICS_AGGREGATOR -->|"session metrics"| TELEMETRY

    CONCIERGE_FSM -->|"Write Request"| MUTATION_GUARD
    MUTATION_GUARD -->|"Approved/Rejected"| CONCIERGE_FSM
    MUTATION_GUARD -->|"Eviction Needed"| EVICTION_ENGINE
    EVICTION_ENGINE -->|"Summarize + Archive"| LOCAL_RECONSTRUCTION
    TOTAL_LIMIT -->|"≥95KB"| EMERGENCY_SUMMARIZE
    EMERGENCY_SUMMARIZE -->|"Aggressive Compression"| WARM_TIER
    TOTAL_LIMIT -->|"Critical"| EMERGENCY_READONLY
    EMERGENCY_READONLY -->|"Temporary Reject"| CONCIERGE_FSM
    TOTAL_LIMIT -->|"Overload"| EMERGENCY_SHED
    EMERGENCY_SHED -->|"Priority Evict"| EVICTION_ENGINE
    LOCAL_RECONSTRUCTION -->|"Reconstruct"| RECONSTRUCTION_SLA
    RECONSTRUCTION_SLA -->|"<100ms"| HOT_CORE
    %% Cross-Kernel Bridge: All K0 communication goes through Bridge (root level)
    ORCHESTRATOR_ACTOR -->|"Memory Writes"| BRIDGE_CLIENT
    L4_SUBAGENTS -->|"Persistence"| BRIDGE_CLIENT
    SESSIONSTATE_STORE -->|"Checkpoints"| BRIDGE_CLIENT
    CONCIERGE_FSM -->|"Feedback Signals"| BRIDGE_CLIENT
    K0_SSE_ENDPOINT -->|"SSE Stream"| BRIDGE_SSE
    BRIDGE_SSE -->|"SSE Events"| EVENT_BUS
    EVENT_BUS -->|"k1.k0.sse.received.v1"| SSE_TRIGGER
    SSE_TRIGGER -->|"Event Analysis"| PROACTIVE_DECISION
    PROACTIVE_DECISION -->|"k1.proactive.decision.made.v1"| PROACTIVE_BUDGET_GATE
    PROACTIVE_DECISION -->|"needs content"| LLM_REQUEST_BUS
    PROACTIVE_DECISION -->|"with interruption policy"| CONCIERGE_MAILBOX
    PROACTIVE_BUDGET_GATE -->|"Budget OK"| PROACTIVE_SPAWN
    PROACTIVE_SPAWN -->|"Via Fabric"| CAPABILITY_FABRIC

    %% Gap Resolution Flow (System 1: Active Learning)
    %% CURIOSITY_AGENT uses LLM to formulate natural questions
    BRIDGE_SSE -->|"curiosity.intent.v1"| GAP_SSE_LISTENER
    GAP_SSE_LISTENER -->|"spawn"| CURIOSITY_AGENT
    CURIOSITY_AGENT -->|"question prompt (~300 tokens)"| LLM_REQUEST_BUS
    CURIOSITY_AGENT -->|"formulate question"| CONCIERGE_FSM
    CURIOSITY_AGENT -->|"user answers"| GAP_ANSWER_WRITER
    GAP_ANSWER_WRITER -->|"memory.delta + gap_id"| BRIDGE_CLIENT

    CONVERSATION_SCHEDULER -->|"Rhythm Algorithms"| L1_RHYTHM
    RHYTHM_PATTERNS -->|"Pattern Library"| CONVERSATION_BEAT
    CONVERSATION_BEAT -->|"Timing Context"| DYNAMIC_ADJUSTMENT
    DYNAMIC_ADJUSTMENT -->|"Adjusted Timing"| CONVERSATION_SCHEDULER
    L1_RHYTHM -->|"Pacing & Cadence"| CONCIERGE_FSM
    CONCIERGE_FSM -->|"EMOTIONAL_PROCESSING"| AFFECTIVE_MIRRORING_ENGINE
    AFFECTIVE_MIRRORING_ENGINE -->|"Adjust Emotional Tone"| CONCIERGE_FSM
    %% AFFECT ANALYSIS: Now handled by K1 UltraBERT (not K0)
    CONCIERGE_FSM -->|"analyze affect (local)"| ULTRABERT_EMOTIONS
    ULTRABERT_EMOTIONS -->|"k1.affect.analyzed.v1"| EVENT_BUS
    EVENT_BUS -->|"Update affective_context"| AFFECTIVE_CONTEXT
    CONVERSATIONAL_ANTICIPATION_ENGINE -->|"Speculative Execution"| ORCHESTRATOR_ACTOR
    THEORY_OF_MIND_ENGINE -->|"Mental Model Updates"| MENTAL_MODEL
    THEORY_OF_MIND_ENGINE -->|"Cognitive Load"| MENTAL_MODEL_MANAGEMENT
    MENTAL_MODEL_MANAGEMENT -->|"Load State"| COGNITIVE_LOAD_ROUTING
    MENTAL_MODEL_MANAGEMENT -->|"Capacity Estimate"| CONCIERGE_FSM
    PREDICTIVE_COMPLETION -->|"Predictions"| CONVERSATIONAL_ANTICIPATION_ENGINE
    CONVERSATIONAL_ANTICIPATION_ENGINE -->|"Feed Predictions"| PREDICTIVE_COMPLETION
    L3_EMPATHY -->|"Cognitive Load-Aware"| ORCHESTRATOR_ACTOR
    SUPERVISOR_MONITORING -->|"Health Monitoring"| L4_SUBAGENTS
    WFQ_SCHEDULER -->|"Priority-based Delivery"| EVENT_BUS
    WFQ_SCHEDULER -->|"Priority-based Delivery"| MAILBOX_ROUTER
    CONCIERGE_USER_LOOP -->|"Bidirectional Flow"| CONCIERGE_FSM
    PLANNER_USER_LOOP -->|"Bidirectional Flow"| PLANNER_AGENT
    SUBAGENTS_USER_LOOP -->|"Bidirectional Flow"| L4_SUBAGENTS
    ORCHESTRATOR_USER_LOOP -->|"Bidirectional Flow"| ORCHESTRATOR_ACTOR
    FEEDBACK_ROUTING -->|"All Feedback through Event Bus"| EVENT_BUS
    DELTA_BUS -->|"Session Deltas"| MEMORY_WRITER_AGENTS
    MEMORY_WRITER_AGENTS -->|"Agent Deltas"| DELTA_AGGREGATOR
    DELTA_AGGREGATOR -->|"batch to K0"| K0_CMD
    K0_CMD -->|"submit_command()"| PORT_CMD
    PORT_CMD -->|"emits event that routes to P02 via router"| BUS_DISPATCH
    BUS_DISPATCH -->|"topic match"| PIPELINE_ROUTER
    PIPELINE_ROUTER -->|"P02 trigger"| PIPELINE_P02
    PIPELINE_P02 -->|"emit k0.episodic.written"| BUS_DISPATCH
    BUS_DISPATCH -->|"trigger P03"| PIPELINE_P03
    PIPELINE_P03 -->|"emit k0.memory.consolidated"| PORT_SSE
    PORT_SSE -->|"SSE event"| BRIDGE_SSE
    BRIDGE_SSE -->|"to K1 EventBus"| EVENT_BUS
    STATE_DELTA_EMITTER -->|"K0 Command Envelopes"| BRIDGE_CLIENT
    STATE_DELTA_EMITTER -->|"JSON Envelope"| JSON_ENVELOPES
    SESSIONSTATE_STORE -->|"Session End"| K0_SESSION_CHECKPOINTS
    K0_SESSION_CHECKPOINTS -->|"Retention Expiry"| AUTOMATED_DELETION
    K0_TURN_HISTORY -->|"Retention Expiry"| AUTOMATED_DELETION
    USER_DELETION -->|"Soft Delete"| K0_SESSION_CHECKPOINTS
    USER_DELETION -->|"Soft Delete"| K0_TURN_HISTORY
    GRACE_PERIOD -->|"Recovery Within Grace"| K0_SESSION_CHECKPOINTS
    GRACE_PERIOD -->|"Recovery Within Grace"| K0_TURN_HISTORY
    %% ======================================================================================
    %% PLANNER 4-STAGE PIPELINE (For HIGH complexity tasks)
    %% Each stage uses LLM for intelligent processing
    %% ======================================================================================

    %% MEDIUM tier: Direct tool execution (no full planning needed)
    ORCHESTRATOR_ACTOR -->|"MEDIUM: direct execution"| CAPABILITY_FABRIC

    %% HIGH tier: Full planning pipeline required
    ORCHESTRATOR_ACTOR -->|"PlanRequest{intent, constraints}"| PLANNER_MAILBOX
    PLANNER_MAILBOX -->|"dequeue plan request"| PLANNER_AGENT
    PLANNER_AGENT -->|"Stage 1: sketch plan"| STAGE1_SKETCH

    %% Stage 1: LLM-Powered Plan Sketching (~2K tokens)
    %% NOTE: LLM calls routed via LLM_REQUEST_BUS (see MODEL_GATEWAY HUB section)
    STAGE1_SKETCH -->|"sketch prompt (~2K tokens)"| LLM_REQUEST_BUS
    STAGE1_SKETCH -->|"rough plan"| STAGE2_EXPAND

    %% Stage 2: Tool Selection & Expansion (~1K tokens)
    STAGE2_EXPAND -->|"tool mapping (~1K tokens)"| LLM_REQUEST_BUS
    STAGE2_EXPAND -->|"expanded plan with tools"| STAGE3_VALIDATE

    %% Stage 3: LLM Arbiter Validation (~500 tokens)
    STAGE3_VALIDATE -->|"arbiter validation (~500 tokens)"| LLM_REQUEST_BUS
    STAGE3_VALIDATE -->|"validated plan"| STAGE4_COMMIT

    STAGE4_COMMIT -->|"committed plan"| ORCHESTRATOR_ACTOR
    STAGE4_COMMIT -->|"persist plan to K0"| BRIDGE_CLIENT

    %% Plan Execution: Orchestrator receives plan and executes via Fabric
    ORCHESTRATOR_ACTOR -->|"execute CommittedPlan.steps[]"| PARALLEL_DAG
    PARALLEL_DAG -->|"spawn tools per step"| CAPABILITY_FABRIC
    CAPABILITY_FABRIC -->|"step completed"| PARALLEL_DAG
    PARALLEL_DAG -->|"all steps done"| ORCHESTRATOR_ACTOR

    %% Planner HIL integration (LLM generates natural language for user)
    %% NOTE: All HIL LLM calls routed via LLM_REQUEST_BUS
    STAGE1_SKETCH -->|"need clarification"| REQUIREMENT_CLARIFICATION
    REQUIREMENT_CLARIFICATION -->|"clarification prompt (~300 tokens)"| LLM_REQUEST_BUS
    REQUIREMENT_CLARIFICATION -->|"user input"| STAGE1_SKETCH

    STAGE3_VALIDATE -->|"needs approval"| PLAN_APPROVAL
    PLAN_APPROVAL -->|"format options (~400 tokens)"| LLM_REQUEST_BUS
    PLAN_APPROVAL -->|"approved/modified"| STAGE3_VALIDATE

    ORCHESTRATOR_ACTOR -->|"execution status"| EXECUTION_MONITORING
    EXECUTION_MONITORING -->|"progress narration (~200 tokens)"| LLM_REQUEST_BUS
    EXECUTION_MONITORING -->|"user override"| ORCHESTRATOR_ACTOR

    ORCHESTRATOR_ACTOR -->|"Workflow Scheduling"| WORKFLOW_SCHEDULER
    WORKFLOW_SCHEDULER -->|"Workflow Triggers"| EVENT_BUS
    WORKFLOW_SCHEDULER -->|"Supervise Runs"| WORKFLOW_RUN_SUPERVISOR
    WORKFLOW_RUN_SUPERVISOR -->|"Run Manifest"| RUN_MANIFEST
    WORKFLOW_COMPILER -->|"Compile DAGs"| DAG_ENGINE
