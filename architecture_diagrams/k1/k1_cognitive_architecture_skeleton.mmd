    CONSTRAINT_MANAGER -->|"Load Graph"| CONSTRAINT_GRAPH
    CONSTRAINT_MANAGER -->|"Control Iterations"| ITERATION_CONTROLLER
    ITERATION_CONTROLLER -->|"Validate Solutions"| SOLUTION_VALIDATOR
    SOLUTION_VALIDATOR -->|"validation check (~500 tokens)"| LLM_REQUEST_BUS
    ITERATION_CONTROLLER -->|"Trigger HIL"| FALLBACK_TRIGGER
    FALLBACK_TRIGGER -->|"HIL prompt (~400 tokens)"| LLM_REQUEST_BUS
    FALLBACK_TRIGGER -->|"HIL Request"| PLANNER_HIL
    CONSTRAINT_MANAGER -->|"Validated Solution"| SAGA_RECOVERY
    CONSTRAINT_GRAPH -->|"Constraint State"| SESSIONSTATE_STORE
    ITERATION_CONTROLLER -->|"Iteration Count"| SESSIONSTATE_STORE
    MODEL_ROUTER -->|"API calls"| LLM_MODEL_ENGINE
    CONSTRAINT_MANAGER -->|"k1.constraint.progress.v1"| EVENT_BUS
    EVENT_BUS -->|"Progress Updates"| CONCIERGE_MAILBOX
    CONCIERGE_FSM -->|"PROGRESSING State"| COMPANIONING
    CONSTRAINT_MANAGER -->|"Constraint Conflict"| AFFECTIVE_MIRRORING_ENGINE
    AFFECTIVE_MIRRORING_ENGINE -->|"Adjust Tone"| CONCIERGE_FSM
    ITERATION_CONTROLLER -->|"Complexity Score"| L1_RHYTHM
    L1_RHYTHM -->|"Adjust Pacing"| CONCIERGE_FSM

    %% Cross-Kernel Bridge Connections (Bridge is at root level, not in K1)
    BRIDGE_CLIENT -->|"Learning Signals"| CAPABILITY_LEARNING_BRIDGE
    CAPABILITY_FABRIC -->|"k1.capability.invoked.v1"| EVENT_BUS
    EVENT_BUS -->|"Route capability events"| FABRIC_MAILBOX
