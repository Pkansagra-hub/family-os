    HITL_APPROVAL -->|"relay to Front"| CONCIERGE_FSM
    HITL_SELECTION -->|"relay to Front"| CONCIERGE_FSM
    HITL_SUBTASK -->|"stores react_snapshot"| HITL_MANAGER
    HITL_MULTI_DEVICE_DEDUP -->|"first response wins"| HITL_MANAGER
    CONCIERGE_FSM -->|"HITL_RELAY mode"| CLARIFYING_WORKER

