    MODULE_SCANNER -->|"registers"| TOOL_REGISTRY
    MODULE_SCANNER -->|"registers prompts"| PROMPT_REGISTRY
    MODULE_SCANNER -->|"registers agent templates"| AGENT_REGISTRY
    MODULE_SCANNER -->|"registers schemas"| SCHEMA_REGISTRY
    TOOL_REGISTRY -->|"exposes"| CAPABILITY_REGISTRY
    AGENT_REGISTRY -->|"templates"| AGENT_FACTORY
    AGENT_FACTORY -->|"spawns"| DYNAMIC_INSTANCES

    %% ======================================================================================
    %% PROMPT MANAGEMENT FLOWS
    %% All LLM calls go through Prompt Management before Model Gateway
    %% ======================================================================================

    %% Prompt Resolution: Consumer requests prompt by ID
    CONCIERGE_FSM -->|"request prompt: concierge.response"| PROMPT_RESOLVER
    PLANNER_AGENT -->|"request prompt: planner.sketch"| PROMPT_RESOLVER
    MEMORY_WRITER_AGENTS -->|"request prompt: memory.extract"| PROMPT_RESOLVER
    SOLUTION_VALIDATOR -->|"request prompt: validator.check"| PROMPT_RESOLVER
    PROACTIVE_DECISION -->|"request prompt: proactive.decide"| PROMPT_RESOLVER
    DYNAMIC_AGENTS -->|"request prompt: agent.{template}"| PROMPT_RESOLVER

    %% Prompt Resolution Pipeline
    PROMPT_RESOLVER -->|"lookup template"| PROMPT_TEMPLATE_STORE
    PROMPT_TEMPLATE_STORE -->|"template found"| PROMPT_VERSION_CONTROLLER
    PROMPT_VERSION_CONTROLLER -->|"versioned template"| PROMPT_VARIABLE_INJECTOR
    PROMPT_VARIABLE_INJECTOR -->|"read context"| SESSIONSTATE_STORE
    SESSIONSTATE_STORE -->|"session context"| PROMPT_VARIABLE_INJECTOR
    PROMPT_VARIABLE_INJECTOR -->|"inject variables"| PROMPT_COMPILER
    PROMPT_COMPILER -->|"compiled prompt"| MODEL_ROUTER

    %% Dynamic Agent Schema Registration (at spawn time)
    AGENT_FACTORY -->|"register agent schema"| SCHEMA_COMPILER
    SCHEMA_COMPILER -->|"compile FlatBuffer schema"| SCHEMA_REGISTRY
    AGENT_TEMPLATES -->|"schema reference"| SCHEMA_COMPILER

    %% ======================================================================================
    %% OUTPUT VALIDATION FLOWS
    %% All LLM responses go through Output Validation before returning to consumer
    %% ======================================================================================

    %% LLM Response → Validation Pipeline
    HUB_ROUTER -->|"raw LLM response"| OUTPUT_VALIDATOR

    %% 3-Tier Validation
    OUTPUT_VALIDATOR -->|"T1: parse"| TIER1_STRUCTURAL
    TIER1_STRUCTURAL -->|"parse success"| TIER2_SCHEMA
    TIER1_STRUCTURAL -->|"parse fail"| VALIDATION_FALLBACK

    OUTPUT_VALIDATOR -->|"lookup schema"| SCHEMA_REGISTRY
    SCHEMA_REGISTRY -->|"agent schema"| TIER2_SCHEMA
    TIER2_SCHEMA -->|"schema valid"| TIER3_SEMANTIC
    TIER2_SCHEMA -->|"schema fail"| VALIDATION_FALLBACK

    TIER3_SEMANTIC -->|"check facts"| HALLUCINATION_DETECTOR
    HALLUCINATION_DETECTOR -->|"cross-ref"| SESSIONSTATE_STORE
    SESSIONSTATE_STORE -->|"known facts"| HALLUCINATION_DETECTOR
    HALLUCINATION_DETECTOR -->|"hallucination score"| TIER3_SEMANTIC
    TIER3_SEMANTIC -->|"semantic valid"| OUTPUT_VALIDATOR
    TIER3_SEMANTIC -->|"semantic fail"| VALIDATION_FALLBACK

    %% Validation Fallback Strategies
    VALIDATION_FALLBACK -->|"retry (max 2)"| PROMPT_COMPILER
    VALIDATION_FALLBACK -->|"repair attempt"| OUTPUT_VALIDATOR
    VALIDATION_FALLBACK -->|"reject"| MODEL_METRICS

    %% Validated Response → Consumer
    OUTPUT_VALIDATOR -->|"validated response"| MODEL_ROUTER
    MODEL_ROUTER -->|"validated + cached"| CONCIERGE_FSM
    MODEL_ROUTER -->|"validated + cached"| PLANNER_AGENT
    MODEL_ROUTER -->|"validated + cached"| MEMORY_WRITER_AGENTS
    MODEL_ROUTER -->|"validated + cached"| DYNAMIC_AGENTS

    %% Core vs Generic Schema Selection
    CORE_OUTPUT_SCHEMA -->|"base fields"| TIER2_SCHEMA
    CONCIERGE_PAYLOAD_SCHEMA -->|"concierge fields"| TIER2_SCHEMA
    PLANNER_PAYLOAD_SCHEMA -->|"planner fields"| TIER2_SCHEMA
    MEMORY_PAYLOAD_SCHEMA -->|"memory fields"| TIER2_SCHEMA
    GENERIC_PAYLOAD_SCHEMA -->|"dynamic agent fields"| TIER2_SCHEMA

