    %% ======================================================================================
    CONNECTOR_GATEWAY -->|"Forward request"| IFL_FORWARDER
    IFL_FORWARDER -->|"Route to adapter"| IFL_HOMEKIT
    IFL_FORWARDER -->|"Route to adapter"| IFL_NEST
    IFL_FORWARDER -->|"Route to adapter"| IFL_TESLA
    IFL_FORWARDER -->|"Route to adapter"| IFL_SONOS
