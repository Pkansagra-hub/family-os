    %% MODEL_GATEWAY HUB (Consolidated LLM Access)
    %% All LLM consumers route through MODEL_GATEWAY → LLM_REQUEST_BUS → HUB_ROUTER
    %% Consumers: CONCIERGE_FSM, PLANNER_AGENT, DYNAMIC_AGENTS, MEMORY_WRITER_AGENTS,
    %%            PROACTIVE_DECISION, SOLUTION_VALIDATOR, CAPABILITY_FABRIC, Planner stages
    %% ======================================================================================

    %% LLM Request Bus (consolidates all LLM call sources)
    LLM_REQUEST_BUS["LLM Request Bus<br/>Consolidates: Concierge, Planner, Agents,<br/>Memory Writers, Validators, Fabric"]:::routing

    %% Primary LLM consumers → Request Bus
    CONCIERGE_FSM -->|"LLM request"| LLM_REQUEST_BUS
    PLANNER_AGENT -->|"LLM request"| LLM_REQUEST_BUS
    DYNAMIC_AGENTS -->|"LLM request"| LLM_REQUEST_BUS

    %% Request Bus → Model Gateway → Hub Router
    LLM_REQUEST_BUS -->|"route request"| MODEL_GATEWAY
    MODEL_GATEWAY -->|"Route to Providers"| HUB_ROUTER

    %% Model Gateway internal flow
    MODEL_ROUTER -->|"check cache"| MODEL_CACHE
    MODEL_CACHE -->|"cache miss"| HUB_ROUTER
    MODEL_CACHE -->|"cache hit"| MODEL_ROUTER
    MODEL_ROUTER -->|"track usage"| MODEL_METRICS
    HUB_ROUTER -->|"response"| MODEL_ROUTER

