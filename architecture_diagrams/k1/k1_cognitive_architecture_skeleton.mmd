    EMOTIONAL_PROCESSING -->|"emotional trajectory"| EMOTIONAL_MIRRORING
    EMOTIONAL_MIRRORING -->|"tone adjustments"| CONCIERGE_STYLE
    EMOTIONAL_MIRRORING -->|"update persona hints"| CONCIERGE_PERSONA

    DELIVERING -->|"turn_count % 20 == 0"| NARRATIVE_WEAVING
    NARRATIVE_WEAVING -->|"active threads"| CONVERSATIONAL_NARRATIVE_ENGINE
    NARRATIVE_WEAVING -->|"update session"| NARRATIVE_ACTIVE

    DELIVERING -->|"turn_count % 30 == 0"| ANTICIPATORY_RESPONSE
    ANTICIPATORY_RESPONSE -->|"predicted needs"| CONVERSATIONAL_ANTICIPATION_ENGINE
    ANTICIPATORY_RESPONSE -->|"prefetch context"| CAPABILITY_FABRIC
    CONVERSATIONAL_NARRATIVE_ENGINE -->|"Update Threads"| CONVERSATION_THREADS
    CONVERSATIONAL_NARRATIVE_ENGINE -->|"Update Arc"| NARRATIVE_ARC
    LLM_MODEL_ENGINE -->|"Route to Providers"| HUB_ROUTER
    HUB_ROUTER -->|"OpenAI API"| HUB_OPENAI
    HUB_ROUTER -->|"Anthropic API"| HUB_ANTHROPIC
    HUB_ROUTER -->|"Other APIs"| HUB_OTHERS
    DAG_ENGINE -->|"Complex Task"| CONSTRAINT_MANAGER
    CONSTRAINT_MANAGER -->|"Load Graph"| CONSTRAINT_GRAPH
    CONSTRAINT_MANAGER -->|"Control Iterations"| ITERATION_CONTROLLER
    ITERATION_CONTROLLER -->|"Validate Solutions"| SOLUTION_VALIDATOR
    ITERATION_CONTROLLER -->|"Trigger HIL"| FALLBACK_TRIGGER
    FALLBACK_TRIGGER -->|"HIL Request"| PLANNER_HIL
    CONSTRAINT_MANAGER -->|"Validated Solution"| SAGA_RECOVERY
    CONSTRAINT_GRAPH -->|"Constraint State"| SESSIONSTATE_STORE
    ITERATION_CONTROLLER -->|"Iteration Count"| SESSIONSTATE_STORE
    CONSTRAINT_MANAGER -->|"k1.constraint.progress.v1"| EVENT_BUS
    EVENT_BUS -->|"Progress Updates"| CONCIERGE_MAILBOX
    CONCIERGE_FSM -->|"PROGRESSING State"| COMPANIONING
    CONSTRAINT_MANAGER -->|"Constraint Conflict"| AFFECTIVE_MIRRORING_ENGINE
    AFFECTIVE_MIRRORING_ENGINE -->|"Adjust Tone"| CONCIERGE_FSM
    ITERATION_CONTROLLER -->|"Complexity Score"| L1_RHYTHM
    L1_RHYTHM -->|"Adjust Pacing"| CONCIERGE_FSM

    CAPABILITY_FABRIC -->|"k1.capability.invoked.v1"| EVENT_BUS
    EVENT_BUS -->|"Route capability events"| FABRIC_MAILBOX
    CAPABILITY_FABRIC -->|"k1.capability.completed.v1"| EVENT_BUS
    EVENT_BUS -->|"Notify completion"| CONCIERGE_MAILBOX

    %% ======================================================================================
    %% FABRIC POLICY ENGINE (Affects Provider Selection)
    %% ======================================================================================
    AFFECTIVE_NOW -->|"current emotion"| AFFECTIVE_ROUTING
    AFFECTIVE_ROUTING -->|"emotion-aware selection"| CAPABILITY_RESOLVER
    CONTROL -->|"cognitive load"| COGNITIVE_LOAD_ROUTING
    COGNITIVE_LOAD_ROUTING -->|"complexity-aware selection"| CAPABILITY_RESOLVER
