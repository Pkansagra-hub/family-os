    %% POC-VALIDATED: WEAVE POLICY EDGES (M8 Adaptive Delivery)
    %% ======================================================================================
    WEAVE_POLICY -->|"evaluate signals"| WEAVE_SIGNAL
    WEAVE_POLICY -->|"IMMEDIATE"| WEAVE_IMMEDIATE
    WEAVE_POLICY -->|"BATCH"| WEAVE_BATCH
    WEAVE_POLICY -->|"DEFER"| WEAVE_DEFER
    WEAVE_POLICY -->|"DIGEST"| WEAVE_DIGEST
