    SECURITY_CONTEXT -->|"band-based access"| CAPABILITY_RESOLVER
    CAPABILITY_RESOLVER -->|"selected provider"| CAPABILITY_FABRIC

    WORKFLOW_RUN_SUPERVISOR -->|"Execute via Fabric"| CAPABILITY_FABRIC
    WORKFLOW_COMPILER -->|"Compile to Capability DAG"| PROVIDER_MATCHER

    STATE_PENDING -->|"Via Fabric Spawn"| CAPABILITY_FABRIC
    CAPABILITY_FABRIC -->|"Create Agent Instance"| AGENT_PROVIDERS

    MCP_TOOL_DISCOVERY -->|"Discover Tools"| LOCAL_MCP_SERVERS
    MCP_TOOL_DISCOVERY -->|"Discover Remote Tools"| REMOTE_MCP_SERVERS
    REMOTE_MCP_SERVERS -->|"Cloud Routing"| K0_CONNECTOR_PROXY
    K0_CONNECTOR_PROXY -->|"Auth + Cache"| MCP_CAPABILITY_REGISTRAR
    LOCAL_MCP_SERVERS -->|"Expose Capabilities"| MCP_CAPABILITY_REGISTRAR
    MCP_CAPABILITY_REGISTRAR -->|"Register Capabilities"| CAPABILITY_REGISTRY
