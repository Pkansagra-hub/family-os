    K0_SSE_ENDPOINT -->|"Direct SSE"| PROACTIVE_DECISION

    MODEL_GATEWAY -->|"Route to Providers"| HUB_ROUTER
    %% Model Gateway internal flow
    MODEL_ROUTER -->|"check cache"| MODEL_CACHE
    MODEL_CACHE -->|"cache miss"| HUB_ROUTER
    MODEL_CACHE -->|"cache hit"| MODEL_ROUTER
    MODEL_ROUTER -->|"track usage"| MODEL_METRICS
    HUB_ROUTER -->|"response"| MODEL_ROUTER
    CAPABILITY_FABRIC -->|"LLM Access"| MODEL_GATEWAY
    CONCIERGE_FSM -->|"LLM Inference"| MODEL_GATEWAY
    PLANNER_AGENT -->|"LLM Inference"| MODEL_GATEWAY
    DYNAMIC_AGENTS -->|"LLM Calls"| MODEL_GATEWAY
    MEMORY_WRITER_AGENTS -->|"LLM Inference"| MODEL_GATEWAY
    PROACTIVE_DECISION -->|"LLM Analysis"| MODEL_GATEWAY
    SOLUTION_VALIDATOR -->|"LLM Validation"| MODEL_GATEWAY

    DISTRIBUTED_TRACING -->|"Trace Collection"| COGNITIVE_TRACE_ID
    METRICS_AGGREGATOR -->|"Aggregate Metrics"| SESSIONSTATE_STORE
