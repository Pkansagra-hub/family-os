graph TB
    subgraph UI["🎨 User Interface Layer"]
        ChatUI["Chat Interface<br/>Web/Mobile/Voice"]
    end
    
    subgraph L5["🔌 Layer 5: Infrastructure"]
        APIGateway["API Gateway<br/>TLS 1.3 + JWT Auth<br/>Rate Limiting<br/>Privacy Band Validation"]
        SSEPort["SSE Port :5202<br/>K0 Ticks & Events"]
    end
    
    subgraph L1["📥 Layer 1: Input Processing"]
        StreamSwitch["Stream Switch<br/>Text/Audio/Vision Normalization"]
        IntentRouter["Intent Router<br/>Rules → SLM → LLM<br/>50ms P95 Budget"]
        SessionStateBS["SessionState Bootstrap<br/>Metadata + Privacy Band"]
    end
    
    subgraph L2_Orch["🎯 Layer 2: Orchestration"]
        Concierge["🤖 Concierge Agent<br/>Tier 1 AI Agent<br/>Meta-intent Triage<br/>11 Classification Patterns"]
        
        Orchestrator["Orchestrator<br/>Pure Actor | Deterministic<br/>3-Phase Coordination"]
        
        CapabilityDir["CapabilityDirectory<br/>Scopes Broadcasts<br/>~10 bidders not 58"]
        
        Planner["🤖 Planner Agent<br/>Tier 2 AI Agent<br/>4-Stage Pipeline<br/>Sketch→Expand→Validate→Commit"]
    end
    
    subgraph L3_Exec["⚙️ Layer 3: Execution"]
        SpecAgents["Specialist Agents<br/>Healthcare, Finance<br/>Social, Research<br/>Created On-Demand"]
    end
    
    subgraph L4_State["💾 Layer 4: Session State"]
        SessionState["SessionState Actor<br/>6-Section Working Memory<br/>Beliefs | Scoreboard | Control<br/>Persona | Multimodal | Meta"]
        DeltaBus["DeltaBus<br/>In-Process Event Bus<br/>Field-Level Changes"]
    end
    
    subgraph L3_Writers["🎬 Tier 3: Writer Agents"]
        MemoryWriter["MemoryWriterAgent<br/>RECEIVES tasks from Planner<br/>READS SessionState<br/>KNOWS P05/P02/Semantic<br/>FORMATS deltas for K0"]
        
        LearningExt["LearningExtractorAgent<br/>RECEIVES learning tasks<br/>KNOWS P06 schema<br/>Extracts drift signals"]
        
        SemanticEnr["SemanticEnricherAgent<br/>RECEIVES enrichment tasks<br/>KNOWS KG schema<br/>Tags concepts & entities"]
    end
    
    subgraph Bridge["🌉 K0 Bridge Layer"]
        StateEmitter["state_delta_emitter<br/>Batches: 250ms/64KB/100-delta"]
        
        LaneRouter["lane_router (ADR-0049)<br/>GREEN band → Fast <50ms<br/>AMBER/RED → Smart <200ms"]
        
        CommandClient["command_client<br/>HTTP/2 FlatBuffers/JSON<br/>Dual-protocol support"]
    end
    
    subgraph Phase1["📋 PHASE 1: Key Additions"]
        Idempotency["✅ Idempotency Keys<br/>session_id+plan_hash+step_num<br/>K0 deduplicates"]
        
        ObservabilityBox["✅ Observability Export<br/>Prometheus: mailbox depth,<br/>contract-net rounds,<br/>Bridge QPS, K0 lag"]
        
        SSEAck["✅ SSE Ack Offsets<br/>Event IDs + sequence offsets<br/>Replay-to-last-ack"]
        
        SagaRecipe["✅ Saga Recipes<br/>Recipe ID → compensation steps<br/>Deterministic rollback"]
    end
    
    subgraph K0_Side["🧠 K0 Memory Kernel"]
        P05["K0 P05 Prospective<br/>Background Loop Every 1min<br/>Evaluates Triggers<br/>EMITS SSE TICKS"]
        
        P02["K0 P02 MemoryWrite<br/>Receives Writer deltas<br/>Stores episodic memories"]
        
        P06["K0 P06 Learning<br/>Receives learning signals<br/>Parameter updates"]
        
        Stores["K0 Multi-Store<br/>SQLite | Vector | KG<br/>Temporal deduplication"]
    end
    
    subgraph ProactiveAgent["🚀 K1 ProactiveAgent"]
        Listener["SSE Listener (Tier 3)<br/>Always-Listening on K0 Ticks<br/>Replays from last_ack on restart"]
    end
    
    %% UI Flow
    ChatUI -->|WebSocket/REST| APIGateway
    APIGateway --> L1
    
    %% Layer 1 → Layer 2
    StreamSwitch --> IntentRouter
    IntentRouter --> SessionStateBS
    SessionStateBS --> Concierge
    
    %% Concierge routes
    Concierge -->|task_intent| Orchestrator
    Concierge -->|meta_intent| Concierge
    
    %% Orchestrator flow with CapabilityDirectory
    Orchestrator --> CapabilityDir
    CapabilityDir -->|scoped bids| SpecAgents
    CapabilityDir -->|queries| Orchestrator
    
    %% Orchestrator → Planner (if needed)
    Orchestrator -->|route for planning| Planner
    Planner --> Orchestrator
    
    %% Execution & Writers
    Orchestrator -->|AWARD| SpecAgents
    SpecAgents -->|results| Orchestrator
    
    %% Planner sends tasks to Writers
    Planner -->|TASK| MemoryWriter
    Planner -->|TASK| LearningExt
    Planner -->|TASK| SemanticEnr
    
    %% SessionState & Writers
    SpecAgents -->|read| SessionState
    MemoryWriter -->|read| SessionState
    LearningExt -->|read| SessionState
    SemanticEnr -->|read| SessionState
    
    SessionState -->|deltas| DeltaBus
    DeltaBus -->|subscribe| MemoryWriter
    DeltaBus -->|subscribe| LearningExt
    DeltaBus -->|subscribe| SemanticEnr
    
    %% Writers → Bridge
    MemoryWriter -->|idempotency_key| StateEmitter
    LearningExt -->|idempotency_key| StateEmitter
    SemanticEnr -->|idempotency_key| StateEmitter
    
    StateEmitter --> LaneRouter
    LaneRouter --> CommandClient
    
    %% K0 Bridge → K0
    CommandClient -->|POST P02| P02
    CommandClient -->|POST P06| P06
    CommandClient -->|POST P05| P05
    
    P02 --> Stores
    P06 --> Stores
    P05 --> Stores
    
    %% K0 → K1 SSE Ticks
    P05 -->|SSE TICKS| SSEPort
    SSEPort -->|prospective.trigger.fired| Listener
    SSEPort -->|prospective.pattern.detected| Listener
    
    %% ProactiveAgent processes ticks
    Listener -->|RECEIVES tick| Listener
    Listener -->|ack_offset| SSEPort
    Listener -->|action| APIGateway
    APIGateway -->|notification| ChatUI
    
    %% Phase 1 Callouts
    Phase1 -->|ref| Idempotency
    Phase1 -->|ref| ObservabilityBox
    Phase1 -->|ref| SSEAck
    Phase1 -->|ref| SagaRecipe
    
    %% Styling
    classDef phase1Color fill:#90EE90,stroke:#2d5016,color:#000
    classDef aiAgent fill:#FFB6C1,stroke:#8B0000,color:#fff
    classDef pureActor fill:#87CEEB,stroke:#000080,color:#fff
    classDef k0Color fill:#DDA0DD,stroke:#4B0082,color:#fff
    classDef bridge fill:#F0E68C,stroke:#8B8B00,color:#000
    
    class Concierge,Planner aiAgent
    class Orchestrator,MemoryWriter,LearningExt,SemanticEnr,CapabilityDir pureActor
    class P05,P02,P06,Stores k0Color
    class StateEmitter,LaneRouter,CommandClient bridge
    class Idempotency,ObservabilityBox,SSEAck,SagaRecipe phase1Color
