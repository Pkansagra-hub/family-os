---
config:
  layout: elk
---
flowchart TB

    %% ======================================================================
    %% THE DUMB-LLM PRINCIPLE
    %% ======================================================================
    DUMB_LLM["An LLM cannot plan from information it does not have.
It cannot infer a check it was never told to perform.
Knowledge lives on the connector contract, not in the prompt."]
    DUMB_LLM -.->|"this axiom governs everything below"| RULES

    %% ======================================================================
    %% RULES
    %% ======================================================================
    subgraph RULES["Eight Non-Negotiable Rules"]
        direction LR
        R1["1. No action without a permission ticket (binding_id)"]
        R2["2. No side effect without policy approval"]
        R3["3. No done without proof it worked"]
        R4["4. The AI never sees raw internals"]
        R5["5. All options must be considered before acting"]
        R6["6. Every failure is a typed error, never None"]
        R7["7. Safety bands are split, not one ambiguous field"]
        R8["8. Budget limits produce clear outcomes, never silence"]
    end

    %% ======================================================================
    %% L0 - TIER ROUTING
    %% ======================================================================
    subgraph L0["Tier Routing"]
        FRONT["Front Actor. Captures what the user wants."]:::talk
        FSM["FSM State Authority. Organizes the task into a standard format."]:::gate
        TG["Tier Gate. LOW=Front talks, MEDIUM=Back single-pass, HIGH=Planner DAG."]:::gate
        T1["Tier 1: Just Talk (Front). No tool access. May escalate."]:::talk
        T2["Tier 2: Back LLM (SINGLE-PASS). Extract, resolve ONCE, execute plan, verify, submit."]:::do
        T3["Tier 3: Planner + Orchestrator. Multi-step cross-resource DAG."]:::plan
    end
    FRONT --> FSM
    FSM --> TG
    TG -->|"conversation"| T1
    TG -->|"single action"| T2
    TG -->|"multi-step plan"| T3
    RULES -.->|"governs"| L0

    %% ======================================================================
    %% L1 - BACK LLM: Extract Intent + Resolve ONCE
    %% ======================================================================
    subgraph L1["Back LLM: Extract Intent then Resolve ONCE"]
        ENV["Parse Task Envelope. Validates: task_id, actor, safety band, budget. Code: BackTaskEnvelope."]:::intake
        BUDGET_IN["Check Budget. max_iterations, max_fabric_calls, max_prompt_tokens. Code: ExecutionBudget."]:::intake
        FRAME["LLM Extraction to RequestFrame. operation_hint: create|list|update|delete. resource_kind_hint: calendar_event|chore|meal_plan. subject_hint, params: person_hint+time_hint. person_refs, resource_refs, time_window_hint. Code: RequestFrame."]:::intake

        RESOLVER["resolve_situation(frame) - ONE CALL. ResolveSituationService.resolve(). Code: k1/fabric/resolver/situated_resolver.py."]:::resolver

        R1_RES["1. Resource Resolution. Alias lookup, connected resources, household members, scope proof. -> candidate_universe."]:::resolver
        R2_TYP["2. Type Resolution. 4-step graph: operation, concept, resource_family, typed capability. -> intent_resolutions."]:::resolver
        R3_POL["3. Policy Selection (ADVISORY). Role check, safety band, HIL conditions, prerequisite reads from constitution. -> policy_bundle (machine recommendation, NOT enforcement)."]:::policy
        R4_BIND["4. Capability Binding. 3-pass discovery: typed > exact > BM25. Constitution-driven prereq+companion. required_inputs+optional_inputs DENORMALIZED on every binding. -> binding_bundle (primary+prerequisites+verifiers)."]:::binding
        R5_EXEC["5. Constitution + execution_plan. constitution_loader.load(connector_id). _build_execution_plan(): prereq,primary,verifier. Each step: capability_name, required_inputs[], optional_inputs[], resource_id, depends_on[], completed. 13-step cascade -> machine_verdict (ADVISORY ONLY). verdict retained for backward compat. -> constitution + execution_plan."]:::resolver
    end
    T2 --> ENV
    ENV -.->|"budget limits"| BUDGET_IN
    ENV -->|"LLM extraction"| FRAME
    FRAME -->|"Step 5"| RESOLVER
    RESOLVER --> R1_RES --> R2_TYP --> R3_POL --> R4_BIND --> R5_EXEC

    %% ======================================================================
    %% ENVELOPE - The complete 23-key wire contract
    %% ======================================================================
    subgraph ENVELOPE["ResolutionEnvelope.to_dict() - 23 keys, NOTHING withheld"]
        direction TB
        E_ID["identity: resolution_id, request_id."]:::resolver
        E_VERDICT["verdict surface: verdict, machine_verdict (advisory), sub_reason."]:::resolver
        E_PLAN["EXECUTION_PLAN (the single-pass artifact that kills re-resolve). Ordered steps: prereq(read),primary(mutate),verifier(verify). Each step: capability_name, binding_id, resource_id, required_inputs[], optional_inputs[], depends_on[], completed. depends_on encodes read-before-write and verify-after-write. ALWAYS fully populated regardless of gate verdict."]:::new_approach
        E_INFO["FULL info surface (previously withheld from to_dict). request_frame (intents+user values+time_window). candidate_universe (resource_candidates+person_candidates+unresolved). intent_resolutions (typed intent to capability mapping). policy_bundle (verdict,gates,hil_triggers,roles_allowed). binding_bundle (primary+prereqs+companions+verifiers+unbound_roles). constitution (execution_phases, prerequisite_reads, hil_gates, mutation_sequencing, verification_requirements, degradation_policy)."]:::resolver
        E_OTHER["authorization: allowed_next_actions, allowed_capability_names, capability_name_to_binding, hil_request, recovery_directive, diagnostics, completeness, freshness, prompt_pack, created_at, expires_at."]:::resolver
    end
    R5_EXEC --> E_PLAN
    R1_RES --> E_INFO
    R2_TYP --> E_INFO
    R3_POL --> E_INFO
    R4_BIND --> E_INFO
    R5_EXEC --> E_INFO

    %% ======================================================================
    %% BACK LLM REASONING - The brain reads the envelope and self-plans
    %% ======================================================================
    subgraph BACK_REASON["Back LLM: Reads envelope then Self-plans then Executes"]
        BACK_READ["Back reads the FULL envelope. 1. execution_plan: ordered steps with depends_on. 2. constitution: rules for read-before-write, HIL gates, verification. 3. request_frame.intents[].params: user-provided VALUES. 4. candidate_universe.resource_candidates: resolved resource IDs. 5. binding_bundle: every bound capability with required_inputs. 6. policy_bundle: advisory policy verdict+gates."]:::loop

        BACK_PLAN["Back self-plans. I have step 1 (prereq read) and step 2 (primary write). Step 2 depends_on step 1. Constitution says execution_phases=[read,mutate]. Constitution says prerequisite_reads require read-before-write. I will run step 1, check its result against hil_gates, then run step 2. No second resolve call needed - the plan is already complete."]:::loop

        BACK_EXEC["Back executes the plan IN ORDER. For each uncompleted step in execution_plan: 1. Map required_inputs names to values from request_frame.intents[].params + candidate_universe. 2. Construct CapabilityRequest with capability_name + params. 3. Call fabric.execute(CapabilityRequest). 4. Check result against constitution.hil_gates. 5. If gate fires: suspend with needs_human (NOT re-resolve). 6. If verification required: run verifier step from plan. 7. Mark step completed, proceed to next."]:::do

        BACK_SUBMIT["After all steps: submit_result(completed). If HIL suspended: submit_result(needs_human). If blocked: submit_result(cannot_execute, reason)."]:::submit
    end
    E_PLAN --> BACK_READ
    E_INFO --> BACK_READ
    E_VERDICT --> BACK_READ
    BACK_READ --> BACK_PLAN
    BACK_PLAN --> BACK_EXEC
    BACK_EXEC -->|"all steps done"| BACK_SUBMIT
    BACK_EXEC -->|"HIL gate fired"| HIL_HUMAN

    %% ======================================================================
    %% HIL - Human in the Loop (Back-driven, NOT resolver-driven)
    %% ======================================================================
    subgraph HIL["Human-in-the-Loop (Back self-checks, NOT resolver)"]
        HIL_HUMAN["Back suspends with needs_human. Back reads constitution.hil_gates to build the prompt. Back presents options from candidate_universe. Human provides missing field or disambiguation choice. Back resumes: re-runs SAME execution_plan. Completed steps are skipped (completed=true). NO re-resolve needed: the plan did not change."]:::verdict_hil
    end
    BACK_EXEC -->|"ambiguous person or resource"| HIL_HUMAN
    HIL_HUMAN -->|"human answers"| BACK_EXEC

    %% ======================================================================
    %% FABRIC EXECUTION
    %% ======================================================================
    subgraph FABRIC_EXEC["fabric.execute() - 9-step pipeline"]
        PF["fabric internal preflight. 1. Emit k1.capability.invoked event. 2. Resolve provider from contract. 3. Conscience gate (social act check). 4. HIL gate (fabric-level pre-execution). 5. Build context (params+session+trace). 6. Instantiate provider. 7. Execute via CircuitBreaker. 8. Validate output (structural,schema,semantic). 9. Emit completed/failed event + learning signal."]:::exec
        NA["Native Tools (SQLite). Calendar, Chores, Meals, Tasks, Shopping."]:::do
        BR["Bridge Adapters. External services via bridge ports."]:::exec
    end
    BACK_EXEC -->|"CapabilityRequest"| PF
    PF -->|"resolve"| NA
    PF -->|"resolve"| BR

    %% ======================================================================
    %% VERIFICATION
    %% ======================================================================
    subgraph VERIFY["Verification (constitution-driven)"]
        V_CHK["Back reads constitution.verification_requirements. If method=read_after_write: Back re-runs the prereq read step from execution_plan. Compares result with what was written. If verified: submit_result(completed). If mismatch: recovery or needs_human."]:::verify
    end
    FABRIC_EXEC -->|"CapabilityResult"| V_CHK
    V_CHK -->|"verified"| BACK_SUBMIT
    V_CHK -->|"mismatch"| HIL_HUMAN

    %% ======================================================================
    %% STORES
    %% ======================================================================
    subgraph STORES["Data Stores"]
        SG["GlobalProjectionStore. 182 capabilities, 50 connectors, 11 tables + FTS5."]:::store
        SL["LocalProjectionStore. Connected resources, household members, alias index, projection snapshots. Freshness: fresh|stale|unknown."]:::store
        SI["IdempotencyStore. State machine: not_seen,in_flight,succeeded|failed. Duplicate returns prior result."]:::store
    end
    R1_RES -.->|"reads"| SL
    R2_TYP -.->|"reads"| SG
    R3_POL -.->|"reads policy+constitution"| SG
    R4_BIND -.->|"reads capabilities"| SG
    R5_EXEC -.->|"reads constitution"| SG
    PF -.->|"idempotency check"| SI

    %% ======================================================================
    %% AMBIGUITY handling
    %% ======================================================================
    subgraph AMBIGUITY["Ambiguity: Exposed, NOT resolved by the resolver"]
        AD["Alias Lookup. Query alias_index WHERE name=Riley. Exact match first. Fuzzy only if exact returns nothing."]:::resolver
        ADQ{"How many matches?"}
        AD1["1 match: Resolved. person_id, linked resources, role."]:::verdict_go
        AD2["2+ matches: AMBIGUOUS. candidate_universe.unresolved populated. candidate_universe.person_candidates populated. Back shows the human the options. NOT a resolver decision."]:::verdict_hil
        AD0["0 matches: NOT FOUND. candidate_universe.unresolved populated. Back asks human to clarify."]:::verdict_hil
        RES_R["Resource Lookup. Same pattern for family calendar. active? accessible? admitted connector?"]:::resolver
    end
    R1_RES --> AD
    AD --> ADQ
    ADQ -->|"1"| AD1 --> RES_R
    ADQ -->|"2+"| AD2
    ADQ -->|"0"| AD0
    AD2 -->|"exposed in envelope"| BACK_READ
    AD0 -->|"exposed in envelope"| BACK_READ

    %% ======================================================================
    %% POLICY detail
    %% ======================================================================
    subgraph POLICY_DETAIL["Policy: ADVISORY, not enforcement"]
        RC["Role Check. Parent can create events. Child cannot write to family calendar. policy_bundle.policy_verdict=deny (advisory)."]:::policy
        SC["Safety Band Check. capability.safety_band_min: GREEN < AMBER < RED. policy_bundle with safety_mapping_evidence."]:::policy
        PC["Prerequisite Reads (constitution). Constitution says: list_events before create_event. binding_bundle.prerequisites populated. execution_plan step 2 depends_on step 1."]:::policy
    end
    R3_POL --> RC
    R3_POL --> SC
    R3_POL --> PC

    %% ======================================================================
    %% BINDING detail
    %% ======================================================================
    subgraph BINDING_DETAIL["CapabilityBinding: Complete tool contract (25 fields)"]
        BIND_FIELDS["Every CapabilityBinding: capability_name, connector_id, invocation_mode, action_name, effect, resource_kind, resource_id, role (primary|companion|prereq|verifier|alternative), confidence, source (typed_intent|exact_match|bm25_search), REQUIRED_INPUTS[] (denormalized from CapabilityRecord), OPTIONAL_INPUTS[] (denormalized from CapabilityRecord), authority_verdict, binding_id, freshness_state, effect_summary, safety_requirement, limitations."]:::binding
    end
    R4_BIND --> BIND_FIELDS

    %% ======================================================================
    %% VERDICT TAXONOMY
    %% ======================================================================
    subgraph TX["10 Verdicts (advisory machine_verdict)"]
        direction LR
        TX1["can_execute"]:::verdict_go
        TX2["can_execute_with_gate"]:::verdict_go
        TX3["needs_disambiguation"]:::verdict_hil
        TX4["missing_required_params"]:::verdict_hil
        TX5["promote_to_tier3"]:::verdict_hil
        TX6["blocked_by_policy"]:::verdict_block
        TX7["stale_projection"]:::verdict_block
        TX8["missing_capability"]:::verdict_block
        TX9["cannot_execute"]:::verdict_block
        TX10["needs_hil"]:::verdict_hil
    end

    %% ======================================================================
    %% HAPPY PATH - Single-pass end-to-end
    %% ======================================================================
    subgraph HP["Happy Path: Add Riley dentist appointment next Monday 3pm"]
        direction LR
        H1["1. Front dispatches to Back (MEDIUM tier)."]:::happy
        H2["2. Back LLM extracts: create calendar_event, Riley, Mon 3pm."]:::happy
        H3["3. resolve_situation ONCE: ResolutionEnvelope."]:::happy
        H4["4. execution_plan: step1=list_events(read), step2=create_event(write). step2.depends_on=[step1.binding_id]."]:::happy
        H5["5. Back runs step 1: list_events(time_min=Mon, time_max=Tue). No conflicts."]:::happy
        H6["6. Back runs step 2: create_event(title, start=Mon 3pm, end=Mon 4pm). INSERT."]:::happy
        H7["7. Constitution says verify: read_after_write. Back runs list_events again. Confirms event exists. submit_result(completed)."]:::happy
    end
    H1 --> H2 --> H3 --> H4 --> H5 --> H6 --> H7

    %% ======================================================================
    %% CLASS DEFS
    %% ======================================================================
    classDef gate fill:#1a1a2e,stroke:#e94560,stroke-width:2,color:#eee
    classDef talk fill:#2a2a1e,stroke:#f77f00,stroke-width:2,color:#eee
    classDef do fill:#1a2a2e,stroke:#4cc9f0,stroke-width:2,color:#eee
    classDef plan fill:#1a2e2e,stroke:#00b4d8,stroke-width:2,color:#eee
    classDef intake fill:#1e1a1e,stroke:#7209b7,stroke-width:2,color:#eee
    classDef resolver fill:#1a1a3e,stroke:#533483,stroke-width:2,color:#eee
    classDef policy fill:#1a2a1e,stroke:#2d6a4f,stroke-width:2,color:#eee
    classDef binding fill:#2a1a1e,stroke:#c77dff,stroke-width:2,color:#eee
    classDef verdict_go fill:#1a3a1e,stroke:#06d6a0,stroke-width:2.5,color:#eee
    classDef verdict_hil fill:#3a3a1e,stroke:#ffd166,stroke-width:2.5,color:#eee
    classDef verdict_block fill:#3a1a1a,stroke:#e71d36,stroke-width:2.5,color:#eee
    classDef loop fill:#1e1a2a,stroke:#4361ee,stroke-width:2,color:#eee
    classDef exec fill:#1a2a2e,stroke:#4cc9f0,stroke-width:2,color:#eee
    classDef verify fill:#2e2a1e,stroke:#ffd166,stroke-width:2,color:#eee
    classDef submit fill:#1a2e1e,stroke:#06d6a0,stroke-width:2,color:#eee
    classDef store fill:#1e1e1e,stroke:#6c757d,stroke-width:1.5,color:#aaa
    classDef happy fill:#1a3a1e,stroke:#06d6a0,stroke-width:3,color:#0f0
    classDef new_approach fill:#1a2e1a,stroke:#06d6a0,stroke-width:2.5,color:#0f0
