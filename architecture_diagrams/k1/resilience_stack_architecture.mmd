%% K1 Resilience Stack Architecture Diagram
%% Component-level diagram for k1/l5_infrastructure/resilience/
%% Research Foundation:
%% - Circuit Breaker Pattern ( Nygard 2011)
%% - Exponential Backoff (Varghese 2005)
%% - Hot Reload (Unix inotify, watchdog)
%% Related ADRs: ADR-0009b (Hot Reload), ADR-0080 (Config Hot-Reload)
%% Performance: <100ms reload latency, <10ms circuit breaker decisions

graph TB
    %% External Components
    subgraph "Infrastructure Components"
        CMD_CLIENT["CommandClient<br/>K0 Bridge"]
        SSE_CLIENT["SSEClient<br/>K0 Bridge"]
        HTTP_REQ["HTTP Requests<br/>External APIs"]
        FILE_WATCH["Config Files<br/>*.yml, *.yaml"]
    end

    %% Resilience Stack Core
    subgraph "Resilience Stack [k1/l5_infrastructure/resilience/]"
        CIRCUIT["CircuitBreaker<br/>3-State FSM"]
        RETRY["RetryPolicy<br/>Exponential Backoff"]
        HOT_RELOAD["HotReloadManager<br/>File Watcher"]
    end

    %% Circuit Breaker Components
    subgraph "Circuit Breaker [circuit_breaker.py]"
        CB_FSM["CircuitBreakerFSM<br/>CLOSED→OPEN→HALF_OPEN"]
        CB_CONFIG["CircuitBreakerConfig<br/>failure_threshold: 3<br/>timeout_s: 60<br/>probe_requests: 3"]
        CB_METRICS["CircuitBreakerMetrics<br/>state_changes_total<br/>failures_total<br/>successes_total"]
        CB_DECIDE["decide()<br/>Fail-Fast Logic"]
        CB_RECORD["record_success()<br/>record_failure()"]
    end

    %% Retry Policy Components
    subgraph "Retry Policy [retry_policy.py]"
        RP_CONFIG["RetryPolicyConfig<br/>max_retries: 5<br/>base_delay_ms: 100<br/>max_delay_ms: 5000<br/>jitter: True"]
        RP_CLASSIFY["FailureClassifier<br/>TRANSIENT/PERMANENT/AMBIGUOUS"]
        RP_BACKOFF["ExponentialBackoff<br/>delay = base * 2^attempt<br/>+ jitter"]
        RP_BUDGET["RetryBudget<br/>remaining_attempts<br/>total_attempts"]
        RP_EXECUTE["execute_with_retry()<br/>Async Retry Loop"]
    end

    %% Hot Reload Components
    subgraph "Hot Reload [hot_reload.py]"
        HR_WATCHER["FileSystemWatcher<br/>watchdog library<br/>*.yml, *.yaml"]
        HR_VALIDATOR["ConfigValidator<br/>JSON Schema<br/>Semantic Rules"]
        HR_ROLLBACK["RollbackManager<br/><200ms rollback<br/>Atomic Updates"]
        HR_CALLBACKS["CallbackSystem<br/>change_callbacks<br/>reload_callbacks"]
        HR_QUEUE["ChangeQueue<br/>AsyncIO Queue<br/>Debounced Changes"]
    end

    %% Observability Integration
    subgraph "Observability Integration"
        METRICS["Prometheus Metrics<br/>circuit_breaker_state<br/>retry_attempts_total<br/>config_reloads_total"]
        TRACING["OpenTelemetry Spans<br/>circuit_breaker_decide<br/>retry_execute<br/>config_reload"]
        LOGGING["Structured Logs<br/>state_transitions<br/>retry_attempts<br/>validation_errors"]
    end

    %% Data Flow - Circuit Breaker
    CMD_CLIENT -->|"HTTP request"| CIRCUIT
    SSE_CLIENT -->|"SSE connect"| CIRCUIT
    CIRCUIT -->|"CLOSED: allow"| CB_DECIDE
    CIRCUIT -->|"OPEN: fail-fast"| CB_DECIDE
    CIRCUIT -->|"HALF_OPEN: probe"| CB_DECIDE
    CB_DECIDE -->|"success/failure"| CB_RECORD
    CB_RECORD -->|"update state"| CB_FSM

    %% Data Flow - Retry Policy
    CB_DECIDE -->|"transient failure"| RETRY
    HTTP_REQ -->|"connection error"| RETRY
    RETRY -->|"classify failure"| RP_CLASSIFY
    RP_CLASSIFY -->|"TRANSIENT"| RP_BACKOFF
    RP_BACKOFF -->|"calculate delay"| RP_EXECUTE
    RP_EXECUTE -->|"retry with backoff"| CMD_CLIENT
    RP_EXECUTE -->|"retry with backoff"| SSE_CLIENT

    %% Data Flow - Hot Reload
    FILE_WATCH -->|"file modified"| HR_WATCHER
    HR_WATCHER -->|"queue change"| HR_QUEUE
    HR_QUEUE -->|"debounce + validate"| HR_VALIDATOR
    HR_VALIDATOR -->|"valid: apply"| HR_ROLLBACK
    HR_VALIDATOR -->|"invalid: rollback"| HR_ROLLBACK
    HR_ROLLBACK -->|"notify components"| HR_CALLBACKS

    %% Internal Architecture
    CIRCUIT -->|"uses"| CB_CONFIG
    CIRCUIT -->|"manages"| CB_FSM
    CIRCUIT -->|"tracks"| CB_METRICS

    RETRY -->|"uses"| RP_CONFIG
    RETRY -->|"classifies with"| RP_CLASSIFY
    RETRY -->|"backoff via"| RP_BACKOFF
    RETRY -->|"budgets with"| RP_BUDGET
    RETRY -->|"executes"| RP_EXECUTE

    HOT_RELOAD -->|"watches with"| HR_WATCHER
    HOT_RELOAD -->|"validates with"| HR_VALIDATOR
    HOT_RELOAD -->|"rollbacks with"| HR_ROLLBACK
    HOT_RELOAD -->|"notifies via"| HR_CALLBACKS
    HOT_RELOAD -->|"queues in"| HR_QUEUE

    %% Observability Flow
    CIRCUIT -->|"emits"| METRICS
    RETRY -->|"emits"| METRICS
    HOT_RELOAD -->|"emits"| METRICS

    CIRCUIT -->|"spans"| TRACING
    RETRY -->|"spans"| TRACING
    HOT_RELOAD -->|"spans"| TRACING

    CIRCUIT -->|"logs"| LOGGING
    RETRY -->|"logs"| LOGGING
    HOT_RELOAD -->|"logs"| LOGGING

    %% Performance Notes
    note1["<b>Performance Budget:</b><br/>• Circuit Breaker: <10ms decisions<br/>• Retry: <100ms backoff calc<br/>• Hot Reload: <100ms reload<br/>• Rollback: <200ms max<br/>• All async/non-blocking"]
    note1 -.-> CIRCUIT

    %% Architecture Notes
    note2["<b>Architecture:</b><br/>• Circuit Breaker: 3-state FSM<br/>• Retry: Exponential backoff + jitter<br/>• Hot Reload: File watcher + validation<br/>• All components: Async-first design<br/>• Comprehensive observability"]
    note2 -.-> RETRY

    %% Integration Notes
    note3["<b>Integration:</b><br/>• Circuit Breaker wraps HTTP/SSE clients<br/>• Retry Policy used by circuit breaker<br/>• Hot Reload updates all configs<br/>• All share observability stack<br/>• Zero-downtime config updates"]
    note3 -.-> HOT_RELOAD
