---
config:
  layout: elk
---
flowchart TB

BUS["K1 Bus\none physical transport"]

subgraph EL["Event lane (k1.*)"]
  direction TB
  E1["k1.response.*"]
  E2["k1.hil.*"]
  E3["k1.capability.*"]
  E4["k1.planner.plan.*"]
  E5["k1.fabric.*"]
  E6["k1.session.*"]
end

subgraph DL["Delta lane (k1.*.delta.v1) - STRICT"]
  direction TB
  D1["k1.agent.{id}.delta.v1"]
  D2["k1.planner.delta.v1"]
  D3["k1.orchestration.delta.v1"]
  D4["k1.memory.delta.v1"]
end

BUS --> EL
BUS --> DL

subgraph PUB["Publishers"]
  direction TB
  P1["Concierge\nresponse + turn.complete"]
  P2["Orchestrator\nprogress + orchestration deltas"]
  P3["Planner\nplan lifecycle + planner deltas"]
  P4["Fabric/agents\ncapability events + agent deltas"]
end

subgraph SUB["Subscribers"]
  direction TB
  S1["Concierge\nsubscribes deltas + HIL responses"]
  S2["Orchestrator\nsubscribes planner/HIL/events"]
  S3["Planner\nsubscribes plan requests + HIL responses"]
  S4["Memory Writer\nsubscribes turn.complete"]
  S5["Learning Loop\nsubscribes turn.complete + quality signals"]
end

P1 --> BUS
P2 --> BUS
P3 --> BUS
P4 --> BUS
BUS --> S1
BUS --> S2
BUS --> S3
BUS --> S4
BUS --> S5

subgraph QoS["QoS model"]
  direction TB
  Q1["STRICT: critical state/event ordering"]
  Q2["RELAXED: control-plane events"]
  Q3["BEST_EFFORT: telemetry/learning"]
end

EL --> QoS
DL --> Q1

subgraph WFQ["WFQ Scheduler"]
  direction TB
  W1["URGENT weight=4"]
  W2["REALTIME weight=3"]
  W3["INTERACTIVE weight=2"]
  W4["BACKGROUND weight=1"]
end

BUS --> WFQ

subgraph MBR["Mailbox Router"]
  direction TB
  M1["CONCIERGE mailbox\npriority queue URGENT->BACKGROUND"]
  M2["ORCHESTRATOR mailbox\npriority queue URGENT->BACKGROUND"]
  M3["PLANNER mailbox\npriority queue URGENT->BACKGROUND"]
  BP["Backpressure\nURGENT bumps old BG\nINTERACTIVE may drop if full"]
end

WFQ --> MBR

classDef b fill:#e3f2fd,stroke:#1565c0,stroke-width:2px;
classDef e fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px;
classDef d fill:#fff3e0,stroke:#ef6c00,stroke-width:2px;
class BUS b;
class E1,E2,E3,E4,E5,E6,P1,P2,P3,P4,S1,S2,S3,S4,S5 e;
class D1,D2,D3,D4,Q1,Q2,Q3 d;
