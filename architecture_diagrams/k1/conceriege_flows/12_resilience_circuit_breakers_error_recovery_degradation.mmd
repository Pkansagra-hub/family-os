---
config:
  layout: elk
---
flowchart TB

subgraph CB["Circuit breakers"]
  direction TB
  CBM["CB_MODEL\nprovider-level"]
  CBO["CB_ORCHESTRATOR"]
  CBP["CB_PLANNER"]
  CBF["CB_FABRIC"]
  CBX["CB_MCP"]
  CBS["CB_SESSIONSTATE"]
  CBE["CB_SSE"]
end

subgraph AD["Adapters emitting classified errors"]
  direction TB
  A1["UltraBERT adapter\nRECOVERABLE -> heuristic fallback"]
  A2["Model gateway\nDEGRADED -> canned response\nTERMINAL after repeated failures"]
  A3["Session adapter\nRECOVERABLE reject write\nDEGRADED stale read"]
  A4["Fabric/Orchestrator adapter\nDEGRADED partial results + tier degrade"]
  A5["Output adapter\nRECOVERABLE retry/buffer"]
  A6["Delta adapter\nRECOVERABLE log+skip"]
  A7["Bridge recall adapter\nRECOVERABLE skip memory"]
end

subgraph REC["Recovery policy"]
  direction TB
  R1["RECOVERABLE\nretry/fallback in same phase"]
  R2["DEGRADED\ncontinue to DELIVERING with partial"]
  R3["TERMINAL\ndeliver error/canned response"]
end

subgraph VALFB["Validation fallback policy"]
  direction TB
  V1["T1 fail -> immediate reject"]
  V2["T2 fail -> retry<=2 with schema hints"]
  V3["T3 fail -> repair/warn/retry once"]
end

subgraph DEG["Tier degradation cascade"]
  direction TB
  D1["HIGH fail -> MEDIUM"]
  D2["MEDIUM fail -> LOW"]
  D3["LOW fail -> canned"]
end

subgraph CAN["Canned response store"]
  direction TB
  C1["ack"]
  C2["prelim_ack"]
  C3["clarify"]
  C4["low"]
  C5["med"]
  C6["high"]
  C7["crisis static"]
end

A1 --> R1
A2 --> R2
A2 --> R3
A3 --> R1
A3 --> R2
A4 --> R2
A5 --> R1
A6 --> R1
A7 --> R1

R2 --> D1 --> D2 --> D3 --> CAN
R3 --> CAN
V1 --> R3
V2 --> R1
V3 --> R2
CAN --> OUT["DELIVERING -> OUTPUT_CHANNEL"]

subgraph HSTAT["Provider health states"]
  direction TB
  H1["HEALTHY -> full routing weight"]
  H2["DEGRADED -> 50% routing weight"]
  H3["UNHEALTHY -> failover / bypass"]
  H4["RECOVERING -> gradual ramp-up"]
end

CBF --> HSTAT
CBM --> HSTAT

CBM -.protects.-> A1
CBM -.protects.-> A2
CBO -.protects.-> A4
CBP -.protects.-> A4
CBF -.protects.-> A4
CBX -.protects.-> A4
CBS -.protects.-> A3
CBE -.protects.-> A5

classDef cb fill:#ffebee,stroke:#c62828,stroke-width:2px;
classDef ad fill:#e3f2fd,stroke:#1565c0,stroke-width:2px;
classDef rc fill:#fff3e0,stroke:#ef6c00,stroke-width:2px;
classDef can fill:#fffde7,stroke:#f9a825,stroke-width:2px;
class CBM,CBO,CBP,CBF,CBX,CBS,CBE cb;
class A1,A2,A3,A4,A5,A6,A7,OUT ad;
class R1,R2,R3,D1,D2,D3 rc;
class C1,C2,C3,C4,C5,C6,C7,CAN can;
