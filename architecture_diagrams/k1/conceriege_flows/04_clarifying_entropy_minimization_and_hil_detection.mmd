---
config:
  layout: elk
---
flowchart TB

A["ACKING uncertainty >= 0.2"] --> Q["Question planner\nentropy-minimizing progressive disclosure"]
Q --> C["CLARIFYING state"]

subgraph CQ["Clarification question generation"]
  direction TB
  Q1["Max 1-2 questions/turn"]
  Q2["Max 300 tokens"]
  Q3["Ask highest information gain field first"]
  Q4["Avoid repeating already-resolved slots"]
end

C --> Q1
C --> Q2
C --> Q3
C --> Q4
C --> TMO["Timeout policy\n5 min reminder, no silent stall"]

C --> OUT["emit k1.response.clarification.v1\nvia OUTPUT_CHANNEL"]

U["User response"] --> DET["HIL response detector"]

subgraph HIL["HIL correlation logic"]
  direction TB
  PEND["Pending clarifications store\nkey: request_id + originator + agent_id?"]
  LSTATE["Planner loop states\nAWAITING_REQUIREMENTS / AWAITING_APPROVAL / EXECUTING_WITH_MONITORING"]
  R1["If request_id matches active HIL -> route response"]
  R2["planner clarification_response"]
  R3["planner approval_response"]
  R4["orchestrator fallback_response"]
  R5["orchestrator override_response"]
  R6["clear pending entry on successful route"]
end

DET --> PEND
PEND --> LSTATE
DET --> R1
R1 -->|"planner clarification"| R2
R1 -->|"planner approval"| R3
R1 -->|"orchestrator fallback"| R4
R1 -->|"orchestrator override"| R5
R2 --> R6
R3 --> R6
R4 --> R6
R5 --> R6

EVT["Feedback events\nk1.hil.clarification_response.v1\nk1.hil.approval_response.v1\nk1.hil.fallback_response.v1\nk1.hil.override_response.v1"]
R2 --> EVT
R3 --> EVT
R4 --> EVT
R5 --> EVT

R6 --> A2["Return to ACKING\nre-classify with new evidence"]

FAIL["Max clarification rounds reached (3)"] --> ESC["Escalate\nDEGRADED best-effort or HIL fallback"]

classDef s fill:#fff3e0,stroke:#ef6c00,stroke-width:2px;
classDef h fill:#e8eaf6,stroke:#3949ab,stroke-width:2px;
class A,Q,C,OUT,U,DET,A2,FAIL,ESC s;
class PEND,R1,R2,R3,R4,R5,R6,Q1,Q2,Q3,Q4 h;
