---
config:
  layout: elk
---
flowchart TB

FSM["Concierge FSM"]

L["LISTENING\nwait input"]
A["ACKING\nUltraBERT + uncertainty"]
C["CLARIFYING\nentropy-min question"]
D["DISPATCHING\nLOW llm tool loop\nMED/HIGH envelope"]
CO["COMPANIONING\npreliminary ack"]
P["PROGRESSING\nstream deltas/progress"]
DE["DELIVERING\nfinal response + turn close"]
I["INTERRUPT_HANDLING\ntopic change / cancel"]
HIL["HIL_WAIT\nawait planner/orchestrator/user responses"]

FSM --> L
L -->|"user_input"| A
A -->|"uncertainty >= 0.2"| C
A -->|"uncertainty < 0.2"| D
C -->|"user_response"| A
C -->|"planner/orchestrator request"| HIL
HIL -->|"response correlated by request_id"| A
D -->|"LOW direct result"| DE
D -->|"MED/HIGH accepted"| CO
CO -->|"delta updates"| P
P -->|"execution completed"| DE
DE -->|"user ack / next turn"| L

L -->|"interrupt"| I
D -->|"interruptible"| I
CO -->|"interruptible"| I
P -->|"interruptible"| I
I -->|"re-classify"| A

CR["CRISIS override\nSafety gate first\nbypasses routing"]
A -->|"safety_band=CRISIS"| CR
CR -->|"static crisis response"| DE

R20["turn_count % 20 == 0\nthread analysis / narrative update"]
R25["turn_count % 25 == 0\nemotional trajectory + mirroring"]
R30["turn_count % 30 == 0\nanticipation + prefetch"]
DE --> R20
DE --> R25
DE --> R30

INV1["Invariant: single writer to SessionState"]
INV2["Invariant: no bypass of OUTPUT_CHANNEL"]
INV3["Invariant: transition logic no external I/O"]
INV4["Invariant: max one active turn/session"]
INV5["Invariant: HIL responses routed by request_id + originator"]

FSM -.enforces.-> INV1
FSM -.enforces.-> INV2
FSM -.enforces.-> INV3
FSM -.enforces.-> INV4
FSM -.enforces.-> INV5

classDef st fill:#fff3e0,stroke:#ef6c00,stroke-width:2px;
classDef inv fill:#fce4ec,stroke:#ad1457,stroke-width:2px;
class L,A,C,D,CO,P,DE,I,CR,HIL,R20,R25,R30 st;
class INV1,INV2,INV3,INV4,INV5 inv;
