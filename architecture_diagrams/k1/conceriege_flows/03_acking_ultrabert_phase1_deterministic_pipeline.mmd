---
config:
  layout: elk
---
flowchart TB

IN["User input text"] --> CLS["IClassificationPort -> UltraBERT v4\n12 heads single forward pass (~22ms)"]

subgraph H["Head outputs"]
  direction TB
  HI["Intent head\nintents[] + scores{}"]
  HD["Ingress/domain head\ndomains[]"]
  HS["Safety head\nGREEN/AMBER/RED/CRISIS"]
  HE["Emotions head\n44 classes"]
  HSE["Sentiment head"]
  HN["NER head\nPERSON/ORG/LOC/TIME/DATE/DURATION"]
  HR["Relations head"]
end

CLS --> HI
CLS --> HD
CLS --> HS
CLS --> HE
CLS --> HSE
CLS --> HN
CLS --> HR

HS --> SG["Safety gate first"]
SG -->|"CRISIS"| CR["Crisis static response path"]
SG -->|"not crisis"| CMPLX["Complexity classifier"]

HI --> MIS["Multi-intent scorer"] --> CMPLX
HD --> CDD["Cross-domain detector"] --> CMPLX
HE --> CMPLX
HS --> CMPLX

CMPLX -->|"single intent + single domain"| TL["LOW"]
CMPLX -->|"multi-intent OR multi-domain"| TM["MEDIUM"]
CMPLX -->|"complex + emotional"| TH["HIGH"]

HN --> TP["Temporal parser/resolver + timezone"]
HN --> LP["Location resolver + place registry + motion classifier"]
HI --> HY["Hypothesis generator"]
HD --> HY
HY --> GAP["Contract/signal gap detector"]
GAP --> SIG["Signal library"]
SIG --> QP["Entropy-min question planner"]

HN --> CI["Context inference"]
HR --> CI
GAP --> CI
CI --> SA["Tiny sanity arbiter"] --> UE["Uncertainty estimator"]
HI --> UE
UE -->|">=0.2"| QP
UE -->|"<0.2"| READY["Ready for dispatch"]

AFFEV["emit k1.affect.analyzed.v1\npriority=URGENT"]
HE --> AFFEV
AFFEV --> WFQ["EventBus WFQ\nURGENT queue first"]
WFQ --> MIR["Emotional mirroring + routing bias"]
MIR --> READY

subgraph PH1["Phase 1 deterministic writes (not tool calls)"]
  direction TB
  W1["affective_now"]
  W2["beliefs_active"]
  W3["control.safety_band"]
  W4["control.intents + control.domains"]
  W5["temporal/spatial context"]
end

HE --> W1
HN --> W2
HS --> W3
HI --> W4
HD --> W4
TP --> W5
LP --> W5

CAP["Cognitive capacity estimate\n(ToM + load routing)"]
HE --> CAP
HSE --> CAP
CAP --> READY

classDef n fill:#e3f2fd,stroke:#1565c0,stroke-width:2px;
classDef w fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px;
classDef g fill:#fff3e0,stroke:#ef6c00,stroke-width:2px;
class HI,HD,HS,HE,HSE,HN,HR,TP,LP,HY,GAP,SIG,CI,SA,UE,MIS,CDD,CMPLX n;
class W1,W2,W3,W4,W5 w;
class SG,CR,TL,TM,TH,QP,READY g;
