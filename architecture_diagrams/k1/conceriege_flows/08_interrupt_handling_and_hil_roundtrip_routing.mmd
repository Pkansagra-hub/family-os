---
config:
  layout: elk
---
flowchart TB

INT["Interrupt signal or user mid-turn change"] --> CHECK["Interrupt check at await boundaries"]
CHECK -->|"state interruptible\n(DISPATCHING/COMPANIONING/PROGRESSING)"| IH["INTERRUPT_HANDLING"]
CHECK -->|"state non-interruptible"| REQ["Re-enqueue interrupt in mailbox"]

IH --> CXL["Cancel in-flight dispatch where possible"]
IH --> ABBR["turn_end_abbreviated\nrelease lock + checkpoint local"]
ABBR --> ACK["Re-enter ACKING for fresh classification"]

subgraph HILIN["Inbound HIL events"]
  direction TB
  H1["k1.hil.clarification.v1"]
  H2["k1.hil.approval_request.v1"]
  H3["k1.hil.fallback.v1"]
  H4["k1.hil.progress.v1"]
  H5["k1.hil.correction.received.v1"]
  H6["k1.hil.preference.captured.v1"]
end

H1 --> OUT["OUTPUT_CHANNEL"]
H2 --> OUT
H3 --> OUT
H4 --> OUT
H5 --> OUT
H6 --> OUT

subgraph HILOUT["User response routing back to originator"]
  direction TB
  D["HIL response detector"]
  PEND["pending_clarifications\nkey: request_id, originator, agent_id?"]
  R1["k1.hil.clarification_response.v1 -> Planner"]
  R2["k1.hil.approval_response.v1 -> Planner"]
  R3["k1.hil.fallback_response.v1 -> Orchestrator"]
  R4["k1.hil.override_response.v1 -> Orchestrator"]
  R5["sub-agent response via delta lane\nroute by agent_id match"]
  ORC["orchestrator user loop\npriority/resource/fallback decisions"]
  SUBA["sub-agent user loop\ndomain clarifications + recovery options"]
end

USR["User message while HIL active"] --> D
D --> PEND
D --> R1
D --> R2
D --> R3
D --> R4
D --> R5
R3 --> ORC
R4 --> ORC
R5 --> SUBA
R1 --> CLR["clear pending entry"]
R2 --> CLR
R3 --> CLR
R4 --> CLR
R5 --> CLR

classDef c fill:#fff3e0,stroke:#ef6c00,stroke-width:2px;
classDef h fill:#e8eaf6,stroke:#3949ab,stroke-width:2px;
classDef o fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px;
class INT,CHECK,IH,REQ,CXL,ABBR,ACK,USR c;
class H1,H2,H3,H4,D,PEND,R1,R2,R3,R4,R5,CLR h;
class OUT o;
