---
config:
  layout: elk
---
flowchart TB

LLM["ILLMPort TOOL_CALL output"] --> TD["ToolDispatcher"]

subgraph GATE["Pre-execution gates"]
  direction TB
  G1["State gate\nallowed tools by FSM state"]
  G2["Tier gate\nLOW/MED/HIGH capability policy"]
  G3["Safety gate\nband-based restrictions"]
  G4["Schema gate\nparam validation + type coercion"]
  G5["Budget gate\ntool-call count cap (20/turn)"]
end

TD --> G1 --> G2 --> G3 --> G4 --> G5
G5 --> ROUTE["Route to tool class"]

subgraph TC["Tool classes"]
  direction TB
  COG["Cognitive tools\nupdate_scoreboard/update_beliefs/update_clarifications\nupdate_narrative/refine_affect/promote_belief"]
  READ["Read tools\nrecall_memory/discover_capabilities/summarize_context"]
  ACT["Action tools\ninvoke_capability/spawn_via_fabric/execute_workflow"]
  SIG["Signal tool\nacknowledge_request"]
end

ROUTE --> COG
ROUTE --> READ
ROUTE --> ACT
ROUTE --> SIG

COG --> MG["MutationGuard.preflight(section,op,data)"]
MG -->|"approved"| SW["IStatePort write (single writer path)"]
MG -->|"rejected"| RJ["log + skip write (recoverable)"]

READ --> ROK["read-only adapters\nno side effects"]
ACT --> FAB["IDispatchPort -> Fabric/Orchestrator"]
SIG --> OUT["IOutputPort immediate emit"]

SPEC["Speculative executor gate\nexecute only if confidence>0.75\nread-only + low-cost + no side effects"]
READ --> SPEC
SPEC --> ROK

HLTH["Provider health weighting\nHEALTHY/DEGRADED/UNHEALTHY/RECOVERING"]
ACT --> HLTH --> FAB

subgraph BOUND["Prompt injection boundary"]
  direction TB
  B1["LLM text is non-operative"]
  B2["Only validated tool_call can act"]
  B3["No direct SessionState mutation from plain text"]
end

TD -.enforces.-> B1
TD -.enforces.-> B2
MG -.enforces.-> B3

classDef n fill:#e3f2fd,stroke:#1565c0,stroke-width:2px;
classDef g fill:#fff3e0,stroke:#ef6c00,stroke-width:2px;
classDef t fill:#fffde7,stroke:#f9a825,stroke-width:2px;
classDef b fill:#fce4ec,stroke:#ad1457,stroke-width:2px;
class LLM,TD,ROUTE n;
class G1,G2,G3,G4,G5,MG,RJ g;
class COG,READ,ACT,SIG,SW,ROK,FAB,OUT t;
class B1,B2,B3 b;
