  ERR_RECOVER["RECOVERABLE\nretry/fallback in same phase\nExamples:\n- MutationGuard rejects write -> skip\n- Memory recall timeout -> respond without\n- SSE delivery fails -> retry + buffer\n- Delta publish fails -> log + skip"]:::error
  ERR_DEGRADE["DEGRADED\ncontinue to DELIVERING with partial results\nExamples:\n- LLM CB half-open -> wait 30s probe\n- Orchestrator timeout -> degrade tier\n- SessionState read timeout -> stale cache"]:::error
  ERR_TERMINAL["TERMINAL\nerror response to DELIVERING\nExamples:\n- 3 consecutive LLM failures -> canned response\n- All degradation exhausted -> static fallback"]:::error

  TIER_DEGRADE["TIER DEGRADATION CASCADE\nHIGH fails -> MED (skip planning)\nMED fails -> LOW (no tools, conversational only)\nLOW fails -> CANNED response\n---\n7 canned responses by call_type:\nack, prelim_ack, clarify, LOW, MED, HIGH, CRISIS"]:::error

