  LLM_REQUEST["LLM Request Bus\nCapability-tagged HubRequest envelope\n{capability: CHAT+TOOL_CALL\n model_preference: from manifest\n budget: {max_tokens: 2000, timeout_ms: 30000}}"]:::routing
  PROMPT_SYS["Prompt System (Fabric-owned)\nResolve -> Version -> Inject -> Compile\n---\nTemplate vars from SessionState:\npersona, beliefs, scoreboard, history\nCompiled prompt: ~800 tokens system + context"]:::engine
  MODEL_HUB_EXEC["Model Hub\nCapability-driven plugin architecture\nProvider selected by manifest routing\nCapabilities: CHAT, TOOL_CALL, STRUCTURED\n---\nCircuit Breaker: CB_MODEL\nLLM_CASCADE: L1 retry, L2 half-open, L3 canned"]:::gateway

  LLM_REQUEST --> PROMPT_SYS --> MODEL_HUB_EXEC
end

DELIVER_LLM -->|"ILLMPort.execute(HubRequest)\nvia ModelGatewayAdapter"| LLM_REQUEST

%% ------------------------------------------------------------------------------------
%% STEP 20: OUTPUT VALIDATION PIPELINE
%% ------------------------------------------------------------------------------------

subgraph STEP20_VALIDATION["STEP 20: Output Validation Pipeline (T+13500ms)"]
  direction TB

  VAL_T1["T1: FORMAT (<1ms, sync)\nValid text? YES\nWithin max_tokens (2K)? YES (1847 tokens)\nNo template markers? YES\n---\nFAIL action: retry LLM once, 2 max"]:::validation
  VAL_T2["T2: SAFETY (<5ms, sync)\nNo PII leakage? YES\nNo prompt injection echo? YES\nContent policy? PASS\n---\nFAIL action: strip flagged, regen if >50%"]:::validation
  VAL_T3["T3: BELIEF CONSISTENCY (<50ms, async)\nResponse claims vs beliefs_active?\nRecipe prices match price_check results? YES\nNut-free claim matches dietary filter? YES\nNo contradictions detected\n---\nFAIL action: strip contradictions, retry w/ reduced ctx"]:::validation

  VAL_T1 -->|"PASS"| VAL_T2 -->|"PASS"| VAL_T3
end

MODEL_HUB_EXEC -->|"LLM response"| VAL_T1

%% Validation failure paths
VAL_T1 -->|"T1 FAIL"| RETRY_T1["Retry LLM with format hints\n(max 2 retries)"]:::error
VAL_T2 -->|"T2 FAIL"| RETRY_T2["Strip flagged content\nRegenerate if >50% stripped\nFinal fallback: canned response"]:::error
VAL_T3 -->|"T3 FAIL"| RETRY_T3["Strip contradictions\nRetry with reduced context\nAccept stripped + caveat if still fails"]:::error
RETRY_T1 -.-> DELIVER_LLM
RETRY_T2 -.-> DELIVER_LLM
RETRY_T3 -.-> FSM_DELIVER

