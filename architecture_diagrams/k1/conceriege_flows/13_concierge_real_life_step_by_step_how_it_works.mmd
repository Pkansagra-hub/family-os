  OUT_DELIVER["OutputManager.enqueue(event, REALTIME)\n-> IOutputPort.send(OutputEvent)\n-> SSEOutputAdapter\n-> OUTPUT_CHANNEL\n-> WebSocket/SSE frame to user"]:::output

  OUT_FINAL --> OUT_DELIVER
end

VAL_T3 -->|"ALL PASS\nvalidated response"| OUT_FINAL

