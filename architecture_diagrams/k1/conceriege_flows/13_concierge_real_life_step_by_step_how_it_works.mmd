```mermaid.flowchart
---
config:
  layout: elk
---
flowchart TB

%% =====================================================================================
%% CONCIERGE REAL-LIFE STEP-BY-STEP: How Every Component Works
%% =====================================================================================
%% Traces a REAL user message end-to-end through every component.
%% Example: "I need a healthy dinner plan for tonight under $30"
%% Shows: all FSM states, UltraBERT heads, safety gate, complexity router,
%%   temporal/spatial resolution, hypothesis pipeline, context inference,
%%   uncertainty estimation, LLM tools (cognitive/read/action/signal),
%%   ports, adapters, SessionState writes, output system, delta aggregation,
%%   orchestrator/planner/fabric, HIL, circuit breakers, error recovery,
%%   memory writer, learning loop, experience layer, rhythm controller.
%% =====================================================================================

%% ------------------------------------------------------------------------------------
%% STEP 1: USER INPUT ARRIVES
%% ------------------------------------------------------------------------------------

U["USER\n'I need a healthy dinner plan\nfor tonight under $30'\n(T+0ms)"]:::user

subgraph STEP1_INGRESS["STEP 1: Input Ingress (T+0ms)"]
  direction TB

  WS_INPUT["WebSocketInputAdapter\n(IInputPort production binding)\nRESTInputAdapter also available"]:::adapter
  MAILBOX["Concierge Private Mailbox\nActor: async event loop, 1 task/session\nMPSC Queue, WFQ drain order\n---\nPriority: REALTIME(3) > INTERACTIVE(2) > BACKGROUND(1)\nThis message: REALTIME priority"]:::mailbox
  FSM_LISTEN["FSM: LISTENING\ntrace_id = uuid4()\nsession_id bound\nWaiting for input"]:::state
end

U -->|"websocket frame"| WS_INPUT
WS_INPUT -->|"IInputPort.receive()\nk1.concierge.user_input"| MAILBOX
MAILBOX -->|"WFQ drain: REALTIME first\nuser_input dequeued"| FSM_LISTEN

%% ------------------------------------------------------------------------------------
%% STEP 2: FSM TRANSITION TO ACKING
%% ------------------------------------------------------------------------------------

FSM_LISTEN -->|"FSMController.transition(ACKING)\n<= 1ms, no I/O (INV-13)"| FSM_ACKING

subgraph STEP2_TURN_START["STEP 2: Turn Start (T+1ms)"]
  direction TB

  FSM_ACKING["FSM: ACKING\nTurnProcessor.start_turn(msg)\n---\n1. Acquire Single Writer lock (lock_version++)\n2. Increment turn_sequence_number\n3. Read HOT snapshot (all 8 sections)\n4. Reset: ToolDispatcher.clear_buffer()\n   ClarificationTracker.reset_turn()\n   ContextAssembler.reset_budget()\n5. Allocate tier budget envelope"]:::state
end

%% ------------------------------------------------------------------------------------
%% STEP 3: ULTRABERT PHASE 1 -- 22ms Single Forward Pass
%% ------------------------------------------------------------------------------------

FSM_ACKING -->|"IClassificationPort.classify(text)\nvia UltraBERTv4Adapter"| ULTRABERT_FWD

subgraph STEP3_ULTRABERT["STEP 3: UltraBERT Phase 1 -- Pre-LLM (T+1ms to T+23ms)"]
  direction TB

  ULTRABERT_FWD["UltraBERT v4 Core\nModernBERT-base 149M params\nSingle forward pass, 12 heads parallel\n22ms total"]:::ultrabert

  subgraph UB_HEADS["12 Classification Heads (parallel output)"]
    direction TB

    HEAD_INTENT["Intent Head V2 (MULTI-LABEL)\n8 classes\nResult: primary=meal_planning\nall=[meal_planning, budget_check]\nscores={meal_planning:0.91, budget_check:0.72}"]:::ultrabert
    HEAD_INGRESS["Ingress Head V2 (MULTI-LABEL)\n12 domains\nResult: domains=[HEALTH, FINANCE]\nThreshold: above 0.4"]:::ultrabert
    HEAD_SAFETY["Safety Head\n4 bands: GREEN/AMBER/RED/CRISIS\nResult: GREEN\n(no crisis keywords detected)"]:::ultrabert
    HEAD_EMOTION["Emotions Head\n44 classes\nResult: anxiety=0.35, stress=0.42\nprimary=slightly_stressed"]:::ultrabert
    HEAD_SENTIMENT["Sentiment Head\n5 levels\nResult: slightly_negative (budget concern)"]:::ultrabert
    HEAD_NER["NER Head (GlobalPointer)\nPERSON, ORG, LOC, TIME, DATE, DURATION\nResult: TIME='tonight', CURRENCY='$30'"]:::ultrabert
    HEAD_RELATIONS["Relations Head\nspouse_of, parent_of, works_at...\nResult: none detected"]:::ultrabert
  end

  ULTRABERT_FWD --> UB_HEADS
end

%% ------------------------------------------------------------------------------------
%% STEP 4: SAFETY GATE -- ALWAYS FIRST (INV-05, INV-06, INV-07)
%% ------------------------------------------------------------------------------------

subgraph STEP4_SAFETY["STEP 4: Safety Gate -- FIRST, Before Any Routing (T+23ms)"]
  direction TB

  CRISIS_CHECK["Crisis Detector\nChecks safety_band from Safety Head\nCRISIS = immediate protocol bypass\n---\nThis message: GREEN\nNo crisis, proceed normally"]:::safety
  SAFETY_WRITE["Write CONTROL.safety_band = GREEN\nto SessionState (deterministic, Phase 1)\nvia IStatePort -> MutationGuard.preflight()"]:::write
end

HEAD_SAFETY -->|"safety_band = GREEN"| CRISIS_CHECK
CRISIS_CHECK -->|"GREEN: safe to proceed"| SAFETY_WRITE

%% CRISIS path (not taken here but shown)
CRISIS_PATH["CRISIS path (if RED/CRISIS):\nBypass ALL routing\nEmit CRISIS_STATIC hardcoded string\nzero dependencies, absolute last resort\n'If you or someone you know is in crisis...'\nDirect to OUTPUT_CHANNEL"]:::crisis_note
CRISIS_CHECK -.->|"CRISIS band would go here"| CRISIS_PATH

%% ------------------------------------------------------------------------------------
%% STEP 5: PARALLEL PROCESSING PIPELINES (T+23ms to T+30ms)
%% ------------------------------------------------------------------------------------

subgraph STEP5_PARALLEL["STEP 5: Parallel Processing Pipelines (T+23ms to T+30ms)"]
  direction TB

  subgraph COMPLEXITY_ROUTING["5A: Complexity Router V2 (Multi-Factor)"]
    direction TB

    MULTI_INTENT["Multi-Intent Scorer\nlen(intents)=2 + intent_types\n-> complexity bump"]:::router
    CROSS_DOMAIN["Cross-Domain Detector\nlen(domains)=2 (HEALTH+FINANCE) > 1\n-> complexity bump"]:::router
    CLASSIFIER["Complexity Classifier\nprimary_intent + multi_factors + safety + emotion\n---\nFactors: 2 intents, 2 domains, GREEN safety,\nmoderate emotion -> MEDIUM tier"]:::router

    MULTI_INTENT --> CLASSIFIER
    CROSS_DOMAIN --> CLASSIFIER
  end

  subgraph HYPOTHESIS_PIPELINE["5B: Hypothesis and Gap Detection"]
    direction TB

    HYPO_GEN["Hypothesis Generator\nReceives explicit multi-intent:\n[meal_planning, budget_check]\nGenerates hypotheses for EACH intent"]:::engine
    GAP_DETECT["Contract and Signal Gap Detector\nUnion of ALL intent requirements:\nmeal_planning needs: meal_type, servings, dietary\nbudget_check needs: amount (have=$30), items\n---\nMISSING: servings, dietary_preference"]:::engine
    SIG_LIB["Signal Library\nChecks: pronouns? NO, conflicts? NO\nmulti-entities? NO, time vagueness? MAYBE\n(tonight = when exactly?)"]:::engine

    HYPO_GEN --> GAP_DETECT --> SIG_LIB
  end

  subgraph TEMPORAL_ENGINE["5C: Temporal Resolution Engine"]
    direction TB

    TIME_PARSE["Time Parser\nNER: TIME='tonight', CURRENCY='$30'\nParsed: tonight -> temporal token"]:::engine
    TIME_RESOLVE["Time Resolver\nRelative -> Absolute\n'tonight' -> 2026-02-16T18:00-22:00\nUSER_TZ from device/profile"]:::engine
    TZ_CTX["Timezone Context\nUser TZ: America/New_York\nSource: device GPS + profile"]:::engine
    TEMP_ANCHOR["Temporal Anchor\nnow=2026-02-16T14:30, today, tonight\nResolved: dinner window 18:00-22:00"]:::engine

    TIME_PARSE --> TIME_RESOLVE
    TZ_CTX --> TIME_RESOLVE
    TIME_RESOLVE --> TEMP_ANCHOR
  end

  subgraph SPATIAL_ENGINE["5D: Spatial Context Engine (ADR-0085)"]
    direction TB

    LOC_INGRESS["Location Ingress\nGPS + Wi-Fi signal from device\nRaw: lat=40.7128, lng=-74.0060"]:::engine
    LOC_RESOLVE["Location Resolver\nRaw coords -> semantic place\nlat/lng -> 'home' (matched Place Registry)"]:::engine
    PLACE_REG["Place Registry\nLearned: home, work, gym\nMatch: within 50m of 'home' geofence"]:::engine
    MOTION_CLASS["Motion Classifier\nAccelerometer + GPS delta\nResult: STATIONARY"]:::engine
    SPACE_ANCHOR["Spatial Anchor\ncurrent_place='home'\nlast_transition=14:00 (arrived home)\ndwell_time=30min"]:::engine

    LOC_INGRESS --> LOC_RESOLVE
    LOC_RESOLVE --> PLACE_REG
    PLACE_REG --> LOC_RESOLVE
    LOC_RESOLVE --> SPACE_ANCHOR
    MOTION_CLASS --> SPACE_ANCHOR
  end

  subgraph CONTEXT_FILL["5E: Context Inference and Validation"]
    direction TB

    CTX_INFER["Context Inference\nSessionState fill + entity resolution\n---\nFrom NER: entities=[tonight, $30]\nFrom SessionState: family_size=3 (prior belief)\nFrom Spatial: location=home (has kitchen)\nSlot fill: amount=$30, time=tonight"]:::engine
    SANITY_ARB["Tiny Sanity Arbiter (Fast Path)\nUltraBERT + cached checks\n---\nCheck: $30 for dinner? Plausible.\nCheck: tonight for meal? Valid.\nVerdict: PASS, no contradictions"]:::engine

    CTX_INFER --> SANITY_ARB
  end

  subgraph UNCERTAINTY_EST["5F: Uncertainty Estimation and Clarification"]
    direction TB

    UNCERT["Uncertainty Estimator\nUltraBERT confidence scores:\nintent=0.91, domain=0.87\n---\nMISSING_SIGNALS from Gap Detector:\nservings=UNKNOWN, dietary=UNKNOWN\ntime_ambiguity=LOW (tonight=clear enough)\n---\nFinal uncertainty: 0.28 (>= 0.2 threshold)"]:::engine
    ENTROPY_Q["Entropy-Minimizing Question Planner\nProgressive disclosure: 1-2 Qs max\n---\nBest question (max info gain):\n'How many people, and any dietary preferences?'\n(covers 2 gaps in 1 question)"]:::engine

    UNCERT --> ENTROPY_Q
  end
end

HEAD_INTENT -->|"intents[] + scores{}"| MULTI_INTENT
HEAD_INGRESS -->|"domains[]"| CROSS_DOMAIN
HEAD_SAFETY -->|"safety_band"| CLASSIFIER
HEAD_EMOTION -->|"emotion_intensity"| CLASSIFIER

HEAD_INTENT -->|"intents[] explicit"| HYPO_GEN
HEAD_INGRESS -->|"domains[] for context"| HYPO_GEN

HEAD_NER -->|"TIME/DATE/DURATION"| TIME_PARSE
HEAD_NER -->|"LOC entities"| LOC_RESOLVE

HEAD_NER -->|"entities"| CTX_INFER
HEAD_RELATIONS -->|"relations"| CTX_INFER
GAP_DETECT -->|"slot_fill_request"| CTX_INFER
SIG_LIB -->|"time_ambiguity flag"| ENTROPY_Q

SANITY_ARB -->|"verdict + flags"| UNCERT
HEAD_INTENT -->|"confidence_score"| UNCERT

%% ------------------------------------------------------------------------------------
%% STEP 6: PHASE 1 DETERMINISTIC WRITES TO SESSIONSTATE
%% ------------------------------------------------------------------------------------

subgraph STEP6_PHASE1_WRITES["STEP 6: Phase 1 Writes -- Deterministic, NOT LLM (T+25ms)"]
  direction TB

  W_CONTROL["Write CONTROL\nintents=[meal_planning, budget_check]\ndomains=[HEALTH, FINANCE]\ntemporal_context={tonight, 18:00-22:00}"]:::write
  W_AFFECT["Write AFFECTIVE_NOW\nprimary_emotion=slightly_stressed\nvalence=-0.2, arousal=0.4\ntone_hint=empathetic"]:::write
  W_BELIEFS["Write BELIEFS_ACTIVE\nentities: $30 budget, tonight dinner\nrelations: none new\nprovenance: UltraBERT Phase 1"]:::write
  W_SPATIAL["Write MULTIMODAL.spatial_context\ncurrent_place=home\nmotion=STATIONARY\ndwell=30min"]:::write

  W_ALL_NOTE["All writes via IStatePort\n-> SessionKernelAdapter\n-> MutationGuard.preflight()\n-> Approved -> SQLite write\nLatency: 0.02ms per write"]:::note
end

HEAD_EMOTION -->|"update AFFECTIVE_NOW"| W_AFFECT
HEAD_NER -->|"update BELIEFS_ACTIVE"| W_BELIEFS
TEMP_ANCHOR -->|"update CONTROL.temporal_context"| W_CONTROL
SPACE_ANCHOR -->|"update MULTIMODAL.spatial_context"| W_SPATIAL
SAFETY_WRITE --> W_CONTROL

%% ------------------------------------------------------------------------------------
%% STEP 7: DECISION POINT -- CLARIFY OR DISPATCH?
%% ------------------------------------------------------------------------------------

subgraph STEP7_DECISION["STEP 7: Routing Decision (T+28ms)"]
  direction TB

  UNCERT_CHECK{"Uncertainty >= 0.2?\n(score = 0.28)"}:::decision
  TIER_CHECK{"Complexity Tier?\n(result = MEDIUM)"}:::decision
end

UNCERT -->|"uncertainty=0.28"| UNCERT_CHECK
CLASSIFIER -->|"tier=MEDIUM"| TIER_CHECK

%% ------------------------------------------------------------------------------------
%% STEP 8: CLARIFYING (uncertainty was 0.28 >= 0.2)
%% ------------------------------------------------------------------------------------

subgraph STEP8_CLARIFY["STEP 8: CLARIFYING -- Progressive Disclosure (T+30ms)"]
  direction TB

  FSM_CLARIFY["FSM: CLARIFYING\nGenerate entropy-minimizing question\nvia ILLMPort (budget: 300 tokens, INV-21)"]:::state
  CLARIFY_LLM["LLM generates question:\n'How many people should I plan for,\nand any dietary preferences?'\n(1 question covers 2 gaps)"]:::llm
  CLARIFY_OUT["Emit k1.response.clarification.v1\nPriority: IMMEDIATE\n-> OutputManager.enqueue()\n-> IOutputPort -> SSE to user"]:::output
  CLARIFY_TRACK["ClarificationTracker.track_round(meal_planning)\nRound 1 of 3 max (INV-09)"]:::service

  FSM_CLARIFY --> CLARIFY_LLM --> CLARIFY_OUT
  FSM_CLARIFY --> CLARIFY_TRACK
end

UNCERT_CHECK -->|"YES: uncertainty 0.28 >= 0.2\nFSM transition to CLARIFYING"| FSM_CLARIFY

USER_REPLY["USER REPLY\n'2 adults and 1 toddler,\nno nuts -- she is allergic'\n(T+8000ms -- user took 8 seconds)"]:::user

CLARIFY_OUT -->|"SSE delivery to user\nvia WebSocket/SSE adapter"| USER_REPLY

%% ------------------------------------------------------------------------------------
%% STEP 9: RE-ENTER ACKING WITH NEW EVIDENCE
%% ------------------------------------------------------------------------------------

subgraph STEP9_REACK["STEP 9: Re-enter ACKING with New Evidence (T+8001ms)"]
  direction TB

  REACK["FSM: ACKING (re-entry)\nUltraBERT re-classifies combined context\n---\nNew signals:\nservings=3 (2 adults + 1 toddler)\ndietary=nut_free (allergy)\nentity=toddler (age-appropriate food)\n---\nUpdated uncertainty: 0.08 (< 0.2)\nTier remains: MEDIUM (multi-domain)"]:::state
  REACK_WRITES["Phase 1 writes (updated):\nBELIEFS_ACTIVE: +nut_allergy, +3_servings, +toddler\nCONTROL: intents refined, gaps filled\nAFFECTIVE_NOW: concern_level=moderate (allergy mention)"]:::write
end

USER_REPLY -->|"IInputPort.receive()\nre-enter via Mailbox"| REACK
REACK --> REACK_WRITES

%% ------------------------------------------------------------------------------------
%% STEP 10: LLM PHASE 2 -- ACKNOWLEDGE_REQUEST (Signal Tool)
%% ------------------------------------------------------------------------------------

subgraph STEP10_ACK["STEP 10: Intent Acknowledgment -- Signal Tool (T+8025ms)"]
  direction TB

  ACK_LLM["LLM tool loop (TOOL_CALL capability)\nFirst tool call: acknowledge_request()\n---\nintent='meal_planning + budget_check'\nplan_preview='Finding nut-free dinner options\nfor your family under $30'\n---\nBudget: 150 tokens max (INV-19)"]:::llm
  ACK_DISPATCH["ToolDispatcher validates:\n- State: ACKING (allowed)\n- Tier: MEDIUM (allowed)\n- Safety: GREEN (allowed)\n- Schema: valid params"]:::service
  ACK_EMIT["Emit k1.response.intent_ack.v1\nPriority: IMMEDIATE\n-> OutputManager -> IOutputPort\n-> SSE to user (~50ms from re-entry)"]:::output

  ACK_LLM --> ACK_DISPATCH --> ACK_EMIT
end

REACK -->|"ILLMPort.execute(HubRequest)\ncapability=TOOL_CALL\nbudget={max_tokens:150}"| ACK_LLM
UNCERT_CHECK -->|"NO (on re-entry):\nuncertainty 0.08 < 0.2\nproceed to dispatch"| ACK_LLM

%% ------------------------------------------------------------------------------------
%% STEP 11: COGNITIVE TOOLS (parallel with ack, Phase 2 writes)
%% ------------------------------------------------------------------------------------

subgraph STEP11_COGNITIVE["STEP 11: Cognitive Tool Calls -- Phase 2 Writes (T+8030ms)"]
  direction TB

  COG_SCORE["update_scoreboard()\nreferents: 'she' -> toddler\nQUD: [what_to_cook, where_to_buy]\nsalience: nut_allergy=HIGH"]:::tool_cognitive
  COG_BELIEF["update_beliefs()\nNew facts: family_has_nut_allergy\ntoddler_age_appropriate_food_needed\nbudget_30_for_3_people"]:::tool_cognitive
  COG_NARR["update_narrative()\nthread: NEW 'dinner_planning_tonight'\nstatus: active"]:::tool_cognitive

  COG_NOTE["All cognitive tools:\n-> ToolDispatcher.dispatch()\n-> MutationGuard.preflight() per write\n-> IStatePort.write(section, op, data)\n-> SessionState updated\n---\nWrites: SCOREBOARD, BELIEFS_ACTIVE,\nNARRATIVE_ACTIVE sections"]:::note
end

ACK_LLM -->|"LLM parallel tool calls\n(cognitive + signal together)"| COG_SCORE
ACK_LLM --> COG_BELIEF
ACK_LLM --> COG_NARR

%% ------------------------------------------------------------------------------------
%% STEP 12: DISPATCHING -- MEDIUM TIER PATH
%% ------------------------------------------------------------------------------------

TIER_CHECK -->|"MEDIUM: route to DISPATCHING"| FSM_DISPATCH

subgraph STEP12_DISPATCH["STEP 12: DISPATCHING -- TaskEnvelope to Orchestrator (T+8080ms)"]
  direction TB

  FSM_DISPATCH["FSM: DISPATCHING\nTier=MEDIUM: TaskEnvelope path\n---\nBuilds TaskEnvelope:\n{intent: [meal_planning, budget_check]\n context: {servings:3, nut_free, tonight, $30, home}\n tier: MEDIUM\n trace_id: from step 1}"]:::state
  DISPATCH_PORT["IDispatchPort.dispatch_envelope(TaskEnv)\nFIRE_AND_FORGET\n-> FabricOrchestratorAdapter\n-> Routes to Orchestrator Mailbox"]:::port

  FSM_DISPATCH --> DISPATCH_PORT
end

%% ------------------------------------------------------------------------------------
%% STEP 13: COMPANIONING -- Keep User Engaged
%% ------------------------------------------------------------------------------------

subgraph STEP13_COMPANION["STEP 13: COMPANIONING -- Preliminary Ack (T+8090ms)"]
  direction TB

  FSM_COMPANION["FSM: COMPANIONING\nPreliminary ack to user while Orchestrator works\n---\nLLM call (budget: 200 tokens, INV-20):\n'Looking into nut-free dinner ideas\nfor your family. Checking recipes\nand prices now...'"]:::state
  COMP_OUT["Emit k1.response.ack.v1\nPriority: REALTIME\n-> OutputManager -> SSE to user"]:::output
  COMP_INTERRUPTIBLE["State is INTERRUPTIBLE\nIf user sends new message,\nINTERRUPT_HANDLING triggers"]:::note

  FSM_COMPANION --> COMP_OUT
end

FSM_DISPATCH -->|"FSM transition to COMPANIONING"| FSM_COMPANION

%% ------------------------------------------------------------------------------------
%% STEP 14: ORCHESTRATOR PROCESSES (External -- NO LLM, NO Tools)
%% ------------------------------------------------------------------------------------

subgraph STEP14_ORCHESTRATOR["STEP 14: Orchestrator -- Blind DAG Executor (T+8100ms to T+12000ms)"]
  direction TB

  ORCH_RECEIVE["OrchestratorActor\nReceives TaskEnvelope from Mailbox\nWFQ Priority: REALTIME\n---\nTier=MEDIUM: direct to Fabric (1-2 calls)\n(HIGH would go: PlanRequest -> Planner\n-> CommittedPlan -> DAG)"]:::orchestrator

  subgraph ORCH_MED_PATH["MEDIUM Path: Direct Fabric Calls"]
    direction TB

    ORCH_FABRIC_1["Fabric Call 1: recipe_search\nCapabilityRequest:\n{capability: 'recipe_search'\n params: {dietary:'nut_free', servings:3,\n   meal_type:'dinner', max_time:'2hr'}}\n-> CapabilityFabric resolves + executes"]:::fabric
    ORCH_FABRIC_2["Fabric Call 2: price_check\nCapabilityRequest:\n{capability: 'grocery_price_check'\n params: {budget:30, store_proximity:'home',\n   ingredients: [from recipe results]}}\n-> CapabilityFabric resolves + executes"]:::fabric

    ORCH_FABRIC_1 --> ORCH_FABRIC_2
  end

  ORCH_RECEIVE --> ORCH_FABRIC_1

  ORCH_RESULTS["Aggregated results:\n3 nut-free dinner recipes\neach with ingredient list + estimated cost\nRecipe A: $22, Recipe B: $27, Recipe C: $18\nAll under $30 budget"]:::engine

  ORCH_FABRIC_2 --> ORCH_RESULTS
end

DISPATCH_PORT -->|"TaskEnvelope via K1 Bus"| ORCH_RECEIVE

%% ------------------------------------------------------------------------------------
%% STEP 14B: HIGH TIER PATH (shown for completeness)
%% ------------------------------------------------------------------------------------

subgraph STEP14B_HIGH_PATH["HIGH Tier Path (if complexity was HIGH)"]
  direction TB

  HIGH_NOTE["If tier=HIGH, Orchestrator would:\n1. Send PlanRequest to Planner\n2. Planner runs 4 stages:\n   Sketch -> Expand -> Validate -> Commit\n   (LLM-powered, 4 read-only discovery tools)\n3. Planner returns CommittedPlan\n4. Orchestrator walks DAG topologically\n5. Parallel steps where no dependencies\n6. Step retry: 2 attempts, then graceful fail\n7. Cancel dependents on failure, continue independent"]:::note

  subgraph PLANNER_DETAIL["Planner Discovery Tools (served by Fabric)"]
    direction TB
    PD1["discover_capabilities()\nSemantic Top-K from registries"]:::tool
    PD2["find_relevant_prompts()\nSemantic search Prompt Registry"]:::tool
    PD3["query_planning_context()\nRead SessionState sections"]:::tool
    PD4["recall_for_planning()\nK0 long-term memory via Bridge"]:::tool
  end

  subgraph HIL_DETAIL["Human-in-the-Loop (Planner + Orchestrator)"]
    direction TB
    HIL_CLARIFY["k1.hil.clarification.v1\n'Prefer vegetarian or include meat?'\nCorrelated by request_id"]:::hil
    HIL_APPROVE["k1.hil.approval_request.v1\n'Approve this plan before I proceed?'\nTo user via OUTPUT_CHANNEL"]:::hil
    HIL_RESPOND["User response detected by\nHIL Response Detector in ACKING\nMatches request_id in PENDING_CLARIFICATIONS\nRoutes back to originator via K1 Bus"]:::hil
  end
end

%% ------------------------------------------------------------------------------------
%% STEP 15: CAPABILITY FABRIC -- Resolution + Execution
%% ------------------------------------------------------------------------------------

subgraph STEP15_FABRIC["STEP 15: Capability Fabric -- Dual Role (T+8200ms to T+11500ms)"]
  direction TB

  FABRIC_CORE["CapabilityFabric\nRole 1: Intelligent Retrieval (serves Planner)\nRole 2: Resolution + Execution (serves Orchestrator/Concierge)\nRole 3: Agent Factory (spawns per-step workers)"]:::fabric

  subgraph FABRIC_RESOLVE["Resolution Flow"]
    direction TB
    FAB_REGISTRY["Capability Registry\nAgent/Tool/Workflow/Prompt index\n100K+ items at scale\n---\nResolves 'recipe_search' -> RecipeSearchTool\nResolves 'grocery_price_check' -> PriceCheckTool"]:::registry
    FAB_CTX["Capability Context Builder\nSessionState -> Fabric Context\nInjects user preferences, location, time\nToken Budget: 128K"]:::engine
  end

  FABRIC_CORE --> FAB_REGISTRY
  FABRIC_CORE --> FAB_CTX

  subgraph FABRIC_EXEC["Execution Flow"]
    direction TB
    FAB_TOOL_EXEC["Tool Execution\nRecipeSearchTool.execute(params)\nPriceCheckTool.execute(params)\n---\nReal API calls to recipe/price services\nResults: JSON payloads"]:::engine
    FAB_AGENT_FACTORY["Agent Factory (if needed)\nSpawn per-step workers from YAML templates\nMailbox + LLM + SessionState read + granted tools\n---\nNOT used for MEDIUM tier simple tools\nUsed for HIGH tier complex agents"]:::fabric
  end

  FABRIC_CORE --> FAB_TOOL_EXEC
end

ORCH_FABRIC_1 -->|"CapabilityRequest"| FABRIC_CORE
ORCH_FABRIC_2 -->|"CapabilityRequest"| FABRIC_CORE

%% ------------------------------------------------------------------------------------
%% STEP 16: DELTA AGGREGATION -- Results Flow Back
%% ------------------------------------------------------------------------------------

subgraph STEP16_DELTAS["STEP 16: Delta Aggregation -- Results Return (T+11500ms)"]
  direction TB

  DELTA_BUS["K1 Bus -- Delta Lane\nTopics: k1.orchestration.delta.v1\nCarries: orchestration results, progress, errors"]:::routing
  DELTA_PORT["IDeltaPort.subscribe()\nvia DeltaBusAdapter\nReceives delta stream"]:::port
  AGG_WINDOW["Delta Aggregation Window\n500ms batching (INV-14)\nasync timer callback\nMerge conflicts: LWW (Last Writer Wins)\nSort by priority"]:::service
  TOOL_BUFFER["Tool Result Buffer\nStages results for LLM context:\n- 3 recipe results\n- 3 price check results\n- dietary compliance flags\nCleared after DELIVERING"]:::memory

  DELTA_BUS --> DELTA_PORT --> AGG_WINDOW --> TOOL_BUFFER
end

ORCH_RESULTS -->|"orchestration deltas\nvia K1 Bus (delta lane)"| DELTA_BUS

%% ------------------------------------------------------------------------------------
%% STEP 17: PROGRESSING -- Stream Updates to User
%% ------------------------------------------------------------------------------------

subgraph STEP17_PROGRESS["STEP 17: PROGRESSING -- User Updates (T+9000ms to T+11500ms)"]
  direction TB

  FSM_PROGRESS["FSM: PROGRESSING\nStream execution deltas as updates\n---\nProgress narrations to user:\nT+9000: 'Found 3 nut-free recipes...'\nT+10500: 'Checking prices at nearby stores...'\nT+11500: 'All options under budget!'"]:::state
  PROG_OUT["Emit k1.response.progress.v1\nPriority: PROGRESS (level 2)\n-> OutputManager -> SSE to user\nFIRE_AND_FORGET delivery"]:::output

  FSM_PROGRESS --> PROG_OUT
end

FSM_COMPANION -->|"k1.agent.*.delta.v1\nfrom Orchestrator progress"| FSM_PROGRESS
AGG_WINDOW -->|"aggregated batch\nto FSMController"| FSM_PROGRESS

%% ------------------------------------------------------------------------------------
%% STEP 18: DELIVERING -- Final LLM Compose
%% ------------------------------------------------------------------------------------

FSM_PROGRESS -->|"execution.completed\nall results in buffer"| FSM_DELIVER

subgraph STEP18_DELIVER["STEP 18: DELIVERING -- Final Response Composition (T+12000ms)"]
  direction TB

  FSM_DELIVER["FSM: DELIVERING\nFetch all tool_results from buffer\n---\nContextAssembler.assemble(MEDIUM, intent, tool_results)\nBuilds LLM context with:\n- tool_results[] (recipes + prices)\n- SessionState HOT snapshot\n- persona + style hints\n- affective mirroring cues\n- conversation history\n---\nToken budget: 2K max (MEDIUM tier)\nContext window: 128K (INV-18)"]:::state

  DELIVER_LLM["LLM Call via ILLMPort\ncapability=CHAT + TOOL_CALL\n---\nLLM composes final response:\n- Empathetic opening (stress acknowledged)\n- 3 nut-free dinner options\n- Each with cost breakdown (all under $30)\n- Toddler-friendly notes\n- Next-step suggestions\n---\nALSO makes cognitive tool calls:\n- update_scoreboard(): QUD resolved\n- update_beliefs(): dinner_planned=true\n- update_narrative(): thread progressed"]:::llm

  DELIVER_CONTEXT["ContextAssembler checks:\nneeds_summarization()?\nAssembled context < 80% of 128K = NO\n(system-initiated pre-call guard)"]:::service

  FSM_DELIVER --> DELIVER_CONTEXT --> DELIVER_LLM
end

TOOL_BUFFER -->|"all tool_results[]"| FSM_DELIVER

%% ------------------------------------------------------------------------------------
%% STEP 19: LLM GATEWAY -- Model Hub + Prompt System
%% ------------------------------------------------------------------------------------

subgraph STEP19_LLM_GATEWAY["STEP 19: LLM Gateway -- Model Hub Pipeline (T+12050ms)"]
