  TURN_COMPLETE["Emit turn.complete.v1 via IDeltaPort\n---\nPayload:\n{turn_id, session_id, cognitive_trace_id,\n user_message, assistant_response,\n timestamp_ms, tool_calls[], token_usage}\n---\nConsumers: Memory Writer, Learning Loop"]:::output

