  %% === Drivers (SPI) — add store aliases used by cognitive detail ===
  subgraph K0_DRIVERS["Drivers (SPI)"]
    K0_SQL["st_sqlite (WAL)"]:::storage
    st_outbox["Outbox (in‑kernel)"]:::storage
    st_receipts["Receipts (in‑kernel)"]:::storage
    K0_FTS["st_fts (FTS5)"]:::storage
    K0_VEC["st_vector"]:::storage
    K0_KG["st_kg"]:::storage
    K0_BLOB["st_blob (CAS)"]:::storage
    K0_MLS["crypto_mls (keys/ratchet)"]:::mid
    K0_SYNC["sync_crdt"]:::mid
    K0_SSE_DRV["sse_driver (ACL/cursors)"]:::mid
    evt_wal["WAL (in‑kernel)"]:::storage
    evt_offsets["Offsets (in‑kernel)"]:::storage
    evt_dlq["DLQ (in‑kernel)"]:::storage

    %% Aliases so cognitive detail can target kernel drivers (no user-space storage)
    st_fts["st_fts (alias)"]:::storage
    st_vec["st_vec (alias)"]:::storage
    st_epi["st_episodic (alias)"]:::storage
    st_sem["st_semantic (alias)"]:::storage
    st_kg_dom["st_kg_domain (alias)"]:::storage
    st_hipp_store["st_hipp_store (alias)"]:::storage
    st_emb["st_embeddings (alias)"]:::storage
    st_ws["st_workspace (alias)"]:::storage
  end

  %% core data path inside kernel
  CMD-->K0_PEP-->K0_SCHED-->K0_IDEMP-->K0_SQL
  K0_SQL-->st_outbox
  K0_SQL-->st_receipts
  K0_SQL-.durable.->evt_wal
  K0_TIMERS-->K0_BUS
  K0_SSE_DRV<-->SSE
  K0_BUS<-->K0_SSE_DRV
  K0_BUS<-->K0_REPLAY
  K0_REPLAY-->evt_dlq
  K0_REPLAY-->evt_offsets

  %% idempotency wiring - explicit link to kernel
  SHARED_IDEMPOTENCY-->K0_IDEMP

  %% alias wiring to drivers (dashed = alias)
  st_fts-.alias.->K0_FTS
  st_vec-.alias.->K0_VEC
  st_epi-.alias.->K0_SQL
  st_sem-.alias.->K0_SQL
  st_kg_dom-.alias.->K0_KG
  st_hipp_store-.alias.->K0_SQL
  st_emb-.alias.->K0_VEC
  st_ws-.alias.->K0_SQL
end

