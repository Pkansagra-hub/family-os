    %% ======================================================================================
    %% DATA FLOW: DEVICE → K0 (INBOUND)
    %% ======================================================================================

    %% Flow 1: Device writes data to K0
    DEV_APPLE_WATCH -->|"1. HealthKit data"| ADAPT_HEALTHKIT
    DEV_NEST -->|"1. Temperature change"| ADAPT_HOMEKIT
    DEV_TESLA -->|"1. Vehicle telemetry"| ADAPT_TESLA
    DEV_MQTT_SENSOR -->|"1. Sensor reading"| ADAPT_MQTT

    ADAPT_HEALTHKIT -->|"2. Parse protocol"| IFL_PARSE
    ADAPT_HOMEKIT -->|"2. Parse protocol"| IFL_PARSE
    ADAPT_TESLA -->|"2. Parse protocol"| IFL_PARSE
    ADAPT_MQTT -->|"2. Parse protocol"| IFL_PARSE

    IFL_PARSE -->|"3. Translate to IFL"| IFL_TRANSLATE
    IFL_TRANSLATE -->|"4. Validate schema"| IFL_SCHEMA_VALIDATE
    IFL_SCHEMA_VALIDATE -->|"5. Create Envelope"| IFL_TO_ENVELOPE

    IFL_TO_ENVELOPE -->|"6. Submit to K0"| CMD_SUBMIT_FN
    CMD_SUBMIT_FN -->|"7. Acquire QoS token"| QOS_CTX_ACQUIRE
    QOS_CTX_ACQUIRE -->|"8. Acquire scheduler"| SCHED_ACQUIRE
    SCHED_ACQUIRE -->|"9. Gate validate"| GATE_VALIDATE
    GATE_VALIDATE -->|"10. Policy eval"| PEP_EVALUATE
    PEP_EVALUATE -->|"11. Begin txn"| UOW_ENTER
    UOW_ENTER -->|"12. Write WAL"| WAL_APPEND
    WAL_APPEND -->|"13. Enqueue outbox"| OUTBOX_ENQUEUE
    OUTBOX_ENQUEUE -->|"14. Post-commit dispatch"| BUS_DISPATCH
    BUS_DISPATCH -->|"15. Route to pipeline"| PIPELINE_DEVICE
    PIPELINE_DEVICE -->|"16. Process device event"| PIPELINE_HEALTH
    PIPELINE_HEALTH -->|"17. Emit observability"| OBS_EMIT

    %% Flow 2: K0 → Device (OUTBOUND CONTROL)
    PIPELINE_HOME -->|"1. Generate command"| IFL_SEND_CMD
    IFL_SEND_CMD -->|"2. Queue command"| IFL_QUEUE_CMD
    IFL_QUEUE_CMD -->|"3. Enqueue outbox"| OUTBOX_ENQUEUE
    OUTBOX_ENQUEUE -->|"4. Resolve device"| IFL_GET_DEVICE
    IFL_GET_DEVICE -->|"5. Resolve driver alias"| ALIAS_RESOLVE
    ALIAS_RESOLVE -->|"6. Load smart home driver"| DRV_HOME
    DRV_HOME -->|"7. Get adapter"| ADAPT_HOMEKIT
    ADAPT_HOMEKIT -->|"8. Send to device"| DEV_NEST
    DEV_NEST -->|"9. Response"| IFL_HANDLE_RESP
    IFL_HANDLE_RESP -->|"10. Trace span"| TRACER_SPAN

    %% Flow 3: Device Enrollment (via command path)
    DEV_IPHONE -->|"1. Enroll request"| IFL_ENROLL
    IFL_ENROLL -->|"2. Create envelope"| IFL_TO_ENVELOPE
    IFL_TO_ENVELOPE -->|"3. Submit command"| CMD_SUBMIT_FN
    CMD_SUBMIT_FN -->|"4. Gate validate"| GATE_VALIDATE
    GATE_VALIDATE -->|"5. Policy eval"| PEP_EVALUATE
    PEP_EVALUATE -->|"6. Begin txn"| UOW_ENTER
    UOW_ENTER -->|"7. Write WAL"| WAL_APPEND
    WAL_APPEND -->|"8. Enqueue outbox"| OUTBOX_ENQUEUE
    OUTBOX_ENQUEUE -->|"9. Post-commit dispatch"| BUS_DISPATCH
    BUS_DISPATCH -->|"10. Route to provisioning"| PIPELINE_DEVICE
    PIPELINE_DEVICE -->|"11. Register device"| IFL_REG_DEVICE
    IFL_REG_DEVICE -->|"12. Provision keys"| PROV_REGISTER
    PROV_REGISTER -->|"13. Register schema"| IFL_SCHEMA_REG
    IFL_SCHEMA_REG -->|"14. Acquire lease"| IFL_ACQUIRE_LEASE
    IFL_ACQUIRE_LEASE -->|"15. Persist registry"| DB_DEVICE_REG
    IFL_REG_DEVICE -->|"16. Issue receipt"| RECEIPT_ISSUE

    %% Flow 4: Cross-Device Orchestration (full IFL path)
    DEV_APPLE_WATCH -->|"Heart rate spike"| ADAPT_HEALTHKIT
    ADAPT_HEALTHKIT -->|"Parse protocol"| IFL_PARSE
    IFL_PARSE -->|"Translate to IFL"| IFL_TRANSLATE
    IFL_TRANSLATE -->|"Validate schema"| IFL_SCHEMA_VALIDATE
    IFL_SCHEMA_VALIDATE -->|"Create envelope"| IFL_TO_ENVELOPE
    IFL_TO_ENVELOPE -->|"Submit command"| CMD_SUBMIT_FN
    CMD_SUBMIT_FN -->|"Gate + Policy + UoW"| UOW_ENTER
    UOW_ENTER -->|"WAL + Outbox"| WAL_APPEND
    WAL_APPEND -->|"Post-commit"| BUS_DISPATCH
    BUS_DISPATCH -->|"Health pipeline"| PIPELINE_HEALTH
    PIPELINE_HEALTH -->|"Detect anomaly"| PIPELINE_DEVICE
    PIPELINE_DEVICE -->|"Trigger action"| IFL_SEND_CMD
    IFL_SEND_CMD -->|"Queue command"| IFL_QUEUE_CMD
    IFL_QUEUE_CMD -->|"Resolve adapter"| IFL_GET_TRANSLATOR
    IFL_GET_TRANSLATOR -->|"Get HomeKit adapter"| ADAPT_HOMEKIT
    ADAPT_HOMEKIT -->|"Send command"| DEV_NEST
    DEV_NEST -->|"Confirmation response"| IFL_HANDLE_RESP
    IFL_HANDLE_RESP -->|"Trace completion"| TRACER_SPAN

    %% Flow 5: Device Discovery
    DEV_CUSTOM_APP -->|"mDNS broadcast"| IFL_MDNS
    IFL_MDNS -->|"Discover"| IFL_AUTO_DISCOVER
    IFL_AUTO_DISCOVER -->|"Register"| IFL_REG_DEVICE

    %% Flow 6: Query Path (connect query floaters)
    QRY_RECALL_FN -->|"Execute query"| QUERY_EXECUTE
    QUERY_EXECUTE -->|"Resolve driver"| ALIAS_RESOLVE
    ALIAS_RESOLVE -->|"Query device data"| DRV_HEALTH
    DRV_HEALTH -->|"Fetch health records"| DB_DEVICE_REG

    %% Flow 7: Vehicle telemetry
    ADAPT_TESLA -->|"Parse vehicle data"| IFL_PARSE
    ALIAS_RESOLVE -->|"Route vehicle commands"| DRV_VEHICLE

    %% Flow 8: Sensor data ingestion
    ADAPT_MQTT -->|"Parse sensor payload"| IFL_PARSE
    ALIAS_RESOLVE -->|"Store sensor data"| DRV_SENSOR

    %% Storage connections
    IFL_REG_DEVICE -.->|"Persist"| DB_DEVICE_REG
    IFL_ACQUIRE_LEASE -.->|"Persist"| DB_DEVICE_LEASE
    IFL_SCHEMA_REG -.->|"Persist"| DB_DEVICE_SCHEMAS
    IFL_QUEUE_CMD -.->|"Persist"| DB_DEVICE_COMMANDS

    %% Observability
    IFL_PARSE -->|"Emit metrics"| METRIC_DEVICE_MSG
    IFL_SEND_CMD -->|"Trace span"| TRACER_SPAN
    IFL_ACQUIRE_CONN -->|"Connection gauge"| METRIC_DEVICE_CONN
    ADAPT_HEALTHKIT -->|"Error counter"| METRIC_DEVICE_ERR

