                R3_MINHASH["MinHashLSH — minhash_lsh.py<br/>━━━━━━━━━━━━━━━━━<br/>For >50K events: O(log n)<br/>num_hashes: 128<br/>num_bands: 32<br/>similarity_threshold: 0.85<br/>━━━━━━━━━━━━━━━━━<br/>Auto-switch:<br/><10K: pairwise O(n)<br/>10-50K: bucketing O(n/b)<br/>>50K: LSH O(log n)"]:::algo

