                R1_HEB_FORMULA["━━━━ HEBBIAN UPDATE ━━━━<br/>Δw = η × (1 - w/w_max)<br/>new_weight = old_weight + Δw<br/>━━━━━━━━━━━━━━━━━━<br/>Anti-Hebbian (corrections):<br/>Δw = -η_anti × explicit_multiplier<br/>━━━━━━━━━━━━━━━━━━<br/>RelationType: INTERACTS_WITH<br/>FREQUENTS, DISCUSSES"]:::formula
