                R3_NOVEL["DuplicateDetector<br/>duplicate_detector.py<br/>━━━━━━━━━━━━━━━━━<br/>novelty = 1 - max(sim_to_existing)<br/>Output: DuplicationResult<br/>is_duplicate, duplicate_of_id<br/>hamming_distance"]:::algo
            end

