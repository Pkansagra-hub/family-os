    %% Flow 1: Command Submit (Full Chain)
    HTTP_CLIENT -->|"1 POST envelope"| CMD_SUBMIT_FN
    CMD_SUBMIT_FN -->|"2 Parse validate"| GATE_VALIDATE
    GATE_VALIDATE -->|"3 Schema lookup"| SCHEMA_GET
    GATE_VALIDATE -->|"4 Device verify"| PROV_LOOKUP
    GATE_VALIDATE -->|"5 Compute hash"| CRYPTO_COMPUTE_SHA
    GATE_VALIDATE -->|"6 Derive idem"| IDEM_CANONICAL
    GATE_VALIDATE -->|"7 Check replay"| WAL_READ_FROM
    CMD_SUBMIT_FN -->|"8 Check duplicate"| IDEM_LOOKUP
    CMD_SUBMIT_FN -->|"9 Policy eval"| PEP_EVALUATE
    PEP_EVALUATE -->|"10 Create stamp"| STAMP_CREATE
    PEP_EVALUATE -->|"11 Build obligations"| REDACT_APPLY
    CMD_SUBMIT_FN -->|"12 Apply QoS"| QOS_CTX_ACQUIRE
    QOS_CTX_ACQUIRE -->|"13 Acquire token"| SCHED_ACQUIRE
    CMD_SUBMIT_FN -->|"14 Begin txn"| UOW_ENTER
    UOW_ENTER -->|"15 Append entry"| UOW_APPEND_WAL
    UOW_ENTER -->|"16 Save obligations"| OBLIG_SAVE
    UOW_ENTER -->|"17 Stage outbox"| UOW_STAGE_OUTBOX
    UOW_ENTER -->|"18 Issue receipt"| RECEIPT_ISSUE
    RECEIPT_ISSUE -->|"19 Sign receipt"| CRYPTO_SIGN_RECEIPT
    RECEIPT_ISSUE -->|"20 Save receipt"| UOW_SAVE_RECEIPT
    UOW_EXIT -->|"21 Upsert idem"| IDEM_UPSERT
    UOW_EXIT -->|"22 Commit hooks"| BUS_DISPATCH
    BUS_DISPATCH -->|"23 Publish to hub"| SSE_HUB
    SSE_HUB -->|"24 Fan-out to subscribers"| SSE_SUBSCRIBE
    BUS_DISPATCH -->|"25 Mark outbox ready"| OUTBOX_TICK
    OUTBOX_TICK -->|"26 Dequeue batch"| WORKER_PROCESS
    BUS_DISPATCH -->|"27 Route to pipelines"| PIPELINE_ROUTER
    PIPELINE_ROUTER -->|"28 Match topic"| PIPELINE_HANDLE
    PIPELINE_HANDLE -->|"29 Execute pipeline logic"| PIPELINE_PHASE1
    PIPELINE_HANDLE -->|"30 Emit completion"| PIPELINE_EMIT
    RECEIPT_ISSUE -->|"31 Return receipt"| CMD_SUBMIT_FN

    %% Flow 2: Query Recall
    HTTP_CLIENT -->|"1 POST selector"| QRY_RECALL_FN
    QRY_RECALL_FN -->|"2 Policy envelope"| PEP_EVALUATE
    QRY_RECALL_FN -->|"3 QoS token"| SCHED_ACQUIRE
    QRY_RECALL_FN -->|"4 Execute query"| QUERY_EXECUTE
    QUERY_EXECUTE -->|"5 Resolve driver"| QUERY_BUILD_DEFAULT
    QUERY_BUILD_DEFAULT -->|"6 Query WAL"| WAL_READ_FROM

    %% Flow 3: SSE Subscribe
    SSE_CLIENT -->|"1 GET subscribe"| SSE_SUBSCRIBE_FN
    SSE_SUBSCRIBE_FN -->|"2 Load ACL"| ACL_CHECK
    SSE_SUBSCRIBE_FN -->|"3 Query offsets"| OFFSET_FETCH
    SSE_SUBSCRIBE_FN -->|"4 Read WAL"| WAL_READ_FROM
    SSE_SUBSCRIBE_FN -->|"5 Backpressure"| SSE_EVAL_BP
    SSE_SUBSCRIBE_FN -->|"6 QoS token"| SCHED_ACQUIRE

    %% Flow 4: Outbox Processing
    WORKER_PROCESS -->|"1 Dequeue batch"| OUTBOX_DEQUEUE
    WORKER_PROCESS -->|"2 Resolve alias"| ALIAS_RESOLVE
    ALIAS_RESOLVE -->|"3 Load driver"| PGVECTOR_APPLY
    ALIAS_RESOLVE -->|"4 Load driver"| POSTGRES_EXECUTE
    WORKER_PROCESS -->|"5 On failure"| RETRY_DECIDE
    RETRY_DECIDE -->|"6 Requeue DLQ"| DLQ_RECORD

    %% Flow 5: FTS Indexing
    WORKER_PROCESS -->|"1 Check content"| FTS_INDEX_WAL
    FTS_INDEX_WAL -->|"2 Update index"| FTS_SEARCH

    %% Flow 6: Driver Handshake
    DRIVER_CLIENT -->|"1 POST handshake"| DRV_HANDSHAKE_FN
    DRV_HANDSHAKE_FN -->|"2 Validate"| POOL_HANDSHAKE
    POOL_HANDSHAKE -->|"3 Resolve alias"| ALIAS_RESOLVE
    POOL_HANDSHAKE -->|"4 Create session"| POOL_GET_SESSION
    POOL_HANDSHAKE -->|"5 Register worker"| WORKER_REGISTER

    %% Flow 7: Observability
    CMD_SUBMIT_FN -->|"Emit events"| OBS_EMIT
    SSE_SUBSCRIBE_FN -->|"Log traces"| TRACER_SPAN
    RECEIPT_ISSUE -->|"Emit observability"| OBS_EMIT
    BUS_DISPATCH -->|"Middleware traces"| TRACER_SPAN

    %% Flow 8: Infrastructure
    APP_CREATE -->|"Wire components"| UOW_ENTER
    APP_CREATE -->|"Register routers"| CMD_SUBMIT_FN
    APP_CREATE -->|"Apply migrations"| ALB_UPGRADE
    APP_CREATE -->|"Replay WAL"| REPLAY_RUN
    APP_CREATE -->|"Load pipelines"| LOADER_DISCOVER
    LOADER_DISCOVER -->|"Register pipelines"| PIPELINE_P01
    CLI_SERVE -->|"CLI commands"| APP_CREATE

    %% Flow 9: Capability Mesh (ADR-K004)
    APP_CREATE -->|"Register capabilities"| FABRIC_DISCOVER
    FABRIC_DISCOVER -->|"Load YAML definitions"| FABRIC_LOAD_DEFS
    FABRIC_LOAD_DEFS -->|"Register providers"| CAP_REG_REGISTER
