    FABRIC_INVOKE -->|"5 Record metrics"| CAP_REG_RECORD

    %% Flow 10: Pipeline Scheduler (ADR-K004)
    APP_CREATE -->|"Create scheduler"| SCHED_PIPELINE_CLASS
