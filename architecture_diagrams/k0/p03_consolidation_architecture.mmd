    subgraph L10_CONFIG["⚙️ CONFIGURATION & FEATURE FLAGS"]
        direction TB

        subgraph CORE_CONFIG["Core Configuration"]
            CONFIG_TRIGGER["Trigger mode: INTERVAL/THRESHOLD/MANUAL"]:::config
