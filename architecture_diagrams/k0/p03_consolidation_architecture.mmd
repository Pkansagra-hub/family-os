        direction TB

        subgraph P02_INPUT["From P02 (Memory Formation)"]
            P02_EVENTS["st_hipp_events table"]:::storage
            P02_TRIGGER["Trigger: pending_events ≥ 100"]:::trigger
            P02_FORMAT["Format: episodic events with embeddings"]:::format
        end

        subgraph P08_INPUT["From P08 (Embeddings)"]
            P08_VECTORS["st_vec table"]:::storage
            P08_MODEL["UltraBERT v2.1.0"]:::model
            P08_DIMS["768-dim vectors"]:::format
        end

        subgraph K1_FEEDBACK["From K1 (Experience Layer)"]
            K1_SALIENCE["Salience adjustments"]:::feedback
            K1_CORRECTIONS["Cluster corrections"]:::feedback
            K1_IMPORTANCE["Importance feedback"]:::feedback
            K1_REGRET["Regret signals"]:::feedback
        end

        subgraph P06_RESOLUTIONS["From P06 (Active Learning)"]
            P06_ANSWERS["Resolved gap answers"]:::feedback
            P06_CLARIFICATIONS["User clarifications"]:::feedback
        end
    end
    subgraph L1_PHASES["🔄 CORE CONSOLIDATION PHASES"]
        direction LR
        subgraph R0_PHASE["R0: Trigger Detection & Batch Selection"]
            R0_IDLE["IDLE State"]:::phase
            R0_TRIGGER_LOGIC["Trigger Logic"]:::logic
            R0_BATCH_SELECT["Batch Selection"]:::logic
            R0_TRANSITION["→ R1"]:::transition
        end
        subgraph R1_PHASE["R1: Hippocampal Replay (NREM1)"]
            R1_IMPORTANCE["Importance Scoring"]:::algorithm
            R1_HEBBIAN["Hebbian Learning"]:::algorithm
            R1_SELECTION["Event Selection"]:::logic
        end
        subgraph R2_PHASE["R2: Neocortical Integration (NREM2)"]
            R2_HDBSCAN["HDBSCAN Clustering"]:::algorithm
            R2_CLUSTER_QUALITY["Cluster Quality"]:::evaluation
            R2_PATTERN_EXTRACT["Pattern Extraction"]:::logic
        end
        subgraph R3_PHASE["R3: Synaptic Homeostasis (NREM3)"]
            R3_SIMHASH["SimHash Deduplication"]:::algorithm
            R3_DECAY["Decay Calculation"]:::algorithm
            R3_NOVELTY["Novelty Scoring"]:::algorithm
            R3_PRUNE["Prune Decisions"]:::logic
        end
        subgraph R4_PHASE["R4: KG Consolidation (NREM4)"]
            R4_ENTITY["Entity Extraction"]:::algorithm
            R4_DISAMBIGUATION["Disambiguation"]:::algorithm
            R4_CAUSALITY["Causal Inference"]:::algorithm
            R4_RELATIONSHIPS["Relationship Building"]:::logic
        end
        subgraph R5_PHASE["R5: Dream Exploration (REM)"]
            R5_COUNTERFACTUAL["Counterfactual Thinking"]:::algorithm
            R5_MCTS["MCTS Simulation"]:::algorithm
            R5_INSIGHTS["Insight Generation"]:::logic
            R5_STATUS["Status: MVP disabled"]:::status
        end
        subgraph R6_PHASE["R6: Staging Updates"]
            R6_STATUS_UPDATE["Update consolidation_status"]:::logic
            R6_METADATA["Store decision metadata"]:::logic
            R6_LINKING["Link to truth records"]:::logic
        end
        subgraph R7_PHASE["R7: Memory Layer Writes"]
            R7_RECONCILIATION["Apply reconciliation decisions"]:::logic
            R7_WRITE_OUTBOX["Write via st_outbox"]:::storage
            R7_COORD_P08["Coordinate with P08"]:::integration
            R7_AUDIT["Audit to st_consolidation_audit"]:::storage
        end
        subgraph R8_PHASE["R8: Event Emission & Completion"]
            R8_BUS_EVENTS["Emit bus events"]:::event
            R8_OFFSETS["Update st_offsets"]:::storage
            R8_METRICS["Emit metrics"]:::observability
            R8_TRANSITION["→ R0 (IDLE)"]:::transition
        end
    end
    subgraph L2_MEMORY["🧠 8 MEMORY LAYERS (TRUTH)"]
        direction TB

        subgraph EPISODIC["Episodic Memory (Layer 1)"]
            ST_EPI["st_epi table"]:::memory
            EPI_HALFLIFE["Half-life: 139 days"]:::property
            EPI_CONTENT["Episode clusters"]:::content
        end

        subgraph SEMANTIC["Semantic Patterns (Layer 2)"]
            ST_SEM["st_sem table"]:::memory
            SEM_HALFLIFE["Half-life: 231 days"]:::property
            SEM_CONTENT["Patterns & preferences"]:::content
        end

        subgraph PROCEDURAL["Procedural Memory (Layer 3)"]
            ST_PROCEDURAL["st_procedural table"]:::memory
            PROC_HALFLIFE["Half-life: 69 days"]:::property
            PROC_CONTENT["Habits & routines"]:::content
        end

        subgraph SOCIAL["Social Memory (Layer 4)"]
            ST_SOCIAL["st_social table"]:::memory
            SOCIAL_HALFLIFE["Half-life: 347 days"]:::property
            SOCIAL_CONTENT["Social graph"]:::content
        end

        subgraph PROSPECTIVE["Prospective Memory (Layer 5)"]
            ST_PROSPECTIVE["st_prospective table"]:::memory
            PROSP_HALFLIFE["Half-life: 35 days"]:::property
            PROSP_CONTENT["Intentions & goals"]:::content
        end

        subgraph KG_ENTITIES["KG Entities (Layer 6)"]
            ST_KG_DOM["st_kg_dom table"]:::memory
            KG_DOM_HALFLIFE["Half-life: 693 days"]:::property
            KG_DOM_CONTENT["Canonical entities"]:::content
        end

        subgraph KG_RELATIONS["KG Relationships (Layer 7)"]
            ST_KG_EDGES["st_kg_edges table"]:::memory
            KG_EDGES_HALFLIFE["Half-life: 87 days"]:::property
            KG_EDGES_CONTENT["Typed relationships"]:::content
        end

        subgraph EMBEDDINGS["Embeddings (Layer 8)"]
            ST_VEC["st_vec table"]:::memory
            VEC_HALFLIFE["Half-life: 7 days"]:::property
            VEC_CONTENT["768-dim vectors"]:::content
        end
    end
    subgraph L3_ALGORITHMS["⚙️ KEY ALGORITHMS & DECISION LOGIC"]
        direction TB

        subgraph IMPORTANCE_SCORING["Importance Scoring (R1)"]
            IMP_FORMULA["Formula: 0.35×emotional + 0.25×recency + 0.20×frequency + 0.20×social"]:::formula
            IMP_COMPONENTS["Components: salience, recency, access frequency, social"]:::components
            IMP_LEARNING["Weight learning via feedback"]:::learning
        end

        subgraph SIMILARITY["Multi-Factor Similarity"]
            SIM_FORMULA["Formula: 0.40×semantic + 0.25×structural + 0.15×entity + 0.10×temporal + 0.10×spatial"]:::formula
            SIM_LAYER_WEIGHTS["Per-layer weight adjustments"]:::learning
            SIM_COSINE["Cosine similarity (embeddings)"]:::algorithm
        end

        subgraph DECAY_LOGIC["Decay & Forgetting"]
            DECAY_FORMULA["decay = exp(-λ × days_since_observation)"]:::formula
            DECAY_LAMBDAS["Layer-specific λ values"]:::parameters
            DECAY_THRESHOLDS["Archival thresholds: 0.1→ARCHIVED, 0.01→TOMBSTONE"]:::thresholds
        end

        subgraph RECONCILIATION["Reconciliation Decision Matrix"]
            REC_REINFORCE[">0.85 aligned → REINFORCE"]:::decision
            REC_EXTEND["0.60-0.85 aligned → EXTEND"]:::decision
            REC_CREATE["<0.60 aligned → CREATE"]:::decision
            REC_CONTRADICT[">0.85 conflicting → CONTRADICT"]:::decision
            REC_EVOLVE["Semantic change → EVOLVE"]:::decision
            REC_PRUNE["No match + decay → PRUNE"]:::decision
        end

        subgraph CAUSALITY["Causal Inference"]
            CAUSAL_FORMULA["precedence_ratio = a_before_b / (a_before_b + b_before_a)"]:::formula
            CAUSAL_THRESHOLDS["Category-specific thresholds"]:::thresholds
            CAUSAL_OBSERVATIONS["Observation requirements"]:::requirements
        end
    end
    subgraph L4_LEARNING["🧠 LEARNING SYSTEMS & ADAPTATION"]
        direction TB

        subgraph THOMPSON_SAMPLING["Thompson Sampling for Thresholds"]
            THOMPSON_MODEL["Beta-Bernoulli model"]:::model
            THOMPSON_UPDATE["Update: α+=1 (correct), β+=1 (incorrect)"]:::update
            THOMPSON_HIERARCHY["3-level fallback hierarchy"]:::architecture
        end

        subgraph ADAPTIVE_CLUSTERING["Adaptive Clustering"]
            ADAPTIVE_PARAMS["Learn eps and min_samples"]:::parameters
            ADAPTIVE_SILHOUETTE["Silhouette score optimization"]:::optimization
            ADAPTIVE_CLOSED_LOOP["Closed-loop via user corrections"]:::feedback
        end

        subgraph BAYESIAN_ANCHORS["Bayesian Anchor Points"]
            ANCHOR_MODEL["Beta(α, β) distributions"]:::model
            ANCHOR_UPDATE["Update α/β with temporal decay"]:::update
            ANCHOR_DRIFT["Drift detection (Δ>0.20)"]:::detection
        end

        subgraph PER_LAYER_WEIGHTS["Per-Layer Similarity Weights"]
            WEIGHTS_STRUCTURE["8 layers × 5 factors = 40 weights"]:::parameters
            WEIGHTS_LEARNING["Learn from K1 feedback"]:::learning
            WEIGHTS_EXAMPLE["Example: st_epi weights"]:::example
        end
    end
    subgraph L5_MODULES["🔧 MODULE REGISTRY (M18-M25)"]
        direction LR

        M18["M18: EpisodicClusterer"]:::module
        M19["M19: DuplicateDetector"]:::module
        M20["M20: RetentionEnforcer"]:::module
        M21["M21: KGConsolidator"]:::module
        M22["M22: DreamExplorer"]:::module
        M23["M23: ReplayCoordinator"]:::module
        M24["M24: TruthWriter"]:::module
        M25["M25: GapDetector"]:::module
    end
    subgraph L6_OUTPUTS["🚀 DOWNSTREAM OUTPUTS"]
        direction TB

        subgraph P04_OUTPUT["To P04 (Query Pipeline)"]
            P04_TRUTH["Consolidated truth records"]:::output
            P04_CONTRACT["Contract: is_canonical=TRUE"]:::contract
            P04_QUERY["Query for K1 responses"]:::integration
