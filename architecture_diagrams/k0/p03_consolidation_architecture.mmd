    subgraph L8_DATAFLOW["📊 DATA FLOW PATTERNS"]
        direction TB

        subgraph MAIN_FLOW["Main Consolidation Flow"]
            FLOW_1["st_hipp_events → R0 (Trigger)"]:::flow
            FLOW_2["R0 → R1 (Importance)"]:::flow
            FLOW_3["R1 → R2 (Clustering)"]:::flow
            FLOW_4["R2 → R3 (Deduplication)"]:::flow
            FLOW_5["R3 → R4 (KG)"]:::flow
            FLOW_6["R4 → R5 (Dream)"]:::flow
            FLOW_7["R5 → R6 (Staging)"]:::flow
            FLOW_8["R6 → R7 (Writes)"]:::flow
            FLOW_9["R7 → 8 Memory Layers"]:::flow
            FLOW_10["R7 → R8 (Emission)"]:::flow
        end

        subgraph RECONCILIATION_FLOW["Reconciliation Flow"]
            RECON_FLOW_1["New signal → Query truth (8 layers)"]:::flow
            RECON_FLOW_2["Query → Compute similarity (multi-factor)"]:::flow
            RECON_FLOW_3["Similarity → Decision (REINFORCE/EXTEND/CREATE/etc.)"]:::flow
            RECON_FLOW_4["Decision → Apply to truth (R7 writes)"]:::flow
        end

        subgraph GAP_FLOW["Gap Detection Flow"]
            GAP_FLOW_1["Reconciliation decision → GapDetector"]:::flow
            GAP_FLOW_2["GapDetector → st_learning_queue"]:::flow
            GAP_FLOW_3["st_learning_queue → p03.gap.detected.v1"]:::flow
            GAP_FLOW_4["Event → P06 Active Learning"]:::flow
            GAP_FLOW_5["P06 → User question → Answer"]:::flow
            GAP_FLOW_6["Answer → P02 ingestion → Next P03 cycle"]:::flow
        end

        subgraph LEARNING_FLOW["Learning Feedback Flow"]
            LEARN_FLOW_1["K1 feedback → P21 → P03FeedbackHandler"]:::flow
            LEARN_FLOW_2["Handler → Route by signal type"]:::flow
            LEARN_FLOW_3["Route → Update st_learned_weights"]:::flow
            LEARN_FLOW_4["Updated weights → Next cycle"]:::flow
        end
    end
    subgraph L9_OBSERVABILITY["📈 OBSERVABILITY & METRICS"]
        direction TB

        subgraph PERFORMANCE_METRICS["Performance Metrics"]
