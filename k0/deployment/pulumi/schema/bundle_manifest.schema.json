{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "K0DeploymentBundleManifest",
  "type": "object",
  "required": ["stack", "generated_at", "components", "secrets"],
  "properties": {
    "stack": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["component", "path", "sha256", "size_bytes"],
        "properties": {
          "component": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "secrets": {
      "type": "object",
      "required": ["missing", "metadata"],
      "properties": {
        "missing": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "metadata": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "provider",
              "rotation_days",
              "hardware_binding",
              "description",
              "mount_path",
              "config_key",
              "available"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "provider": {
                "type": "string",
                "minLength": 1
              },
              "rotation_days": {
                "type": "integer",
                "minimum": 0
              },
              "hardware_binding": {
                "type": ["string", "null"]
              },
              "description": {
                "type": "string"
              },
              "mount_path": {
                "type": ["string", "null"]
              },
              "config_key": {
                "type": "string",
                "minLength": 1
              },
              "available": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "extra": {
      "type": "object",
      "properties": {
        "outputs": {
          "type": "object"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
