# Chaos engineering configuration for K0 kernel
# Generated by Ansible chaos role (Issue 9.1.4)

chaos:
  enabled: {{ chaos_enabled | default(false) | lower }}
  wal_fsync_fail_rate: {{ chaos_wal_fsync_fail_rate | default(0.0) }}
  scheduler_starvation_multiplier: {{ chaos_scheduler_starvation_multiplier | default(1.0) }}
  network_latency_ms: {{ chaos_network_latency_ms | default(0) }}
  telemetry_outage_rate: {{ chaos_telemetry_outage_rate | default(0.0) }}
{% if chaos_random_seed is defined %}
  random_seed: {{ chaos_random_seed }}
{% endif %}
