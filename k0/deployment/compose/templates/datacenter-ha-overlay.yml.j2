# Datacenter HA Compose overlay generated by Pulumi.
# TODO(familyos): Integrate with load balancer and service mesh once ADR-004 lands.
version: "3.9"

services:
  k0-ingress:
    deploy:
      mode: replicated
      replicas: 2
      placement:
        constraints:
          - node.labels.familyos.role == "edge-gateway"
    x-familyos-todo: "Wire ingress with hardware load balancer and TLS termination."

  k0-peer:
    deploy:
      mode: replicated
      replicas: {{ peer_count }}
      placement:
        constraints:
          - node.labels.familyos.role == "peer"
    x-familyos-todo: "Integrate peer autoscaler with scheduler budgets."

  k0-telemetry:
    deploy:
      mode: replicated
      replicas: {{ regions | length }}
    x-familyos-note: "Telemetry replicas should map one-to-one with regions: {{ regions | join(', ') }}."
    x-familyos-todo: "TODO(familyos): Replace static replicas with regional placement policies."

x-familyos-references:
  storage_fragments: {{ storage_fragments | tojson }}
  telemetry_fragments: {{ telemetry_fragments | tojson }}
