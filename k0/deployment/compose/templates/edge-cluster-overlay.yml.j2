# Edge cluster Compose overlay generated by Pulumi.
# TODO(familyos): Replace this overlay once orchestration migrates to the managed scheduler.
version: "3.9"

services:
  k0-kernel:
    deploy:
      mode: replicated
      replicas: {{ control_plane_replicas }}
      placement:
        max_replicas_per_node: 1
        constraints:
{% for zone in control_zones %}
          - node.labels.familyos.zone == "{{ zone }}"
{% endfor %}
    x-familyos-todo: "Validate kernel placement against hardware affinity requirements."
    x-familyos-reference: {{ storage_fragments | tojson }}

  k0-worker:
    deploy:
      mode: replicated
      replicas: {{ worker_replicas }}
{% if worker_zones %}
      placement:
        constraints:
{% for zone in worker_zones %}
          - node.labels.familyos.zone == "{{ zone }}"
{% endfor %}
{% endif %}
    x-familyos-todo: "Integrate worker autoscaler once edge telemetry budgets are finalised."

volumes:
{% for volume in persistent_volumes %}
  {{ volume.name }}:
    driver: local
    x-familyos-todo: "Provision persistent volume for {{ volume.mount_path }} with {{ volume.size_gib }}GiB capacity."
{% endfor %}
{% for volume in worker_volumes %}
  {{ volume.name }}:
    driver: local
    x-familyos-todo: "Confirm worker tier storage ({{ volume.name }}) replicates across availability zones."
{% endfor %}
