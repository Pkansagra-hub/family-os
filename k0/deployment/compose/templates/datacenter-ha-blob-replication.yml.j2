# Blob replication overlay for datacenter HA stack.
# TODO(familyos): Replace stub service with production-grade replication once object store contracts are final.
version: "3.9"

services:
  blob-replicator:
    image: ghcr.io/familyos/blob-replicator:latest
    deploy:
      mode: replicated
      replicas: 2
    environment:
      BLOB_PROVIDER: "{{ provider }}"
      SNAPSHOT_BUCKET: "{{ snapshot_bucket | default('TODO-configure-bucket') }}"
    x-familyos-todo: "Implement provider-specific sync logic and authentication bindings."
