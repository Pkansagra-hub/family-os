version: "3.8"
services:
  k0-kernel:
    image: {{ kernel_image }}
    env_file:
      - {{ env_file }}
    volumes:
      - {{ sqlite_path }}:/var/lib/k0/kernel.sqlite3
    ports:
      - "{{ kernel_port }}:8080"
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8080/readyz"]
      interval: 30s
      timeout: 5s
      retries: 5
  scheduler-worker:
    image: {{ worker_image }}
    depends_on:
      - k0-kernel
    environment:
      K0_KERNEL_ENDPOINT: http://k0-kernel:8080
