          "range": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "-3",
          "hide": false,
          "legendFormat": "-3σ Threshold",
          "range": true,
          "refId": "C"
        }
      ],
      "title": "Request Rate Z-Score (Spike Detection)",
