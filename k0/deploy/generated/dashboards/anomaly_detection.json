          "sort": "none"
        }
      },
      "pluginVersion": "10.2.2",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "deriv(\n  histogram_quantile(0.95,\n    sum(rate(k0_kernel_http_request_latency_seconds_bucket{operation=\"command\"}[5m])) by (le)\n  )[1h:]\n) * 1000",
          "legendFormat": "Command P95 Latency Trend",
