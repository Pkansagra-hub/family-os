{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "p03.episode.formed.v1",
  "title": "P03 Episode Formed Event",
  "description": "Emitted when a new episode is created in st_epi",
  "type": "object",
  "required": [
    "event_id",
    "cycle_id",
    "tenant_id",
    "space_id",
    "epi_id",
    "formed_at"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "description": "Unique event identifier (ULID)"
    },
    "cycle_id": {
      "type": "string",
      "description": "Consolidation cycle identifier"
    },
    "tenant_id": {
      "type": "string",
      "description": "Tenant identifier"
    },
    "space_id": {
      "type": "string",
      "description": "Space identifier"
    },
    "epi_id": {
      "type": "string",
      "description": "Episode identifier (st_epi.epi_id)"
    },
    "formed_at": {
      "type": "integer",
      "description": "Unix timestamp (seconds) when episode formed"
    },
    "summary": {
      "type": "string",
      "description": "Episode summary text"
    },
    "event_count": {
      "type": "integer",
      "description": "Number of events in episode"
    },
    "time_start": {
      "type": "integer",
      "description": "Earliest event timestamp in episode"
    },
    "time_end": {
      "type": "integer",
      "description": "Latest event timestamp in episode"
    },
    "importance_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Episode importance score"
    }
  },
  "additionalProperties": false
}
