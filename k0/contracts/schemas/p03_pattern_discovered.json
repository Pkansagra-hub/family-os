{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "p03.pattern.discovered.v1",
  "title": "P03 Pattern Discovered Event",
  "description": "Emitted when a new semantic pattern is discovered in st_sem",
  "type": "object",
  "required": [
    "event_id",
    "cycle_id",
    "tenant_id",
    "space_id",
    "sem_id",
    "pattern_type",
    "discovered_at"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "description": "Unique event identifier (ULID)"
    },
    "cycle_id": {
      "type": "string",
      "description": "Consolidation cycle identifier"
    },
    "tenant_id": {
      "type": "string",
      "description": "Tenant identifier"
    },
    "space_id": {
      "type": "string",
      "description": "Space identifier"
    },
    "sem_id": {
      "type": "string",
      "description": "Semantic pattern identifier (st_sem.sem_id)"
    },
    "pattern_type": {
      "type": "string",
      "enum": ["ROUTINE", "PREFERENCE", "RELATIONSHIP", "CONCEPT", "INSIGHT"],
      "description": "Type of semantic pattern"
    },
    "discovered_at": {
      "type": "integer",
      "description": "Unix timestamp (seconds) when pattern discovered"
    },
    "description": {
      "type": "string",
      "description": "Human-readable pattern description"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Pattern confidence score"
    },
    "evidence_count": {
      "type": "integer",
      "default": 0,
      "description": "Number of supporting events/episodes"
    }
  },
  "additionalProperties": false
}
