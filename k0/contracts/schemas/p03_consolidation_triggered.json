{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "p03.consolidation.triggered.v1",
  "title": "P03 Consolidation Triggered Event",
  "description": "Emitted by PipelineScheduler when P03 consolidation cycle is triggered",
  "type": "object",
  "required": [
    "event_id",
    "tenant_id",
    "space_id",
    "trigger_type",
    "triggered_at"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "description": "Unique event identifier (ULID)"
    },
    "tenant_id": {
      "type": "string",
      "description": "Tenant identifier for multi-tenancy"
    },
    "space_id": {
      "type": "string",
      "description": "Space identifier within tenant"
    },
    "trigger_type": {
      "type": "string",
      "enum": ["INTERVAL", "THRESHOLD", "MANUAL"],
      "description": "What triggered the consolidation cycle"
    },
    "triggered_at": {
      "type": "integer",
      "description": "Unix timestamp (seconds since epoch) when triggered"
    },
    "trigger_reason": {
      "type": "string",
      "description": "Human-readable trigger reason"
    },
    "pending_count": {
      "type": "integer",
      "description": "Number of pending events at trigger time (for THRESHOLD)"
    },
    "last_cycle_at": {
      "type": "integer",
      "description": "Unix timestamp (seconds) of last consolidation cycle"
    }
  },
  "additionalProperties": false
}
