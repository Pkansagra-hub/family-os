{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "p03.kg.updated.v1",
  "title": "P03 KG Updated Event",
  "description": "Emitted when knowledge graph is updated (entities/edges added)",
  "type": "object",
  "required": [
    "event_id",
    "cycle_id",
    "tenant_id",
    "space_id",
    "updated_at"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "description": "Unique event identifier (ULID)"
    },
    "cycle_id": {
      "type": "string",
      "description": "Consolidation cycle identifier"
    },
    "tenant_id": {
      "type": "string",
      "description": "Tenant identifier"
    },
    "space_id": {
      "type": "string",
      "description": "Space identifier"
    },
    "updated_at": {
      "type": "integer",
      "description": "Unix timestamp (seconds) when KG updated"
    },
    "entities_added": {
      "type": "integer",
      "default": 0,
      "description": "Number of new entities (st_kg_dom)"
    },
    "entities_updated": {
      "type": "integer",
      "default": 0,
      "description": "Number of updated entities"
    },
    "edges_added": {
      "type": "integer",
      "default": 0,
      "description": "Number of new edges (st_kg_edges)"
    },
    "edges_updated": {
      "type": "integer",
      "default": 0,
      "description": "Number of updated edges"
    }
  },
  "additionalProperties": false
}
