{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "p03.gap.detected.v1",
  "title": "P03 Gap Detected Event",
  "description": "Emitted when a knowledge gap is detected for P06 Active Learning",
  "type": "object",
  "required": [
    "event_id",
    "cycle_id",
    "tenant_id",
    "space_id",
    "gap_id",
    "gap_type",
    "detected_at"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "description": "Unique event identifier (ULID)"
    },
    "cycle_id": {
      "type": "string",
      "description": "Consolidation cycle identifier"
    },
    "tenant_id": {
      "type": "string",
      "description": "Tenant identifier"
    },
    "space_id": {
      "type": "string",
      "description": "Space identifier"
    },
    "gap_id": {
      "type": "string",
      "description": "Gap identifier (st_learning_queue.gap_id)"
    },
    "gap_type": {
      "type": "string",
      "enum": [
        "MISSING_CONTEXT",
        "AMBIGUOUS_REFERENCE",
        "LOW_CONFIDENCE",
        "CONTRADICTION",
        "INCOMPLETE_SEQUENCE",
        "UNKNOWN_RELATIONSHIP"
      ],
      "description": "Type of knowledge gap"
    },
    "detected_at": {
      "type": "integer",
      "description": "Unix timestamp (seconds) when gap detected"
    },
    "question_template": {
      "type": "string",
      "description": "Suggested question format for P06"
    },
    "priority_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Gap priority score"
    }
  },
  "additionalProperties": false
}
