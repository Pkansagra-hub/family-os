{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "cognitive.embedding.backfilled.v1",
  "title": "Cognitive Embedding Backfilled Event",
  "description": "Emitted when a PENDING embedding is backfilled (P08 M25)",
  "type": "object",
  "required": [
    "embedding_id",
    "event_id",
    "tenant_id",
    "space_id",
    "backfilled_at"
  ],
  "properties": {
    "embedding_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier for the newly created embedding record"
    },
    "event_id": {
      "type": "string",
      "description": "Hippocampus event ID (FK to st_hipp_events)"
    },
    "tenant_id": {
      "type": "string",
      "description": "Tenant identifier for multi-tenancy"
    },
    "space_id": {
      "type": "string",
      "description": "Space identifier within tenant"
    },
    "backfilled_at": {
      "type": "integer",
      "description": "Unix timestamp (seconds since epoch) when backfill completed"
    },
    "model_id": {
      "type": "string",
      "default": "ultrabert_v2.1.0",
      "description": "Embedding model used for backfill"
    },
    "vector_dim": {
      "type": "integer",
      "default": 768,
      "description": "Dimensionality of the embedding vector"
    },
    "previous_status": {
      "type": "string",
      "enum": ["PENDING"],
      "description": "Status before backfill (always PENDING)"
    },
    "new_status": {
      "type": "string",
      "enum": ["READY", "FAILED"],
      "description": "Status after backfill attempt"
    },
    "backfill_batch_id": {
      "type": "string",
      "description": "Optional batch identifier for bulk backfill operations"
    },
    "latency_ms": {
      "type": "integer",
      "description": "Time taken to generate embedding (ms)"
    }
  },
  "additionalProperties": false
}
