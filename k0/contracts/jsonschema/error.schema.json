{
  "$id": "error.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["error"],
  "properties": {
    "error": {
      "type": "object",
      "required": ["code", "reason", "trace_id", "component"],
      "properties": {
        "code": {
          "type": "string"
        },
        "component": {
          "type": "string"
        },
        "reason": {
          "type": "string",
          "pattern": "^[A-Z0-9_]+$"
        },
        "trace_id": {
          "type": "string",
          "format": "uuid"
        },
        "component": {
          "type": "string"
        },
        "hint": {
          "type": "string"
        },
        "budgets": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "details": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
