{
  "$id": "driver.handshake.request.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DriverHandshakeRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["alias", "transport", "endpoint"],
  "properties": {
    "alias": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_.-]+$"
    },
    "transport": {
      "type": "string",
      "enum": ["http", "grpc"]
    },
    "endpoint": {
      "type": "string",
      "minLength": 1
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "default": []
    },
    "metadata": {
      "type": "object",
      "default": {},
      "additionalProperties": true
    }
  }
}
