{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://familyos.ai/schemas/k0/retention_policy.schema.json",
  "title": "K0 Retention Policy",
  "description": "Schema for data retention policies in st_retention_policy table",
  "type": "object",
  "required": [
    "policy_id",
    "resource_type",
    "retention_days",
    "archive_enabled",
    "enabled",
    "created_at"
  ],
  "properties": {
    "policy_id": {
      "type": "string",
      "description": "Unique identifier for retention policy",
      "pattern": "^[A-Z0-9]{26}$|^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
    },
    "resource_type": {
      "type": "string",
      "description": "Type of resource subject to retention",
      "enum": ["st_epi", "st_sem", "st_proc", "st_hipp_store", "st_ws", "st_social", "st_wal"]
    },
    "retention_days": {
      "type": "integer",
      "description": "Number of days to retain data",
      "minimum": 1,
      "maximum": 36500
    },
    "archive_enabled": {
      "type": "boolean",
      "description": "If true, archive to blob storage; if false, hard delete"
    },
    "privacy_band_filter": {
      "type": ["string", "null"],
      "description": "Apply policy only to specific privacy band (null = all)",
      "enum": ["GREEN", "AMBER", "RED", null]
    },
    "tenant_id_filter": {
      "type": ["string", "null"],
      "description": "Apply policy only to specific tenant (null = all tenants)",
      "minLength": 1
    },
    "enabled": {
      "type": "boolean",
      "description": "Whether policy is active"
    },
    "created_at": {
      "type": "string",
      "description": "ISO8601 timestamp when policy was created",
      "format": "date-time"
    },
    "updated_at": {
      "type": ["string", "null"],
      "description": "ISO8601 timestamp when policy was last updated",
      "format": "date-time"
    }
  },
  "examples": [
    {
      "policy_id": "01ARZ3NDEKTSV4RRFFQ69G5FAV",
      "resource_type": "st_epi",
      "retention_days": 365,
      "archive_enabled": true,
      "privacy_band_filter": "GREEN",
      "tenant_id_filter": null,
      "enabled": true,
      "created_at": "2025-11-10T19:00:00Z",
      "updated_at": null
    }
  ]
}
