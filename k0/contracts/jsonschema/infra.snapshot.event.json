{
  "$id": "infra.snapshot.event.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["type", "watermark", "snapshot_id"],
  "properties": {
    "type": {
      "type": "string",
      "enum": ["BEGIN", "COMMIT"]
    },
    "watermark": {
      "type": "integer",
      "minimum": 0
    },
    "snapshot_id": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
