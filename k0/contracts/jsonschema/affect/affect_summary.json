{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://familyos.ai/schemas/affect/affect_summary.json",
  "title": "AffectSummary",
  "description": "Lightweight affect summary for K1 Planner/Concierge behavior mode adaptation. Maps affect to mood labels (Circumplex Model) and behavior modes. Reference: ADR-0012f (k003f)",
  "type": "object",
  "required": [
    "person_id",
    "space_id",
    "valence",
    "arousal",
    "band",
    "mood_label",
    "trend",
    "computed_at"
  ],
  "properties": {
    "person_id": {
      "type": "string",
      "description": "Unique identifier for the person",
      "minLength": 1,
      "maxLength": 255
    },
    "space_id": {
      "type": "string",
      "description": "Space/household identifier",
      "minLength": 1,
      "maxLength": 255
    },
    "valence": {
      "type": "number",
      "description": "Current valence from fast EMA",
      "minimum": -1.0,
      "maximum": 1.0
    },
    "arousal": {
      "type": "number",
      "description": "Current arousal from fast EMA",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "band": {
      "type": "string",
      "description": "Current policy band",
      "enum": ["GREEN", "AMBER", "RED", "BLACK"]
    },
    "mood_label": {
      "type": "string",
      "description": "Mood label based on Circumplex Model (valence × arousal mapping)",
      "enum": ["calm", "happy", "excited", "stressed", "sad", "frustrated"]
    },
    "trend": {
      "type": "string",
      "description": "Affect trend: fast EMA vs slow EMA divergence",
      "enum": ["improving", "declining", "stable"]
    },
    "household_state": {
      "type": "object",
      "description": "Lightweight household context for K1 (optional)",
      "properties": {
        "conflict_active": {
          "type": "boolean"
        },
        "family_moment_active": {
          "type": "boolean"
        },
        "household_valence_mean": {
          "type": "number",
          "minimum": -1.0,
          "maximum": 1.0
        }
      }
    },
    "behavior_modes": {
      "type": "array",
      "description": "Suggested K1 behavior modes (can have multiple active)",
      "items": {
        "type": "string",
        "enum": ["slow", "gentle", "quiet", "wind_down", "opportunity"]
      },
      "uniqueItems": true,
      "maxItems": 5
    },
    "computed_at": {
      "type": "number",
      "description": "Unix timestamp when summary was computed",
      "minimum": 0
    }
  },
  "additionalProperties": false
}
