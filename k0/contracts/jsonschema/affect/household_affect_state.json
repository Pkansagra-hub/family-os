{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://familyos.ai/schemas/affect/household_affect_state.json",
  "title": "HouseholdAffectState",
  "description": "Household-level affect dynamics including aggregates, conflict detection, family moments, and emotional contagion. Privacy-preserving (no individual person_ids exposed). Reference: ADR-0012g (k003g)",
  "type": "object",
  "required": [
    "space_id",
    "computed_at",
    "n_members",
    "aggregates",
    "conflict_active",
    "family_moment_active"
  ],
  "properties": {
    "space_id": {
      "type": "string",
      "description": "Space/household identifier",
      "minLength": 1,
      "maxLength": 255
    },
    "computed_at": {
      "type": "number",
      "description": "Unix timestamp when household state was computed",
      "minimum": 0
    },
    "n_members": {
      "type": "integer",
      "description": "Number of household members included in aggregates",
      "minimum": 1
    },
    "aggregates": {
      "type": "object",
      "description": "Statistical aggregates of household affect",
      "required": [
        "valence_mean",
        "valence_std",
        "valence_min",
        "valence_max",
        "arousal_mean",
        "arousal_std",
        "arousal_min",
        "arousal_max"
      ],
      "properties": {
        "valence_mean": {
          "type": "number",
          "description": "Mean valence across household members",
          "minimum": -1.0,
          "maximum": 1.0
        },
        "valence_std": {
          "type": "number",
          "description": "Standard deviation of valence (measures emotional divergence)",
          "minimum": 0.0,
          "maximum": 2.0
        },
        "valence_min": {
          "type": "number",
          "description": "Minimum valence (most negative member)",
          "minimum": -1.0,
          "maximum": 1.0
        },
        "valence_max": {
          "type": "number",
          "description": "Maximum valence (most positive member)",
          "minimum": -1.0,
          "maximum": 1.0
        },
        "arousal_mean": {
          "type": "number",
          "description": "Mean arousal across household members",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "arousal_std": {
          "type": "number",
          "description": "Standard deviation of arousal",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "arousal_min": {
          "type": "number",
          "description": "Minimum arousal (most calm member)",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "arousal_max": {
          "type": "number",
          "description": "Maximum arousal (most aroused member)",
          "minimum": 0.0,
          "maximum": 1.0
        }
      },
      "additionalProperties": false
    },
    "conflict_active": {
      "type": "boolean",
      "description": "Whether household conflict is detected (≥2 members distressed within 5min)"
    },
    "conflict_details": {
      "type": "object",
      "description": "Conflict metadata (only present if conflict_active=true)",
      "required": [
        "severity",
        "participants",
        "duration_seconds"
      ],
      "properties": {
        "severity": {
          "type": "number",
          "description": "Conflict severity score: 0.3×participants + 0.3×arousal + 0.2×valence + 0.2×variance",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "participants": {
          "type": "integer",
          "description": "Number of participants in conflict (privacy-preserving, no person_ids)",
          "minimum": 2
        },
        "duration_seconds": {
          "type": "integer",
          "description": "Duration of ongoing conflict in seconds",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "family_moment_active": {
      "type": "boolean",
      "description": "Whether a positive family moment is detected (≥3 members positive within 10min)"
    },
    "family_moment_details": {
      "type": "object",
      "description": "Family moment metadata (only present if family_moment_active=true)",
      "required": [
        "participants",
        "type"
      ],
      "properties": {
        "participants": {
          "type": "integer",
          "description": "Number of participants in family moment",
          "minimum": 3
        },
        "type": {
          "type": "string",
          "description": "Type of family moment",
          "enum": ["celebration", "bonding", "shared_joy"]
        },
        "duration_seconds": {
          "type": "integer",
          "description": "Duration of ongoing family moment in seconds",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "contagion_detected": {
      "type": "boolean",
      "description": "Whether emotional contagion is detected (one member's affect spreading to others)"
    },
    "contagion_details": {
      "type": "object",
      "description": "Emotional contagion metadata (only present if contagion_detected=true)",
      "properties": {
        "source_affect": {
          "type": "string",
          "description": "Type of affect spreading",
          "enum": ["distress", "joy", "anxiety", "calm"]
        },
        "magnitude": {
          "type": "number",
          "description": "Fraction of household affected (e.g., 0.6 = 60% of members)",
          "minimum": 0.0,
          "maximum": 1.0
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
