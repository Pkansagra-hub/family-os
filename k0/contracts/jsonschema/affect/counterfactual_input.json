{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://familyos.ai/schemas/affect/counterfactual_input.json",
  "title": "CounterfactualInput",
  "description": "Input for counterfactual 'what if?' simulation to predict affect impact of an action (sharing, notification, recall, planning). Reference: ADR-0012i (k003i)",
  "type": "object",
  "required": [
    "action_type",
    "content",
    "recipients",
    "current_affect_states"
  ],
  "properties": {
    "action_type": {
      "type": "string",
      "description": "Type of action being simulated",
      "enum": ["share", "notify", "recall", "suggest"]
    },
    "content": {
      "type": "object",
      "description": "Content being evaluated for affect impact",
      "required": [
        "text",
        "content_affect"
      ],
      "properties": {
        "text": {
          "type": "string",
          "description": "Text content to simulate (e.g., memory to share, notification message)",
          "maxLength": 10000
        },
        "content_affect": {
          "type": "object",
          "description": "Pre-computed affect of the content",
          "required": [
            "valence",
            "arousal"
          ],
          "properties": {
            "valence": {
              "type": "number",
              "minimum": -1.0,
              "maximum": 1.0
            },
            "arousal": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "recipients": {
      "type": "array",
      "description": "Person IDs of recipients to simulate impact for",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 255
      },
      "minItems": 1,
      "maxItems": 20
    },
    "current_affect_states": {
      "type": "object",
      "description": "Current affect state for each recipient (person_id → AffectEMAState)",
      "patternProperties": {
        ".*": {
          "type": "object",
          "required": [
            "valence",
            "arousal",
            "band"
          ],
          "properties": {
            "valence": {
              "type": "number",
              "minimum": -1.0,
              "maximum": 1.0
            },
            "arousal": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0
            },
            "band": {
              "type": "string",
              "enum": ["GREEN", "AMBER", "RED", "BLACK"]
            }
          }
        }
      },
      "minProperties": 1
    },
    "context": {
      "type": "object",
      "description": "Optional contextual information for simulation",
      "properties": {
        "space_id": {
          "type": "string"
        },
        "household_conflict_active": {
          "type": "boolean"
        },
        "time_of_day": {
          "type": "string",
          "enum": ["morning", "afternoon", "evening", "night"]
        }
      }
    }
  },
  "additionalProperties": false
}
