// k0/contracts/observability/receipts/schema/tool_receipt.fbs
// ToolReceipt FlatBuffers schema for tool execution audit logging
// HIPAA § 164.312(b): Audit controls for PHI access
// ADR-0038a: Receipt Generation & Schema

namespace K1.Receipts;

table ToolReceipt {
  // Receipt metadata
  receipt_id: string;
  receipt_type: string = "TOOL";

  // Session context
  session_id: string;
  space_id: string;
  user_id: string;
  turn_number: int;

  // Tool execution data (PII redacted)
  tool_name: string;
  tool_arguments: string;         // JSON string, redacted if PII
  tool_result: string;            // JSON string, redacted if PII
  success: bool;
  error: string;                  // Empty if success

  // Security context
  violation_type: string;         // From ADR-0032 egress rules
  privacy_band: string;

  // Performance metrics
  latency_ms: int;

  // Tracing
  trace_id: string;
  timestamp: long;                // Unix timestamp (ms)

  // Hash chain for tamper-evident audit trail
  previous_receipt_hash: string;
  current_hash: string;
}

root_type ToolReceipt;
