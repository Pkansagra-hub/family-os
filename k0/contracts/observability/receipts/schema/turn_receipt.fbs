// k0/contracts/observability/receipts/schema/turn_receipt.fbs
// TurnReceipt FlatBuffers schema for user turn audit logging
// GDPR Article 30: Record of processing activities
// ADR-0038a: Receipt Generation & Schema

namespace K1.Receipts;

table TurnReceipt {
  // Receipt metadata
  receipt_id: string;
  receipt_type: string = "TURN";

  // Session context
  session_id: string;
  space_id: string;
  user_id: string;
  turn_number: int;

  // Turn data (PII redacted based on privacy band)
  user_message: string;           // Redacted if PII (ADR-0035)
  agent_response: string;         // Redacted if PII
  privacy_band: string;           // GREEN | AMBER | RED

  // Performance metrics
  latency_ms: int;
  intent: string;                 // Intent classification

  // Tracing
  trace_id: string;
  timestamp: long;                // Unix timestamp (ms)

  // Hash chain for tamper-evident audit trail
  previous_receipt_hash: string;  // SHA-256 of previous receipt
  current_hash: string;           // SHA-256 of this receipt
}

root_type TurnReceipt;